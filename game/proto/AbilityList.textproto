}
ability {
  id: ABILITY_HIGHER_RANK
  name: "更高阶层"
  description: "先制招式的威力×1.2。"
  expanded_description: "拥有提升优先度（+1或更高）的招式获得20%的伤害加成."
}
ability {
  id: ABILITY_FUNERAL_PYRE
  name: "火葬柴堆"
  description: "非幽灵和恶属性宝可梦每回合损失1/4HP."
}
ability {
  id: ABILITY_FLAME_BUBBLE
  name: "火焰气泡"
  description: "水泡 + 烈焰之魂."
}
ability {
  id: ABILITY_ELEMENTAL_VORTEX
  name: "元素漩涡"
  description: "引火 + 储水."
