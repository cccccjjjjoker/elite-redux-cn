  expanded_description: "锤类招式攻击两次,每次造成招式正常伤害的70%.追加效果在每次攻击中独立判定（畏缩除外）."
}
ability {
  id: ABILITY_DENTING_BLOWS
  name: "凹陷打击"
  description: "锤类招式降低对手防御."
  expanded_description: "使用锤类攻击命中时,降低目标防御1级.每个目标每回合只能被影响一次防御降低在伤害之后生效."
}
ability {
  id: ABILITY_ICE_COLD_HUNTER
  name: "冰冷猎人"
  description: "在冰雹中,冰属性招式攻击两次."
  expanded_description: "在冰雹中,冰属性招式攻击两次,两次均造成全额伤害.使用者免疫冰雹伤害.两次攻击独立判定追加效果（畏缩除外）."
}
ability {
  id: ABILITY_SOUL_CRUSHER
  name: "灵魂粉碎者"
  description: "锤类招式攻击特防,并获得1.1倍威力加成."
  expanded_description: "锤类招式获得10%的伤害加成,并且伤害计算时目标改为特防而非防御."
}
ability {
  id: ABILITY_ARC_FLASH
  name: "弧光闪烁"
  description: "受到攻击时50%几率灼伤,造成伤害时50%几率麻痹."
  expanded_description: "当使用者攻击时,接触目标有50%的几率使其麻痹.当受到伤害时,有50%的几率使攻击者灼伤."
}
ability {
