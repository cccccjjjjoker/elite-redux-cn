}
ability {
  id: ABILITY_NO_TURNING_BACK
  name: "义无反顾"
  description: "当HP低于1/2时,全能力提升,但无法撤退."
  expanded_description: "当HP首次降至一半或以下时,所有能力提升1级,且使用者无法替换或逃走.常规的绕过此效果的方式（如逃脱按键或逃脱按键）仍然允许替换."
}
ability {
