  name: "潜行"
  description: "上场的第一回合获得+1优先度.负向优先度变为0."
  expanded_description: "在使用者上场的第一回合,所有优先度为0或更高的招式获得+1优先度.负向优先度招式变为优先度0,而非获得+1."
}
ability {
