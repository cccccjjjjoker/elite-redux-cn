}
ability {
  id: ABILITY_EARTH_EATER
  name: "食土"
  description: "受到地面属性招式攻击时，回复最大HP的25%。"
  expanded_description: "食土特性在受到地面属性招式攻击时,为该宝可梦回复其最大HP的25%."
}
ability {
  id: ABILITY_LINGERING_AROMA
  name: "余香"
