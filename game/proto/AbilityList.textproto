}
ability {
  id: ABILITY_FAE_HUNTER
  name: "妖精猎人"
  description: "对妖精造成1.5倍伤害。\n受妖精伤害减半。"
  expanded_description: "对妖精属性宝可梦造成1.5倍伤害,并且受到妖精属性宝可梦攻击时,伤害减半.此效果基于攻击方/防御方宝可梦的属性,而非招式属性.伤害减免与其他来源乘法叠加."
}
ability {
  id: ABILITY_GRAVITY_WELL
  name: "引力井"
  description: "出场时设置重力,持续5回合."
  expanded_description: "在进入战斗时设置重力,持续5回合.重力防止飞翔等飘浮招式,使所有宝可梦接地从而易受地面属性招式、沙穴和场地状态影响,使重力苹果的伤害提升50%,并使招式命中率提升66%."
}
ability {
