}
ability {
  id: ABILITY_EMERGENCY_EXIT
  name: "遁走"
  description: "当HP首次降至1/2或以下时,立即替换下场."
  expanded_description: "当该宝可梦受到伤害,且HP在战斗中首次降至50%或以下时,它会替换下场以保安全.对于连续攻击招式,在最后一击后触发."
}
ability {
  id: ABILITY_WATER_COMPACTION
  name: "遇水凝固"
  description: "受到的水属性招式伤害减半.被水属性招式击中后,防御提升2级."
  expanded_description: "受到的水属性招式伤害降低50%,并且被水属性招式击中后,防御提升2级.与其他减伤来源乘法叠加.防御提升效果在攻击命中后生效对于连续攻击招式,每次命中都会触发."
}
ability {
  id: ABILITY_MERCILESS
  name: "不仁不义"
  description: "攻击处于减速、中毒、麻痹或流血状态的对手时,必定会心一击."
  expanded_description: "对处于中毒、麻痹、流血或速度降低状态的目标,必定造成击中要害."
}
ability {
  id: ABILITY_SHIELDS_DOWN
  name: "界限盾壳"
  description: "当HP降至1/2或以下时,变身为核心形态."
  expanded_description: "当小陨星的HP降至50%或以下时,从流星形态变身为核心形态.在流星形态下,免疫所有异常状态.使用破壳时,无论当前HP多少,立即变身为核心形态.在战斗中一旦变身,无法恢复为流星形态."
}
ability {
  id: ABILITY_STAKEOUT
  name: "蹲守"
  description: "对刚替换上场的对手造成双倍伤害."
  expanded_description: "对刚替换上场的对手造成双倍伤害.仅在对手替换上场后的第一回合内生效."
}
ability {
  id: ABILITY_WATER_BUBBLE
  name: "水泡"
  description: "受到的火属性伤害减半.造成的水属性伤害加倍.不会灼伤."
  expanded_description: "水属性招式威力加倍,受到的火属性伤害降低50%.同时完全免疫灼伤,并在获得此特性时移除已有的灼伤状态."
}
ability {
  id: ABILITY_STEELWORKER
