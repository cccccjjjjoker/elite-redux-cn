  id: ABILITY_DEVOURER
  name: "吞噬者"
  description: "强壮之颚 + 原始颚."
  expanded_description: "使啃咬类招式威力提升30%.所有啃咬类招式攻击两次.第一击造成100%伤害,第二击造成40%伤害.每次攻击独立判定追加效果."
}
ability {
  id: ABILITY_PHANTOM_THIEF
  name: "幽灵窃贼"
  description: "出场时,使用威力40的幽灵窃贼进行攻击."
  expanded_description: "替换上场时,使用威力40的幽灵窃贼（幽灵属性招式）攻击正对面的对手.窃取目标所有的正向能力提升（在造成伤害前）,并将其赋予使用者.必定命中且无视替身."
}
ability {
  id: ABILITY_EARLY_GRAVE
  name: "早夭"
  description: "HP全满时，幽灵属性招式优先度+1。"
  expanded_description: "当HP全满时,幽灵属性招式获得+1优先度."
}
ability {
  id: ABILITY_GRAPPLER
  name: "擒拿手"
  description: "束缚类招式持续6回合,每回合造成1/6的HP伤害."
  expanded_description: "束缚类招式持续6回合而非4-5回合,并且每回合结束时的伤害提升至目标最大HP的1/6."
}
ability {
  id: ABILITY_BASS_BOOSTED
  name: "低音增强"
  description: "扩音器 + 庞克摇滚."
  expanded_description: "使声音类招式威力提升30%.单体目标的声音类招式变为范围攻击,同时攻击双方对手.连续攻击招式不会变为范围攻击同时使使用者的声音类招式再获得30%威力提升,并使受到的声音类招式伤害降低50%.伤害减免与其他来源乘法叠加."
}
ability {
  id: ABILITY_FLAMING_JAWS
  name: "烈焰之颚"
  description: "咬类招式有50%概率使目标灼伤。"
  expanded_description: "啃咬类招式在命中时有50%的几率使目标灼伤.连续攻击的每一击都会独立判定."
}
ability {
  id: ABILITY_MONSTER_HUNTER
  name: "怪物猎人"
  description: "对恶属性宝可梦造成1.5倍伤害.受到恶属性宝可梦攻击伤害减半."
  expanded_description: "对恶属性宝可梦造成1.5倍伤害,并且受到恶属性宝可梦攻击时,伤害减半.此效果基于攻击方/防御方宝可梦的属性,而非招式属性.伤害减免与其他来源乘法叠加."
}
ability {
  id: ABILITY_CROWNED_SWORD
  name: "冠之剑"
  description: "不挠之剑 + 愤怒穴位."
  expanded_description: "替换上场时,攻击提升1级.受到攻击时,攻击提升1级；受到击中要害时,攻击提升至最大.对于连续攻击招式,每次命中都会触发."
}
ability {
  id: ABILITY_CROWNED_SHIELD
  name: "冠之盾"
  description: "不屈之盾 + 持久力."
  expanded_description: "替换上场时,防御提升1级.受到攻击时,防御提升1级；受到击中要害时,防御提升至最大.对于连续攻击招式,每次命中都会触发."
}
ability {
  id: ABILITY_BERSERK_DNA
  name: "狂暴DNA"
  description: "上场时，攻击与特攻中较高的一项提升2级，但会陷入狂怒。"
  expanded_description: "出场时,使用者最高的攻击能力值提升2级,但会陷入愤怒,所有攻击附加33%的反伤.即使无法陷入愤怒,能力提升依然生效."
}
ability {
  id: ABILITY_CROWNED_KING
  name: "冠之王"
  description: "紧张感 + 漆黑嘶鸣 +苍白嘶鸣."
  expanded_description: "阻止所有对手宝可梦消耗其携带的物品.当使用者通过直接攻击击倒对手时,其攻击和特攻能力值各提升1级."
}
ability {
  id: ABILITY_SNAP_TRAP_WHEN_HIT
  name: "夹子陷阱"
  description: "受到接触类招式攻击时，使用威力50的捕兽夹。"
  expanded_description: "当使用者受到接触招式攻击时,以威力50的夹住进行反击.这个钢属性招式会束缚对手4-5回合,每回合造成其1/8的最大HP伤害."
}
ability {
  id: ABILITY_PERMANENCE
  name: "恒久"
  description: "对手无法以任何方式回复HP."
  expanded_description: "阻止所有对手宝可梦通过任何方式回复HP.阻挡回复类招式如自我再生,吸取类招式如吸取拳,剩饭等被动回复和再生力等特性,并阻止树果和其他物品的HP回复."
}
ability {
  id: ABILITY_HUBRIS
  name: "傲慢"
  description: "击倒对手时,特攻提升1级."
  expanded_description: "每当使用者通过直接攻击击倒对手时,其特攻能力值提升1级."
}
ability {
  id: ABILITY_COSMIC_DAZE
  name: "宇宙迷乱"
  description: "对混乱或愤怒的对手造成2倍伤害."
  expanded_description: "对处于混乱或愤怒状态的目标,攻击造成双倍伤害.此外,混乱或愤怒的敌人因此状态伤害自身时,受到的伤害也加倍."
}
ability {
  id: ABILITY_MINDS_EYE
  name: "心眼"
  description: "可以命中幽灵属性宝可梦.命中率不会被降低."
  expanded_description: "心眼允许一般属性和格斗属性招式以普通效果命中幽灵属性宝可梦.此外,此特性防止使用者的命中率被对手的招式或特性降低."
}
ability {
  id: ABILITY_BLOOD_PRICE
  name: "血价"
  description: "造成30%额外伤害,但攻击时损失10%的HP."
  expanded_description: "血价使所有攻击招式威力提升30%,但使用者在攻击命中时损失其最大HP的10%."
}
ability {
  id: ABILITY_SPIKE_ARMOR
  name: "尖刺盔甲"
  description: "接触时有30%概率使目标流血；主动攻击时也能触发。"
  expanded_description: "尖刺盔甲无论攻击方还是被攻击方,在使用接触类招式时有30%的几率造成流血.流血每回合造成1/16最大HP伤害,阻止回复,并使能力等级效果无效.岩石和幽灵属性免疫流血."
}
ability {
  id: ABILITY_VOODOO_POWER
  name: "巫毒之力"
  description: "受到特殊攻击时,有30%几率造成流血."
}
ability {
  id: ABILITY_CHROME_COAT
  name: "铬涂层"
  description: "受到的特殊伤害减少40%，速度×0.9，体重变为3倍。"
  expanded_description: "铬涂层使受到的特殊伤害降低40%,但速度降低10%.同时使使用者的重量变为3倍.伤害减免与其他来源乘法叠加."
}
ability {
  id: ABILITY_BANSHEE
  name: "女妖"
  description: "声音类招式获得1.2倍威力加成,若为一般属性则变为幽灵属性."
  expanded_description: "使所有声音类招式的威力提升20%,并将一般属性的声音类招式转变为幽灵属性."
}
ability {
  id: ABILITY_WEB_SPINNER
  name: "吐丝者"
  description: "出场时使用吐丝."
  expanded_description: "替换上场时使用吐丝,大幅降低所有对手的速度2级."
}
ability {
  id: ABILITY_SHOWDOWN_MODE
  name: "决胜模式"
  description: "埋伏 + 狂暴突袭."
  expanded_description: "替换上场后的一回合内,必定造成击中要害,同时攻击提升20%,速度提升50%."
}
ability {
  id: ABILITY_SEED_SOWER
  name: "播种者"
  description: "受到攻击时设置青草场地.同时治愈全队异常状态."
  expanded_description: "当该宝可梦受到直接攻击伤害时,激活青草场地,持续5回合（携带场地制造机时为8回合）.同时治愈己方所有宝可梦的异常状态."
}
ability {
  id: ABILITY_AIRBORNE
  name: "空中"
  description: "提升自身和同伴的飞行属性招式威力至1.3倍."
  expanded_description: "在战斗中使使用者及其同伴的飞行属性招式威力提升30%."
}
ability {
  id: ABILITY_PARROTING
  name: "模仿"
  description: "模仿其他宝可梦使用的声音类招式."
  expanded_description: "当场上任何宝可梦使用声音类招式后,该宝可梦会立即使用相同的招式每回合对每个招式触发一次."
}
ability {
  id: ABILITY_SALT_CIRCLE
  name: "盐圈"
  description: "出场时阻止对手宝可梦逃走."
  expanded_description: "当使用者进入战斗时,阻止所有对手宝可梦逃跑或替换效果持续到使用者下场.强制替换和快速折返等替换招式仍然有效."
}
ability {
  id: ABILITY_PURIFYING_SALT
  name: "净化之盐"
  description: "免疫异常状态；受到的幽灵属性招式伤害减半。"
  expanded_description: "免疫所有异常状态.此外,受到的幽灵属性伤害降低50%.如果在获得此特性时已处于异常状态,则立即治愈."
}
ability {
  id: ABILITY_PROTOSYNTHESIS
  name: "古代活性"
  description: "在大晴天或携带驱劲能量时,提升最高的能力."
  expanded_description: "在大晴天下,使用者最高的能力值提升（速度提升50%,其他提升30%）.大晴天结束时,如果携带驱劲能量则激活.此效果视为原始能力提升而非能力等级变化.除非被单纯光束或烦恼种子影响,否则无法被复制、压制或替换."
}
ability {
  id: ABILITY_QUARK_DRIVE
  name: "夸克充能"
  description: "在电气场地或携带驱劲能量时,提升最高的能力."
  expanded_description: "在电气场地中,使用者最高的能力值提升（速度提升50%,其他提升30%）.场地结束时,如果携带驱劲能量则激活.此效果视为原始能力提升而非能力等级变化.除非被单纯光束或烦恼种子影响,否则无法被复制、压制或替换."
}
ability {
  id: ABILITY_WIND_POWER
  name: "风力发电"
  description: "受到风类招式或在顺风中出场时进入充电状态."
  expanded_description: "受到基于风的招式攻击或在顺风中进入战斗时,获得充电状态.充电状态使下一次电属性招式威力加倍,直到使用为止."
}
ability {
  id: ABILITY_IMPULSE
  name: "脉冲"
  description: "特殊招式用速度计算伤害。"
  expanded_description: "非接触类招式使用速度能力值而非攻击/特攻进行伤害计算.讲究围巾的效果不影响此特性."
}
ability {
  id: ABILITY_TERMINAL_VELOCITY
  name: "终端速度"
  description: "特殊招式额外使用20%的速度能力值."
  expanded_description: "使用非接触类招式时,将使用者20%的速度能力值加入伤害计算.讲究围巾的效果不影响此特性."
}
ability {
  id: ABILITY_GUARD_DOG
  name: "看门狗"
  description: "不会被强制换下；威吓的效果反转。"
  expanded_description: "看门狗防止因招式或红牌被强制替换.受到威吓或惊吓影响时,改为提升相应能力1级而非降低."
}
ability {
  id: ABILITY_ANGER_SHELL
  name: "愤怒甲壳"
  description: "当HP降至1/2以下时,触发破壳."
  expanded_description: "当HP降至50%以下时,使用者触发破壳效果：攻击、特攻和速度各提升2级,同时防御和特防各降低1级.每场战斗仅触发一次.在连续攻击的最后一击后触发."
}
ability {
  id: ABILITY_EGOIST
  name: "利己主义者"
  description: "当对手提升能力时,自身也提升相同的能力."
  expanded_description: "利己主义者复制敌人宝可梦获得的能力提升,并应用于自身.不会复制其他利己主义者的增益."
}
ability {
  id: ABILITY_SUBDUE
  name: "制服"
  description: "该宝可梦造成的能力降低效果加倍."
  expanded_description: "使招式造成的能力降低效果加倍不影响自身引起的能力降低或敌人的特性."
}
ability {
  id: ABILITY_READIED_ACTION
  name: "准备就绪"
  description: "上场的第一回合攻击加倍."
  expanded_description: "使用者的攻击能力值在上场的第一回合变为2倍.与其他伤害加成效果乘法叠加.替换下场后再次上场可重新触发."
}
ability {
  id: ABILITY_DARK_GALE_WINGS
  name: "冥河冲刺"
  description: "HP全满时，恶属性招式优先度+1。"
  expanded_description: "当HP全满时,赋予恶属性招式+1优先度."
}
ability {
  id: ABILITY_GUILT_TRIP
  name: "愧疚"
  description: "濒死时,大幅降低攻击者的攻击和特攻."
  expanded_description: "给予使用者最后一击的攻击者,其攻击和特攻降低2级.仅当因直接伤害而濒死时生效."
}
ability {
  id: ABILITY_WATER_GALE_WINGS
  name: "潮汐冲击"
  description: "HP全满时，水属性招式优先度+1。"
  expanded_description: "当HP全满时,赋予水属性招式+1优先度."
}
ability {
  id: ABILITY_ZERO_TO_HERO
  name: "从零到英雄"
  description: "替换下场后改变形态."
  expanded_description: "替换下场后,再次上场时变身为英雄形态,持续到战斗结束.无法被压制、交换、复制或覆盖."
}
ability {
  id: ABILITY_COSTAR
  name: "同台共演"
  description: "出场时复制同伴的能力变化."
  expanded_description: "在双打对战中替换上场时,同台共演复制同伴的所有能力等级变化（包括正向和负向）."
}
ability {
  id: ABILITY_COMMANDER
  name: "指挥官"
  description: "进入同伴吃吼霸体内,强化同伴但自身无法行动."
  expanded_description: "允许米立龙进入同伴吃吼霸体内并变得无法被选中.吃吼霸获得全能力+2,无法替换或被强制替换,同时米立龙变得无法使用.如果吃吼霸濒死,米立龙重新出现并可正常行动.无法被交换、复制或压制."
}
ability {
  id: ABILITY_EJECT_PACK_ABILITY
  name: "战术撤退"
  description: "能力被降低时逃走."
  expanded_description: "当使用者的任何能力被降低时（包括自身引起的能力降低）,自动替换下场.每场战斗触发一次."
}
ability {
  id: ABILITY_VENGEFUL_SPIRIT
  name: "复仇之魂"
  description: "作祟的魂魄 + 复仇."
  expanded_description: "当被直接攻击击倒时,对攻击者施加诅咒.诅咒每回合造成其最大HP25%的伤害,直到被诅咒的宝可梦替换下场或濒死.幽灵属性的攻击者免疫此诅咒.幽灵属性招式威力提升30%,当HP低于1/3时提升50%."
}
ability {
  id: ABILITY_CUD_CHEW
  name: "反刍"
  description: "消耗树果后,在下一回合结束时再次食用."
  expanded_description: "消耗树果时,使用者在下一回合结束时再次食用该树果."
}
ability {
  id: ABILITY_ARMOR_TAIL
  name: "尾甲"
  description: "保护自身及同伴免受先制招式影响."
  expanded_description: "防止使用者和它的同伴成为优先度大于0的先制招式的目标."
}
ability {
  id: ABILITY_MIND_CRUSH
  name: "精神咬碎"
  description: "咬类招式使用特攻计算伤害，并多造成30%伤害。"
  expanded_description: "啃咬类招式使用特攻能力值进行伤害计算（除非另有说明,否则仍攻击目标的防御）,并造成30%额外伤害."
}
ability {
  id: ABILITY_SUPREME_OVERLORD
  name: "至高之主"
  description: "每只濒死的同伴使攻击和特攻提升10%."
  expanded_description: "己方每有一只濒死的同伴,攻击和特攻提升10%,最多5只同伴可使两项能力各提升50%.与其他伤害加成效果加法叠加."
}
ability {
  id: ABILITY_ILL_WILL
  name: "恶意"
  description: "删除导致该宝可梦濒死的招式的PP."
  expanded_description: "恶意特性会消耗击败使用者的招式的PP.必须是直接攻击."
}
ability {
  id: ABILITY_FIRE_SCALES
  name: "火鳞"
  description: "受到的特殊招式伤害减半.不会加倍特防."
  expanded_description: "所有受到的特殊攻击伤害减半.与其他减伤来源乘法叠加."
}
ability {
  id: ABILITY_WATCH_YOUR_STEP
  name: "注意脚下"
  description: "出场时撒下两层撒菱."
}
ability {
  id: ABILITY_RAPID_RESPONSE
  name: "快速响应"
  description: "上场的第一回合,速度提升50%,特攻提升20%."
  expanded_description: "使用者替换上场后的第一回合,获得50%的速度加成和20%的特攻加成."
}
ability {
  id: ABILITY_DOUBLE_IRON_BARBS
  name: "锋利的边缘"
  description: "受到接触类招式攻击时，攻击者损失最大HP的1/6。"
  expanded_description: "对使用接触类招式的攻击者造成其最大HP1/6的伤害.对于连续攻击招式,每次命中都会触发."
}
ability {
  id: ABILITY_THERMAL_EXCHANGE
  name: "热交换"
  description: "受到火属性攻击时,攻击提升.免疫灼伤."
  expanded_description: "受到火属性招式攻击时,攻击提升1级,并且免疫灼伤状态.攻击提升在受到火属性攻击的伤害后立即生效.对于连续攻击招式,每次命中都会触发."
}
ability {
  id: ABILITY_GOOD_AS_GOLD
  name: "黄金之躯"
  description: "免疫所有变化招式,除非影响全场."
  expanded_description: "黄金之躯免疫所有直接以该宝可梦为目标的变化招式.但仍会受到影响全场的黑雾等变化招式影响."
}
ability {
  id: ABILITY_SHARING_IS_CARING
  name: "分享即是关爱"
  description: "所有参战者的能力变化共享."
  expanded_description: "场上所有宝可梦的能力变化（正向和负向）都会在彼此间共享."
}
ability {
  id: ABILITY_TABLETS_OF_RUIN
  name: "灾祸之简"
  description: "降低其他宝可梦的攻击25%."
  expanded_description: "在使用者在场时,降低所有其他宝可梦的攻击能力值25%.多个相同的灾祸特性效果不叠加与攻击降低效果乘法叠加."
}
ability {
  id: ABILITY_SWORD_OF_RUIN
  name: "灾祸之剑"
  description: "降低其他宝可梦的防御25%."
  expanded_description: "在使用者在场时,降低所有其他宝可梦的防御能力值25%.多个相同的灾祸特性效果不叠加与防御降低效果乘法叠加."
}
ability {
  id: ABILITY_VESSEL_OF_RUIN
  name: "灾祸之鼎"
  description: "降低其他宝可梦的特攻25%."
  expanded_description: "在使用者在场时,降低所有其他宝可梦的特攻能力值25%.多个相同的灾祸特性效果不叠加与特攻降低效果乘法叠加."
}
ability {
  id: ABILITY_BEADS_OF_RUIN
  name: "灾祸之珠"
  description: "降低其他宝可梦的特防25%."
  expanded_description: "在使用者在场时,降低所有其他宝可梦的特防能力值25%.多个相同的灾祸特性效果不叠加与特防降低效果乘法叠加."
}
ability {
  id: ABILITY_PERMAFROST_CLONE
  name: "厚皮"
  description: "受到效果绝佳的招式攻击时,伤害降低35%."
  expanded_description: "受到效果绝佳的招式攻击时,伤害降低35%.与其他减伤效果乘法叠加."
}
ability {
  id: ABILITY_GALLANTRY
  name: "英勇"
  description: "第一次受到的伤害无效."
  expanded_description: "使第一次受到的伤害变为0.招式仍会连接且附加效果生效,但伤害变为0."
}
ability {
  id: ABILITY_ORICHALCUM_PULSE
  name: "绯红脉动"
  description: "出场时降下大晴天.在大晴天下,攻击提升至1.33倍."
  expanded_description: "出场时降下大晴天,持续8回合（携带炎热岩石时为12回合）.在大晴天下,使用者的攻击能力值提升33%."
}
ability {
  id: ABILITY_SUN_BASKING
  name: "日光浴"
  description: "在大晴天下,阻挡先制招式并使物理伤害减半."
  expanded_description: "在晴天时，阻挡先制招式，\n且受到的物理攻击伤害减半。\n与其他伤害减免相乘。"
}
ability {
  id: ABILITY_WINGED_KING
  name: "羽之王"
  description: "效果绝佳的招式威力提升33%."
  expanded_description: "效果绝佳的攻击威力提升33%."
}
ability {
  id: ABILITY_HADRON_ENGINE
  name: "强子引擎"
  description: "出场时制造电气场地.在电气场地上,特攻提升33%."
  expanded_description: "出场时制造电气场地,持续8回合（携带场地制造机时为12回合）.在电气场地上,使用者的特攻能力值提升33%."
}
ability {
  id: ABILITY_IRON_SERPENT
  name: "钢之蛇"
  description: "效果绝佳的招式威力提升33%."
  expanded_description: "效果绝佳的攻击威力提升33%."
}
ability {
  id: ABILITY_WEATHER_DOUBLE_BOOST
  name: "大灾变"
  description: "晴天时水属性招式增强。\n雨天时火属性招式增强。"
  expanded_description: "在大晴天下,水属性招式获得通常只在雨天才有的威力提升.在雨天下,火属性招式获得通常只在晴天才有的威力提升."
}
ability {
  id: ABILITY_SWEEPING_EDGE_PLUS
  name: "剑术大师"
  description: "横扫利刃与锋锐的效果。"
  expanded_description: "使所有锐利刀刃类招式必定命中,并在双打对战中同时攻击双方对手.连续攻击招式对每个目标只攻击一次.同时使锐利刀刃类招式威力提升30%."
}
ability {
  id: ABILITY_CELESTIAL_BLESSING
  name: "天之恩泽"
  description: "在薄雾场地中,每回合回复1/12的HP."
  expanded_description: "在薄雾场地中,每回合结束时回复使用者最大HP的1/12."
}
ability {
  id: ABILITY_MINION_CONTROL
  name: "仆从控制"
  description: "根据队伍中健康的成员数量,招式额外攻击数次."
  expanded_description: "招式每有一个健康的队伍成员（最多6次）,就额外攻击一次.处于濒死或异常状态的成员不计数.第一击造成全额伤害,每次额外攻击造成10%伤害.每次攻击独立判定追加效果."
}
ability {
  id: ABILITY_MOLTEN_BLADES
  name: "熔岩之刃"
  description: "锋锐的效果；切割类招式有20%概率使目标灼伤。"
  expanded_description: "锐利刀刃类招式威力提升30%,并有20%的几率在命中时造成灼伤."
}
ability {
  id: ABILITY_HAUNTING_FRENZY
  name: "萦绕狂暴"
  description: "20%几率使对手畏缩.击倒对手时,速度+1."
  expanded_description: "攻击有20%的几率造成畏缩.通过直接攻击击败敌人时,使用者获得+1速度."
}
ability {
  id: ABILITY_NOISE_CANCEL
  name: "噪音消除"
  description: "保护己方队伍免受声音类招式影响."
  expanded_description: "防止使用者和它的同伴成为声音类招式的目标."
}
ability {
  id: ABILITY_RADIO_JAM
  name: "无线电干扰"
  description: "声音类招式有20%几率造成封印效果."
  expanded_description: "使用声音类招式命中后,有20%几率封印目标最后使用的招式,持续4回合."
}
ability {
  id: ABILITY_OLE
  name: "¡Olé!"
  description: "20%几率闪避单体招式."
  expanded_description: "使所有以使用者为目标的单体招式的命中率降低20%.热风等范围招式保持正常命中率."
}
ability {
  id: ABILITY_MALICIOUS
  name: "恶毒"
  description: "出场时,降低对手最高的攻击和防御能力."
  expanded_description: "替换上场时,降低所有对手宝可梦最高的进攻能力（攻击或特攻）和最高的防御能力（防御或特防）各1级."
}
ability {
  id: ABILITY_DEAD_POWER
  name: "死亡之力"
  description: "攻击提升1.5倍.接触类招式有20%几率施加诅咒."
  expanded_description: "使用者的攻击能力值提升50%,并且接触类招式有20%的几率施加诅咒.诅咒每回合造成目标最大HP25%的伤害,直到被诅咒的宝可梦替换下场或濒死.攻击提升与其他伤害加成效果乘法叠加."
}
ability {
  id: ABILITY_BRAWLING_WYVERN
  name: "搏斗飞龙"
  description: "无防守 + 龙属性招式变为拳类招式."
  expanded_description: "确保该宝可梦使用的所有招式以及所有对该宝可梦使用的招式必定命中.龙属性招式被视为拳类招式."
}
ability {
  id: ABILITY_MYTHICAL_ARROWS
  name: "神话之箭"
  description: "箭矢类招式变为特殊,且造成30%额外伤害."
  expanded_description: "箭矢类招式变为特殊（造成特殊伤害并使用特攻能力值）,并造成30%额外伤害."
}
ability {
  id: ABILITY_LAWNMOWER
  name: "割草机"
  description: "上场时移除场地，然后提升防御或特防。"
  expanded_description: "替换上场时,移除任何激活的场地,并获得能力提升：移除青草或电气场地时,防御+1；移除薄雾、精神或剧毒场地时,特防+1."
}
ability {
  id: ABILITY_FLOURISH
  name: "茂密丛林"
  description: "在青草场地中,草属性招式威力提升50%."
  expanded_description: "当青草场地激活时,草属性招式威力提升50%."
}
ability {
  id: ABILITY_DESERT_SPIRIT
  name: "沙漠之魂"
  description: "出场时引发沙暴.在沙暴中,地面属性招式可以命中飘浮的宝可梦."
  expanded_description: "出场时引发沙暴,持续8回合（携带光滑岩石时为12回合）.在沙暴中,使用者的地面属性招式可以穿透免疫,以普通效果命中飘浮的宝可梦.使用者免疫沙暴伤害."
}
ability {
  id: ABILITY_CONTEMPT
  name: "蔑视"
  description: "纯朴 + 不服输."
  expanded_description: "进行伤害计算时,完全无视对手的所有能力等级变化.当该宝可梦的能力被其他宝可梦降低时,其攻击能力提升2级."
}
ability {
  id: ABILITY_AERIALIST
  name: "空中飞人"
  description: "飘浮 + 鸟群."
  expanded_description: "该宝可梦免疫地面属性招式以及其他地面效果,如撒菱和场地状态.飞行属性招式伤害提升25%.此外,飞行属性招式威力再提升20%,当HP低于1/3时提升50%."
}
ability {
  id: ABILITY_TERA_SHELL
  name: "太晶甲壳"
  description: "HP全满时,所有攻击都将变得效果不好."
  expanded_description: "当HP全满时,所有对该宝可梦的攻击都将造成效果不好的伤害,无论属性相性如何.与其他类似特性不同,此效果在连续攻击的每次命中都会激活."
}
ability {
  id: ABILITY_TOXIC_CHAIN
  name: "毒锁链"
  description: "攻击有30%概率使目标陷入剧毒。"
  expanded_description: "使用者在使用任何招式命中后,有30%的几率使目标陷入剧毒连续攻击的每一击都会独立判定."
}
ability {
  id: ABILITY_PARASITIC_SPORES
  name: "寄生孢子"
  description: "每回合对非幽灵属性造成1/8HP伤害.接触时传播."
  expanded_description: "出场时获得寄生孢子.每回合,受影响的宝可梦损失1/8最大HP（幽灵属性免疫）.使用接触招式时,将孢子传播给目标.孢子持续到替换下场."
}
ability {
  id: ABILITY_POISON_PUPPETEER
  name: "毒操偶师"
  description: "使目标中毒时，也会使其混乱。"
  expanded_description: "当使用者施加中毒时,也同时施加混乱.不会因毒菱而触发."
}
ability {
  id: ABILITY_ENTRANCE
  name: "着迷"
  description: "施加混乱时也施加着迷."
  expanded_description: "当使用者使对手混乱时,如果对手是异性,则也使其着迷（将其攻击和特攻减半）."
}
ability {
  id: ABILITY_REJECTION
  name: "拒绝"
  description: "出场时使用延后."
  expanded_description: "出场时使用延后.延后使大多数改变速度的效果无效,包括顺风、戏法空间、正向优先度、速度能力提升等.负向优先度正常工作.持续5回合."
}
ability {
  id: ABILITY_APPLE_ENLIGHTENMENT
  name: "苹果启示"
  description: "毛皮大衣 + 魔法防守."
  expanded_description: "所有受到的物理攻击伤害减半.与其他减伤来源乘法叠加.同时免疫所有非攻击性的伤害来源,包括入场陷阱、天气伤害、异常状态以及反伤伤害."
}
ability {
  id: ABILITY_BALLOON_BOMBER
  name: "气球炸弹"
  description: "引爆 + 充气."
  expanded_description: "当该宝可梦被击倒时,使用威力100的大爆炸或迸裂拳（取两者中威力更高者）.使用爆炸类招式时,必定使目标畏缩.受到任何火属性或飞行属性招式攻击时,防御和特防能力值各提升1级.对于连续攻击招式,每次命中都会触发.能力提升效果在攻击命中后生效."
}
ability {
  id: ABILITY_FLAMING_MAW
  name: "烈焰巨颚"
  description: "强壮之颚 + 烈焰之颚."
  expanded_description: "啃咬类招式威力提升30%,并在命中时有50%的几率使目标灼伤.连续攻击的每一击都会独立判定."
}
ability {
  id: ABILITY_DEMOLITIONIST
  name: "爆破专家"
  description: "准备就绪 + 无视保护 + 在准备回合击破屏障."
  expanded_description: "使用者的攻击能力值在一回合内变为2倍,击破屏障,并无视保护效果.与其他伤害加成效果乘法叠加.替换下场后再次上场可重新触发."
}
ability {
  id: ABILITY_ROCKHARD_WILL
  name: "磐石意志"
  description: "岩石属性招式威力提升至1.2倍,HP低于1/3时提升至1.5倍."
  expanded_description: "岩石属性招式威力提升20%,当HP低于1/3时提升50%."
}
ability {
  id: ABILITY_FRAGRANT_DAZE
  name: "芳香迷乱"
  description: "接触攻击有30%几率造成混乱."
  expanded_description: "无论攻击方还是被攻击方,使用接触类招式时有30%的几率造成混乱."
}
ability {
  id: ABILITY_LOW_VISIBILITY
  name: "低能见度"
  description: "上场时召唤持续8回合的雾。"
  expanded_description: "出场时召唤诡异迷雾,持续8回合（携带烟雾球时为12回合）.迷雾每回合减少非幽灵/超能力属性宝可梦的1级能力提升,使基于天气的回复效果减半,给予幽灵/超能力属性宝可梦20%的伤害减免,并将所有诅咒转变为幽灵属性的诅咒."
}
ability {
  id: ABILITY_OLD_MARINER
  name: "老水手"
  description: "海草 + 水系本系."
  expanded_description: "如果使用者是草属性,其受到的火属性攻击伤害减半,并且使用草属性招式对火属性宝可梦造成2倍伤害.伤害减免与其他来源乘法叠加.使水属性招式获得本系加成,无论使用者的属性如何.同时免疫浸水状态."
}
ability {
  id: ABILITY_ECTOPLASM
  name: "灵质"
  description: "在雾中,自身最高的攻击能力提升至1.5倍."
  expanded_description: "在迷雾中时,该宝可梦最高的攻击能力值提升50%."
}
ability {
  id: ABILITY_BEAUTIFUL_MUSIC
  name: "美妙音乐"
  description: "声音类招式有50%几率造成着迷,无视性别."
  expanded_description: "声音类招式在命中时有50%的几率使目标着迷（将其攻击和特攻减半）."
}
ability {
  id: ABILITY_SURPRISE
  name: "惊喜！"
  description: "在雾中,惊吓使用高优先度招式的使用者."
  expanded_description: "在迷雾中,以惊吓反击优先度招式.惊吓是威力40的幽灵属性攻击,拥有+3优先度且必定造成畏缩此能力会在对手的优先度招式使出前激活."
}
ability {
  id: ABILITY_SNOW_SONG
  name: "雪之歌"
  description: "声音类招式获得1.2倍威力加成,若为一般属性则变为冰属性."
  expanded_description: "使所有声音类招式的威力提升20%,并将一般属性的声音类招式转变为冰属性."
}
ability {
  id: ABILITY_GREATER_SPIRIT
  name: "崇高精神"
  description: "在雾中出场时,自身最高的能力值提升1级."
  expanded_description: "在迷雾中进入战斗时,使使用者最高的能力值提升1级."
}
ability {
  id: ABILITY_RESONANCE
  name: "共鸣"
  description: "声音类招式有50%几率造成流血."
  expanded_description: "声音类招式在命中时有50%的几率造成流血.流血每回合造成1/16最大HP伤害,阻止回复,并使能力等级效果无效.岩石和幽灵属性免疫流血."
}
ability {
  id: ABILITY_ETHEREAL_RUSH
  name: "飘渺冲刺"
  description: "在雾中,速度提升至1.5倍."
  expanded_description: "在迷雾中,该宝可梦的速度能力值提升50%."
}
ability {
  id: ABILITY_CUTE_ANTECEDENCE
  name: "漂亮特权"
  description: "HP全满时，妖精属性招式优先度+1。"
  expanded_description: "当HP全满时,赋予妖精属性招式+1优先度."
}
ability {
  id: ABILITY_RECURRING_NIGHTMARE
  name: "浅坟"
  description: "在雾中濒死后,复活一次,HP为25%."
  expanded_description: "在迷雾激活时濒死后,当派出下一只宝可梦时,使用者以25%的最大HP复活即使使用者是在迷雾的最后一回合濒死,此效果仍会激活."
}
ability {
  id: ABILITY_MENACING_SITUATION
  name: "恐惧症"
  description: "接触时有30%概率使目标恐惧；主动攻击时也能触发。"
  expanded_description: "无论攻击方还是被攻击方,使用接触类招式时有30%的几率造成恐惧.恐惧束缚目标2回合,使其受到的伤害增加50%.如果被吹飞等招式强制替换,目标会摆脱恐惧."
}
ability {
  id: ABILITY_SHINY_LIGHTNING
  name: "闪光闪电"
  description: "获得1.2倍的命中率提升.打雷必定命中."
  expanded_description: "该宝可梦的招式命中率变为1.2倍,且打雷必定命中."
}
ability {
  id: ABILITY_TERRIFY
  name: "恐怖"
  description: "出场时,降低所有对手的特攻2级."
  expanded_description: "进入战斗时,降低所有对手宝可梦的特攻能力值2级."
}
ability {
  id: ABILITY_ICE_DOWNFALL
  name: "冰崩"
  description: "受到接触类招式攻击时，使用威力60的冰柱坠击。"
  expanded_description: "受到接触招式攻击时,使用者以威力60的冰锥进行反击.冰锥有20%的几率造成畏缩."
}
ability {
  id: ABILITY_LAST_STAND
  name: "背水一战"
  description: "防御和特防随HP降低而提升,最高1.6倍."
  expanded_description: "防御和特防能力值随HP降低线性提升.倍率从HP全满时的1.0倍提升至HP0%时的1.6倍.HP50%时提供1.3倍加成,HP25%时提供1.45倍加成."
}
ability {
  id: ABILITY_PYROCLASTIC_FLOW
  name: "火山碎屑流"
  description: "熔解 + 腐蚀."
  expanded_description: "使火属性招式对岩石属性宝可梦变得效果绝佳,而非被抵抗.使毒属性招式对钢属性宝可梦变得效果绝佳.此外,该宝可梦可以使任何属性的宝可梦陷入中毒状态."
}
ability {
  id: ABILITY_BLOOD_BATH
  name: "血浴"
