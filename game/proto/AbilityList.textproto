}
ability {
  id: ABILITY_RHYTHMIC
  name: "韵律"
  description: "连续使用同一招式时,每次伤害提高10%."
  expanded_description: "连续使用同一招式,每次伤害提高10%.无上限.切换招式或招式失败时重置."
}
ability {
  id: ABILITY_CHUNKY_BASS_LINE
  name: "厚重低音"
