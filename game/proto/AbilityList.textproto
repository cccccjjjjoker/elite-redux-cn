# proto-file: AbilityList.proto
# proto-message: er.AbilityList

ability {
  id: ABILITY_NONE
  name: "-------"
  description: "特性槽为空。"
}
ability {
  id: ABILITY_STENCH
  name: "恶臭"
  description: "10%几率使目标畏缩.剧毒地形永久存在."
  expanded_description: "攻击获得+10%的畏缩几率.连续攻击招式的每一击单独计算畏缩几率.当该宝可梦在场时,剧毒地形的回合数不会减少."
}
ability {
  id: ABILITY_DRIZZLE
  name: "降雨"
  description: "出场时降下雨水,持续8回合."
  expanded_description: "降雨特性会在宝可梦进入战斗时降下雨水,持续8回合（携带潮湿岩石时为12回合）.雨天使水系招式威力提升50%,火系伤害降低50%.部分招式和特性在雨天下有特殊效果.无法覆盖原始天气."
}
ability {
  id: ABILITY_SPEED_BOOST
  name: "加速"
  description: "每回合结束后自身速度提升1级."
  expanded_description: "该宝可梦每在场完成一个完整的回合,其速度在回合结束时提升1级.入场的当回合不会触发."
}
ability {
  id: ABILITY_BATTLE_ARMOR
  name: "战斗盔甲"
  description: "免疫击中要害.受到的招式伤害降低20%."
  expanded_description: "受到的伤害降低20%（x0.8）,与其他减伤效果乘法叠加.此外,免疫击中要害,会心一击将作为普通攻击处理,并且不会触发攻击要害的效果（例如“至骨”的流血效果）."
}
ability {
  id: ABILITY_STURDY
  name: "结实"
  description: "满HP时,不会一击濒死,必定留下1点HP."
  expanded_description: "当该宝可梦HP全满时,能够承受任何一次攻击并至少留下1点HP.此效果如同携带了气势披带,因此无法抵御连续攻击招式或后续攻击（例如“余震”、“雷召”）."
}
ability {
  id: ABILITY_DAMP
  name: "湿气"
  description: "使接触到的对手变为水属性.攻击时也生效."
  expanded_description: "如果该宝可梦与另一只宝可梦发生接触（无论是攻击方还是防御方）,对方的属性会变为纯水属性.此效果在连续招式或优先度招式命中时立即发生,可以在对手的连续攻击过程中消除其本系加成."
}
ability {
  id: ABILITY_LIMBER
  name: "柔软"
  description: "免疫麻痹；反作用力伤害减半，且不会因自身招式而降低能力。"
  expanded_description: "该宝可梦受到的所有反伤伤害减半；包括具有比例反伤的招式（如勇鸟猛攻）、具有撞伤风险的招式（如飞膝踢）、或固定反伤的招式（如钢炮光线）.麻痹状态无法影响该宝可梦,且获得此特性时,若已处于麻痹状态则会立刻治愈."
}
ability {
  id: ABILITY_SAND_VEIL
  name: "沙隐"
  description: "在沙暴中,闪避率提升1.25倍."
  expanded_description: "在沙暴中,对手的命中率变为原来的1/1.25,且自身免疫沙暴伤害.会被无防御或破格特性识破."
}
ability {
  id: ABILITY_STATIC
  name: "静电"
  description: "接触攻击有30%几率麻痹,非接触攻击有10%几率麻痹."
  expanded_description: "无论该宝可梦是攻击方还是被攻击方,都有几率使对手陷入麻痹.非接触攻击有10%几率麻痹,接触攻击有30%几率麻痹."
}
ability {
  id: ABILITY_VOLT_ABSORB
  name: "蓄电"
  description: "受到电属性招式攻击时,恢复最大HP的25%."
  expanded_description: "该宝可梦能够吸收电属性招式,将其转化为能量,恢复其最大HP的25%.对电属性伤害及其附加效果（如电磁波的麻痹）完全免疫.对于水/飞行属性宝可梦来说,是消除4倍电系弱点的完美选择."
}
ability {
  id: ABILITY_WATER_ABSORB
  name: "储水"
  description: "受到水属性招式攻击时,恢复最大HP的25%."
  expanded_description: "该宝可梦免疫水属性招式,并且受到水属性招式攻击时会恢复其最大HP的25%."
}
ability {
  id: ABILITY_OBLIVIOUS
  name: "迟钝"
  description: "免疫着迷、惊吓、威吓及招式封锁。"
  expanded_description: "该宝可梦免疫着迷、惊吓、威吓和挑衅.在获得此特性时,如果已经处于上述任意状态,则会立刻解除."
}
ability {
  id: ABILITY_CLOUD_NINE
  name: "无关天气"
  description: "清除天气并阻止其效果产生."
  expanded_description: "上场时清除所有天气,并且在该宝可梦在场期间使所有天气效果（包括原始天气）失效.天气仍可以被设置,但在该宝可梦下场前,不会提供任何伤害加成或触发与天气相关的特性."
}
ability {
  id: ABILITY_COMPOUND_EYES
  name: "复眼"
  description: "获得1.3倍的命中率提升."
  expanded_description: "该宝可梦的招式命中率变为1.3倍."
}
ability {
  id: ABILITY_INSOMNIA
  name: "不眠"
  description: "不会陷入睡眠状态.使用睡觉会失败."
  expanded_description: "防止任何方式陷入睡眠状态,包括催眠招式、特性（如哈欠）以及其他可能导致睡眠的效果.使用招式睡觉将完全失败.若在获得此特性前已处于睡眠状态（例如通过烦恼种子或特性交换）,则会立刻醒来.可被破格等特性识破"
}
ability {
  id: ABILITY_COLOR_CHANGE
  name: "变色"
  description: "受到攻击前,变为拥有抗性或免疫的属性."
  expanded_description: "受到伤害前,将自身转变为防御效果最佳的纯属性.优先考虑免疫而非抗性.每回合仅触发一次."
}
ability {
  id: ABILITY_IMMUNITY
  name: "免疫"
  description: "不会陷入中毒状态.受到的毒属性伤害减半."
  expanded_description: "防止中毒.所有毒属性伤害减半.与其他减伤效果乘法叠加.获得此特性时若已中毒,则立刻治愈."
}
ability {
  id: ABILITY_FLASH_FIRE
  name: "引火"
  description: "受到火属性招式攻击后,自身火属性招式威力提升至1.5倍."
  expanded_description: "引火特性使宝可梦完全免疫火属性招式.受到火属性攻击后,自身的火属性招式威力提升50%,直到下场为止.多次被火属性攻击命中不会使效果叠加."
}
ability {
  id: ABILITY_SHIELD_DUST
  name: "鳞粉"
  description: "免疫招式的追加效果、场地状态和粉末类招式."
  expanded_description: "阻挡所有攻击招式的追加效果.免疫所有入场陷阱.免疫所有粉末类招式,包括催眠粉、麻痹粉、毒粉、蘑菇孢子、棉孢子、愤怒粉、粉末和魔法粉."
}
ability {
  id: ABILITY_OWN_TEMPO
  name: "我行我素"
  description: "免疫混乱、威吓和惊吓."
  expanded_description: "免疫混乱、威吓和惊吓.获得此特性时若已混乱,则立刻解除混乱状态."
}
ability {
  id: ABILITY_SUCTION_CUPS
  name: "吸盘"
  description: "不会被对手的招式强制替换下场."
  expanded_description: "防止被招式或红牌强制替换下场."
}
ability {
  id: ABILITY_INTIMIDATE
  name: "威吓"
  description: "出场时,降低所有对手的攻击1级."
  expanded_description: "进入战斗时,降低所有对手宝可梦的攻击1级."
}
ability {
  id: ABILITY_SHADOW_TAG
  name: "影子游戏"
  description: "对手无法替换下场.幽灵属性不受影响."
  expanded_description: "阻止所有不具有影子游戏特性或非幽灵属性的对手替换下场.携带逃脱按键或使用替换招式（如快速折返）的宝可梦可以逃脱如果在战斗中中途替换上场,效果将在下一回合生效."
}
ability {
  id: ABILITY_ROUGH_SKIN
  name: "粗糙皮肤"
  description: "受到接触类招式攻击时，攻击者损失最大HP的1/8。"
  expanded_description: "对使用接触类招式的攻击者造成其最大HP1/8的伤害.对于连续攻击招式,每次命中都会触发."
}
ability {
  id: ABILITY_WONDER_GUARD
  name: "神奇守护"
  description: "仅会受到效果绝佳的攻击或间接伤害."
  expanded_description: "只有效果绝佳的招式或间接伤害能够伤害到该宝可梦.其他所有直接攻击造成的伤害均为零.中毒或特性伤害等其他来源的伤害照常生效."
}
ability {
  id: ABILITY_LEVITATE
  name: "飘浮"
  description: "免疫地面属性招式.自身飞行招式威力提升至1.25倍."
  expanded_description: "该宝可梦免疫地面属性招式以及其他地面效果,如撒菱和场地状态.飞行属性招式伤害提升25%."
}
ability {
  id: ABILITY_EFFECT_SPORE
  name: "孢子"
  description: "受接触攻击时30%使攻击者\n陷入睡眠、麻痹或中毒。"
  expanded_description: "受到接触类招式攻击时,有30%的几率使攻击者陷入睡眠、麻痹或中毒状态.状态类型随机选择."
}
ability {
  id: ABILITY_SYNCHRONIZE
  name: "同步"
  description: "受到异常状态时，使攻击者也获得相同的异常状态"
  expanded_description: "当被施加非瞬间异常状态（睡眠除外）时,攻击者也会陷入相同的状态.此效果可穿透替身.若该宝可梦在被施加异常状态时能够治愈自身,则会在治愈前先将异常状态施加给攻击者."
}
ability {
  id: ABILITY_CLEAR_BODY
  name: "恒净之躯"
  description: "免疫能力降低."
  expanded_description: "免疫所有由招式或特性引起的能力降低效果.包括因使用过热等招式导致的自身能力降低."
}
ability {
  id: ABILITY_NATURAL_CURE
  name: "自然回复"
  description: "替换下场时,治愈异常状态."
  expanded_description: "替换下场时,治愈所有异常状态."
}
ability {
  id: ABILITY_LIGHTNING_ROD
  name: "避雷针"
  description: "吸引电属性招式.并提升自身最高的攻击能力."
  expanded_description: "该宝可梦会吸引电属性招式,并对其免疫.此外,受到电属性招式攻击后,自身最高的攻击能力提升1级."
}
ability {
  id: ABILITY_SERENE_GRACE
  name: "天恩"
  description: "自身招式的追加效果触发几率加倍."
  expanded_description: "自身攻击招式的追加效果触发几率加倍."
}
ability {
  id: ABILITY_SWIFT_SWIM
  name: "悠游自如"
  description: "下雨天气时,该宝可梦的速度提升至1.5倍."
  expanded_description: "下雨天气时,速度提升50%."
}
ability {
  id: ABILITY_CHLOROPHYLL
  name: "叶绿素"
  description: "大晴天天气时,该宝可梦的速度提升至1.5倍."
  expanded_description: "大晴天天气时,速度提升50%."
}
ability {
  id: ABILITY_ILLUMINATE
  name: "发光"
  description: "命中率×1.2；攻击会移除目标的幽灵属性。"
  expanded_description: "该宝可梦的招式命中率变为1.2倍.攻击命中时,移除目标的幽灵属性."
}
ability {
  id: ABILITY_TRACE
  name: "复制"
  description: "复制对手的特性.无法复制先天特性."
  expanded_description: "进入战斗时,复制一只对手宝可梦的特性,替换当前特性栏位中的特性.无法复制复制、神奇守护以及大多数与形态相关的特性.在双打对战中,随机选择首个符合条件的对手."
}
ability {
  id: ABILITY_HUGE_POWER
  name: "大力士"
  description: "自身的攻击能力加倍.提升最终能力值而非基础能力值."
  expanded_description: "该宝可梦的攻击能力值变为2倍与其他伤害加成效果乘法叠加."
}
ability {
  id: ABILITY_POISON_POINT
  name: "毒刺"
  description: "接触攻击有30%几率使目标中毒.攻击时也生效."
  expanded_description: "无论该宝可梦是攻击方还是被攻击方,使用接触类招式时有30%的几率使对手中毒."
}
ability {
  id: ABILITY_INNER_FOCUS
  name: "精神力"
  description: "不会陷入畏缩状态,免疫威吓和惊吓.真气弹必中."
  expanded_description: "真气弹必定命中.不受畏缩、威吓或惊吓的影响."
}
ability {
  id: ABILITY_MAGMA_ARMOR
  name: "熔岩铠甲"
  description: "免疫冻伤.受到的水系和冰系招式伤害降低30%."
  expanded_description: "免疫冻伤状态.受到的水属性和冰属性招式伤害降低30%.与其他减伤效果乘法叠加."
}
ability {
  id: ABILITY_WATER_VEIL
  name: "水幕"
  description: "免疫灼伤.出场时制造出水环."
  expanded_description: "出场时制造出水环,每回合回复1/16的HP.免疫灼伤状态,并在替换上场时解除灼伤状态."
}
ability {
  id: ABILITY_MAGNET_PULL
  name: "磁力"
  description: "钢属性宝可梦无法逃走幽灵属性不受影响."
  expanded_description: "在该宝可梦在场期间,阻止钢属性宝可梦替换下场.幽灵属性免疫此效果.携带逃脱按键或使用替换招式（如快速折返）的宝可梦可以逃脱如果在战斗中中途替换上场,效果将在下一回合生效."
}
ability {
  id: ABILITY_SOUNDPROOF
  name: "隔音"
  description: "免疫声音类招式."
  expanded_description: "免疫声音类招式.以自身为目标的声音类招式不受影响."
}
ability {
  id: ABILITY_RAIN_DISH
  name: "雨盘"
  description: "下雨天气时,每回合回复1/8的最大HP."
  expanded_description: "下雨天气时,每回合结束时回复1/8的最大HP."
}
ability {
  id: ABILITY_SAND_STREAM
  name: "扬沙"
  description: "出场时引发沙暴,持续8回合."
  expanded_description: "出场时引发沙暴,持续8回合（携带光滑岩石时为12回合）.每回合对非岩石/地面/钢属性宝可梦造成1/16的HP伤害岩石属性宝可梦的特防提升50%.使与大晴天相关的招式效果减半"
}
ability {
  id: ABILITY_PRESSURE
  name: "压迫感"
  description: "对手招式PP消耗翻倍.出场时清除对手的能力提升."
  expanded_description: "对手使用招式时,PP消耗加倍.出场时,清除所有对手的能力提升等级."
}
ability {
  id: ABILITY_THICK_FAT
  name: "厚脂肪"
  description: "受到的火属性和冰属性招式伤害减半."
  expanded_description: "受到的火属性和冰属性招式伤害降低50%.与其他减伤效果乘法叠加."
}
ability {
  id: ABILITY_EARLY_BIRD
  name: "早足"
  description: "从睡眠中醒来的速度加倍."
  expanded_description: "该宝可梦从睡眠状态醒来的速度加倍.每回合减少2个睡眠计数而非1个."
}
ability {
  id: ABILITY_FLAME_BODY
  name: "火焰之躯"
  description: "接触攻击有30%几率灼伤,非接触20%.主动攻击时也生效."
  expanded_description: "与该宝可梦发生接触有30%几率使对手灼伤.非接触攻击有20%几率.无论攻击方还是被攻击方均会生效."
}
ability {
  id: ABILITY_RUN_AWAY
  name: "逃足"
  description: "必定能逃离.能力被对手降低时,速度提升."
  expanded_description: "无论速度如何,必定能从野生宝可梦对战中成功逃离.当该宝可梦的任何能力被对手的招式或特性降低时,其速度提升2级."
}
ability {
  id: ABILITY_KEEN_EYE
  name: "锐利目光"
  description: "免疫命中率降低.获得1.2倍的命中率提升."
  expanded_description: "防止命中率能力等级被降低.所有招式获得1.2倍的命中率提升."
}
ability {
  id: ABILITY_HYPER_CUTTER
  name: "巨钳"
  description: "无法降低自身的攻击或特攻.接触类招式易中要害."
  expanded_description: "巨钳特性防止敌人通过招式或特性降低该宝可梦的攻击能力.该宝可梦使用的所有接触类招式的击中要害率提升1级."
}
ability {
  id: ABILITY_PICKUP
  name: "捡拾"
  description: "出场时移除所有场地状态.但不会免疫场地状态伤害."
  expanded_description: "进入战斗时,清除己方场地上所有入场陷阱.该宝可梦在清除陷阱时仍会受到它们的影响."
}
ability {
  id: ABILITY_TRUANT
  name: "懒惰"
  description: "无法连续使用攻击招式."
  expanded_description: "防止连续使用攻击招式.使用攻击招式后,下一回合必须偷懒,无法攻击.使用变化招式不受影响."
}
ability {
  id: ABILITY_HUSTLE
  name: "活力"
  description: "命中率0.9倍.伤害提升至1.4倍."
  expanded_description: "攻击招式威力提升40%,但命中率降低10%.仅影响非变化招式."
}
ability {
  id: ABILITY_CUTE_CHARM
  name: "迷人之躯"
  description: "接触时有50%概率使对方着迷；主动攻击时也能触发。"
  expanded_description: "当通过接触受到攻击时（无论攻击方还是被攻击方）,有50%几率使攻击者陷入着迷状态（使其攻击和特攻减半）.此效果仅对异性宝可梦生效."
}
ability {
  id: ABILITY_PLUS
  name: "正电"
  description: "如果同伴宝可梦具有负电或正电,造成双倍伤害."
  expanded_description: "当与具有负电或正电的同伴一起出战时,该宝可梦的输出威力加倍."
}
ability {
  id: ABILITY_MINUS
  name: "负电"
  description: "如果同伴宝可梦具有负电或正电,造成双倍伤害."
  expanded_description: "当与具有负电或正电的同伴一起出战时,该宝可梦的输出威力加倍."
}
ability {
  id: ABILITY_FORECAST
  name: "天气预报"
  description: "随天气改变形态.在设置天气时发动攻击."
  expanded_description: "根据当前的天气改变自身形态和属性.当使用改变天气的招式时,会紧接着使用气象球（威力100,特殊,类型与设置的天气一致）.在出场时、天气变化时以及回合结束时触发形态变化.此特性无法被压制,即使在破格等效果下也能生效."
}
ability {
  id: ABILITY_STICKY_HOLD
  name: "黏着"
  description: "不会失去携带的物品."
  expanded_description: "该宝可梦携带的物品不会被强制移除或偷走."
}
ability {
  id: ABILITY_SHED_SKIN
  name: "蜕皮"
  description: "每回合结束时,有30%几率治愈自身的异常状态."
  expanded_description: "每回合结束时,该宝可梦有30%的几率治愈自身所受到的异常状态."
}
ability {
  id: ABILITY_GUTS
  name: "毅力"
  description: "处于异常状态时，攻击×1.5。"
  expanded_description: "处于任何异常状态时,攻击能力值提升50%.并且无视灼伤状态带来的攻击力降低效果."
}
ability {
  id: ABILITY_MARVEL_SCALE
  name: "神奇鳞片"
  description: "处于异常状态时，防御×1.5。"
  expanded_description: "处于任何异常状态时,基础防御能力值提升50%."
}
ability {
  id: ABILITY_LIQUID_OOZE
  name: "污泥浆"
  description: "吸取招式会对使用者造成伤害而非治疗."
  expanded_description: "污泥浆特性会反转所有吸取招式的治疗效果,使攻击者受到伤害.影响吸取拳、超级吸取、终极吸取、吸血以及类似的吸取类攻击伤害量等于原本应恢复的HP.完美克制依赖治疗的战术."
}
ability {
  id: ABILITY_OVERGROW
  name: "茂盛"
  description: "草属性招式威力提升至1.2倍,HP低于1/3时提升至1.5倍."
  expanded_description: "草属性招式威力提升20%,当HP低于1/3时提升50%."
}
ability {
  id: ABILITY_BLAZE
  name: "猛火"
  description: "火属性招式威力提升至1.2倍,HP低于1/3时提升至1.5倍."
  expanded_description: "火属性招式威力提升20%,当HP低于1/3时提升50%."
}
ability {
  id: ABILITY_TORRENT
  name: "激流"
  description: "水属性招式威力提升至1.2倍,HP低于1/3时提升至1.5倍."
  expanded_description: "水属性招式威力提升20%,当HP低于1/3时提升50%."
}
ability {
  id: ABILITY_SWARM
  name: "虫之预感"
  description: "虫属性招式威力提升至1.2倍,HP低于1/3时提升至1.5倍."
  expanded_description: "虫属性招式威力提升20%,当HP低于1/3时提升50%."
}
ability {
  id: ABILITY_ROCK_HEAD
  name: "坚硬脑袋"
  description: "免疫反伤伤害,但不免疫大爆炸/撞击伤害."
  expanded_description: "防止所有来自自身招式或特性的反伤伤害.同时免疫因愤怒产生的反伤伤害无法防止撞击伤害或大爆炸/自爆的伤害."
}
ability {
  id: ABILITY_DROUGHT
  name: "干旱"
  description: "出场时降下大晴天,持续8回合."
  expanded_description: "出场时引发大晴天,持续8回合（携带炎热岩石时为12回合）.火属性招式威力提升50%,水属性招式威力降低50%.并激活与大晴天相关的招式的额外效果."
}
ability {
  id: ABILITY_ARENA_TRAP
  name: "沙穴"
  description: "敌人无法逃走.幽灵属性和飘浮状态的宝可梦免疫."
  expanded_description: "防止所有非飘浮状态或非幽灵属性的对手替换下场.携带逃脱按键或使用替换招式（如快速折返）的宝可梦可以逃脱如果在战斗中中途替换上场,效果将在下一回合生效."
}
ability {
  id: ABILITY_VITAL_SPIRIT
  name: "干劲"
  description: "不会陷入睡眠.使用格斗属性招式治愈异常状态."
  expanded_description: "免疫睡眠状态.当该宝可梦使用格斗属性招式时在招式效果结束后立即治愈所有异常状态.获得此特性时若已睡眠,则立刻解除."
}
ability {
  id: ABILITY_WHITE_SMOKE
  name: "白烟"
  description: "替换上场时,设置烟幕,持续3回合."
  expanded_description: "出场时设置烟幕,持续3回合.烟幕使己方全队的闪避率提升25%."
}
ability {
  id: ABILITY_PURE_POWER
  name: "瑜伽之力"
  description: "自身的特攻能力加倍.提升最终能力值,而非基础能力值."
  expanded_description: "该宝可梦的攻击能力值变为2倍与其他伤害加成效果乘法叠加."
}
ability {
  id: ABILITY_SHELL_ARMOR
  name: "硬壳盔甲"
  description: "免疫击中要害.受到的招式伤害降低20%."
  expanded_description: "受到的伤害降低20%（x0.8）,与其他减伤效果乘法叠加.此外,免疫击中要害,会心一击将作为普通攻击处理,并且不会触发攻击要害的效果（例如“至骨”的流血效果）."
}
ability {
  id: ABILITY_AIR_LOCK
  name: "气闸"
  description: "无关天气 + 吹气筒."
  expanded_description: "出场时设置顺风,持续3回合,并清除所有天气效果.原始天气会被压制.在该宝可梦在场期间,天气仍可被设置,但不会产生任何效果,直到该宝可梦下场."
}
ability {
  id: ABILITY_TANGLED_FEET
  name: "蹒跚"
  description: "处于混乱或愤怒状态时,使用速度进行防御."
  expanded_description: "当该宝可梦处于混乱或愤怒状态时,在伤害计算中使用其速度能力值来代替防御或特防.讲究围巾的效果不会影响此特性"
}
ability {
  id: ABILITY_MOTOR_DRIVE
  name: "电气引擎"
  description: "受到电属性招式攻击时,提升速度而非受到伤害."
  expanded_description: "免疫电属性招式,并且在受到电属性招式攻击时,速度提升1级.对于连续攻击招式,每次命中都会触发."
}
ability {
  id: ABILITY_RIVALRY
  name: "斗争心"
  description: "对同性对手造成1.25倍伤害.受到异性对手的伤害为0.75倍."
  expanded_description: "该宝可梦对同性别的对手造成伤害提高25%,受到异性别的对手造成的伤害降低25%.对无性别的宝可梦无效."
}
ability {
  id: ABILITY_STEADFAST
  name: "不屈之心"
  description: "如果该宝可梦畏缩,速度提升1级."
  expanded_description: "当陷入畏缩状态时,速度提升1级."
}
ability {
  id: ABILITY_SNOW_CLOAK
  name: "雪隐"
  description: "在冰雹中,闪避率提升至1.25倍."
}
ability {
  id: ABILITY_GLUTTONY
  name: "贪吃鬼"
  description: "提早吃树果.树果还会额外回复1/3的最大HP."
  expanded_description: "原本在HP低于1/4时发动的树果,改为在HP低于1/2时发动.此外,在消耗任何树果后,该宝可梦会额外回复1/3的最大HP.不包括通过啄食等招式消耗的树果."
}
ability {
  id: ABILITY_ANGER_POINT
  name: "愤怒穴位"
  description: "受到攻击时,攻击提升1级.受到击中要害的攻击时提升至最大."
  expanded_description: "受到攻击时,该宝可梦的攻击提升1级；若受到击中要害的攻击,则攻击能力值提升至最大.对于连续攻击招式,每次命中都会触发."
}
ability {
  id: ABILITY_UNBURDEN
  name: "轻装"
  description: "消耗掉携带的物品后,速度加倍直到下场."
  expanded_description: "当消耗或失去携带的物品时,该宝可梦的基础速度能力值变为2倍.当替换下场、获得新物品或失去此特性时,速度加成消失."
}
ability {
  id: ABILITY_HEATPROOF
  name: "耐热"
  description: "受到的火属性招式伤害减半.不会受到灼伤伤害."
  expanded_description: "受到的火属性招式伤害减半.免疫灼伤伤害以及灼伤状态带来的攻击力降低效果."
}
ability {
  id: ABILITY_SIMPLE
  name: "单纯"
  description: "该宝可梦的能力变化效果翻倍."
}
ability {
  id: ABILITY_DRY_SKIN
  name: "干燥皮肤"
  description: "水/雨天会回复.火/晴天会受伤."
  expanded_description: "受到水属性招式攻击时回复25%的HP,下雨天气时每回合回复12.5%的HP.受到火属性招式伤害增加25%,大晴天天气时每回合损失12.5%的HP."
}
ability {
  id: ABILITY_DOWNLOAD
  name: "下载"
  description: "根据对手的防御和特防,提升自身的攻击或特攻1级."
  expanded_description: "替换上场时,如果对手的防御高于特防,则自身的特攻提升1级.如果对手的特防高于或等于防御则自身的攻击提升1级."
}
ability {
  id: ABILITY_IRON_FIST
  name: "铁拳"
  description: "拳类招式的威力提升至1.3倍."
  expanded_description: "拳类招式的威力提升30%."
}
ability {
  id: ABILITY_POISON_HEAL
  name: "毒疗"
  description: "处于中毒状态时,每回合结束回复1/8的最大HP."
  expanded_description: "处于中毒状态时,每回合回复1/8的最大HP,而非受到伤害.对普通中毒和剧毒状态均有效.同时免疫剧毒地形的伤害."
}
ability {
  id: ABILITY_ADAPTABILITY
  name: "适应力"
  description: "本系加成从1.5倍提升至2倍."
  expanded_description: "使用与自身属性相同的招式时,伤害加成从1.5倍提升至2.0倍."
}
ability {
  id: ABILITY_SKILL_LINK
  name: "连续攻击"
  description: "连续攻击招式总会打出最大次数."
  expanded_description: "使连续攻击招式必定打出5次.对于仅能攻击3次或使用大扫荡时,所有攻击进行一次命中判定,而非每次攻击单独判定."
}
ability {
  id: ABILITY_HYDRATION
  name: "湿润之躯"
  description: "下雨天气时,每回合结束时治愈自身异常状态."
  expanded_description: "下雨天气时,每回合结束时治愈所有异常状态"
}
ability {
  id: ABILITY_SOLAR_POWER
  name: "太阳之力"
  description: "大晴天时,自身最高的攻击能力提升至1.5倍."
  expanded_description: "大晴天时,该宝可梦最高的攻击能力值提升50%."
}
ability {
  id: ABILITY_QUICK_FEET
  name: "飞毛腿"
  description: "处于异常状态时,速度提升至1.5倍."
  expanded_description: "处于任何异常状态时,速度能力值提升50%.并且无视麻痹状态带来的速度降低效果."
}
ability {
  id: ABILITY_NORMALIZE
  name: "一般皮肤"
  description: "自身的招式变为一般属性,获得1.1倍威力提升,并无视抗性."
  expanded_description: "将所有攻击招式转变为一般属性,并给予10%的威力加成.一般属性招式可以无视属性抗性但无法无视属性免疫."
}
ability {
  id: ABILITY_SNIPER
  name: "狙击手"
  description: "击中要害时的伤害倍率从1.5倍提升至2.25倍."
  expanded_description: "击中要害时的伤害倍率从1.5倍提升至2.25倍,即额外增加50%的伤害加成."
}
ability {
  id: ABILITY_MAGIC_GUARD
  name: "魔法防守"
  description: "仅受攻击伤害."
  expanded_description: "免疫所有非攻击性的伤害来源,包括入场陷阱、天气伤害、异常状态以及反伤伤害."
}
ability {
  id: ABILITY_NO_GUARD
  name: "无防守"
  description: "该宝可梦使用或受到的招式必定命中."
  expanded_description: "确保该宝可梦使用的所有招式以及所有对该宝可梦使用的招式必定命中."
}
ability {
  id: ABILITY_STALL
  name: "后攻"
  description: "如果还未行动,受到的伤害降低30%."
  expanded_description: "如果该宝可梦本回合还未行动,则受到的伤害降低30%.与其他减伤效果乘法叠加.当该宝可梦在回合中替换上场时也生效."
}
ability {
  id: ABILITY_TECHNICIAN
  name: "技术高手"
  description: "威力小于等于60的招式威力提升至1.5倍."
  expanded_description: "威力小于等于60的招式威力提升1.5倍.对于基础威力可能超过60的招式（如复仇或毒击）,即使当前威力小于等于60,也不会获得提升."
}
ability {
  id: ABILITY_LEAF_GUARD
  name: "叶子防守"
  description: "大晴天时,每回合结束时治愈自身异常状态."
  expanded_description: "大晴天时,每回合结束时治愈所有异常状态"
}
ability {
  id: ABILITY_KLUTZ
  name: "笨拙"
  description: "自身携带的物品无效.超级石不受影响."
  expanded_description: "使所有携带物品的效果失效.物品仍可以被打落或偷走,但不会提供任何增益.投掷等依赖物品的招式会失败.超级石不受此限制."
}
ability {
  id: ABILITY_MOLD_BREAKER
  name: "破格"
  description: "招式可穿透特性生效.同样影响先天特性."
  expanded_description: "允许招式无视目标的特性和先天特性,包括那些会干扰效果或降低伤害的特性.无法绕过那些会修改基础能力值的特性,如草之皮毛."
}
ability {
  id: ABILITY_SUPER_LUCK
  name: "超幸运"
  description: "自身招式的击中要害率提升1级."
  expanded_description: "该宝可梦所有攻击招式的击中要害率提升1级."
}
ability {
  id: ABILITY_AFTERMATH
  name: "引爆"
  description: "倒下时发动威力100的大爆炸。\n爆炸类招式使目标畏缩。"
  expanded_description: "当该宝可梦被击倒时,使用威力100的大爆炸或迸裂拳（取两者中威力更高者）.使用爆炸类招式时,必定使目标畏缩."
}
ability {
  id: ABILITY_ANTICIPATION
  name: "危险预知"
  description: "预感到效果绝佳的招式.能闪避一次效果绝佳的招式攻击."
  expanded_description: "替换上场时,若对手拥有对自身效果绝佳的招式,则会收到警告.闪避战斗中受到的第一次效果绝佳的招式攻击."
}
ability {
  id: ABILITY_FOREWARN
  name: "预知梦"
  description: "出场时,对对手施放威力80的预知未来."
  expanded_description: "替换上场时,对目标对手施放一个威力80的预知未来.2回合后攻击,可穿透替身和其他保护效果.一旦施放必定命中,无视命中判定.无法对同一目标施放两次."
}
ability {
  id: ABILITY_UNAWARE
  name: "纯朴"
  description: "无视对手的能力变化,无论是提升还是降低."
  expanded_description: "进行伤害计算时,完全无视对手的所有能力等级变化."
}
ability {
  id: ABILITY_TINTED_LENS
  name: "有色眼镜"
  description: "攻击被抵抗时,造成双倍伤害."
  expanded_description: "攻击被抵抗时,伤害加倍.如果招式被抵抗（伤害减半或更低）,则最终伤害乘以2倍."
}
ability {
  id: ABILITY_FILTER
  name: "过滤"
  description: "受到效果绝佳的招式攻击时,伤害降低35%."
  expanded_description: "受到效果绝佳的招式攻击时,伤害降低35%.与其他减伤效果乘法叠加."
}
ability {
  id: ABILITY_SLOW_START
  name: "慢启动"
  description: "出场后的前5回合,攻击、特攻和速度减半."
  expanded_description: "替换上场后的前5回合,攻击、特攻和速度能力值减半.每次替换下场后,回合计数会重置."
}
ability {
  id: ABILITY_SCRAPPY
  name: "胆量"
  description: "一般/格斗系招式可以命中幽灵系.免疫威吓和惊吓."
  expanded_description: "该宝可梦使用的一般和格斗属性招式能够以普通效果击中幽灵属性宝可梦.免疫威吓和惊吓."
}
ability {
  id: ABILITY_STORM_DRAIN
  name: "引水"
  description: "吸引水属性招式.并提升自身最高的攻击能力."
  expanded_description: "该宝可梦会吸引水属性招式,并对其免疫.此外,受到水属性招式攻击后,自身最高的攻击能力提升1级."
}
ability {
  id: ABILITY_ICE_BODY
  name: "冰冻之躯"
  description: "冰雹天气时,每回合回复1/8的最大HP."
  expanded_description: "冰雹天气时,每回合结束时回复1/8的最大HP.同时免疫冰雹伤害."
}
ability {
  id: ABILITY_SOLID_ROCK
  name: "坚硬岩石"
  description: "受到效果绝佳的招式攻击时,伤害降低35%."
  expanded_description: "受到效果绝佳的招式攻击时,伤害降低35%.与其他减伤效果乘法叠加."
}
ability {
  id: ABILITY_SNOW_WARNING
  name: "降雪"
  description: "出场时引发冰雹,持续8回合."
  expanded_description: "出场时引发冰雹,持续8回合（携带冰冷岩石时为12回合）.每回合对非冰属性宝可梦造成1/16的HP伤害.冰属性宝可梦的防御提升50%.使与大晴天相关的招式效果减半."
}
ability {
  id: ABILITY_HONEY_GATHER
  name: "采蜜"
  description: "每回合有50%几率获得甜甜蜜."
  expanded_description: "如果未携带物品,每回合有50%的几率获得甜甜蜜.甜甜蜜每回合可回复1/16的HP,并可在危急时食用以回复1/4的HP.即使该宝可梦最初未携带甜甜蜜作为物品,此效果也有效."
}
ability {
  id: ABILITY_FRISK
  name: "察觉"
  description: "查看对手的物品,并使其物品失效2回合."
  expanded_description: "进入战斗时,揭示对手的物品,并使其效果失效2回合.此效果不会阻止超级石及其他类似物品的运作."
}
ability {
  id: ABILITY_RECKLESS
  name: "舍身"
  description: "会造成反伤伤害的招式威力提升至1.2倍."
  expanded_description: "会造成反伤伤害的招式威力提升20%.此加成也适用于通过其他方式（如疯狂状态或特性）获得反伤效果的招式."
}
ability {
  id: ABILITY_MULTITYPE
  name: "多重属性"
  description: "携带的石板决定持有者的属性."
  expanded_description: "该宝可梦根据其当前携带的石板的属性改变形态.石板无法被移除,并且多重属性特性无法以任何方式被覆盖、压制、交换或复制."
}
ability {
  id: ABILITY_FLOWER_GIFT
  name: "花之礼"
  description: "在大晴天时,使己方全队的特攻和特防提升至1.5倍."
  expanded_description: "在大晴天时,该宝可梦及其所有同伴的基础特攻和特防提升50%."
}
ability {
  id: ABILITY_BAD_DREAMS
  name: "梦魇"
  description: "处于睡眠状态的对手每回合结束时损失1/4的最大HP."
  expanded_description: "所有处于睡眠状态的对手每回合结束时损失25%的最大HP."
}
ability {
  id: ABILITY_PICKPOCKET
  name: "顺手牵羊"
  description: "通过接触招式偷走对手携带的物品."
  expanded_description: "如果该宝可梦当前未携带物品,通过接触招式攻击时,会偷走目标携带的物品.对超级石及其他类似物品无效."
}
ability {
  id: ABILITY_SHEER_FORCE
  name: "强行"
  description: "以牺牲招式的追加效果为代价,换取1.3倍的威力提升."
  expanded_description: "在攻击命中后,移除大部分有益的追加效果,以获得1.3倍的威力提升.使用此类招式时,显著特点是不会受到生命宝珠的反伤.可被移除的效果包括：降低目标能力、提升自身能力、施加异常状态以及造成畏缩."
}
ability {
  id: ABILITY_CONTRARY
  name: "唱反调"
  description: "对该宝可梦的能力提升会变成降低,反之亦然."
  expanded_description: "反转影响该宝可梦的所有能力变化.对自身引起的能力变化同样有效."
}
ability {
  id: ABILITY_UNNERVE
  name: "紧张感"
  description: "对手无法使用消耗性物品."
  expanded_description: "阻止所有对手宝可梦消耗其携带的物品."
}
ability {
  id: ABILITY_DEFIANT
  name: "不服输"
  description: "能力被对手降低时,攻击提升2级."
  expanded_description: "当该宝可梦的能力被其他宝可梦降低时,其攻击能力提升2级."
}
ability {
  id: ABILITY_DEFEATIST
  name: "受迫"
  description: "当HP低于1/3时,攻击和特攻能力减半."
  expanded_description: "当HP低于最大值的33%时,攻击和特攻能力值减半.当HP回复至该阈值以上时,效果解除."
}
ability {
  id: ABILITY_CURSED_BODY
  name: "诅咒之躯"
  description: "受到接触招式攻击时,有30%几率使对手的招式陷入封印状态."
  expanded_description: "该宝可梦受到接触招式攻击时,有30%的几率使攻击者的该招式陷入封印状态,持续4回合.被封印的招式在效果结束前无法被选择."
}
ability {
  id: ABILITY_HEALER
  name: "治愈之心"
  description: "每回合结束时,有30%几率治愈自身或同伴的异常状态."
  expanded_description: "在双打对战中,每回合结束时,有30%的几率治愈自身和场上同伴的异常状态.对两只宝可梦分别进行几率判定."
}
ability {
  id: ABILITY_FRIEND_GUARD
  name: "友情防守"
  description: "双打中，队友受到的伤害减少25%。"
  expanded_description: "在双打对战中,该宝可梦的同伴受到伤害降低50%.与其他减伤来源乘法叠加."
}
ability {
  id: ABILITY_WEAK_ARMOR
  name: "碎裂铠甲"
  description: "受到接触类招式攻击时，防御降低1级，速度提升2级。"
  expanded_description: "受到接触招式攻击时,该宝可梦的速度提升2级,防御降低1级.对于连续攻击招式,每次命中都会触发."
}
ability {
  id: ABILITY_HEAVY_METAL
  name: "重金属"
  description: "受到的幽灵、恶属性伤害减半，体重翻倍。"
  expanded_description: "受到的幽灵和恶属性招式伤害减半.该宝可梦的重量加倍,影响部分招式."
}
ability {
  id: ABILITY_LIGHT_METAL
  name: "轻金属"
  description: "速度提升1.3倍,且该宝可梦的重量减半."
  expanded_description: "轻金属使该宝可梦的重量减半,并且速度能力值提升30%.这使得基于重量的招式（如踢倒）对该宝可梦造成的伤害降低.但同时也会降低该宝可梦使用重磅冲撞等基于重量的招式造成的伤害."
}
ability {
  id: ABILITY_MULTISCALE
  name: "多重鳞片"
  description: "HP全满时,受到的招式伤害减半."
  expanded_description: "当该宝可梦HP全满时,受到的所有伤害降低50%.与其他减伤效果乘法叠加."
}
ability {
  id: ABILITY_TOXIC_BOOST
  name: "中毒激升"
  description: "处于中毒状态时,攻击提升至1.5倍.免疫中毒状态造成的伤害."
  expanded_description: "处于中毒状态（普通中毒或剧毒）时,该宝可梦的攻击能力值提升50%.在剧毒地形上,无论是否扎根,都会立刻让自己陷入中毒状态.无视中毒伤害."
}
ability {
  id: ABILITY_FLARE_BOOST
  name: "受热激升"
  description: "处于灼伤状态时,特攻提升至1.5倍.在雾中会点燃自身."
  expanded_description: "处于灼伤状态时,该宝可梦的特攻能力值提升50%.无视灼伤伤害.在雾天时立刻让自己陷入灼伤状态."
}
ability {
  id: ABILITY_HARVEST
  name: "收获"
  description: "每回合有50%几率回收已使用的树果,大晴天时100%回收."
  expanded_description: "每回合结束时,有50%几率回收已使用的树果大晴天时100%回收.包括用于投掷、自然恩惠或被吃掉的树果."
}
ability {
  id: ABILITY_TELEPATHY
  name: "心灵感应"
  description: "保护己方队伍免受友方伤害."
  expanded_description: "在双打对战中,保护该宝可梦免受其同伴使用的所有造成伤害的招式的影响."
}
ability {
  id: ABILITY_MOODY
  name: "心情不定"
  description: "每回合随机一项能力大幅提升,另一项能力降低."
  expanded_description: "每回合结束时,随机选择一项能力提升2级,并随机选择另一项不同的能力降低1级."
}
ability {
  id: ABILITY_OVERCOAT
  name: "防尘"
  description: "免疫天气伤害和粉末类招式.受到的特殊伤害降低20%."
  expanded_description: "免疫沙暴和冰雹的天气伤害,并阻挡所有粉末类招式,包括催眠粉、麻痹粉、毒粉、蘑菇孢子、棉孢子、愤怒粉、粉末和魔法粉.同时,受到的特殊伤害降低20%.与其他减伤来源乘法叠加."
}
ability {
  id: ABILITY_POISON_TOUCH
  name: "剧毒之触"
  description: "接触攻击有30%几率使目标中毒.攻击时也生效."
  expanded_description: "无论该宝可梦是攻击方还是被攻击方,使用接触类招式时有30%的几率使对手中毒."
}
ability {
  id: ABILITY_REGENERATOR
  name: "再生力"
  description: "替换下场时,回复1/3的最大HP."
  expanded_description: "替换下场时,回复33%的最大HP.此回复效果不受回复封锁影响."
}
ability {
  id: ABILITY_BIG_PECKS
  name: "健壮胸肌"
  description: "接触类招式的威力提升至1.3倍."
  expanded_description: "接触类招式的威力提升30%."
}
ability {
  id: ABILITY_SAND_RUSH
  name: "挖沙"
  description: "在沙暴中,宝可梦的速度提升至1.5倍."
  expanded_description: "在沙暴中,该宝可梦的速度能力值提升50%.同时免疫沙暴伤害."
}
ability {
  id: ABILITY_WONDER_SKIN
  name: "奇迹皮肤"
  description: "阻挡大多数伤害增益和连续攻击特性."
  expanded_description: "免疫对手所有提升伤害的特性效果,亲子爱和多头龙特性除外."
}
ability {
  id: ABILITY_ANALYTIC
  name: "分析"
  description: "如果在目标之后行动,招式威力提升至1.3倍."
  expanded_description: "当该宝可梦在目标之后行动时,攻击威力提升30%."
}
ability {
  id: ABILITY_ILLUSION
  name: "幻觉"
  description: "伪装成队伍中最后的宝可梦,在受到攻击前威力提升1.3倍."
  expanded_description: "使该宝可梦伪装成队伍中最后存活的同伴.在幻觉被打破前,该宝可梦造成的伤害提升30%."
}
ability {
  id: ABILITY_IMPOSTER
  name: "变身者"
  description: "出场时,变身为对手."
  expanded_description: "替换上场时,该宝可梦变身为对手.复制其外形、能力值（HP除外）、属性、特性、招式以及能力变化.每个被复制的招式拥有5点PP如果目标有替身、已经变身、处于幻觉状态或处于部分无敌状态,则无法变身."
}
ability {
  id: ABILITY_INFILTRATOR
  name: "穿透"
  description: "自身的招式可以穿透替身和伤害减免屏障."
  expanded_description: "允许招式穿透光墙、反射壁、神秘守护、白雾和替身的效果."
}
ability {
  id: ABILITY_MUMMY
  name: "木乃伊"
  description: "受到接触攻击时,使攻击者的特性变为木乃伊."
  expanded_description: "当该宝可梦受到其他宝可梦的接触招式攻击时,如果对方不具有此特性,则对方的当前特性会被替换为木乃伊."
}
ability {
  id: ABILITY_MOXIE
  name: "自信过度"
  description: "击倒对手时,攻击提升1级."
  expanded_description: "每当该宝可梦通过直接攻击击倒对手时,其攻击能力值提升1级."
}
ability {
  id: ABILITY_JUSTIFIED
  name: "正义之心"
  description: "免疫恶属性招式，并提升攻击与特攻中较高的一项。"
  expanded_description: "免疫恶属性招式,并在受到恶属性招式攻击时,攻击能力值提升1级."
}
ability {
  id: ABILITY_RATTLED
  name: "胆小"
  description: "受到虫、恶或幽灵招式攻击或畏缩时,速度提升1级."
  expanded_description: "受到虫、恶或幽灵属性招式攻击或陷入畏缩状态时,速度提升1级.对连续攻击招式可多次触发."
}
ability {
  id: ABILITY_MAGIC_BOUNCE
  name: "魔法镜"
  description: "将变化招式弹回给使用者."
  expanded_description: "在大部分变化招式生效前,将其反弹回原使用者.被反弹的招式无需额外命中判定直接作用于原使用者.无法反弹已被反弹的招式."
}
ability {
  id: ABILITY_SAP_SIPPER
  name: "食草"
  description: "吸收草属性招式,提升自身最高的攻击能力."
  expanded_description: "免疫草属性招式,并在受到草属性招式攻击时,自身最高的攻击能力值提升1级."
}
ability {
  id: ABILITY_PRANKSTER
  name: "恶作剧之心"
  description: "变化招式拥有+1优先度,但对恶属性对手失效."
  expanded_description: "变化类招式获得+1优先度.当直接以恶属性宝可梦为目标时变化招式会失败."
}
ability {
  id: ABILITY_SAND_FORCE
  name: "沙之力"
  description: "在沙暴中,自身最高的攻击能力提升至1.5倍."
  expanded_description: "在沙暴中,该宝可梦最高的攻击能力值提升50%.免疫沙暴伤害."
}
ability {
  id: ABILITY_IRON_BARBS
  name: "铁棘"
  description: "使用接触类招式的敌人损失1/8的最大HP."
}
ability {
  id: ABILITY_ZEN_MODE
  name: "禅境模式"
  description: "出场时变为禅境模式,持续至战斗结束."
  expanded_description: "进入战斗时触发形态变化."
}
ability {
  id: ABILITY_VICTORY_STAR
  name: "胜利之星"
  description: "为己方和同伴的招式提供1.2倍命中率提升."
  expanded_description: "在双打对战中,该宝可梦及其同伴的招式命中率提升1.2倍."
}
ability {
  id: ABILITY_TURBOBLAZE
  name: "涡轮火焰"
  description: "招式可穿透特性.为自身添加火属性."
  expanded_description: "允许招式无视目标的特性和先天特性,包括那些会干扰效果或降低伤害的特性.无法绕过会修改基础能力值的特性,如草之皮毛.为自身添加火属性.即使失去此特性,添加的火属性在替换下场前依然保留."
}
ability {
  id: ABILITY_TERAVOLT
  name: "兆级电压"
  description: "招式可穿透特性.为自身添加电属性."
  expanded_description: "允许招式无视目标的特性和先天特性,包括那些会干扰效果或降低伤害的特性.无法绕过会修改基础能力值的特性,如草之皮毛.为自身添加电属性.即使失去此特性,添加的电属性在替换下场前依然保留."
}
ability {
  id: ABILITY_AROMA_VEIL
  name: "芳香幕"
  description: "保护己方队伍免受着迷、回复封锁和封印效果."
  expanded_description: "保护该宝可梦及其同伴免受着迷、回复封锁效果以及封印类招式（包括封印、挑衅、再来一次和无理取闹）的影响."
}
ability {
  id: ABILITY_FLOWER_VEIL
  name: "花幕"
  description: "保护草属性的同伴免受异常状态和能力降低."
  expanded_description: "防止草属性同伴陷入任何异常状态或能力降低.包括自身引起的能力降低."
}
ability {
  id: ABILITY_CHEEK_POUCH
  name: "颊囊"
  description: "此特性无效果."
  expanded_description: "无效果."
}
ability {
  id: ABILITY_PROTEAN
  name: "变幻自如"
  description: "使用招式前变为该招式的属性；每次上场仅触发一次。"
  expanded_description: "每次攻击前,该宝可梦的属性会变为与所用招式相同的属性.每回合触发一次."
}
ability {
  id: ABILITY_FUR_COAT
  name: "毛皮大衣"
  description: "受到的物理招式伤害减半.不会加倍防御."
  expanded_description: "所有受到的物理攻击伤害减半.与其他减伤来源乘法叠加."
}
ability {
  id: ABILITY_MAGICIAN
  name: "魔术师"
  description: "使用非接触类招式后,偷走对手携带的物品."
  expanded_description: "如果该宝可梦当前未携带物品,使用非接触类招式命中后,会偷走目标携带的物品.对超级石及其他类似物品无效."
}
ability {
  id: ABILITY_BULLETPROOF
  name: "防弹"
  description: "免疫基于投射物、球或炸弹的招式."
  expanded_description: "免疫球、炸弹和投射物类招式.包括酸液炸弹、岩石炮、花粉团和投球."
}
ability {
  id: ABILITY_COMPETITIVE
  name: "好胜"
  description: "能力被对手降低时,特攻提升2级."
  expanded_description: "当该宝可梦的能力被其他宝可梦降低时,其特攻能力提升2级."
}
ability {
  id: ABILITY_STRONG_JAW
  name: "强壮之颚"
  description: "啃咬类招式威力提升至1.3倍."
  expanded_description: "啃咬和颚类招式的威力提升30%."
}
ability {
  id: ABILITY_REFRIGERATE
  name: "冰冻皮肤"
  description: "一般属性招式变为冰属性.冰属性招式得到强化."
  expanded_description: "将该宝可梦的一般属性招式变为冰属性.如果该宝可梦是冰属性,其冰属性招式有10%的几率造成冻伤；否则,它获得冰属性的本系加成."
}
ability {
  id: ABILITY_SWEET_VEIL
  name: "甜幕"
  description: "该宝可梦及其同伴免疫睡眠."
  expanded_description: "在双打对战中,为该宝可梦及其同伴提供睡眠免疫."
}
ability {
  id: ABILITY_STANCE_CHANGE
  name: "战斗切换"
  description: "根据使用的招式在刀剑形态和盾牌形态之间切换."
  expanded_description: "根据使用的招式改变坚盾剑怪的形态.盾牌形态在使用攻击招式时切换为刀剑形态.刀剑形态在使用王者盾牌时切换为盾牌形态.终极形态根据招式类型在物理/特殊之间切换.此特性无法被压制.形态变化在招式执行前发生."
}
ability {
  id: ABILITY_GALE_WINGS
  name: "疾风之翼"
  description: "HP全满时,飞行属性招式获得+1优先度."
  expanded_description: "当HP全满时,赋予飞行属性招式+1优先度."
}
ability {
  id: ABILITY_MEGA_LAUNCHER
  name: "超级发射器"
  description: "波动、波导、脉冲类招式威力提升至1.3倍."
  expanded_description: "脉冲、波导、波动和光环类招式威力提升30%."
}
ability {
