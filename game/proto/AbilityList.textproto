}
ability {
  id: ABILITY_BATTERY
  name: "蓄电池"
  description: "使同伴的特殊攻击威力提升至1.3倍."
  expanded_description: "在双打对战中,蓄电池为同伴宝可梦的特殊攻击提供30%的威力提升.不影响使用者自身的招式."
}
ability {
  id: ABILITY_FLUFFY
  name: "毛茸茸"
  description: "受到的接触类招式伤害减半；受到的火属性招式伤害翻倍。"
  expanded_description: "毛茸茸使受到的接触类招式伤害降低50%.火属性招式对该宝可梦造成双倍伤害.与其他减伤效果乘法叠加."
}
ability {
  id: ABILITY_DAZZLING
  name: "炫彩之躯"
  description: "保护自身及同伴免受先制招式影响."
  expanded_description: "棱镜装甲阻挡所有来自对手的、以该宝可梦或其同伴为目标的先制招式."
}
ability {
  id: ABILITY_SOUL_HEART
  name: "魂心"
  description: "场上任何宝可梦被击倒时,特攻提升1级."
  expanded_description: "当战场上任何宝可梦（包括同伴和对手）濒死时,魂心特性会提升该宝可梦的特攻1级."
}
ability {
  id: ABILITY_TANGLING_HAIR
  name: "卷发"
  description: "与该宝可梦发生接触的敌人,其速度降低."
  expanded_description: "当该宝可梦受到接触招式攻击时,攻击者的速度降低1级.对于连续攻击招式,每次命中都会触发."
}
ability {
  id: ABILITY_RECEIVER
  name: "接球手"
  description: "在双打对战中,复制濒死同伴的特性."
  expanded_description: "接球手会复制濒死同伴的特性,替换自身的接球手特性.此效果持续到替换下场."
}
ability {
  id: ABILITY_POWER_OF_ALCHEMY
  name: "化学之力"
  description: "出场时转化树果.物品失去时转化物品."
  expanded_description: "出场时,将所有对手的树果转化为黑色污泥.战斗中任何宝可梦失去物品时,该物品会被黑色污泥取代.如果黑色污泥被移除,则会被大金珠取代."
}
ability {
  id: ABILITY_BEAST_BOOST
  name: "异兽提升"
  description: "击倒对手后,自身最高的计算后能力值提升1级."
  expanded_description: "每当该宝可梦击倒一名对手时,其最高的计算后能力值提升1级被提升的能力基于不考虑当前能力等级变化的原始能力值决定."
}
ability {
  id: ABILITY_RKS_SYSTEM
  name: "AR系统"
  description: "携带的记忆碟决定其属性.同时拥有变幻自在和适应力特性."
  expanded_description: "AR系统根据携带的记忆碟改变使用者的形态.每次攻击前,使用者的属性会变为与所用招式相同的属性.本系加成从1.5倍提升至2.0倍."
}
ability {
  id: ABILITY_ELECTRIC_SURGE
  name: "电气制造者"
  description: "出场时制造电气场地,持续8回合."
  expanded_description: "出场时制造电气场地,持续8回合（携带场地制造机时为12回合）.地面上的宝可梦不会陷入睡眠,且电属性招式威力提升30%.激活时覆盖其他场地."
}
ability {
  id: ABILITY_PSYCHIC_SURGE
  name: "精神制造者"
  description: "出场时制造精神场地,持续8回合."
  expanded_description: "出场时制造精神场地,持续8回合（携带场地制造机时为12回合）.地面上的宝可梦免疫对手的先制招式.超能力属性招式威力提升30%.广阔战场可以攻击所有对手且威力提升.自然之力变为精神强念.覆盖其他现有场地."
}
ability {
  id: ABILITY_MISTY_SURGE
  name: "薄雾制造者"
  description: "出场时制造薄雾场地,持续8回合."
  expanded_description: "出场时制造薄雾场地,持续8回合（携带场地制造机时为12回合）.薄雾场地防止地面上的宝可梦陷入任何异常状态,并使妖精属性招式威力提升30%.覆盖现有场地."
}
ability {
  id: ABILITY_GRASSY_SURGE
  name: "青草制造者"
  description: "出场时制造青草场地,持续8回合."
  expanded_description: "出场时制造青草场地,持续8回合（携带场地制造机时为12回合）地面上的宝可梦每回合回复1/16的HP,且草属性招式威力提升30%.覆盖其他场地."
}
ability {
  id: ABILITY_FULL_METAL_BODY
  name: "金属防护"
  description: "免疫能力降低."
  expanded_description: "金属防护使该宝可梦免疫所有来自招式或特性的能力降低效果.包括因使用过热等招式导致的自身能力降低."
}
ability {
  id: ABILITY_SHADOW_SHIELD
  name: "幻影防守"
  description: "HP全满时,受到的招式伤害减半."
  expanded_description: "当HP全满时,幻影防守使受到的所有攻击伤害减半.与其他减伤来源乘法叠加."
}
ability {
  id: ABILITY_PRISM_ARMOR
  name: "棱镜装甲"
  description: "受到效果绝佳的招式攻击时,伤害降低35%."
  expanded_description: "受到效果绝佳的招式攻击时,伤害降低35%.与其他减伤效果乘法叠加."
}
ability {
  id: ABILITY_NEUROFORCE
  name: "脑核之力"
  description: "对效果绝佳的招式提供额外的1.35倍威力加成."
  expanded_description: "效果绝佳的攻击威力提升35%."
}
ability {
  id: ABILITY_INTREPID_SWORD
  name: "不挠之剑"
  description: "出场时,攻击提升1级."
  expanded_description: "不挠之剑在替换上场时,使该宝可梦的攻击能力提升1级."
}
ability {
  id: ABILITY_DAUNTLESS_SHIELD
  name: "不屈之盾"
  description: "出场时,防御提升1级."
  expanded_description: "不屈之盾在进入战斗时,立即将防御能力提升1级."
}
ability {
  id: ABILITY_LIBERO
  name: "自由者"
  description: "使用招式前变为该招式的属性；每次上场仅触发一次。"
  expanded_description: "自由者在攻击前,会将使用者的属性覆盖为与所用招式相同的属性.挣扎招式无法触发此效果."
}
ability {
  id: ABILITY_BALL_FETCH
  name: "拾球"
  description: "对战斗无效果."
  expanded_description: "对战斗无效果."
}
ability {
  id: ABILITY_COTTON_DOWN
  name: "棉絮"
  description: "受到攻击时,降低所有对手的速度1级."
  expanded_description: "棉絮特性在该宝可梦受到任何攻击时触发,降低所有宝可梦的速度1级.对于连续攻击招式,每次命中都会触发."
}
ability {
  id: ABILITY_PROPELLER_TAIL
  name: "螺旋尾鳍"
  description: "悠游自如 + 免疫招式吸引."
  expanded_description: "螺旋尾鳍使该宝可梦在雨天时速度提升50%,并且免疫招式吸引效果.速度加成在所有形式的雨天中都有效."
}
ability {
  id: ABILITY_MIRROR_ARMOR
  name: "镜甲"
  description: "将敌人施加的任何能力降低效果反弹回去."
  expanded_description: "镜甲将所有以该宝可梦为目标的降低能力效果反弹给攻击者.反弹效果无视免疫."
}
ability {
  id: ABILITY_GULP_MISSILE
  name: "一口导弹"
  description: "使用潜水/冲浪后叼住猎物.受到攻击时,向敌人射出猎物."
  expanded_description: "当古月鸟使用冲浪、三重潜水或潜水时,它会叼住猎物：HP小于50%时为叼喙形态,HP大于50%时为吞喙形态.在任一形态下受到攻击时,会向攻击者吐出猎物,造成其最大HP25%的伤害,并返回普通形态.叼喙形态还会降低防御1级；吞喙形态会麻痹目标.此特性无法被压制等."
}
ability {
  id: ABILITY_STALWART
  name: "坚毅"
  description: "不受招式吸引、击中要害或特性压制的影响."
  expanded_description: "招式不会被吸引,不会受到击中要害,且特性不会被压制.特性压制包括破格、化学变化气体和菌丝之力等效果."
}
ability {
  id: ABILITY_STEAM_ENGINE
  name: "蒸汽机"
  description: "受到火属性或水属性招式攻击时,速度提升至最大."
  expanded_description: "受到任何火属性或水属性招式攻击后,蒸汽机特性立即将速度能力值提升至+6级.提升效果在受到伤害后生效."
}
ability {
  id: ABILITY_PUNK_ROCK
  name: "庞克摇滚"
  description: "声音类招式造成1.3倍伤害.受到的声音类招式伤害降低50%."
  expanded_description: "庞克摇滚使该宝可梦的声音类招式威力提升30%,并且受到的声音类招式伤害降低50%.伤害减免与其他来源乘法叠加."
}
ability {
  id: ABILITY_SAND_SPIT
  name: "喷沙"
  description: "受到攻击时引发沙暴.攻击者随后会接地."
  expanded_description: "受到攻击伤害时,如果场上没有沙暴,则会引发持续8回合的沙暴.如果沙暴被引发,攻击者会被拉至地面.该宝可梦免疫沙暴伤害.如果该宝可梦因该次攻击而濒死则不会触发此特性."
}
ability {
  id: ABILITY_ICE_SCALES
  name: "冰鳞粉"
  description: "受到的特殊招式伤害减半.不会加倍特防."
  expanded_description: "所有受到的特殊攻击伤害减半.与其他减伤来源乘法叠加."
}
ability {
  id: ABILITY_RIPEN
  name: "熟成"
  description: "树果提供的抗性、回复和能力提升效果加倍."
  expanded_description: "熟成使所有树果的有益效果加倍回复类树果回复量加倍,提升能力的树果改为提升2级,抵抗树果将效果绝佳的伤害降低75%而非50%,回复PP的树果回复量加倍."
}
ability {
  id: ABILITY_ICE_FACE
  name: "结冻头"
  description: "抵挡一次攻击.在冰雹中可恢复此保护效果."
  expanded_description: "结冻头使哭哭面具在受到物理攻击后变身为无头形态,并抵消一次伤害.在无头形态下,如果场上出现冰雹或该宝可梦被替换上场,则恢复为结冻头形态.无法被复制或压制."
}
ability {
  id: ABILITY_POWER_SPOT
  name: "能量点"
  description: "使同伴的攻击威力提升至1.3倍."
  expanded_description: "在双打对战中,能量点使同伴的攻击威力提升30%.使用者自身不受此加成影响."
}
ability {
  id: ABILITY_MIMICRY
  name: "拟态"
  description: "根据当前场地改变自身属性."
  expanded_description: "拟态使该宝可梦的属性变为与当前场地一致：电气场地变为电属性,薄雾场地变为妖精属性,青草场地变为草属性,精神场地变为超能力属性.属性变化持续到场地结束或该宝可梦下场.保留通过浸水等招式改变的属性."
}
ability {
  id: ABILITY_SCREEN_CLEANER
  name: "除障"
  description: "出场时清除双方场上的屏障.可以重置屏障."
  expanded_description: "除障特性在该宝可梦进入战斗时,移除双方场地上所有的防护屏障、反射壁、光墙、极光幕和烟幕它还允许该宝可梦在屏障已激活时重新设置它们,刷新其持续时间."
}
ability {
  id: ABILITY_STEELY_SPIRIT
  name: "钢魂"
  description: "提升自身和同伴的钢属性招式威力至1.3倍."
  expanded_description: "钢魂特性在战斗中使使用者及其同伴的钢属性招式威力提升30%."
}
ability {
  id: ABILITY_PERISH_BODY
  name: "灭亡之躯"
  description: "受到接触类招式攻击时使用灭亡之歌。"
  expanded_description: "受到接触招式攻击时,灭亡之躯对使用者和攻击者发动灭亡之歌.除非替换下场,否则两只宝可梦将在3回合后濒死."
}
ability {
  id: ABILITY_WANDERING_SPIRIT
  name: "游魂"
  description: "受到接触攻击时,与攻击者交换特性."
  expanded_description: "受到接触招式攻击时,游魂特性会与攻击者交换特性.两只宝可梦在替换下场后恢复各自原有的特性.无法与同样不能被复制或压制的特性交换."
}
ability {
  id: ABILITY_GORILLA_TACTICS
  name: "一猩一意"
  description: "自身攻击提升1.5倍,但只能使用最初选择的招式."
  expanded_description: "一猩一意使物理招式威力提升50%,但会锁定使用者只能使用首次选择的招式,直到替换下场."
}
ability {
  id: ABILITY_NEUTRALIZING_GAS
  name: "化学变化气体"
  description: "所有特性都失效."
  expanded_description: "用气体充满战场,完全压制除无法压制外的所有特性.效果在使用者在场时持续.在使用者尝试替换下场后,所有被压制的特性会重新触发其入场效果.无法被复制或交换."
}
ability {
  id: ABILITY_PASTEL_VEIL
  name: "粉彩护幕"
  description: "出场时施放神秘守护."
  expanded_description: "粉彩护幕在该宝可梦进入战斗时,自动为其队伍设置神秘守护.神秘守护持续5回合,保护所有队友免受异常状态."
}
ability {
  id: ABILITY_HUNGER_SWITCH
  name: "饱了又饿"
  description: "每回合结束后在吃饱形态和饥饿形态之间切换."
  expanded_description: "每回合结束时自动在吃饱形态和饥饿形态之间切换.无法以任何方式覆盖、压制、交换或复制."
}
ability {
  id: ABILITY_QUICK_DRAW
  name: "速击"
  description: "30%几率先出手."
  expanded_description: "速击有30%的几率让使用者在当前优先度层级内率先行动.与先制之爪的效果乘法叠加,使总触发几率达到44%."
}
ability {
  id: ABILITY_UNSEEN_FIST
  name: "无形拳"
  description: "接触类招式可以穿透保护效果."
  expanded_description: "无形拳允许所有接触类招式穿透保护类招式,并忽略与其相关的任何附加效果."
}
ability {
  id: ABILITY_CURIOUS_MEDICINE
