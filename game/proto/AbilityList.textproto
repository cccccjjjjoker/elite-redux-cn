  expanded_description: "余香特性在受到接触招式攻击时,将攻击者的特性（非先天特性）改变为余香."
}
ability {
  id: ABILITY_FAIRY_TALE
  name: "童话"
  description: "出场时添加妖精属性."
  expanded_description: "进入战斗时,为使用者的当前属性添加妖精属性.即使失去此特性,添加的妖精属性在替换下场前依然保留."
}
ability {
  id: ABILITY_RAGING_MOTH
  name: "暴怒飞蛾"
  description: "火属性招式攻击两次,每次造成70%伤害."
  expanded_description: "火属性招式攻击两次,每次造成招式正常伤害的70%.追加效果在每次攻击中独立判定（畏缩除外）."
}
ability {
  id: ABILITY_ADRENALINE_RUSH
  name: "肾上腺素冲击"
