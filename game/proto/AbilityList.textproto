}
ability {
  id: ABILITY_MASTER_HAND
  name: "大师之手"
  description: "超级发射器 + 暴走."
  expanded_description: "使脉冲、波导、波动和光环类招式威力提升30%.击倒对手时,立即从休息状态中恢复,允许立即使用破坏光线等招式而无需等待."
