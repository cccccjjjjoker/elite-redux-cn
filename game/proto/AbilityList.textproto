}
ability {
  id: ABILITY_MAJESTIC_BIRD
  name: "华贵之鸟"
  description: "自身的特攻能力提升至1.5倍.提升最终能力值,而非基础能力值."
  expanded_description: "华贵之鸟使该宝可梦的特攻能力值提升50%.与其他伤害加成效果乘法叠加."
}
ability {
  id: ABILITY_PHANTOM
  name: "幻影"
  description: "出场时添加幽灵属性."
  expanded_description: "进入战斗时,为使用者的当前属性添加幽灵属性.即使失去此特性,添加的幽灵属性在替换下场前依然保留."
}
ability {
  id: ABILITY_INTOXICATE
