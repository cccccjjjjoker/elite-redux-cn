  expanded_description: "吹气筒在进入战斗时自动设置持续3回合的顺风,使使用者一方所有宝可梦的速度加倍.同时会触发乘风特性."
}
ability {
  id: ABILITY_JUGGERNAUT
  name: "主宰"
  description: "接触类招式将20%的防御加入攻击计算.免疫麻痹."
  expanded_description: "主宰特性增强接触类招式,将使用者20%的防御能力值加入攻击计算.防止麻痹状态,并在陷入麻痹时立即治愈."
}
ability {
  id: ABILITY_SHORT_CIRCUIT
  name: "短路"
  description: "电属性招式威力×1.2；HP低于1/3时改为×1.5。"
