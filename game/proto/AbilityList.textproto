ability {
  id: ABILITY_FIREFIGHTER
  name: "消防员"
  description: "对火属性造成1.5倍伤害。\n受火属性伤害减半。"
  expanded_description: "对火属性宝可梦造成1.5倍伤害,并且受到火属性宝可梦攻击时,伤害减半.此效果基于攻击方/防御方宝可梦的属性,而非招式属性.伤害减免与其他来源乘法叠加."
}
ability {
  id: ABILITY_SEPIA_LENS
  name: "棕褐色镜片"
  description: "有色眼镜 + 沙之守卫."
  expanded_description: "结合有色眼镜和沙之守卫.攻击被抵抗时造成双倍伤害.在沙暴中,阻挡对手的先制招式,并使受到的特殊攻击伤害减半.同时像其他地面属性一样免疫沙暴伤害."
}
ability {
  id: ABILITY_SUPER_SNIPER
  name: "超级狙击手"
  description: "狙击手 + 攻击替换下场的对手,威力为1/2."
  expanded_description: "击中要害时的伤害倍率从1.5倍提升至2.25倍,即额外增加50%的伤害加成.在对手替换下场前以50%的威力攻击他们,在其离开前造成伤害."
}
ability {
  id: ABILITY_WOODLAND_CURSE
  name: "林地诅咒"
  description: "出场时使用森林诅咒.接触时添加草属性."
  expanded_description: "进入战斗时,对随机一名对手使用森林诅咒,为其添加草属性.当对手与使用者发生接触时,他们也会被添加草属性作为额外属性.仅影响非草属性目标.效果持续到替换下场."
}
ability {
  id: ABILITY_MALODOR
  name: "浊臭"
  description: "接触时压制攻击者的特性."
  expanded_description: "受到接触招式攻击时,使用者压制攻击者的特性和先天特性,直到他们替换下场."
}
ability {
  id: ABILITY_BLUR
  name: "模糊"
  description: "受物理攻击时用速度作防御。"
  expanded_description: "当受到接触招式攻击时,该宝可梦使用其速度能力值而非防御或特防进行伤害计算.讲究围巾的效果不影响此特性."
}
ability {
  id: ABILITY_ELUDE
  name: "规避"
  description: "受特殊攻击时用速度作防御。"
  expanded_description: "受特殊招式攻击时，用速度而非防御或特防计算伤害。讲究围巾不影响此特性。"
}
ability {
  id: ABILITY_DRAKE_OF_RAGE
  name: "暴怒之龙"
  description: "有色眼镜 + 暴走."
  expanded_description: "攻击被抵抗时,伤害加倍.如果招式被抵抗（0.5倍伤害或更低）,则最终伤害乘以2倍.当使用者通过直接攻击击倒对手时,立即从休息状态中恢复."
}
ability {
  id: ABILITY_REVERBATE
  name: "混响"
  description: "一般属性招式变为声音类招式."
  expanded_description: "将所有一般属性招式转变为声音类招式,使其能够受益于基于声音的特性和互动."
}
ability {
  id: ABILITY_MIXED_MARTIAL_ARTS
  name: "综合格斗"
  description: "一般属性招式被视为拳和腿类招式."
  expanded_description: "将所有一般属性招式转变为铁拳和前锋类招式,使其能够受益于相关特性和互动."
}
ability {
  id: ABILITY_STRATEGIC_PAUSE
  name: "战略停顿"
  description: "后手攻击时+2击中要害率 + 分析."
  expanded_description: "当使用者后手攻击时,击中要害率提升2级,攻击威力提升30%."
}
ability {
  id: ABILITY_OVERRULE
  name: "否决"
  description: "击中要害时无视特性,且对被抵抗的目标造成2倍伤害."
  expanded_description: "当该宝可梦的招式造成击中要害时,它们会无视通常会降低伤害的防御性特性,并且如果招式被抵抗,则造成双倍伤害.对于连续攻击招式,如果第一击是击中要害,则所有攻击都无视特性,否则都不无视."
}
ability {
  id: ABILITY_MENTAL_POLLUTION
  name: "精神污染"
  description: "当自身混乱时,压制其他宝可梦的特性."
  expanded_description: "当它陷入混乱时,对其他宝可梦施加特性压制.压制效果在这些宝可梦在场期间持续.拥有精神污染特性的宝可梦不受影响."
}
ability {
  id: ABILITY_MADNESS_ENHANCEMENT
  name: "狂化增强"
  description: "雾中陷入狂怒；狂怒时受到的伤害减少20%。"
  expanded_description: "进入迷雾时陷入愤怒.当使用者愤怒时,所有受到的伤害降低50%,且不会受到愤怒伤害."
}
ability {
  id: ABILITY_TENTALOCK
  name: "触手束缚"
  description: "擒拿手 + 蛇缚."
  expanded_description: "束缚类招式持续6回合而非4-5回合,并且每回合结束时的伤害提升至目标最大HP的1/6.攻击有50%几率束缚目标6回合,防止逃跑或替换.一旦被束缚,目标每在场一回合速度降低1级."
}
ability {
  id: ABILITY_SERPENT_BIND
  name: "蛇缚"
  description: "有50%概率束缚目标；被束缚的对手每回合速度降低1级。"
  expanded_description: "攻击有50%几率束缚目标4-5回合,防止逃跑或替换.一旦被束缚,目标每在场一回合速度降低1级."
}
ability {
  id: ABILITY_SOUL_TAP
  name: "灵魂之触"
  description: "在雾中,每回合结束时从对手吸取10%的HP."
  expanded_description: "在迷雾激活时,每回合结束时,从每个在场的对手吸取其最大HP的1/10,并回复给使用者.无视替身."
}
ability { 
  id: ABILITY_SCARECROW
  name: "稻草人"
  description: "惊吓与棉絮的效果。"
  expanded_description: "进入战斗时,降低所有对手宝可梦的特攻1级对手无法造成击中要害,总是造成最低伤害（85%而非85-100%）,无法触发非必定触发的追加效果,并且有5%的几率招式落空."
}
ability {
  id: ABILITY_OMINOUS_SHROUD
  name: "不祥之幕"
  description: "幻影 + 幻影防守."
  expanded_description: "进入战斗时,为使用者的当前属性添加幽灵属性.即使失去此特性,添加的幽灵属性在替换下场前依然保留.当HP全满时,所有受到的攻击伤害减半.与其他减伤来源乘法叠加."
}
ability {
  id: ABILITY_CHILLING_PRESENCE
  name: "寒意逼人"
  description: "上场时使用威力10的冰冻之风。"
  expanded_description: "出场时使用威力10的冰息（冰属性,特殊,空气类）,攻击所有对手并降低其速度1级."
}
ability {
  id: ABILITY_FROSTBIND
  name: "冰封禁锢"
  description: "造成冻伤时也施加封印."
  expanded_description: "当造成冻伤时,使用者也会施加封印.封印阻止目标使用其最后使用的招式,持续4回合.如果目标尚未行动,则失败."
}
ability {
  id: ABILITY_GLACIAL_GHOST
  name: "冰川鬼影"
  description: "拨雪 + 雪隐."
  expanded_description: "在冰雹中,该宝可梦的速度提升50%,并且对手的命中率降低25%.免疫冰雹伤害."
}
ability {
  id: ABILITY_TENDER_AFFECTION
  name: "温柔爱意"
  description: "迷人之躯 + 妖精属性本系."
  expanded_description: "受到接触招式攻击时,有50%几率使攻击者着迷（将其攻击和特攻减半）.同时为妖精属性招式提供本系加成."
}
ability {
  id: ABILITY_WONDER_SCALE
  name: "奇异鳞片"
  description: "蜕皮 + 奇迹皮肤."
  expanded_description: "每回合结束时,该宝可梦有30%的几率治愈自身所受到的异常状态.免疫对手所有提升伤害的特性效果,亲子爱和多头龙特性除外."
}
ability {
  id: ABILITY_OVERZEALOUS
  name: "过度狂热 (N)"
  description: "使用者的效果绝佳招式拥有+1优先度."
  expanded_description: "不会实装."
}
ability {
  id: ABILITY_STAINLESS_STEEL
  name: "不锈钢"
  description: "坚壁 + 钢能力士."
  expanded_description: "使用者无视大多数增加伤害或额外攻击次数的特性.将使用者的一般属性招式变为钢属性.如果使用者是钢属性,它抵抗幽灵和钢属性；否则,它获得钢属性的本系加成."
}
ability {
  id: ABILITY_TEMPORAL_RUPTURE
  name: "时空断裂"
  description: "时光咆哮被大幅改变."
  expanded_description: "时光咆哮变为威力100,优先度0的攻击,将目标的特性变为慢启动（攻击、特攻和速度减半5回合）,但不再强制目标替换."
}
ability {
  id: ABILITY_GRASS_FLUTE
  name: "草笛"
  description: "声音类招式造成恐惧."
  expanded_description: "声音类招式命中时造成恐惧.恐惧束缚目标2回合,使其受到的伤害增加50%.如果被吹飞等招式强制替换,目标会摆脱恐惧."
}
ability {
  id: ABILITY_HEMOTOXIN
  name: "溶血毒素"
  description: "目标中毒时，压制其特性。"
  expanded_description: "当使用者成功使对手中毒时,压制对手的特性和先天特性.压制效果在他们替换下场后解除."
}
ability {
  id: ABILITY_HARUKAZE
  name: "春风"
  description: "设置青草场地时也设置顺风,反之亦然."
  expanded_description: "设置顺风时也会设置青草场地,设置青草场地时也会设置顺风.如果其中一种效果已激活,则不会刷新其持续时间."
}
ability {
  id: ABILITY_TOXIC_SURGE
  name: "毒沼制造者"
  description: "上场时展开持续8回合的剧毒场地。"
  expanded_description: "替换上场时设置剧毒场地,持续8回合（携带场地制造机时为12回合）.激活时,非毒或钢属性的接地宝可梦每回合损失1/16最大HP,毒属性招式威力提升30%,撒菱会转变为毒菱."
}
ability {
  id: ABILITY_ATLANTIC_RULER
  name: "大西洋统治者"
  description: "水栖居民 + 悠游自如."
  expanded_description: "进入战斗时,为使用者的当前属性添加水属性即使失去此特性,添加的水属性在替换下场前依然保留.同时水属性招式威力提升50%.下雨天气时,速度提升50%."
}
ability {
  id: ABILITY_BIOFILM
  name: "生物膜"
  description: "剧毒场地中，特防提升50%。"
  expanded_description: "在剧毒场地中,使用者的特防能力值提升50%."
}
ability {
  id: ABILITY_CHOKEHOLD
  name: "扼喉"
  description: "束缚类招式使目标麻痹，并使其每回合速度降低1级。"
  expanded_description: "当使用者束缚目标时,它们造成麻痹,并且在被束缚期间每回合降低其速度1级."
}
ability {
  id: ABILITY_GUARDIAN_COAT
  name: "守护者外套"
  description: "免疫天气伤害和粉末类招式.受到的物理伤害降低20%."
  expanded_description: "免疫沙暴和冰雹的天气伤害,并阻挡所有粉末类招式,包括催眠粉、麻痹粉、毒粉、蘑菇孢子、棉孢子、愤怒粉、粉末和魔法粉.同时,受到的物理伤害降低20%.与其他减伤来源乘法叠加."
}
ability {
  id: ABILITY_NEUTRALIZING_FOG
  name: "中和雾气"
  description: "出场时使用清除浓雾."
  expanded_description: "替换上场时使用清除浓雾,清除所有入场陷阱、屏障、神秘守护和白雾.同时降低对手的闪避率1级."
}
ability {
  id: ABILITY_POISON_QUILLS
  name: "毒羽刺"
  description: "粗糙皮肤 + 毒刺."
  expanded_description: "对使用接触类招式的攻击者造成其最大HP1/8的伤害.同时,无论攻击方还是被攻击方,使用接触类招式时有30%的几率使对手中毒.对于连续攻击招式,每次命中都会触发."
}
ability {
  id: ABILITY_DRACONIC_MIGHT
  name: "龙之威仪"
  description: "龙化 + 半龙."
  expanded_description: "将所有一般属性招式转变为龙属性招式,并为龙属性招式提供本系加成.如果使用者是龙属性,其龙属性招式对妖精属性造成普通伤害.出场时,为使用者的当前属性添加龙属性即使失去此特性,添加的龙属性在替换下场前依然保留."
}
ability {
  id: ABILITY_FESTIVITIES
  name: "庆典"
  description: "声音类招式同时视为舞蹈类，舞蹈类招式同时视为声音类。"
  expanded_description: "声音类招式也被视为舞蹈类招式,可从舞者类特性中受益.舞蹈类招式也被视为声音类招式,可从基于声音的特性中受益."
}
ability {
  id: ABILITY_FEY_FLIGHT
  name: "妖精飞行"
  description: "妖精传说与飘浮的效果。"
  expanded_description: "进入战斗时,为使用者的当前属性添加妖精属性.即使失去此特性,添加的妖精属性在替换下场前依然保留.使用者免疫地面属性招式以及其他地面效果,如撒菱和场地状态.飞行属性招式伤害提升25%."
}
ability {
  id: ABILITY_BEST_OFFENSE
  name: "最佳攻势"
  description: "切割类招式变为特殊招式，并使用增加20%的特防计算攻击。"
  expanded_description: "锐利刀刃类招式变为特殊（造成特殊伤害并使用特攻能力值）,并在攻击计算中使用使用者20%的特防能力值."
}
ability {
  id: ABILITY_IMPALER
  name: "穿刺者"
  description: "强大之角的效果；角类招式有30%概率使目标流血。"
  expanded_description: "使角和钻类攻击的威力提升30%,并且有30%的几率使目标流血流血每回合造成1/16最大HP伤害,阻止回复,并使能力等级效果无效.岩石和幽灵属性免疫流血."
}
ability {
  id: ABILITY_MAGUS_BLADES
  name: "魔导剑"
  description: "最佳攻势的效果；切割类招式攻击两次，每次造成60%伤害。"
  expanded_description: "锐利刀刃类招式变为特殊（造成特殊伤害并使用特攻能力值）,并在攻击计算中使用使用者20%的特防能力值.同时,锐利刀刃类招式攻击两次,每次造成招式正常伤害的70%.追加效果在每次攻击中独立判定（畏缩除外）."
}
ability {
  id: ABILITY_LIGHTNING_BORN
  name: "闪电之躯"
  description: "出场时添加电属性."
  expanded_description: "进入战斗时,为使用者的当前属性添加电属性即使失去此特性,添加的电属性在替换下场前依然保留."
}
ability {
  id: ABILITY_SUPERHEAVY
  name: "超重"
  description: "不屈之心的效果；不会被强制换下。"
  expanded_description: "当陷入畏缩状态时,速度提升1级.防止因招式或红牌被强制替换."
}
ability {
  id: ABILITY_WORLD_SERPENT
  name: "世界之蛇"
  description: "蛇缚与钳制的效果。"
  expanded_description: "物理非接触类招式造成20%额外伤害.接触类招式有50%几率束缚目标4-5回合."
}
ability {
  id: ABILITY_LUCKY_WINGS
  name: "幸运之翼"
  description: "天恩 + 巨翼."
  expanded_description: "自身招式的追加效果触发几率加倍.使所有翅膀、风和空气类招式的威力提升30%."
}
ability {
  id: ABILITY_KOMODO
  name: "科莫多"
  description: "增加龙属性；攻击有30%概率使目标陷入剧毒。"
  expanded_description: "进入战斗时,为使用者的当前属性添加龙属性.即使失去此特性,添加的龙属性在替换下场前依然保留.使用者在使用任何招式命中后,有30%的几率使目标陷入剧毒连续攻击的每一击都会独立判定."
}
ability {
  id: ABILITY_ENVENOM
  name: "施毒"
  description: "攻击有30%概率使目标中毒。"
  expanded_description: "使用者在使用任何招式命中后,有30%的几率使目标中毒.连续攻击的每一击都会独立判定."
}
ability {
  id: ABILITY_PURPLE_HAZE
  name: "紫色迷雾"
  description: "使用攻击招式后，追加威力20的毒瓦斯。"
  expanded_description: "使用招式后,紧接着使用威力20的毒瓦斯（毒属性,特殊,20%几率中毒,对飞行属性效果绝佳）."
}
ability {
  id: ABILITY_GNASHING_CANNON
  name: "咬牙加农"
  description: "超级发射器 + 精神咬碎."
  expanded_description: "使脉冲、波导、波动和光环类招式威力提升30%.啃咬类招式使用特攻能力值进行伤害计算（除非另有说明,否则仍攻击目标的防御）,并造成30%额外伤害."
}
ability {
  id: ABILITY_HYPER_CLEANSE
  name: "超净"
  description: "免疫异常状态；受到的毒属性招式伤害减半。"
}
ability {
  id: ABILITY_MOLTEN_COAT
  name: "熔岩外套"
  description: "矿化 + 岩石属性招式有50%几率造成灼伤."
}
ability {
  id: ABILITY_ROYAL_DECREE
  name: "王室敕令"
  description: "女王威严 + 出场时使用一次大蛇瞪眼."
  expanded_description: "防止使用者和它的同伴成为优先度大于0的先制招式的目标.出场时使用大蛇瞪眼,使目标麻痹.每场战斗仅触发一次."
}
ability {
  id: ABILITY_BREEZY_NEIGH
  name: "轻风嘶鸣"
  description: "击倒对手时,速度提升1级."
  expanded_description: "当该宝可梦通过直接攻击使对手濒死时,其速度能力值提升1级."
}
ability {
  id: ABILITY_DREAMSCAPE
  name: "梦境领域"
  description: "绝对睡眠 + 捕梦人 + 造成20%额外伤害."
  expanded_description: "该宝可梦在招式和状态判定中被视为处于睡眠状态.可以正常行动,并且免疫所有异常状态.当场上任何宝可梦处于睡眠时,招式威力加倍.攻击会对正在替换下场的睡眠中对手造成1倍伤害,在其离开前造成伤害.伤害提升20%."
}
ability {
  id: ABILITY_HASTE_MAKES_WASTE
  name: "欲速则不达"
  description: "后攻 + 分析."
  expanded_description: "如果该宝可梦本回合还未行动,则受到的伤害降低30%.与其他减伤来源乘法叠加.当该宝可梦在回合中替换上场时也生效.如果目标本回合已行动,则造成的伤害提升30%."
}
ability {
  id: ABILITY_HUNGRY_MAWS
  name: "饥饿之颚"
  description: "强壮之颚 + 杀戮之颚."
  expanded_description: "使啃咬和颚类招式威力提升30%.使用啃咬类招式击败对手时,回复50%最大HP；使用其他招式击败时,回复25%.仅当通过直接攻击击倒目标时触发."
}
ability {
  id: ABILITY_THERMAL_SLIDE
  name: "热滑"
  description: "在大晴天或冰雹中,速度提升50%."
  expanded_description: "在冰雹或大晴天下,该宝可梦的速度提升50%.同时免疫冰雹伤害."
}
ability {
