  expanded_description: "使所有攻击连续命中两次.第一击造成100%伤害,第二击造成25%伤害.每次攻击独立判定追加效果（畏缩除外）.可穿透坚壁/奇迹皮肤."
}
ability {
  id: ABILITY_DARK_AURA
  name: "暗黑气场"
  description: "在该宝可梦在场时,所有宝可梦的恶属性招式威力提升至1.33倍."
  expanded_description: "使用者、其同伴以及对手的所有恶属性招式获得1.33倍的威力提升.此加成会被气场破坏反转."
}
ability {
  id: ABILITY_FAIRY_AURA
  name: "妖精气场"
  description: "在该宝可梦在场时,所有宝可梦的妖精属性招式威力提升至1.33倍."
  expanded_description: "使用者、其同伴以及对手的所有妖精属性招式获得1.33倍的威力提升.此加成会被气场破坏反转."
}
ability {
  id: ABILITY_AURA_BREAK
