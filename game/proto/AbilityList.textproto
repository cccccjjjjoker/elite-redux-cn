}
ability {
  id: ABILITY_DRAGONS_MAW
  name: "龙颚"
  description: "龙属性招式威力提升至1.5倍."
  expanded_description: "龙颚使龙属性招式的威力提升50%."
}
ability {
  id: ABILITY_CHILLING_NEIGH
  name: "苍白嘶鸣"
  description: "击倒对手时,攻击提升1级."
  expanded_description: "当该宝可梦通过直接攻击击倒对手时,其攻击能力值提升1级."
}
ability {
  id: ABILITY_GRIM_NEIGH
  name: "漆黑嘶鸣"
  description: "击倒对手时,特攻提升1级."
  expanded_description: "漆黑嘶鸣特性在该宝可梦通过直接攻击使对手濒死时,提升其特攻能力值1级."
}
ability {
  id: ABILITY_AS_ONE_ICE_RIDER
  name: "人马一体"
  description: "紧张感 + 苍白嘶鸣."
  expanded_description: "阻止所有对手宝可梦消耗其携带的物品.当该宝可梦通过直接攻击击倒对手时,其攻击能力值提升1级."
}
ability {
  id: ABILITY_AS_ONE_SHADOW_RIDER
  name: "人马一体"
  description: "紧张感 + 漆黑嘶鸣."
  expanded_description: "阻止所有对手宝可梦消耗其携带的物品.当该宝可梦通过直接攻击击倒对手时,其特攻能力值提升1级."
}
ability {
  id: ABILITY_CHLOROPLAST
  name: "叶绿体"
  description: "气象球、日光束/刃、生长视为在大晴天下使用."
  expanded_description: "气象球威力加倍并变为火属性.日光类招式无需蓄力.生长使攻击和特攻提升2级.月光、晨光和光合作用回复2/3的最大HP.草之誓约和水之誓约组合分别产生火海或彩虹效果."
}
ability {
  id: ABILITY_WHITEOUT
  name: "白茫茫"
  description: "在冰雹中,自身最高的攻击能力提升至1.5倍."
  expanded_description: "白茫茫使该宝可梦在冰雹中时,其最高的攻击能力值提升50%.同时免疫冰雹伤害."
}
ability {
  id: ABILITY_PYROMANCY
  name: "火焰占卜"
  description: "招式的灼伤几率变为5倍."
  expanded_description: "火焰占卜将所有招式的灼伤几率乘以5倍.与火焰之躯特性不叠加."
}
ability {
  id: ABILITY_KEEN_EDGE
  name: "锋锐"
  description: "切割类招式威力×1.3。"
  expanded_description: "锐利刀刃使所有劈开类攻击的威力提升30%."
}
ability {
  id: ABILITY_PRISM_SCALES
  name: "棱镜鳞片"
  description: "受到的特殊攻击伤害降低30%."
  expanded_description: "棱镜鳞片使受到的所有特殊攻击伤害降低30%.与其他减伤来源乘法叠加."
}
ability {
  id: ABILITY_POWER_FISTS
  name: "铁拳之力"
  description: "拳类招式以目标特防计算伤害，威力×1.3。"
  expanded_description: "拳类招式获得30%的伤害加成,并且伤害计算时目标改为特防而非防御."
}
ability {
  id: ABILITY_SAND_SONG
  name: "沙之歌"
  description: "声音类招式获得1.2倍威力加成,若为一般属性则变为地面属性."
  expanded_description: "沙之歌使所有声音类招式的威力提升20%,并将一般属性的声音类招式转变为地面属性."
}
ability {
  id: ABILITY_RAMPAGE
  name: "暴走"
  description: "需要休息一回合的招式,在击倒对手后无需休息."
  expanded_description: "暴走特性在该宝可梦通过直接攻击成功击倒对手时,消除其需要休息的回合."
}
ability {
  id: ABILITY_VENGEANCE
  name: "复仇"
  description: "幽灵属性招式威力×1.2；HP低于1/3时改为×1.5。"
  expanded_description: "幽灵属性招式威力提升20%,当HP低于1/3时提升50%."
}
ability {
  id: ABILITY_BLITZ_BOXER
  name: "闪电拳手"
  description: "HP全满时，拳类招式优先度+1。"
  expanded_description: "闪电拳手在HP全满时,赋予所有拳类招式+1优先度."
}
ability {
  id: ABILITY_ANTARCTIC_BIRD
  name: "南极鸟"
  description: "冰属性和飞行属性招式威力提升至1.3倍."
  expanded_description: "南极鸟使冰属性和飞行属性招式的威力提升30%.与其他伤害加成效果加法叠加."
}
ability {
  id: ABILITY_IMMOLATE
  name: "献祭"
  description: "一般属性招式变为火属性.火属性招式得到强化."
  expanded_description: "将该宝可梦的一般属性招式变为火属性.如果该宝可梦是火属性,其火属性招式有10%的几率造成灼伤；否则,它获得火属性的本系加成."
}
ability {
  id: ABILITY_CRYSTALLIZE
  name: "结晶"
  description: "岩石属性招式变为冰属性,并获得1.1倍威力加成."
  expanded_description: "结晶将所有岩石属性招式转变为冰属性,并将其威力提升10%."
}
ability {
  id: ABILITY_ELECTROCYTES
  name: "电细胞"
  description: "电属性招式威力提升至1.25倍."
  expanded_description: "电细胞使电属性招式威力提升25%."
}
ability {
  id: ABILITY_AERODYNAMICS
  name: "空气动力学"
  description: "免疫飞行属性招式,并在受到攻击时提升速度."
  expanded_description: "当成为飞行属性招式的目标时,空气动力学吸收该攻击并使使用者的速度能力值提升1级."
}
ability {
  id: ABILITY_CHRISTMAS_SPIRIT
  name: "圣诞精神"
  description: "在冰雹中,受到的伤害降低50%."
  expanded_description: "圣诞精神在冰雹天气时使受到的所有伤害降低50%.免疫冰雹伤害.与其他减伤来源乘法叠加."
}
ability {
  id: ABILITY_EXPLOIT_WEAKNESS
  name: "弱点利用"
  description: "攻击处于异常状态的对手时,针对其较低的防御能力."
  expanded_description: "当攻击处于异常状态的对手时,攻击目标改为其较低的防御能力值."
}
ability {
  id: ABILITY_GROUND_SHOCK
  name: "大地冲击"
  description: "使地面属性的目标不再免疫电属性,而是变为抵抗."
  expanded_description: "大地冲击允许电属性招式命中地面属性宝可梦,造成0.5倍伤害."
}
ability {
  id: ABILITY_ANCIENT_IDOL
  name: "古代偶像"
  description: "攻击时,使用防御和特防代替攻击和特攻."
  expanded_description: "物理招式使用使用者的防御能力值而非攻击能力值进行伤害计算特殊招式则使用使用者的特防能力值而非特攻能力值."
}
ability {
  id: ABILITY_MYSTIC_POWER
  name: "神秘力量"
  description: "所有招式获得1.5倍的本系加成."
  expanded_description: "神秘力量使所有招式获得1.5倍的本系加成,无论属性是否匹配.不会增强已经获得本系加成的招式."
}
ability {
  id: ABILITY_PERFECTIONIST
  name: "完美主义者"
  description: "威力<51：暴击率+1。\n威力<26：再获先制+1。"
  expanded_description: "威力小于等于50的攻击招式,其击中要害率提升1级；威力小于等于25的招式,额外获得+1优先度."
}
ability {
  id: ABILITY_GROWING_TOOTH
  name: "不断生长的牙齿"
  description: "自身咬类招式命中时，攻击提升1级。"
  expanded_description: "不断生长的牙齿特性在该宝可梦成功使用啃咬类招式命中后,其攻击能力值提升1级."
}
ability {
  id: ABILITY_INFLATABLE
  name: "充气"
  description: "受到飞行或火属性招式攻击时,防御和特防各提升1级."
  expanded_description: "受到任何火属性或飞行属性招式攻击时,防御和特防能力值各提升1级.对于连续攻击招式,每次命中都会触发.能力提升效果在攻击命中后生效."
}
ability {
  id: ABILITY_AURORA_BOREALIS
  name: "北极光"
  description: "冰属性招式获得本系加成.招式总能享受到冰雹的增益."
  expanded_description: "北极光使所有冰属性招式获得本系加成,无论该宝可梦的属性如何.气象球变为冰属性且威力加倍,极光幕无需冰雹即可生效,基于天气的冰属性招式（如暴风雪）必定命中."
}
ability {
  id: ABILITY_AVENGER
  name: "复仇者"
  description: "上一回合有同伴宝可梦濒死,下次招式威力提升1.5倍."
  expanded_description: "复仇者特性在任何同伴宝可梦濒死后的一回合内,使所有招式的威力提升50%."
}
ability {
  id: ABILITY_LETS_ROLL
  name: "我们滚吧"
  description: "出场时使用变圆."
  expanded_description: "我们滚吧在进入战斗时自动将防御提升1级并附加变圆状态,使滚动等招式的威力加倍."
}
ability {
  id: ABILITY_AQUATIC
  name: "水生"
  description: "出场时添加水属性."
  expanded_description: "进入战斗时,为使用者的当前属性添加水属性即使失去此特性,添加的水属性在替换下场前依然保留."
}
ability {
  id: ABILITY_LOUD_BANG
  name: "巨响"
  description: "声音类招式有50%几率使对手混乱."
  expanded_description: "声音类攻击成功命中后,有50%的几率使目标陷入混乱状态."
}
ability {
  id: ABILITY_LEAD_COAT
  name: "铅衣"
  description: "受到的物理伤害减少40%，速度×0.9，体重变为3倍。"
  expanded_description: "铅衣使受到的物理伤害降低40%,但速度降低10%.同时使使用者的重量变为3倍.伤害减免与其他来源乘法叠加."
}
ability {
  id: ABILITY_AMPHIBIOUS
  name: "两栖"
  description: "水属性招式获得本系加成.不会被浸水."
  expanded_description: "使水属性招式获得本系加成,无论使用者的属性如何.同时免疫浸水状态."
}
ability {
  id: ABILITY_GROUNDED
  name: "接地"
  description: "出场时添加地面属性."
  expanded_description: "接地特性在出场时为该宝可梦添加地面属性.即使失去此特性,添加的地面属性在替换下场前依然保留."
}
ability {
  id: ABILITY_EARTHBOUND
  name: "大地束缚"
  description: "地面属性招式威力提升至1.2倍,HP低于1/3时提升至1.5倍."
  expanded_description: "地面属性招式威力提升20%,当HP低于1/3时提升50%."
}
ability {
  id: ABILITY_FIGHT_SPIRIT
  name: "斗争精神"
  description: "一般属性招式变为格斗属性.格斗属性招式得到强化."
  expanded_description: "将该宝可梦的一般属性招式变为格斗属性.如果该宝可梦是格斗属性,其格斗属性招式可以击破屏障；否则,它获得格斗属性的本系加成."
}
ability {
  id: ABILITY_FELINE_PROWESS
  name: "猫科本领"
  description: "自身的特攻能力加倍.提升最终能力值,而非基础能力值."
  expanded_description: "神秘力量使该宝可梦的特攻能力值变为2倍.与其他伤害加成效果乘法叠加."
}
ability {
  id: ABILITY_COIL_UP
  name: "盘卷"
  description: "每次上场使用的首个咬类招式优先度+1。"
  expanded_description: "出场时,赋予第一次使用的啃咬类招式+1优先度.在使用任何啃咬类招式命中后,该优先度加成即被消耗."
}
ability {
  id: ABILITY_FOSSILIZED
  name: "化石"
  description: "受到的岩石属性伤害减半.自身的岩石属性招式威力提升1.2倍."
  expanded_description: "化石使受到的岩石属性伤害降低50%,并提升使用者自身的岩石属性招式威力20%.伤害减免与其他来源乘法叠加,威力加成与其他来源加法叠加."
}
ability {
  id: ABILITY_MAGICAL_DUST
  name: "魔法粉"
  description: "使接触到的对手变为超能力属性.主动攻击时也生效."
  expanded_description: "如果该宝可梦与另一只宝可梦发生接触（无论是攻击方还是防御方）,对方的属性会变为纯超能力属性此效果在连续招式或优先度招式命中时立即发生,可以在对手的连续攻击过程中消除其本系加成."
}
ability {
  id: ABILITY_DREAMCATCHER
  name: "捕梦人"
  description: "如果对手处于睡眠状态,造成双倍伤害.追击睡眠中的对手."
  expanded_description: "当场上任何对手处于睡眠状态时,捕梦人使该宝可梦的招式威力加倍.这包括使用者、同伴或对手造成的睡眠.攻击会对正在替换下场的睡眠中对手造成1倍伤害,在其离开前造成伤害.对绝对睡眠特性无效."
}
ability {
  id: ABILITY_NOCTURNAL
  name: "夜行"
  description: "恶属性招式威力1.25倍。\n受恶、妖精伤害降低25%。"
  expanded_description: "恶属性招式获得25%威力提升,并且使用者受到的恶属性和妖精属性伤害降低25%.伤害减免与其他来源乘法叠加."
}
ability {
  id: ABILITY_SELF_SUFFICIENT
  name: "自给自足"
  description: "每回合结束时回复1/16的最大HP."
}
ability {
  id: ABILITY_TECTONIZE
  name: "构造"
  description: "一般属性招式变为地面属性；地面属性可无视部分场地陷阱。"
  expanded_description: "将该宝可梦的一般属性招式变为地面属性.如果该宝可梦是地面属性,它免疫隐形岩和撒菱；否则,它获得地面属性的本系加成."
}
ability {
  id: ABILITY_ICE_AGE
  name: "冰河时代"
  description: "出场时添加冰属性."
  expanded_description: "进入战斗时,为使用者的当前属性添加冰属性即使失去此特性,添加的冰属性在替换下场前依然保留."
}
ability {
  id: ABILITY_HALF_DRAKE
  name: "半龙"
  description: "出场时添加龙属性."
  expanded_description: "进入战斗时,为使用者的当前属性添加龙属性即使失去此特性,添加的龙属性在替换下场前依然保留."
}
ability {
  id: ABILITY_LIQUIFIED
  name: "液化"
  description: "受到的接触类招式伤害减半,但受到的水属性招式会造成2倍伤害."
  expanded_description: "液化使受到的接触类招式伤害降低50%,但受到的水属性招式伤害变为2倍.与其他减伤来源乘法叠加."
}
ability {
  id: ABILITY_DRAGONFLY
  name: "龙飞"
  description: "出场时添加龙属性.回避地面属性攻击."
  expanded_description: "进入战斗时,为使用者的当前属性添加龙属性即使失去此特性,添加的龙属性在替换下场前依然保留.同时使该宝可梦免疫地面属性攻击以及需要接地才能生效的场地效果."
}
ability {
  id: ABILITY_DRAGONSLAYER
  name: "屠龙者"
  description: "对龙属性目标造成的伤害×1.5；受到龙属性目标的伤害×0.5。"
  expanded_description: "对龙属性宝可梦造成1.5倍伤害,并且受到龙属性宝可梦攻击时,伤害减半.此效果基于攻击方/防御方宝可梦的属性,而非招式属性.伤害减免与其他来源乘法叠加."
}
ability {
  id: ABILITY_MOUNTAINEER
  name: "登山者"
