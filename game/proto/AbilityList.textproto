}
ability {
  id: ABILITY_MAJESTIC_MOTH
  name: "华贵之蛾"
  description: "出场时,自身最高的计算后能力值提升1级."
  expanded_description: "华贵之蛾在进入战斗时,使该宝可梦最高的计算后基础能力值提升1级."
}
ability {
