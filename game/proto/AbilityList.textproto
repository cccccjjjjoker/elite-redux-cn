  expanded_description: "上场时为此宝可\n梦追加虫属性。\n即使失去此特性\n也保留虫属性，\n仅在替换下场时消失。"
}

ability {
  id: ABILITY_THIRDDEGREEBURN
  name: "三度烧伤"
  description: "可使任何属性的目标灼伤；火属性招式无视特性。"
  expanded_description: "此宝可梦可以灼伤火属性宝可梦，\n无视灼伤免疫。\n火属性招式无视对手干扰\n效果或减伤的特性和天赋。"
}

ability {
  id: ABILITY_ENGULF
  name: "吞没"
  description: "50%几率束缚对手.之后无视防御和命中判定."
  expanded_description: "接触类招式有50%几率束缚目标（如捆绑）,防止其逃跑或替换.对抗被束缚的目标时,使用者的招式无视其防御能力变化并必定命中.被束缚的目标每回合损失1/8的最大HP.束缚持续4-5回合（携带紧绑钩爪时为7回合）."
}

ability {
  id: ABILITY_GRIMACE
  name: "狰狞面容"
  description: "上场时使用黑色目光。"
  expanded_description: "上场时自动对对手\n施加黑色目光。\n黑色目光使对手\n无法替换下场。"
}

ability {
  id: ABILITY_THERMALDWELLER
  name: "热域栖居"
  description: "耐热与献祭的效果。"
}

ability {
  id: ABILITY_LETHALTOUCH
  name: "致命之触"
  description: "毒锁链与锋利的边缘的效果。"
}

ability {
  id: ABILITY_FROSTY
  name: "冰寒"
  description: "冰属性招式威力×1.2；HP低于1/3时改为×1.5。"
  expanded_description: "冰属性招式的威力提升20%，\nHP低于1/3时提升50%。"
}

ability {
  id: ABILITY_POISON_UPSURGE
  name: "毒性涌动"
  description: "毒属性招式威力×1.2；HP低于1/3时改为×1.5。"
  expanded_description: "毒属性招式的威力提升20%，\nHP低于1/3时提升50%。"
}

ability {
  id: ABILITY_PACKEDICE
  name: "坚冰"
  description: "免疫冰属性招式，并大幅提升防御。"
  expanded_description: "受到冰属性招式攻击时，\n免疫冰属性招式并\n使防御提升2级。"
}

ability {
  id: ABILITY_BUSHRUSH
  name: "丛林突袭"
  description: "HP全满时，草属性招式优先度+1。"
  expanded_description: "HP全满时，\n草属性招式获得先制+1。"
}
ability {
  id: ABILITY_GUERILLA_FIGHTER
  name: "游击战士"
  description: "丛林突袭与斗争精神的效果。"
}
ability {
  id: ABILITY_SOUR_APPLE
  name: "酸苹果"
  description: "腐蚀与芳香幕的效果；自身悬浮。"
}
ability {
  id: ABILITY_SEARCHLIGHT
  name: "探照灯"
  description: "察觉与发光的效果。"
}

ability {
  id: ABILITY_LIGHT_WIELD
  name: "御光"
  description: "上场时设置持续3回合的光墙。"
}

ability {
  id: ABILITY_PHOTOKINESIS
  name: "光能操控"
  description: "光类招式威力×1.3。"
}

ability {
  id: ABILITY_PHOTON_BURST
  name: "光子爆发"
  description: "光类招式以目标防御计算伤害，威力×1.3。"
}

ability {
  id: ABILITY_RIPPLING_PUNCH
  name: "波动拳"
  description: "拳类招式同时视为声音类招式。"
}

ability {
  id: ABILITY_CACKLING
  name: "怪笑"
  description: "上场时使用诡笑；每场战斗最多触发两次。"
}

ability {
  id: ABILITY_FRESH_SNOWFALL
  name: "新雪"
  description: "受到特殊攻击时，使用威力30的细雪。"
}

ability {
  id: ABILITY_STICKY_SITUATION
  name: "黏滞困境"
  description: "虫属性招式降低目标速度。"
}

ability {
  id: ABILITY_BIOLUMINESCENT
  name: "生物荧光"
  description: "自身增加电属性，并具有发光的效果。"
}

ability {
  id: ABILITY_BLINKING_FLASH
  name: "闪烁光辉"
  description: "光类招式有10%概率降低目标命中率。"
}

ability {
  id: ABILITY_BRAIN_FREEZE
  name: "脑冻结"
  description: "超能力属性招式有30%概率造成冻伤。"
}

ability {
  id: ABILITY_BLUESCREEN
  name: "蓝屏"
  description: "脑冻结与除障的效果。"
}

ability {
  id: ABILITY_CHLOROPHYLLO
  name: "叶绿附生"
  description: "上场时增加草属性。"
  expanded_description: "上场时为此宝可梦追加草属性。即使失去此特性也保留草属性，仅在替换下场时消失。"
}

ability {
  id: ABILITY_CHARGE_SPORES
  name: "充能孢子"
  description: "闪电之躯与孢子的效果。"
}

ability {
  id: ABILITY_STATIC_BLOOM
  name: "静电绽放"
  description: "电气场地中，电属性招式威力提升50%。"
  expanded_description: "电气场地激活时，\n电属性招式威力提升50%。"
}

ability {
  id: ABILITY_DAZZLING_WINGS
  name: "炫目之翼"
  description: "鲜艳之躯与巨翼的效果。"
}

ability {
  id: ABILITY_FEARLESS
  name: "无畏"
  description: "免疫恐惧与威吓。"
}

ability {
  id: ABILITY_GNAWING_AWAY
  name: "啃噬"
  description: "咬类招式有50%概率降低目标防御。"
}

ability {
  id: ABILITY_VERSATILE
  name: "多才多艺"
  description: "使用招式前变为该招式的属性。"
}

ability {
  id: ABILITY_POWER_SHOES
  name: "力量鞋"
  description: "踢类招式以目标特防计算伤害，威力×1.3。"
}

ability {
  id: ABILITY_CLEANSE
  name: "净化"
  description: "上场时使用治愈铃声；每场战斗限两次。"
}

ability {
  id: ABILITY_SHARPSHOOTER
  name: "神射手"
  description: "狙击手与超级发射器的效果。"
}

ability {
  id: ABILITY_HIGH_RISE
  name: "高楼"
  description: "钢能力者与镜甲的效果。"
}

ability {
  id: ABILITY_EARTH_WIRE
  name: "接地线"
  description: "电属性招式对地面属性效果绝佳。"
  expanded_description: "自身电属性招式对地面属性宝可梦\n造成效果绝佳的伤害，而非无效。"
}

ability {
  id: ABILITY_UNERRING
  name: "精准无误"
  description: "变化招式必定命中。"
  expanded_description: "自身变化招式必定命中，\n无论命中与闪避等级如何。"
}

ability {
  id: ABILITY_TIDAL_FORCE
  name: "潮汐力"
  description: "水属性招式伤害翻倍。"
  expanded_description: "自身水属性招式的伤害翻倍。"
}

ability {
  id: ABILITY_FIGHT_CLUB
  name: "格斗俱乐部"
  description: "格斗属性招式伤害翻倍。"
  expanded_description: "自身格斗属性招式的伤害翻倍。"
}

ability {
  id: ABILITY_MARTIAL_ARTS
  name: "武术"
  description: "拳击与踢击招式伤害1.5倍。"
  expanded_description: "拳击与踢击招式伤害提升50%，\n与铁拳、踢击效果叠加。"
}

ability {
  id: ABILITY_BONE_MASTER
  name: "骨骼大师"
  description: "自身所有招式都视为骨系招式。"
  expanded_description: "自身使用的所有招式都视为骨系招式，\n因此骨之领域等特性对全部招式生效。"
}

ability {
  id: ABILITY_EXECUTIONER
  name: "刽子手"
  description: "暴击可直接击倒目标。"
  expanded_description: "自身击中要害时，\n造成等于目标剩余HP的伤害。\n结实、气势披带与挺住仍可撑住。"
}

ability {
  id: ABILITY_PERFECT_PITCH
  name: "绝对音感"
  description: "音波招式必定击中要害。"
  expanded_description: "自身所有音波招式必定击中要害，\n除非目标免疫要害\n(战斗盔甲、贝壳盔甲等)。"
}
