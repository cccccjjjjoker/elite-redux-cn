  description: "在雾中,每回合回复1/8的最大HP."
  expanded_description: "在迷雾中时,每回合结束时回复使用者最大HP的1/8."
}
ability {
  id: ABILITY_WHITE_NOISE
  name: "白噪音"
  description: "静电 + 安息."
