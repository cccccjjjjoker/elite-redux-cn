  expanded_description: "画皮会抵挡第一个命中该宝可梦的造成伤害的招式,之后改变形态.仅能抵挡非变化招式.在雾中,每次替换上场或当雾重新出现时,画皮会立即恢复."
}
ability {
  id: ABILITY_BATTLE_BOND
  name: "牵绊变身"
  description: "击倒对手后,变身为牵绊形态."
  expanded_description: "当该宝可梦给予对手最后一击使其濒死时,立即触发形态变化.无法被复制."
}
ability {
  id: ABILITY_POWER_CONSTRUCT
  name: "群聚变形"
  description: "当HP降至1/2或以下时,变身为完全体形态."
  expanded_description: "群聚变形会在任何回合结束时,如果基格尔德50%或10%形态的HP降至50%或以下,则使其变身为完全体形态.完全体形态拥有高达216的HP（从108翻倍）,使其成为极其耐打的坦克.此形态变化在战斗中永久持续,且无法被压制."
}
ability {
  id: ABILITY_CORROSION
