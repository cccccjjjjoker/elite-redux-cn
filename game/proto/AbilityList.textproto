}
ability {
  id: ABILITY_HYDRATE
  name: "水合"
  description: "一般属性招式变为水属性.水属性招式得到强化."
  expanded_description: "将该宝可梦的一般属性招式变为水属性.如果该宝可梦是水属性,其水属性招式有10%的几率造成浸水；否则,它获得水属性的本系加成."
}
ability {
  id: ABILITY_METALLIC
  name: "金属化"
  description: "出场时添加钢属性."
  expanded_description: "进入战斗时,为使用者的当前属性添加钢属性即使失去此特性,添加的钢属性在替换下场前依然保留."
}
ability {
  id: ABILITY_PERMAFROST
  name: "永冻土"
  description: "受到效果绝佳的招式攻击时,伤害降低35%."
  expanded_description: "受到效果绝佳的招式攻击时,伤害降低35%.与其他减伤效果乘法叠加."
}
ability {
  id: ABILITY_PRIMAL_ARMOR
  name: "原始铠甲"
  description: "受到效果绝佳的招式攻击时,伤害降低50%."
  expanded_description: "受到效果绝佳的招式攻击时,伤害降低50%.与其他减伤效果乘法叠加."
}
ability {
  id: ABILITY_RAGING_BOXER
  name: "狂暴拳手"
  description: "拳类招式攻击两次.第一击威力100%,第二击威力40%."
  expanded_description: "狂暴拳手使拳类招式连续命中两次,第一击造成100%伤害,第二击造成40%伤害.两次攻击独立判定追加效果（畏缩除外）."
}
ability {
  id: ABILITY_AIR_BLOWER
  name: "吹气筒"
