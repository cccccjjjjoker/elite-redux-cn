}
ability {
  id: ABILITY_PRIMORDIAL_SEA
  name: "始源之海"
  description: "制造终焉大雨,持续到下场.火属性招式无法使用."
  expanded_description: "创造终焉大雨,持续到使用者下场.完全无效所有造成伤害的火属性招式.水属性招式获得50%威力提升除其他原始天气外,无法被覆盖.激活与雨天相关招式的额外效果使与大晴天相关的招式效果减半."
}
ability {
  id: ABILITY_DESOLATE_LAND
  name: "终结之地"
  description: "制造终焉大晴天,持续到下场.水属性招式无法使用."
  expanded_description: "创造终焉大晴天,持续到使用者下场.完全无效所有造成伤害的水属性招式.火属性招式获得50%威力提升除其他原始天气外,无法被覆盖.激活与大晴天相关招式的额外效果."
}
ability {
  id: ABILITY_DELTA_STREAM
  name: "德尔塔气流"
  description: "制造强风,持续到下场.基于天气的招式无法使用."
  expanded_description: "创造强风,持续到使用者下场.将场上所有飞行属性宝可梦受到的效果绝佳伤害变为普通伤害.阻止所有基于天气的招式命中对手.除其他原始天气外,无法被覆盖."
}
ability {
