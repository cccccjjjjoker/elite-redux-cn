  expanded_description: "毒属性招式对钢属性宝可梦变得效果绝佳.此外,该宝可梦可以使任何属性的宝可梦陷入中毒状态."
}
ability {
  id: ABILITY_COMATOSE
  name: "绝对睡眠"
  description: "可以行动,但始终处于睡眠状态.免疫异常状态."
  expanded_description: "绝对睡眠特性使该宝可梦在招式和状态判定中被视为处于睡眠状态.该宝可梦可以正常行动,并且免疫所有异常状态.此特性无法被复制或压制.使用招式睡觉会失败."
}
ability {
  id: ABILITY_QUEENLY_MAJESTY
  name: "女王威严"
  description: "保护自身及同伴免受先制招式影响."
  expanded_description: "女王威严防止该宝可梦及其同伴成为优先度大于0的先制招式的目标."
}
ability {
  id: ABILITY_INNARDS_OUT
  name: "甩不掉的"
