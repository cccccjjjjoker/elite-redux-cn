  expanded_description: "埋伏特性在使用者替换上场后或战斗开始的第一回合,必定造成击中要害."
}
ability {
  id: ABILITY_ATLAS
  name: "阿特拉斯"
  description: "出场时设置重力,持续8回合."
  expanded_description: "阿特拉斯在进入战斗时设置重力,持续8回合.重力防止飞翔等飘浮招式,使所有宝可梦接地从而易受地面属性招式、沙穴和场地状态影响使重力苹果的伤害提升50%,并使招式命中率提升66%."
}
ability {
  id: ABILITY_RADIANCE
  name: "光辉"
  description: "命中率×1.2；在场时，恶属性招式使用失败。"
