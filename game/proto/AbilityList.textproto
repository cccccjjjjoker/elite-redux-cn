ability {
  id: ABILITY_ASSASSINS_TOOLS
  name: "刺客工具"
  description: "接触类招式有30%几率造成中毒、麻痹或流血."
  expanded_description: "当使用者使用接触类招式命中时,有30%的几率随机使目标陷入中毒、麻痹或流血状态.连续攻击的每一击都会独立判定."
}
ability {
  id: ABILITY_FROSTMAW
  name: "霜冻之颚"
  description: "啃咬类招式有50%几率造成冻伤."
  expanded_description: "啃咬类招式在命中时有50%的几率使目标灼伤.连续攻击的每一击都会独立判定."
}
ability {
  id: ABILITY_PATCHWORK
  name: "拼凑"
  description: "画皮 + 画皮被打破时诅咒对手."
