  description: "攻击者受到对自身造成的所有伤害,自身攻击时也受影响."
  expanded_description: "当使用者受到直接攻击时,对手受到等量伤害.当使用者造成直接攻击伤害时,自身也受到等量伤害.当任意一方濒死、通过痛平分受到伤害或对另一个拥有灵魂链接特性的宝可梦时,此特性不会触发."
}
ability {
  id: ABILITY_SWEET_DREAMS
  name: "美梦"
  description: "处于睡眠状态时,每回合回复1/8的最大HP.免疫梦魇."
  expanded_description: "美梦特性在使用者处于睡眠状态或拥有绝对睡眠特性时,每回合结束时回复1/8的最大HP.此外,它免疫梦魇特性的伤害."
}
ability {
  id: ABILITY_BAD_LUCK
  name: "厄运"
  description: "对手无法会心一击,命中率降低5%,且无法触发追加效果."
  expanded_description: "对手无法造成击中要害,总是造成最低伤害（85%而非85-100%）,无法触发非必定触发的追加效果,并且有5%的几率招式落空."
}
ability {
  id: ABILITY_HAUNTED_SPIRIT
  name: "作祟的魂魄"
  description: "当该宝可梦被击倒时,对攻击者施加诅咒."
  expanded_description: "当被直接攻击击倒时,对攻击者施加诅咒.诅咒每回合造成其最大HP25%的伤害,直到被诅咒的宝可梦替换下场或濒死.幽灵属性的攻击者免疫此诅咒."
}
ability {
  id: ABILITY_ELECTRIC_BURST
  name: "电爆"
  description: "电属性招式造成1.35倍伤害,但有10%的反伤."
  expanded_description: "电爆使电属性招式威力提升35%,但会造成基于伤害值10%的反伤（最少1点HP）.反伤不会导致使用者濒死."
}
ability {
  id: ABILITY_RAW_WOOD
  name: "原木"
  description: "受到的草属性伤害减半.自身的草属性招式威力提升1.2倍."
  expanded_description: "受到的草属性攻击伤害降低50%,同时使用者自身的草属性招式威力提升20%.伤害减免与其他来源乘法叠加."
}
ability {
  id: ABILITY_SOLENOGLYPHS
  name: "毒牙"
