}
ability {
  id: ABILITY_FATAL_PRECISION
  name: "致命精准"
  description: "效果绝佳的招式必定命中且必定会心一击."
  expanded_description: "效果绝佳的攻击招式必定命中,并且必定造成击中要害."
}
ability {
  id: ABILITY_FORT_KNOX
  name: "坚壁"
  description: "阻挡大多数伤害增益和连续攻击特性."
  expanded_description: "免疫对手所有提升伤害的特性效果,亲子爱和多头龙特性除外."
}
ability {
  id: ABILITY_SEAWEED
  name: "海草"
  description: "草属性时受火伤害减半。\n草属性对火造成2倍伤害。"
  expanded_description: "如果使用者是草属性,其受到的火属性攻击伤害减半,并且使用草属性招式对火属性宝可梦造成2倍伤害.伤害减免与其他来源乘法叠加."
}
ability {
  id: ABILITY_PSYCHIC_MIND
  name: "超能之心"
  description: "超能力属性招式威力提升至1.2倍,HP低于1/3时提升至1.5倍."
  expanded_description: "超能力属性招式威力提升20%,当HP低于1/3时提升50%."
}
ability {
  id: ABILITY_POISON_ABSORB
  name: "毒吸收"
  description: "引导并吸收毒属性招式；在剧毒场地中回复HP。"
  expanded_description: "该宝可梦会吸引毒属性招式,并对其免疫,转而回复最大HP的1/4.此外,在剧毒地形上,每回合回复1/8的最大HP."
}
ability {
  id: ABILITY_SCAVENGER
  name: "拾荒者"
  description: "击倒对手时,回复该宝可梦1/4的最大HP."
  expanded_description: "当该宝可梦通过直接攻击击败对手时,立即恢复其最大HP的25%."
}
ability {
  id: ABILITY_TWISTED_DIMENSION
  name: "扭曲空间"
  description: "出场时设置戏法空间,持续3回合."
}
ability {
  id: ABILITY_MULTI_HEADED
  name: "多头龙"
  description: "根据拥有的头数进行多次攻击."
  expanded_description: "根据头数,每次攻击2-3次.双头宝可梦攻击两次（第一击100%,第二击25%）,三头宝可梦攻击三次（第一击100%,第二击20%,第三击15%）.每次攻击独立判定追加效果（畏缩除外）.可穿透坚壁/奇迹皮肤."
}
ability {
  id: ABILITY_NORTH_WIND
  name: "北风"
  description: "出场时设置3回合的极光幕.免疫冰雹伤害."
  expanded_description: "进入战斗时设置极光幕,使己方全队受到的物理和特殊伤害减半.极光幕持续3回合,携带光之黏土时为5回合.使用者同时免疫冰雹伤害.如果极光幕已激活,则无法再次触发."
}
ability {
  id: ABILITY_OVERCHARGE
  name: "过载"
  description: "电属性招式对电属性效果绝佳.可以使电属性宝可梦麻痹."
  expanded_description: "使用者的电属性招式对电属性宝可梦变得有效,造成2倍伤害而非0.5倍.同时允许使用者使电属性宝可梦陷入麻痹状态."
}
ability {
  id: ABILITY_VIOLENT_RUSH
  name: "狂暴突袭"
  description: "上场的第一回合,速度提升50%,攻击提升20%."
  expanded_description: "使用者替换上场后的第一回合,获得50%的速度加成和20%的攻击加成."
}
ability {
  id: ABILITY_FLAMING_SOUL
  name: "烈焰之魂"
  description: "HP全满时，火属性招式优先度+1。"
  expanded_description: "当HP全满时,赋予火属性招式+1优先度."
}
ability {
  id: ABILITY_SAGE_POWER
  name: "贤者之力"
  description: "特攻提升50%,但锁定招式."
  expanded_description: "特攻能力值提升50%,但会将使用者锁定在首次选择的招式上,直到替换下场."
}
ability {
  id: ABILITY_BONE_ZONE
  name: "骨区"
  description: "骨类招式无视免疫,且对效果不好的目标造成2倍伤害."
  expanded_description: "骨类招式可以穿透免疫造成正常伤害,而对被抵抗的目标则造成2倍伤害.普通/效果绝佳的伤害保持不变."
}
ability {
  id: ABILITY_WEATHER_CONTROL
  name: "天气控制"
  description: "免疫所有与天气相关的招式。"
  expanded_description: "免疫基于天气的招式：打雷、日光束/刃、暴风、暴风雪、银色旋风、气象球、所有风暴类招式（不包括岩浆风暴、飞叶风暴或钻石风暴）、绝对零度和誓约招式.不阻止天气的设置或其伤害."
}
ability {
  id: ABILITY_SPEED_FORCE
  name: "速度之力"
  description: "物理招式额外\n使用20%速度能力。"
  expanded_description: "使用接触类招式时,将使用者20%的速度能力值加入伤害计算.讲究围巾的效果不影响此特性."
}
ability {
  id: ABILITY_SEA_GUARDIAN
  name: "海洋守护者"
  description: "雨天下上场时，最高的一项能力提升1级。"
  expanded_description: "在雨天天气下进入战斗时,海洋守护者使你最高的能力值提升1级.适用于任何形式的雨天.每次替换上场触发一次."
}
ability {
  id: ABILITY_MOLTEN_DOWN
  name: "熔解"
  description: "火属性招式对岩石属性效果绝佳."
  expanded_description: "熔解使火属性招式对岩石属性宝可梦变得效果绝佳,而非被抵抗."
}
ability {
  id: ABILITY_HYPER_AGGRESSIVE
  name: "极度好战"
  description: "招式攻击两次.第二击造成25%伤害."
  expanded_description: "使所有攻击连续命中两次.第一击造成100%伤害,第二击造成25%伤害.每次攻击独立判定追加效果（畏缩除外）."
}
ability {
  id: ABILITY_FLOCK
  name: "鸟群"
  description: "飞行属性招式威力×1.2；HP低于1/3时改为×1.5。"
  expanded_description: "飞行属性招式威力提升20%,当HP低于1/3时提升50%."
}
ability {
  id: ABILITY_FIELD_EXPLORER
  name: "旷野探险家"
  description: "野外场地招式威力提升50%.如居合劈、冲浪、怪力等."
  expanded_description: "将在野外可以使用的招式威力提升50%.包括所有秘传技招式、（意念头锤/）头锤、冰旋、觉醒力量/自然之力和挖洞."
}
ability {
  id: ABILITY_STRIKER
  name: "前锋"
  description: "踢腿类招式的威力提升至1.3倍."
  expanded_description: "前锋使所有踢腿类招式的威力提升30%.包括火焰球."
}
ability {
  id: ABILITY_FROZEN_SOUL
  name: "冰霜之魂"
  description: "HP全满时，冰属性招式优先度+1。"
  expanded_description: "冰霜之魂在使用者HP全满时,赋予所有冰属性招式+1优先度."
}
ability {
  id: ABILITY_PREDATOR
  name: "掠食者"
  description: "击倒对手时,回复该宝可梦1/4的最大HP."
  expanded_description: "当使用者通过直接攻击击倒对手时,立即恢复其最大HP的25%."
}
ability {
  id: ABILITY_LOOTER
  name: "掠夺者"
  description: "击倒对手时,回复该宝可梦1/4的最大HP."
  expanded_description: "当使用者通过直接攻击击倒对手时,立即恢复其最大HP的25%."
}
ability {
  id: ABILITY_LUNAR_ECLIPSE
  name: "月食"
  description: "妖精和恶属性招式获得本系加成.催眠术命中率提升至1.5倍."
  expanded_description: "月食使妖精属性和恶属性招式获得本系加成,无论使用者的属性如何.将催眠术的命中率提升至90%."
}
ability {
  id: ABILITY_SOLAR_FLARE
  name: "太阳耀斑"
  description: "叶绿体 + 献祭."
  expanded_description: "将一般属性招式转变为火属性并获得火属性本系加成.如果使用者是火属性,其火属性招式有10%的几率造成灼伤.此外,为使用者的招式激活所有与大晴天相关的效果."
}
ability {
  id: ABILITY_POWER_CORE
  name: "动力核心"
  description: "该宝可梦在使用招式时,额外使用20%的防御或特防."
  expanded_description: "计算伤害时,物理攻击额外增加20%的防御能力值,特殊攻击额外增加20%的特防能力值."
}
ability {
  id: ABILITY_SIGHTING_SYSTEM
  name: "瞄准系统"
  description: "招式必定命中.基础命中率低于80%的招式优先度降低."
  expanded_description: "瞄准系统确保所有招式无视命中判定,必定命中.基础命中率低于80%的招式获得-3优先度."
}
ability {
  id: ABILITY_BAD_COMPANY
  name: "坏伙伴"
  description: "目前未实装.无效果."
  expanded_description: "未实装."
}
ability {
  id: ABILITY_OPPORTUNIST
  name: "机会主义者"
  description: "对HP低于1/2的对手获得+1优先度."
  expanded_description: "当目标对手的HP为50%或以下时,赋予所有招式+1优先度."
}
ability {
  id: ABILITY_GIANT_WINGS
  name: "巨翼"
  description: "翅膀、风或空气类招式威力提升至1.3倍."
  expanded_description: "巨翼使所有翅膀、风和空气类招式的威力提升30%."
}
ability {
  id: ABILITY_MOMENTUM
  name: "动量"
  description: "物理招式用速度计算伤害。"
  expanded_description: "接触类招式使用速度能力值而非攻击/特攻进行伤害计算.讲究围巾的效果不影响此特性."
}
ability {
  id: ABILITY_GRIP_PINCER
  name: "钳制"
  description: "50%几率束缚对手.之后无视防御和命中判定."
  expanded_description: "接触类招式有50%几率束缚目标（如捆绑）,防止其逃跑或替换.对抗被束缚的目标时,使用者的招式无视其防御能力变化并必定命中.被束缚的目标每回合损失1/8的最大HP.束缚持续4-5回合（携带紧绑钩爪时为7回合）."
}
ability {
  id: ABILITY_BIG_LEAVES
  name: "大叶子"
  description: "叶绿体 + 叶绿素 + 叶子防守 + 收获 + 太阳之力."
  expanded_description: "为使用者的招式激活所有与大晴天相关的效果.在大晴天下速度提升50%.在大晴天下治愈异常状态.每回合结束时有50%几率回收树果,大晴天下为100%.在大晴天下,自身最高的攻击能力值提升50%."
}
ability {
  id: ABILITY_PRECISE_FIST
  name: "精密之拳"
  description: "拳类招式+1击中要害率,且追加效果几率变为5倍."
  expanded_description: "拳类招式获得+1击中要害率,并且其原本的追加效果触发几率变为5倍."
}
ability {
  id: ABILITY_DEADEYE
  name: "神枪手"
  description: "箭矢和炮类招式必定命中.会心一击攻击最弱的防御."
  expanded_description: "使用者不会打空箭矢类攻击和炮类招式（与超级发射器招式不同,包括被防弹阻挡的招式）.此外,当造成击中要害时,攻击目标改为对手较弱的防御能力值."
}
ability {
  id: ABILITY_ARTILLERY
  name: "炮术"
  description: "超级发射器类招式必定命中,且同时攻击双方."
  expanded_description: "超级发射器类招式必定命中,并同时攻击双方对手.所有脉冲、波导、波动、光环及其他爆裂相关招式不会打空."
}
ability {
  id: ABILITY_AMPLIFIER
  name: "扩音器"
  description: "声音类招式威力提升30%,并同时攻击双方."
  expanded_description: "扩音器使声音类招式威力提升30%.单体目标的声音类招式变为范围攻击,同时攻击双方对手.连续攻击招式不会变为范围攻击."
}
ability {
  id: ABILITY_ICE_DEW
  name: "冰露"
  description: "吸引冰属性招式.吸收后提升自身最高的攻击能力."
  expanded_description: "将所有冰属性招式吸引到该宝可梦身上并吸收.吸收冰属性招式时,提升攻击或特攻中较高的一项1级."
}
ability {
  id: ABILITY_SUN_WORSHIP
  name: "太阳崇拜"
  description: "晴天下上场时，最高的一项能力提升1级。"
  expanded_description: "在大晴天天气下进入战斗时,使使用者最高的能力值提升1级."
}
ability {
  id: ABILITY_POLLINATE
  name: "授粉"
  description: "一般属性招式变为虫属性；自身为虫属性时免疫粉末类招式。"
  expanded_description: "将该宝可梦的一般属性招式变为虫属性.如果该宝可梦是虫属性,它免疫粉末类招式；否则,它获得虫属性的本系加成."
}
ability {
  id: ABILITY_VOLCANO_RAGE
  name: "火山之怒"
  description: "使用火属性招式后,触发威力50的喷火."
  expanded_description: "使用任何火属性招式后,火山之怒会触发一次后续的喷火攻击,基础威力为50.伤害根据使用者当前的HP比例变化,满HP时威力为50."
}
ability {
  id: ABILITY_COLD_REBOUND
  name: "冰冷反击"
  description: "受到接触招式攻击时,以冰息进行反击."
  expanded_description: "受到任何接触招式攻击时,冰冷反击会以冰息（60威力）进行反击,并降低攻击者的速度1级."
}
ability {
  id: ABILITY_LOW_BLOW
  name: "下流打击"
  description: "出场时,使用威力40的暗算."
  expanded_description: "下流打击在替换上场时,使用威力40的暗算攻击随机一名对手.暗算是恶属性物理攻击,必定命中."
}
ability {
  id: ABILITY_NOSFERATU
  name: "诺斯费拉图"
  description: "接触类招式造成+20%伤害,并回复伤害量的一半HP."
  expanded_description: "造成接触的招式额外造成20%的伤害,并使使用者回复伤害量的一半HP.此回复在连续攻击的所有命中之后以及反伤结算之后生效."
}
ability {
  id: ABILITY_SPECTRAL_SHROUD
  name: "幽灵魂"
  description: "幽灵魂化的效果；招式有30%概率使对手陷入剧毒。"
  expanded_description: "将使用者的一般属性招式变为幽灵属性.如果使用者是幽灵属性,其幽灵属性招式有10%的几率造成恐惧；否则,它获得幽灵属性的本系加成.其所有招式（包括变化招式）有30%的几率使目标陷入剧毒."
}
ability {
  id: ABILITY_DISCIPLINE
  name: "自律"
  description: "可以在暴走时替换下场.不会混乱或被威吓."
  expanded_description: "使用狂暴招式（如逆鳞、暴怒）期间\n可替换下场。免疫混乱、\n威吓与惊吓。获得此特性时\n立即解除混乱。"
}
ability {
  id: ABILITY_THUNDERCALL
  name: "雷召"
  description: "使用电属性招式时,以20%的威力触发天谴."
  expanded_description: "使用任何电属性招式后,雷召会自动触发一次后续的天谴攻击,威力为20%（基础威力24）这个物理电属性攻击命中率为80%,有20%的几率使目标麻痹,并施加击落效果使飞行属性宝可梦接地."
}
ability {
  id: ABILITY_MARINE_APEX
  name: "海洋霸主"
  description: "对水属性宝可梦造成50%额外伤害 + 穿透特性."
  expanded_description: "对水属性宝可梦造成1.5倍伤害,并穿透防御屏障（光墙、反射壁、极光幕）/替身."
}
ability {
  id: ABILITY_MIGHTY_HORN
  name: "强大之角"
  description: "角类和钻类招式威力提升至1.3倍."
  expanded_description: "强大之角使角类和钻类攻击的威力提升30%."
}
ability {
  id: ABILITY_HARDENED_SHEATH
  name: "硬化鞘"
  description: "自身角类招式命中时，攻击提升1级。"
  expanded_description: "每次成功的角类攻击命中后,使用者的攻击能力值提升1级."
}
ability {
  id: ABILITY_ARCTIC_FUR
  name: "极地毛发"
  description: "受到的物理和特殊招式伤害减弱35%."
  expanded_description: "使受到的物理和特殊伤害降低35%.与其他减伤来源乘法叠加."
}
ability {
  id: ABILITY_SPECTRALIZE
  name: "幽灵魂化"
  description: "一般属性招式变为幽灵属性.幽灵属性招式得到强化."
  expanded_description: "将使用者的一般属性招式变为幽灵属性.如果使用者是幽灵属性,其幽灵属性招式有10%的几率造成恐惧；否则,它获得幽灵属性的本系加成."
}
ability {
  id: ABILITY_LETHARGY
  name: "昏昏欲睡"
  description: "每回合伤害降低20%,最多降至20%.替换上场时重置."
  expanded_description: "每回合开始时,使用者的总伤害降低20%,最多降低80%.替换后重置."
}
ability {
  id: ABILITY_IRON_BARRAGE
  name: "钢铁弹幕"
  description: "超级发射器 + 瞄准系统."
  expanded_description: "使脉冲、波导、波动和光环类招式威力提升30%.确保所有招式无视命中判定,必定命中.基础命中率低于80%的招式获得-3优先度."
}
ability {
  id: ABILITY_STEEL_BARREL
  name: "钢桶"
  description: "免疫反伤伤害,但不免疫大爆炸/撞击伤害."
  expanded_description: "防止所有来自自身招式或特性的反伤伤害.同时免疫因愤怒产生的反伤伤害无法防止撞击伤害或大爆炸/自爆的伤害."
}
ability {
  id: ABILITY_PYRO_SHELLS
  name: "火焰弹"
  description: "使用超级发射器增幅的招式后，追加威力50的大爆炸或蒸汽爆发。"
  expanded_description: "火焰弹在任何超级发射器强化的招式后触发一个威力50的一般属性迸裂拳.迸裂拳没有追加效果,且攻击场上所有周围的宝可梦."
}
ability {
  id: ABILITY_FUNGAL_INFECTION
  name: "真菌感染"
  description: "接触类招式对目标施加寄生种子."
  expanded_description: "使用接触类招式时,对目标施加寄生种子,每回合结束时吸取目标1/8的最大HP."
}
ability {
  id: ABILITY_PARRY
  name: "招架"
  description: "受接触攻击时反击音速拳。\n受到的伤害减少20%。"
  expanded_description: "所有受到的伤害降低20%.与其他减伤来源乘法叠加.以威力20的音速拳反击接触类招式."
}
ability {
  id: ABILITY_SCRAPYARD
  name: "废料场"
  description: "受到接触类招式攻击时，撒下一层撒菱。"
  expanded_description: "当使用者成功被接触招式命中时,在对手场上设置一层撒菱.每层使替换上场的接地宝可梦分别损失最大HP的12.5%、16.7%或25%（对应1-3层）连续攻击招式的每一次命中都会设置一层."
}
ability {
  id: ABILITY_LOOSE_QUILLS
  name: "松散尖刺"
  description: "受到接触类招式攻击时，撒下一层撒菱。"
  expanded_description: "当使用者成功被接触招式命中时,在对手场上设置一层撒菱.每层使替换上场的接地宝可梦分别损失最大HP的12.5%、16.7%或25%（对应1-3层）连续攻击招式的每一次命中都会设置一层."
}
ability {
  id: ABILITY_TOXIC_DEBRIS
  name: "毒棘"
  description: "受到接触类招式攻击时，撒下一层毒菱。"
  expanded_description: "毒棘特性在受到接触招式攻击时,自动在对手场上设置一层毒菱.每层会使替换上场的接地宝可梦中毒：一层为普通中毒,两层为剧毒.连续攻击招式的每一次命中都会设置一层."
}
ability {
  id: ABILITY_ROUNDHOUSE
  name: "回旋踢"
  description: "踢腿招式必定命中.攻击对手较弱的防御."
  expanded_description: "回旋踢使所有踢腿类招式必定命中,并且攻击目标改为对手较弱的防御能力值."
}
ability {
  id: ABILITY_MINERALIZE
  name: "矿化"
  description: "一般属性招式变为岩石属性.岩石属性招式得到强化."
  expanded_description: "将使用者的一般属性招式变为岩石属性.如果使用者是岩石属性,其岩石属性招式有10%的几率造成流血；否则,它获得岩石属性的本系加成."
}
ability {
  id: ABILITY_LOOSE_ROCKS
  name: "松散岩石"
  description: "受到接触类招式攻击时，布下隐形岩。"
  expanded_description: "当使用者受到任何接触招式攻击时,在对手场上设置隐形岩.隐形岩在对手替换上场时造成其最大HP1/8的伤害.视为岩石属性伤害,受属性相性影响."
}
ability {
  id: ABILITY_SPINNING_TOP
  name: "旋转陀螺"
  description: "使用格斗属性招式时,速度提升1级并清除场地状态."
  expanded_description: "旋转陀螺在使用格斗属性招式时,使使用者速度提升1级,并移除己方场上的所有入场陷阱."
}
ability {
  id: ABILITY_RETRIBUTION_BLOW
  name: "报应打击"
  description: "如果有对手使用能力提升招式,则使用破坏光线."
  expanded_description: "自动对提升能力的对手使用威力150的破坏光线.触发的破坏光线没有休息回合,允许下回合正常行动."
}
ability {
  id: ABILITY_FEARMONGER
  name: "恐惧散布者"
  description: "威吓 + 惊吓 + 接触类招式有10%几率造成恐惧."
  expanded_description: "恐惧散布者在出场时降低所有对手宝可梦的攻击和特攻1级.此外,使用接触类招式命中时,有10%的几率造成恐惧."
}
ability {
  id: ABILITY_KINGS_WRATH
  name: "王之怒"
  description: "己方场上任何能力被降低时,提升攻击和防御."
  expanded_description: "王之怒在使用者或其同伴的能力被降低时触发,立即提升使用者的攻击和防御1级.不会因自身引起的能力降低而激活."
}
ability {
  id: ABILITY_QUEENS_MOURNING
  name: "后之哀"
  description: "己方场上任何能力被降低时,提升特攻和特防."
  expanded_description: "后之哀在使用者或其同伴的能力被降低时触发,立即提升使用者的特攻和特防1级.不会因自身引起的能力降低而激活."
}
ability {
  id: ABILITY_TOXIC_SPILL
  name: "毒溢"
  description: "在场时,非毒属性宝可梦每回合损失1/8的HP."
  expanded_description: "毒溢特性每回合伤害所有非毒属性宝可梦,造成其1/8的HP损失.拥有毒疗特性的宝可梦反而会回复.使用者下场时效果消失."
}
ability {
  id: ABILITY_DESERT_CLOAK
  name: "沙漠披风"
  description: "在沙暴中,保护己方不受异常状态和追加效果影响."
  expanded_description: "在沙暴生效时,所有同伴免疫异常状态和来自敌人的招式追加效果."
}
ability {
  id: ABILITY_DRACONIZE
  name: "龙化"
  description: "一般属性招式变为龙属性.龙属性招式得到强化."
  expanded_description: "将使用者的一般属性招式变为龙属性.如果使用者是龙属性,其龙属性招式对妖精属性造成普通伤害；否则,它获得龙属性的本系加成."
}
ability {
  id: ABILITY_PRETTY_PRINCESS
  name: "漂亮公主"
  description: "如果目标有任何能力降低,造成50%额外伤害."
  expanded_description: "漂亮公主使使用者对拥有任何负向能力等级的目标造成50%额外伤害."
}
ability {
  id: ABILITY_SELF_REPAIR
  name: "自我修复"
  description: "自给自足 + 自然回复."
  expanded_description: "每回合结束时回复1/16的最大HP,并且替换下场时治愈所有异常状态."
}
ability {
  id: ABILITY_ATOMIC_BURST
  name: "原子爆炸"
  description: "电力转换 + 电气皮肤."
  expanded_description: "受到任何招式攻击时,使用者会进入充电状态,使下一次电属性招式威力加倍.将所有一般属性招式转变为电属性招式,并为电属性招式提供本系加成.如果使用者是电属性,其电属性招式有10%的几率造成麻痹."
}
ability {
  id: ABILITY_HELLBLAZE
  name: "地狱烈焰"
  description: "火属性招式威力×1.3；HP低于1/3时改为×1.8。"
  expanded_description: "火属性招式威力提升30%,当HP低于1/3时提升80%."
}
ability {
  id: ABILITY_RIPTIDE
  name: "暗涌"
  description: "水属性招式威力×1.3；HP低于1/3时改为×1.8。"
  expanded_description: "水属性招式威力提升30%,当HP低于1/3时提升80%."
}
ability {
  id: ABILITY_FOREST_RAGE
  name: "森林之怒"
  description: "草属性招式威力×1.3；HP低于1/3时改为×1.8。"
  expanded_description: "草属性招式威力提升30%,当HP低于1/3时提升80%."
}
ability {
  id: ABILITY_PRIMAL_MAW
  name: "原始颚"
  description: "啃咬类招式攻击两次.第二击造成0.4倍伤害."
  expanded_description: "原始颚使所有啃咬类招式攻击两次.第一击造成100%伤害,第二击造成40%伤害.每次攻击独立判定追加效果（畏缩除外）."
}
ability {
  id: ABILITY_SWEEPING_EDGE
  name: "横扫利刃"
  description: "切割类招式必定命中，并攻击对方两只宝可梦。"
  expanded_description: "横扫利刃使所有锐利刀刃类招式必定命中,并在双打对战中同时攻击双方对手.连续攻击招式对每个目标只攻击一次."
}
ability {
  id: ABILITY_GIFTED_MIND
  name: "天赋异禀"
  description: "消除超能力弱点,变化招式必定命中."
  expanded_description: "天赋异禀使该宝可梦免疫恶、幽灵和虫属性招式,同时其使用的所有变化招式必定命中.此免疫效果无视奇妙空间."
}
ability {
  id: ABILITY_HYDRO_CIRCUIT
  name: "水力循环"
  description: "电属性招式+50%威力,水属性招式吸取25%的伤害."
  expanded_description: "水力循环使电属性招式威力提升50%,并使用水属性招式时,回复造成伤害25%的HP."
}
ability {
  id: ABILITY_EQUINOX
  name: "昼夜平分"
  description: "每次攻击使用攻击或特攻中较高的能力值."
  expanded_description: "昼夜平分为每次攻击选择较高的进攻能力值.如果攻击较高,物理和特殊招式都使用攻击能力值；如果特攻较高,则都使用特攻能力值."
}
ability {
  id: ABILITY_ABSORBANT
  name: "吸收"
  description: "吸取类招式的回复量增加50%，并施加寄生种子。"
  expanded_description: "吸收特性使吸取类招式的HP回复量提升50%,并在命中时对目标施加寄生种子,每回合结束时吸取目标1/8的最大HP."
}
ability {
  id: ABILITY_CLUELESS
  name: "无知的"
  description: "在场时,无效化天气、房间和场地效果."
  expanded_description: "无知的特性在该宝可梦在场时,无效化所有天气、场地和房间效果."
}
ability {
  id: ABILITY_CHEATING_DEATH
  name: "逃过一死"
  description: "前两次受到的伤害无效."
  expanded_description: "使前两次受到的伤害变为0.招式仍会连接且附加效果生效,但伤害变为0."
}
ability {
  id: ABILITY_CHEAP_TACTICS
  name: "廉价战术"
  description: "出场时,使用抓进行攻击."
  expanded_description: "廉价战术在替换上场时,使用抓（40威力,一般属性物理招式）攻击随机一名对手."
}
ability {
  id: ABILITY_COWARD
  name: "懦夫"
