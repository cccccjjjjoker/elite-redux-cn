}
ability {
  id: ABILITY_VITALITY_STRIKE
  name: "活力打击"
  description: "使用拳类招式造成伤害时,回复伤害量10%的HP."
  expanded_description: "使用拳类招式造成伤害时,回复相当于伤害量10%的HP."
}
ability {
