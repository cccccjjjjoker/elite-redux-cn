}
ability {
  id: ABILITY_BATTLE_AURA
  name: "战斗气场"
  description: "使所有参战者的击中要害率提升2级."
  expanded_description: "使每只宝可梦的击中要害率提升2级.包括同伴和对手."
}
ability {
  id: ABILITY_BLOODLUST
  name: "嗜血"
  description: "血浴 + 噬魂."
  expanded_description: "免疫流血状态.当该宝可梦成功使对手流血时,也使其陷入恐惧.恐惧束缚目标2回合,使其受到的伤害增加50%.如果被吹飞等招式强制替换,目标会摆脱恐惧.通过直接攻击击倒对手时,回复25%的最大HP."
}
ability {
  id: ABILITY_PIERCING_SOLO
  name: "独奏穿刺"
