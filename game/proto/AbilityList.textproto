}
ability {
  id: ABILITY_PURGATORY
  name: "炼狱"
  description: "幽灵属性招式威力×1.3；HP低于1/3时改为×1.8。"
  expanded_description: "幽灵属性招式威力提升30%,当HP低于1/3时提升80%."
}
ability {
  id: ABILITY_EMANATE
  name: "散发"
  description: "一般属性招式变为超能力属性.超能力属性招式得到强化."
  expanded_description: "将使用者的一般属性招式变为超能力属性.如果使用者是超能力属性,其超能力属性招式有10%的几率造成混乱；否则,它获得超能力属性的本系加成."
