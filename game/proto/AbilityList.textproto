}
ability {
  id: ABILITY_BLIND_RAGE
  name: "盲目狂怒"
  description: "胆量 + 破格."
  expanded_description: "该宝可梦使用的一般和格斗属性招式能够以普通效果命中幽灵属性宝可梦.免疫威吓和惊吓.允许招式无视目标的特性和先天特性,包括那些会干扰效果或降低伤害的特性.无法绕过会修改基础能力值的特性,如草之皮毛."
}
ability {
  id: ABILITY_SLIPSTREAM
  name: "滑流"
  description: "使用攻击时,额外使用20%的速度能力值."
  expanded_description: "使用攻击时,将使用者20%的速度能力值加入伤害计算.讲究围巾的效果不影响此特性."
}
ability {
  id: ABILITY_APEX_PREDATOR
  name: "顶级掠食者"
  description: "坚硬爪子 + 掠食者."
  expanded_description: "接触类招式的威力提升30%.当使用者通过直接攻击击倒对手时,立即恢复其最大HP的25%."
}
ability {
  id: ABILITY_DRAGONS_RITUAL
  name: "龙之仪式"
  description: "击倒对手时,攻击和速度各提升1级."
  expanded_description: "每当使用者通过直接攻击击倒对手时,其攻击和速度能力值各提升1级."
}
ability {
  id: ABILITY_PINNACLE_BLADE
  name: "巅峰之刃"
  description: "劈开类招式必定命中,且能穿透保护和屏障."
  expanded_description: "所有锐利刀刃类招式必定命中,并且可以穿透保护类招式,忽略与其相关的任何附加效果."
}
ability {
  id: ABILITY_ENERGIZED
  name: "充能"
  description: "发电机 + 使用电属性招式击倒对手时充电."
  expanded_description: "替换上场时使使用者进入充电状态,下一次电属性招式威力加倍.在战斗中电气场地激活时再次充电.充电状态在替换下场或使用一次电属性招式后消失.使用电属性招式直接击倒对手时重新充电."
}
ability {
  id: ABILITY_COLOR_SPECTRUM
  name: "光谱"
  description: "同属性攻击获得1.2倍加成.每回合改变属性."
  expanded_description: "本系招式获得20%威力提升.使用者在每回合开始时随机变为一种纯属性."
}
ability {
  id: ABILITY_STEEL_BEETLE
  name: "钢甲虫"
  description: "狂暴拳手 + 授粉."
  expanded_description: "使拳类招式攻击两次,第一击造成100%伤害,第二击造成40%伤害.一般属性招式变为虫属性并获得本系加成.如果使用者是虫属性,则免疫粉末类招式."
}
ability {
  id: ABILITY_FROM_THE_SHADOWS
  name: "来自暗影"
  description: "先手攻击时,有20%几率造成畏缩并束缚目标."
  expanded_description: "当使用者在一回合中先出手时,攻击有20%的几率造成畏缩,并且在命中时束缚目标.束缚效果与畏缩是否成功无关.畏缩几率仅对连续攻击的第一击有效."
}
ability {
  id: ABILITY_RAGE_POINT
  name: "怒穴"
  description: "处于异常状态时伤害×1.5；受到击中要害时提升攻击与特攻。"
  expanded_description: "当使用者处于任何异常状态时,其攻击招式威力提升50%.当该宝可梦受到击中要害时,其攻击和特攻各提升1级.同时无视灼伤带来的攻击降低和冰冻带来的特攻降低."
}
ability {
  id: ABILITY_HOT_COALS
  name: "热煤"
  description: "设置一个陷阱,使下一个替换上场的对手灼伤."
  expanded_description: "使用者替换上场时,在对手场上设置一个灼伤陷阱.下一个替换上场的对手如果接地且可被灼伤,则会被灼伤.触发后陷阱消失.多个陷阱不会叠加."
}
ability {
  id: ABILITY_TERASTAL_TREASURE
  name: "太晶宝藏"
  description: "受到的伤害降低40%,但速度降低20%."
  expanded_description: "受到的伤害降低40%,同时该宝可梦的速度降低20%.与其他减伤来源乘法叠加."
}
ability {
  id: ABILITY_SHOCKING_MAW
  name: "电击巨颚"
  description: "强壮之颚与电击之颚的效果。"
  expanded_description: "使啃咬类招式威力提升30%,并在命中时有50%的几率使目标麻痹."
}
ability {
  id: ABILITY_GLEAM_EYES
  name: "微光之眼"
  description: "察觉 + 惊吓."
  expanded_description: "进入战斗时,揭示对手的物品,并使其效果失效2回合,同时降低所有对手宝可梦的特攻1级.不会阻止超级石及其他类似物品的运作."
}
ability {
  id: ABILITY_ROUSED_FANGS
  name: "巨咬"
  description: "啃咬类招式使用特攻,并造成30%额外伤害."
  expanded_description: "啃咬类招式使用特攻能力值进行伤害计算（除非另有说明,否则仍攻击目标的防御）,并造成30%额外伤害."
}
ability {
  id: ABILITY_DREAM_STATE
  name: "梦境"
  description: "免疫击中要害.受到的招式伤害降低20%."
  expanded_description: "受到的伤害降低20%（x0.8）,与其他减伤效果乘法叠加.此外,免疫击中要害,会心一击将作为普通攻击处理,并且不会触发攻击要害的效果（例如“至骨”的流血效果）."
}
ability {
  id: ABILITY_DREAM_WHIMSY
  name: "梦幻奇想"
  description: "出场时使用哈欠."
  expanded_description: "替换上场时使用哈欠,以对手宝可梦为目标.哈欠使目标陷入瞌睡,并在下一回合结束时睡眠.替换下场可以防止睡眠."
}
ability {
  id: ABILITY_LUNAR_AFFINITY
  name: "月之亲和"
  description: "模仿其他宝可梦使用的月亮相关招式."
  expanded_description: "当其他宝可梦在战斗中使用月亮相关招式时,进行模仿.包括月光、月亮之力、月之舞和月之祝福.每回合对每个招式触发一次."
}
ability {
  id: ABILITY_FLAME_SHIELD
  name: "火焰盾"
  description: "受到效果绝佳的招式攻击时,伤害降低35%."
  expanded_description: "受到效果绝佳的招式攻击时,伤害降低35%.与其他减伤效果乘法叠加."
}
ability {
  id: ABILITY_AQUATIC_DWELLER
  name: "水栖居民"
  description: "水生 + 水属性招式威力提升1.5倍."
  expanded_description: "进入战斗时,为使用者的当前属性添加水属性即使失去此特性,添加的水属性在替换下场前依然保留.同时水属性招式威力提升50%."
}
ability {
  id: ABILITY_APPLE_PIE
  name: "苹果蛋糕"
  description: "自给自足与熟成的效果。"
  expanded_description: "每回合结束时回复1/16的最大HP.熟成使所有树果的有益效果加倍回复类树果回复量加倍,提升能力的树果改为提升2级,抵抗树果将效果绝佳的伤害降低75%,回复PP的树果回复20 PP."
}
ability {
  id: ABILITY_HOVER
  name: "悬浮"
  description: "为自身添加超能力属性.回避地面属性攻击."
  expanded_description: "进入战斗时,为使用者的当前属性添加超能力属性.即使失去此特性,添加的超能力属性在替换下场前依然保留.使用者免疫地面属性招式以及撒菱和场地状态等其他地面效果."
}
ability {
  id: ABILITY_DEPRAVITY
  name: "堕落"
  description: "不仁不义 + 过载."
  expanded_description: "对处于中毒、麻痹、流血或速度降低状态的目标,必定造成击中要害.使用者的电属性招式对电属性宝可梦变得有效,造成2倍伤害而非0.5倍.同时允许使用者使电属性宝可梦陷入麻痹状态."
}
ability {
  id: ABILITY_WILDFIRE
  name: "野火"
  description: "出场时使用火焰旋涡."
  expanded_description: "替换上场时使用火焰旋涡,威力50的火属性特殊招式,束缚对手4-5回合.目标每回合损失1/8最大HP,且在束缚结束前无法替换下场."
}
ability {
  id: ABILITY_JUMP_SCARE
  name: "突然惊吓"
  description: "首次替换上场时,使用惊吓进行攻击."
  expanded_description: "替换上场时使用惊吓,威力40的幽灵属性物理招式,拥有+3优先度且必定造成畏缩每场战斗仅触发一次."
}
ability {
  id: ABILITY_TAR_TOSS
  name: "焦油投掷"
  description: "出场时使用掷焦油."
  expanded_description: "替换上场时使用掷焦油,降低目标速度1级,并使其受到的火属性伤害变为2倍.后续使用不会叠加火属性伤害的负面效果."
}
ability {
  id: ABILITY_STUN_SHOCK
  name: "惊愕冲击"
  description: "攻击有60%几率造成麻痹或中毒."
  expanded_description: "当使用者攻击命中时,有60%的几率随机使目标陷入中毒或麻痹状态.连续攻击的每一击都会独立判定."
}
ability {
  id: ABILITY_RAGING_GODDESS
  name: "狂怒女神"
  description: "暴走 + 极度好战."
  expanded_description: "击倒对手时,立即从休息状态中恢复.所有攻击连续命中两次.第一击造成100%伤害,第二击造成25%伤害.每次攻击独立判定追加效果（畏缩除外）."
}
ability {
  id: ABILITY_WHIPLASH
  name: "鞭打"
  description: "物理攻击降低对手防御."
  expanded_description: "使用物理攻击命中时,降低目标防御1级.每个目标每回合只能被影响一次防御降低在伤害之后生效."
}
ability {
  id: ABILITY_SUPERSWEET_SYRUP
  name: "超甜糖浆"
  description: "黏着 + 接触时使对手物品失效2回合."
  expanded_description: "该宝可梦携带的物品不会被强制移除或偷走.发生接触时,对手的物品失效2回合."
}
ability {
  id: ABILITY_LUCKY_HALO
  name: "幸运光环"
  description: "不会因自身招式而降低能力；可承受一次致命攻击。"
  expanded_description: "防止使用者自身引起的能力降低,并允许其承受一次会使其濒死的攻击,留下1点HP."
}
ability {
  id: ABILITY_TRASH_HEAP
  name: "垃圾堆"
  description: "腐蚀 + 毒溢."
  expanded_description: "毒属性招式对钢属性宝可梦变得效果绝佳.此外,该宝可梦可以使任何属性的宝可梦陷入中毒状态.每回合伤害所有非毒属性宝可梦,造成其1/8的HP损失.拥有毒疗特性的宝可梦反而会回复.使用者下场时效果消失."
}
ability {
  id: ABILITY_SLUDGY_MIX
  name: "污泥混合"
  description: "醉人 + 庞克摇滚."
  expanded_description: "将所有一般属性招式转变为毒属性,并为毒属性招式提供本系加成.如果使用者是毒属性,其毒属性招式有10%的几率造成剧毒.使使用者的声音类招式威力提升30%,并使受到的声音类招式伤害降低50%.伤害减免与其他来源乘法叠加."
}
ability {
  id: ABILITY_OVERWATCH
  name: "守望"
  description: "潜行 + 蹲守."
  expanded_description: "在使用者上场的第一回合,所有优先度为0或更高的招式获得+1优先度.负向优先度招式变为优先度0,而非获得+1.对刚替换上场的对手造成双倍伤害.仅在对手替换上场后的第一回合内生效."
}
ability {
  id: ABILITY_WIND_RAGE
  name: "风怒"
  description: "出场时使用清除浓雾.空气类招式获得1.3倍威力加成."
  expanded_description: "替换上场时使用清除浓雾.降低对手闪避率1级,并清除所有入场陷阱、屏障、神秘守护和白雾.此外,所有空气类招式获得1.3倍伤害加成."
}
ability {
  id: ABILITY_VICTORY_BOMB
  name: "胜利炸弹"
  description: "濒死时,使用威力100的火属性大爆炸."
  expanded_description: "濒死时,以威力100的火属性大爆炸反击所有相邻的宝可梦.必定命中.无论使用者如何被击倒都会生效."
}
ability {
  id: ABILITY_RAZOR_SHARP
  name: "削铁如泥"
  description: "击中要害时也造成流血."
  expanded_description: "造成击中要害时施加流血.流血每回合造成1/16最大HP伤害,阻止回复,并使能力等级效果无效.岩石和幽灵属性免疫流血."
}
ability {
  id: ABILITY_TO_THE_BONE
  name: "至骨"
  description: "击中要害获得1.5倍加成,并造成流血."
}
ability {
  id: ABILITY_BLADE_DANCE
  name: "刀舞"
  description: "使用舞蹈类招式后,触发威力50的叶刃."
  expanded_description: "使用任何舞蹈类招式后,立即触发一次威力50的叶刃（草属性,物理）作为后续攻击."
}
ability {
  id: ABILITY_TAEKKYEON
  name: "跆跟"
  description: "所有攻击都视为舞蹈."
  expanded_description: "使所有非变化招式都被视为舞蹈类招式,可以触发舞者等特性以及与舞蹈相关的效果."
}
ability {
  id: ABILITY_APE_SHIFT
  name: "猿之变"
  description: "HP低于50%时变身,治愈异常状态且攻击必定会心一击."
  expanded_description: "当HP降至50%或以下时变身,变身完成后自动治愈所有异常状态.变身后,所有攻击都变为击中要害.在出场时、战斗中及回合结束时均可触发."
}
ability {
  id: ABILITY_KNOW_YOUR_PLACE
  name: "识相点"
  description: "接触类招式使目标在接下来的5回合最后行动。"
  expanded_description: "使用接触类招式命中后,使目标在5回合内无论优先度、速度或其他效果如何,总是最后行动.效果不会叠加,也不会对已受影响的目标刷新."
}
ability {
  id: ABILITY_DEEP_CUTS
  name: "深割"
  description: "劈开类招式有50%几率造成流血."
  expanded_description: "锐利刀刃类招式命中时有50%的几率造成流血.流血每回合造成1/16最大HP伤害,阻止回复,并使能力等级效果无效.岩石和幽灵属性免疫流血.连续攻击的每一击都会独立判定."
}
ability {
  id: ABILITY_LIFE_STEAL
  name: "生命偷取"
  description: "每回合从对手吸取1/10的HP."
  expanded_description: "每回合结束时,从每个在场的对手吸取其最大HP的1/10,并回复给使用者.无视替身."
}
ability {
  id: ABILITY_RUDE_AWAKENING
  name: "粗暴唤醒"
  description: "醒来后,全能力提升,并永久免疫睡眠."
  expanded_description: "从睡眠中醒来时,使用者永久获得睡眠免疫,且所有能力提升1级.每场战斗仅触发一次."
}
ability {
  id: ABILITY_TERAFORM_ZERO
  name: "太晶归零"
  description: "太晶甲壳 + 首次出场时清除天气和场地."
  expanded_description: "当HP全满时,所有对该宝可梦的攻击都将造成效果不好的伤害,无论属性相性如何.与其他类似特性不同,此效果在连续攻击的每次命中都会激活.出场时清除普通天气和场地."
}
ability {
  id: ABILITY_SET_ABLAZE
  name: "点燃"
  description: "造成灼伤时也施加恐惧."
  expanded_description: "当使用者施加灼伤时,也同时施加恐惧.恐惧束缚目标2回合,使其受到的伤害增加50%.如果被吹飞等招式强制替换,目标会摆脱恐惧."
}
ability {
  id: ABILITY_BREAKWATER
  name: "防波堤"
  description: "悠游自如 + 后攻."
  expanded_description: "下雨天气时,速度提升50%.在对手之前行动时,受到的伤害降低30%.当该宝可梦在回合中替换上场时也生效."
}
ability {
  id: ABILITY_MAGICAL_FISTS
  name: "魔法之拳"
  description: "拳类招式使用特攻计算伤害，并多造成30%伤害。"
  expanded_description: "拳类招式使用特攻能力值进行伤害计算（除非另有说明,否则仍攻击目标的防御）,并造成30%额外伤害."
}
ability {
  id: ABILITY_CUTTHROAT
  name: "凶手"
  description: "每次上场使用的首个切割类招式优先度+1。"
  expanded_description: "出场时,赋予第一次使用的锐利刀刃类招式+1优先度.在使用任何锐利刀刃类招式命中后,该优先度加成即被消耗.使用磨砺可重置此特性."
}
ability {
  id: ABILITY_SAND_BENDER
  name: "沙之操控者"
  description: "扬沙 + 沙之力."
  expanded_description: "出场时引发沙暴,持续8回合（携带光滑岩石时为12回合）.在沙暴中,该宝可梦最高的攻击能力值提升50%.同时免疫沙暴伤害."
}
ability {
  id: ABILITY_SAND_PIT
  name: "沙坑"
  description: "出场时使用威力20的沙穴."
  expanded_description: "替换上场时使用威力20的沙穴攻击所有对手宝可梦,束缚它们4-5回合,使其每回合损失1/8最大HP必定命中,无视命中判定."
}
ability {
  id: ABILITY_DESOLATE_SUN
  name: "荒芜太阳"
  description: "终结之地 + 食土."
  expanded_description: "创造终焉大晴天,持续到使用者下场.具有标准晴天效果,并使所有水属性招式无效.此外,使用者受到地面属性招式攻击时,回复其最大HP的25%而非受到伤害."
}
ability {
  id: ABILITY_DAYBREAK
  name: "破晓"
  description: "接触时使对手灼伤.攻击时也生效."
  expanded_description: "使用者接触时使对手灼伤.无论攻击方还是被攻击方均会生效."
}
ability {
  id: ABILITY_ENERGY_SIPHON
  name: "能量虹吸"
  description: "回复造成伤害的1/4."
  expanded_description: "回复使用者对对手造成伤害的25%.回复在伤害造成后立即生效.最少回复1点HP."
}
ability {
  id: ABILITY_RESERVOIR
  name: "水库"
  description: "储水 + 引水."
  expanded_description: "该宝可梦会吸引水属性招式,并对其免疫.此外,吸收水属性招式时,使用者最高的攻击能力值提升1级,并回复其最大HP的25%."
}
ability {
  id: ABILITY_NEUROTOXIN
  name: "神经毒素"
  description: "造成中毒时,降低对手的攻击、特攻和速度."
  expanded_description: "当使对手中毒时,立即降低其攻击、特攻和速度各1级."
}
ability {
  id: ABILITY_ENERGIZED_HORNS
  name: "能量角"
  description: "角类招式变为特殊招式,并造成30%额外伤害."
  expanded_description: "角类招式变为特殊（造成特殊伤害并使用特攻能力值）,并造成30%额外伤害."
}
ability {
  id: ABILITY_SPIDER_LAIR_UPGRADE
  name: "生面团"
  description: "出场时设置黏黏网,持续7回合."
  expanded_description: "使用者进入战斗时,在对手场上设置黏黏网.持续7回合,使任何替换上场的接地宝可梦速度降低1级.如果对手场上已有黏黏网,则无法激活."
}
ability {
  id: ABILITY_CRUST_COAT
  name: "硬壳"
  description: "免疫击中要害.受到的招式伤害降低20%."
  expanded_description: "受到的伤害降低20%（x0.8）,与其他减伤效果乘法叠加.此外,免疫击中要害,会心一击将作为普通攻击处理,并且不会触发攻击要害的效果（例如“至骨”的流血效果）."
}
ability {
  id: ABILITY_PUFFY
  name: "蓬松"
  description: "受到的接触类招式伤害减半,但火属性招式会造成2倍伤害."
  expanded_description: "使受到的接触类招式伤害降低50%.火属性招式对该宝可梦造成双倍伤害.与其他减伤效果乘法叠加."
}
ability {
  id: ABILITY_BALLOON_BLITZ
  name: "气球突击"
  description: "充气 + 极度好战."
  expanded_description: "受到任何火属性或飞行属性招式攻击时,防御和特防各提升1级.对于连续攻击招式,每次命中都会触发.能力提升效果在攻击命中后生效.所有攻击命中两次.第一击造成100%伤害,第二击造成25%伤害.每次攻击独立判定追加效果（畏缩除外）."
}
ability {
  id: ABILITY_STRIKER_PIXILATE
  name: "纤巧脚尖"
  description: "前锋与妖精皮肤的效果。"
  expanded_description: "使所有踢腿类招式的威力提升30%.一般属性招式变为妖精属性,使用者获得妖精属性本系加成.如果使用者是妖精属性,其妖精属性招式有10%的几率造成着迷."
}
ability {
  id: ABILITY_DOOM_BLAST
  name: "末日爆裂"
  description: "恶属性招式造成1.35倍伤害,但有10%的反伤."
  expanded_description: "使恶属性招式威力提升35%,但会造成基于伤害值10%的反伤（最少1点HP）.反伤不会导致使用者濒死."
}
ability {
  id: ABILITY_BRUTEFORCE
  name: "蛮力"
  description: "坚硬脑袋 + 舍身."
  expanded_description: "会造成反伤伤害的招式威力提升20%.处于愤怒状态时,此加成适用于所有招式.防止所有来自自身招式或特性的反伤伤害.同时免疫因愤怒产生的反伤伤害无法防止撞击伤害或大爆炸/自爆的伤害."
}
ability {
  id: ABILITY_FARADAY_CAGE
  name: "法拉第笼"
  description: "战斗盔甲 + 受到接触攻击时使用威力50的雷电笼."
  expanded_description: "受到的伤害降低20%,与其他减伤来源乘法叠加.免疫击中要害.受到接触招式攻击时,使用雷电笼进行反击,威力50的电属性特殊招式,束缚对手4-5回合.目标每回合损失1/8最大HP,且在束缚结束前无法替换下场."
}
ability {
  id: ABILITY_ACIDIC_SLIME
  name: "酸性黏液"
  description: "腐蚀 + 毒属性本系."
  expanded_description: "毒属性招式对钢属性宝可梦变得效果绝佳.此外,该宝可梦可以使任何属性的宝可梦陷入中毒状态.同时为毒属性招式提供本系加成."
}
ability {
  id: ABILITY_ROSE_GARDEN
  name: "玫瑰园"
  description: "出场时撒下两层毒菱."
  expanded_description: "出场时在对手场上撒下两层毒菱任何非毒或钢属性的接地敌人替换上场时,都会陷入剧毒."
}
ability {
  id: ABILITY_QIGONG
  name: "气功"
  description: "必定命中.斗争精神 + 暴走."
  expanded_description: "使用者总是能命中目标.将所有一般属性招式转变为格斗属性招式,并为格斗属性攻击提供本系加成如果使用者是格斗属性,其格斗属性招式可以击破屏障.击倒对手时,立即从休息状态中恢复."
}
ability {
  id: ABILITY_CONJOURER_OF_DECEIT
  name: "欺诈魔术师"
  description: "魔法防守 + 魔法镜."
  expanded_description: "免疫所有非攻击性的伤害来源,包括入场陷阱、天气伤害、异常状态以及反伤伤害.在大部分变化招式生效前,将其反弹回原使用者.被反弹的招式作用于原使用者.无法反弹已被反弹的招式."
}
ability {
  id: ABILITY_DEEP_FREEZE
  name: "深度冻结"
  description: "水、冰属性招式威力×1.25；受到的火属性伤害减半。"
  expanded_description: "水属性和冰属性招式威力提升25%.受到的火属性招式伤害减半.与其他减伤来源乘法叠加."
}
ability {
  id: ABILITY_SOUL_DEVOURER
  name: "灵魂吞噬者"
  description: "噬魂 + 幻痛."
  expanded_description: "当使用者通过直接攻击击倒对手时,立即恢复其最大HP的25%.移除一般属性对幽灵属性招式的免疫,允许幽灵属性攻击以1倍效果命中一般属性宝可梦."
}
ability {
  id: ABILITY_CHAMPIONS_ENTRANCE
  name: "冠军登场"
  description: "威吓 + 狂暴突袭."
  expanded_description: "进入战斗时,降低所有对手宝可梦的攻击能力值1级.使用者替换上场后的第一回合,获得50%的速度加成和20%的攻击加成."
}
ability {
  id: ABILITY_PRESTO
  name: "急板"
  description: "HP全满时,声音类招式获得+1优先度."
  expanded_description: "当HP全满时,赋予声音类招式+1优先度."
}
ability {
