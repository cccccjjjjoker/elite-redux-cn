  expanded_description: "当该宝可梦被对手的攻击击倒时,会向攻击者返还与致命一击等量的伤害.对拥有魔法防守特性的攻击者无效."
}
ability {
  id: ABILITY_DANCER
  name: "舞者"
  description: "模仿其他宝可梦使用的舞蹈招式."
