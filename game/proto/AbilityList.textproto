}
ability {
  id: ABILITY_SLUSH_RUSH
  name: "拨雪"
  description: "在冰雹中,该宝可梦的速度提升至1.5倍."
  expanded_description: "在冰雹中,该宝可梦的速度能力值提升50%.同时免疫冰雹伤害."
}
ability {
  id: ABILITY_LONG_REACH
  name: "远隔"
