PetalburgCity_Gym_Text_DadYoureHereWithYourPokemon: @ 82057A2
	.string "爸爸：嗯？\n"
	.string "哟，这不是{PLAYER}吗！\p"
	.string "搬家都收拾好了？\n"
	.string "你居然能一个人走到这儿，\p"
	.string "真让我意外。\n"
	.string "哦，我明白了。\p"
	.string "你是和宝可梦一起来的。\n"
	.string "嗯……那看来你也要\p"
	.string "成为像我这样的训练家了，\n"
	.string "{PLAYER}。\p"
	.string "这消息真好！我很期待！$"

PetalburgCity_Gym_Text_WallyIdLikeAPokemon: @ 82058B1
	.string "那个……我……\n"
	.string "我想领一只宝可梦……$"

PetalburgCity_Gym_Text_DadOhYoureWallyRight: @ 82058DB
	.string "爸爸：嗯？你是……呃……哦，\n"
	.string "对了。\p"
	.string "你是小胜吧？$"

PetalburgCity_Gym_Text_WallyIveNeverCaughtAPokemon: @ 8205910
	.string "小胜：我要去绿茵镇的亲戚家住一阵\n"
	.string "子。\p"
	.string "一个人去太寂寞了，\n"
	.string "所以想带一只宝可梦一起去。\p"
	.string "可是我从来没抓过宝可梦，\n"
	.string "不知道该怎么抓……$"

PetalburgCity_Gym_Text_DadHmISee: @ 82059D8
	.string "爸爸：嗯，我知道了。$"

PetalburgCity_Gym_Text_DadPlayerGoWithWally: @ 82059E8
	.string "爸爸：{PLAYER}，你都听到了吧？\n"
	.string "陪小胜一起去，\p"
	.string "确保他安全地抓到宝可梦。$"

PetalburgCity_Gym_Text_IllLoanYouMyZigzagoon: @ 8205A46
	.string "小胜，来，我把我的宝可梦借给你。\n"
	.string "小胜得到了蛇纹熊！$"

PetalburgCity_Gym_Text_WallyThankYouAndDadGivesPokeBall: @ 8205A89
	.string "小胜：哦，哇！\n"
	.string "是宝可梦！\p"
	.string "爸爸：嗯，再给你一个精灵球。\n"
	.string "去吧！\p"
	.string "小胜得到了精灵球！$"

PetalburgCity_Gym_Text_WallyOhWowThankYou: @ 8205AF4
	.string "小胜：哦，哇！\n"
	.string "谢谢你！$"

PetalburgCity_Gym_Text_WouldYouReallyComeWithMe: @ 8205B0F
	.string "{PLAYER}……\n"
	.string "你真的愿意陪我去吗？$"

PetalburgCity_Gym_Text_DadSoDidItWorkOut: @ 8205B32
	.string "爸爸：怎么样，顺利吗？$"

PetalburgCity_Gym_Text_WallyThankYouBye: @ 8205B4C
	.string "小胜：谢谢，很顺利。\n"
	.string "您的宝可梦还给您。\p"
	.string "{PLAYER}，谢谢你陪我去。\n"
	.string "正因为有你们两位，\p"
	.string "我才能抓到自己的宝可梦。\n"
	.string "我保证会好好照顾它。\p"
	.string "哦！我妈妈还在等我，我得走了！\n"
	.string "再见，{PLAYER}！$"

PetalburgCity_Gym_Text_DadGoCollectBadges: @ 8205C40
	.string "爸爸：那么……\n"
	.string "{PLAYER}，想成为强大的训练家，\p"
	.string "我给你一个建议。\n"
	.string "去这座城市外面的卡那兹市吧。\p"
	.string "到那里挑战道馆馆主杜娟。\n"
	.string "之后再去其他的宝可梦道馆，\p"
	.string "打败那里的馆主。\n"
	.string "从他们手里拿到徽章，明白了吗？\p"
	.string "当然，我也是个道馆馆主。\n"
	.string "总有一天我们也会对战，\p"
	.string "{PLAYER}。\n"
	.string "不过那要等你变得更强之后。$"

PetalburgCity_Gym_Text_NormanGoToRustboro: @ 8205DB4
	.string "爸爸：嗯？你不是要去卡那兹市的\n"
	.string "宝可梦道馆吗？\p"
	.string "跟一个新手训练家打，\n"
	.string "对我来说算不上挑战。\p"
	.string "{PLAYER}，\n"
	.string "等你强得多了再来挑战我。\p"
	.string "等你能拿出四枚徽章的时候，\n"
	.string "我就跟你打，{PLAYER}，好吗？$"

PetalburgCity_Gym_Text_NormanGoToDewford: @ 8205EAE
	.string "爸爸：我明白了……你打赢了\n"
	.string "卡那兹市的道馆馆主。\p"
	.string "但比你强的训练家还有一大堆，\n"
	.string "{PLAYER}。\p"
	.string "海对面的武斗镇有位馆主叫藤树。\n"
	.string "你该去挑战他。$"

PetalburgCity_Gym_Text_YouHaveGottenStronger: @ 8205F87
	.string "爸爸：嗯……{PLAYER}，\n"
	.string "你变强了。\p"
	.string "从你拿到的徽章数量就能看出来。$"

PetalburgCity_Gym_Text_NormanIntro: @ 8205FE5
	.string "爸爸：嗯……\n"
	.string "你真的拿到四枚徽章了。\p"
	.string "好，按约定，我们来场宝可梦对战。\n"
	.string "不过先把这个给你。$"

PetalburgCity_Gym_Text_NormanMegaBracelet:
	.string "这个超级手环能让特定的宝可梦\n"
	.string "在对战中超级进化。\p"
	.string "不过光有它没用。\n"
	.string "要让宝可梦超级进化，\p"
	.string "还得让它带上自己的进化石。\n"
	.string "然后，在选择招式前按下START键。\p"
	.string "超级进化是非常强大的技巧，\n"
	.string "但我觉得你和你的宝可梦已经准备好\p"
	.string "了。\n"
	.string "可以的话，就在我们的对战中试试！\p"
	.string "来，这些进化石也拿去。$"

PetalburgCity_Gym_Text_NormanBattleIntro:
	.string "{PLAYER}……\n"
	.string "能自己的孩子真正打一场，\p"
	.string "我真高兴。\n"
	.string "但是，对战就是对战！\p"
	.string "作为道馆馆主，我会尽全力取胜。\n"
	.string "{PLAYER}，你也最好拿出全力！$"

PetalburgCity_Gym_Text_NormanDefeat: @ 8206107
	.string "……\n"
	.string "我……我不敢相信。\p"
	.string "{PLAYER}……\n"
	.string "我输给{PLAYER}了？\p"
	.string "不过，规则就是规则！\n"
	.string "来，拿着这个。$"

PetalburgCity_Gym_Text_ReceivedBalanceBadge: @ 8206162
	.string "{PLAYER}从爸爸那里得到了平衡徽\n"
	.string "章！$"

PetalburgCity_Gym_Text_ExplainBalanceBadgeTakeThis: @ 820618A
	.string "爸爸：有了这枚徽章，\n"
	.string "学会秘传招式冲浪的宝可梦\p"
	.string "就能在水上行动了。\n"
	.string "如果你不想让宝可梦学，\p"
	.string "可以借我的爆音怪去冲浪。\n"
	.string "…… …… …… ……$"

PetalburgCity_Gym_Text_RegisteredExploud: @ 81FF517
	.string "在宝可梦导航器里登录了爸爸的爆音\n"
	.string "怪。$"

PetalburgCity_Gym_Text_TakeThis:
	.string "这是我给你的礼物。{PLAYER}，\n"
	.string "我相信你能用对地方。$"

PetalburgCity_Gym_Text_ExplainFacade: @ 8206254
	.string "爸爸：招式学习器42里装着硬撑。\n"
	.string "宝可梦中毒、麻痹或灼伤时，\p"
	.string "它的威力会翻倍。\n"
	.string "也许能把糟糕的局面变成机会。$"

PetalburgCity_Gym_Text_DadHappyAndSad: @ 82062FB
	.string "爸爸：作为道馆馆主，\n"
	.string "我懊恼得说不出话……\p"
	.string "但作为父亲，我又高兴又有点难过。\n"
	.string "真是奇怪……$"

PetalburgCity_Gym_Text_PleaseComeWithMe: @ 8206377
	.string "啊，你在这儿，{PLAYER}{KUN}！\n"
	.string "请跟我来。\p"
	.string "我有样东西想给你。$"

PetalburgCity_Gym_Text_LetMeBorrowPlayer: @ 82063CA
	.string "千里，你不介意吧？\n"
	.string "把{PLAYER}{KUN}借我一两分钟。$"

PetalburgCity_Gym_Text_DadGoingToKeepTraining: @ 8206417
	.string "爸爸：{PLAYER}，\n"
	.string "你该偶尔去看看你妈妈。\p"
	.string "我要留在这里加倍训练。\n"
	.string "作为训练家，输了却不扳回来，\p"
	.string "我心里过不去，{PLAYER}！$"

PetalburgCity_Gym_Text_DadNoAmountOfTrainingIsEnough: @ 82064C3
	.string "爸爸：{PLAYER}，近来如何？\n"
	.string "宝可梦的世界很深。\p"
	.string "说实话，我觉得再怎么训练都不够。$"

PetalburgCity_Gym_Text_GymGuideAdvice1: @ 8206542
	.string "哟，向着冠军前进的{PLAYER}，\n"
	.string "过得怎么样？$"

PetalburgCity_Gym_Text_GymGuideAdvice2:
	.string "这间道馆的门，\n"
	.string "要打败守着它的训练家\p"
	.string "才会打开。\n"
	.string "哎哟！这间屋子的门已经开了，\p"
	.string "别打我啊！\n"
	.string "左边的门通往速度房间。\p"
	.string "右边的门通往命中房间。\n"
	.string "门上会写着房间名，仔细选。\p"
	.string "选好门之后……\n"
	.string "那就去吧！\p"
	.string "哦，还有，等你走到你爸爸那里，\n"
	.string "他有特别的东西给你！$"

PetalburgCity_Gym_Text_GymGuidePostVictory: @ 82066F3
	.string "{PLAYER}！哇！\n"
	.string "你连自己的父亲都赢过了！\p"
	.string "真是……哇！\n"
	.string "这发展太惊人了！$"

PetalburgCity_Gym_Text_RandallIntro: @ 820674F
	.string "能比对手先出手……\n"
	.string "光这一点就让我占了大便宜，\p"
	.string "你不觉得吗？$"

PetalburgCity_Gym_Text_RandallDefeat: @ 82067B9
	.string "真是一场精彩的对战！$"

PetalburgCity_Gym_Text_RandallPostBattle: @ 82067D8
	.string "去下一间房间吧，新的挑战在等你。\n"
	.string "左边是混乱房间。\p"
	.string "右边的门通往防御房间。$"

PetalburgCity_Gym_Text_RandallPostBadge: @ 820685E
	.string "不管赢了谁、输给谁，\n"
	.string "都从不逃避锻炼自己和宝可梦。\p"
	.string "我觉得这才叫道馆馆主。$"

PetalburgCity_Gym_Text_ParkerIntro: @ 82068FD
	.string "这里是混乱房间。\n"
	.string "让我看看你和宝可梦的羁绊有多深！$"

PetalburgCity_Gym_Text_ParkerDefeat: @ 820694F
	.string "没能把你们的队伍搅乱……\n"
	.string "你们的羁绊真强。$"

PetalburgCity_Gym_Text_ParkerPostBattle: @ 8206996
	.string "下一间是力量房间。\n"
	.string "你挡得住蛮力吗？$"

PetalburgCity_Gym_Text_ParkerPostBadge: @ 82069D9
	.string "自从我们馆主赢了之后，\n"
	.string "训练变得难多了。$"

PetalburgCity_Gym_Text_GeorgeIntro: @ 8206A1B
	.string "就在你以为要赢的时候，\n"
	.string "对手却回复了HP……\p"
	.string "你能想象那有多难受吗？\n"
	.string "我就让你好好体会一下！$"

PetalburgCity_Gym_Text_GeorgeDefeat: @ 8206AB8
	.string "HP没能回复够……\n"
	.string "好强的攻击力……$"

PetalburgCity_Gym_Text_GeorgePostBattle: @ 8206AE9
	.string "不愧是我们馆主的孩子。\n"
	.string "不，等等！训练家的实力\p"
	.string "只能靠努力换来。\n"
	.string "我输，是因为我的努力不够。\p"
	.string "去吧！下一间是一击必杀房间。$"

PetalburgCity_Gym_Text_GeorgePostBadge: @ 8206BB1
	.string "我会继续在道馆里修炼。\n"
	.string "总有一天我要当上馆主。$"

PetalburgCity_Gym_Text_BerkeIntro: @ 8206BF4
	.string "不会因为你是我们馆主的孩子\n"
	.string "就手下留情。\p"
	.string "我要让你知道，宝可梦被打中要害\n"
	.string "有多可怕！$"

PetalburgCity_Gym_Text_BerkeDefeat: @ 8206C7D
	.string "你的实力……\n"
	.string "是货真价实的。$"

PetalburgCity_Gym_Text_BerkePostBattle: @ 8206C9F
	.string "你父亲真的很强。\n"
	.string "他是值得我尊敬的训练家。\p"
	.string "而且，我从你身上也感到了\n"
	.string "同样的光芒。\p"
	.string "希望你们父子能打出一场\n"
	.string "精彩的对战！$"

PetalburgCity_Gym_Text_BerkePostBadge: @ 8206D56
	.string "自从你爸爸当上馆主，\n"
	.string "橙华市的训练家都变强了不少。$"

PetalburgCity_Gym_Text_MaryIntro: @ 8206DB2
	.string "嘻嘻……\n"
	.string "这里是命中房间。\p"
	.string "每一击都必定命中，\n"
	.string "那可是相当难受的。$"

PetalburgCity_Gym_Text_MaryDefeat: @ 8206E0D
	.string "你比我高出一筹……$"

PetalburgCity_Gym_Text_MaryPostBattle: @ 8206E26
	.string "还有更强的训练家在等你。\n"
	.string "左边是防御房间，\p"
	.string "右边是回复房间。\n"
	.string "不管走哪边，\p"
	.string "你的宝可梦的攻击力都会受到考验。$"

PetalburgCity_Gym_Text_MaryPostBadge: @ 8206ED8
	.string "你知道我们作为训练家\n"
	.string "追求的是什么吗？\p"
	.string "我们在努力与宝可梦\n"
	.string "成为灵魂相通的伙伴。$"

PetalburgCity_Gym_Text_AlexiaIntro: @ 8206F44
	.string "防御越高，我攻击起来就越放得开。$"

PetalburgCity_Gym_Text_AlexiaDefeat: @ 8206F82
	.string "我们的防御还不够……$"

PetalburgCity_Gym_Text_AlexiaPostBattle: @ 8206F9F
	.string "我想你教会了我宝贵的一课。\n"
	.string "现在，去吧！\p"
	.string "左边的门通往力量房间。\n"
	.string "右边的门通往一击必杀房间。\p"
	.string "两边的训练家都擅长进攻。$"

PetalburgCity_Gym_Text_AlexiaPostBadge: @ 8207069
	.string "嗨！你试过用冲浪吗？$"

PetalburgCity_Gym_Text_JodyIntro: @ 8207088
	.string "我们馆主吩咐我们全力打败你。\n"
	.string "哪怕你是馆主的孩子也一样！$"

PetalburgCity_Gym_Text_JodyDefeat: @ 82070E6
	.string "可是……我已经全力了！$"

PetalburgCity_Gym_Text_JodyPostBattle: @ 82070FB
	.string "你用宝可梦的方式……\n"
	.string "和你父亲很像。\p"
	.string "去吧！道馆馆主，你的父亲，\n"
	.string "正在等你！$"

PetalburgCity_Gym_Text_JodyPostBadge: @ 8207170
	.string "让宝可梦变强当然好。\n"
	.string "但决定胜负的是什么？\p"
	.string "是训练家对宝可梦的感情。$"

PetalburgCity_Gym_Text_DoorAppearsLocked: @ 82071F4
	.string "这扇门现在好像是锁着的……$"

PetalburgCity_Gym_Text_EnterSpeedRoom: @ 820721E
	.string "牌子上写着“速度房间”。\n"
	.string "要进去吗？$"

@ Unused
PetalburgCity_Gym_Text_DoorAppearsLocked2: @ 8207256
	.string "这扇门现在好像是锁着的……$"

PetalburgCity_Gym_Text_EnterAccuracyRoom: @ 8207280
	.string "牌子上写着“命中房间”。\n"
	.string "要进去吗？$"

PetalburgCity_Gym_Text_EnterMainRoom: @ 8207280
	.string "牌子上写着“主房间”。\n"
	.string "要进去吗？$"

PetalburgCity_Gym_Text_EnterConfusionRoom: @ 82072BB
	.string "牌子上写着“混乱房间”。\n"
	.string "要进去吗？$"

PetalburgCity_Gym_Text_EnterDefenseRoom: @ 82072F7
	.string "牌子上写着“防御房间”。\n"
	.string "要进去吗？$"

PetalburgCity_Gym_Text_EnterRecoveryRoom: @ 8207331
	.string "牌子上写着“回复房间”。\n"
	.string "要进去吗？$"

PetalburgCity_Gym_Text_EnterStrengthRoom: @ 820736C
	.string "牌子上写着“力量房间”。\n"
	.string "要进去吗？$"

PetalburgCity_Gym_Text_EnterOHKORoom: @ 82073A7
	.string "牌子上写着“一击必杀房间”。\n"
	.string "要进去吗？$"

PetalburgCity_Gym_Text_EnterGymLeadersRoom: @ 82073E4
	.string "“道馆馆主的房间。”\n"
	.string "“准备好被你爸爸揍一顿吧！”\p"
	.string "牌子上这么写着。\n"
	.string "要进去吗？$"

PetalburgCity_Gym_Text_GymStatue: @ 820744C
	.string "橙华市宝可梦道馆$"

PetalburgCity_Gym_Text_GymStatueCertified: @ 8207467
	.string "橙华市宝可梦道馆\n"
	.string "千里的认定训练家：\p"
	.string "{PLAYER}$"

PetalburgCity_Gym_Text_NormanPreRematch: @ 82074A2
	.string "正因为我们是父子，\n"
	.string "才更要彼此拿出最好的表现。\p"
	.string "对吧，{PLAYER}？$"

PetalburgCity_Gym_Text_NormanRematchDefeat: @ 82075CE
	.string "呃……哈哈……\n"
	.string "也许我下手太重了……$"

PetalburgCity_Gym_Text_NormanPostRematch: @ 82075F7
	.string "爸爸：{PLAYER}……\n"
	.string "你的梦想是什么？\p"
	.string "我的梦想……\n"
	.string "哈哈哈……\p"
	.string "其实已经实现了。$"

PetalburgCity_Gym_Text_NormanRematchNeedTwoMons: @ 820764A
	.string "爸爸：嗯？等一下，{PLAYER}。\n"
	.string "你能对战的宝可梦只有一只吗？\p"
	.string "抱歉，你至少得带两只再来。$"

PetalburgCity_Gym_Text_NormanChooseFormat:
	.string "爸爸：{PLAYER}……\n"
	.string "我就知道你会来。\p"
	.string "我绝不会拒绝你的挑战。\n"
	.string "你明白吧？\p"
	.string "在道馆里，父子关系不算什么。\n"
	.string "再战的条件由你来定。\p"
	.string "那么，单打还是双打？$"

PetalburgCity_Gym_Text_NormanAllowLegends:
	.string "爸爸：想试试和我的传说宝可梦打一\n"
	.string "场吗？$"
`

script PetalburgCity_Gym_EventScript_Kangaskhan{
	msgbox(format("这只特别的宝可梦，\n就当作我送你的礼物！$"))
	givecustommon(SPECIES_KANGASKHAN, 45, ITEM_FLAME_ORB, ITEM_CHERISH_BALL, NATURE_JOLLY, 2, 0, 252, 4, 252, 0, 0, 0, 0, 0, 0, 0, 0, MOVE_FAKE_OUT, MOVE_DRAIN_PUNCH, MOVE_FACADE, MOVE_COMET_PUNCH, FALSE)
	playfanfare(MUS_OBTAIN_ITEM)
	msgbox(format("{PLAYER}得到了千里的{COLOR BLUE}袋兽{COLOR DARK_GRAY}！$"))
	waitfanfare
	setflag(FLAG_RECEIVED_TM42)
	return
}


script PetalburgCity_Gym_EventScript_Norman{
	lock
	faceplayer
	switch(var(VAR_PETALBURG_GYM_STATE)){
		case 0:
			//Wally Tutorial
			goto(PetalburgCity_Gym_EventScript_Norman_WallyTutorial)
		break
		case 1:
			//No idea what goes here this is a failsafe
			msgbox(format("这是保险措施。\n如果你看到这行文字，\p请提交错误报告。$"), MSGBOX_DEFAULT)
			release
			end
		break
		case 2:
			//failsafe
			if (flag(FLAG_BADGE01_GET) && flag(FLAG_BADGE02_GET) && flag(FLAG_BADGE03_GET) && flag(FLAG_BADGE04_GET)){
				setvar(VAR_PETALBURG_GYM_STATE, 6)
				warp(MAP_PETALBURG_CITY, 255, 15,9)
				waitstate
				release
				end
			}
			msgbox(PetalburgCity_Gym_Text_NormanGoToRustboro, MSGBOX_DEFAULT)
			release
			end
		break
		case 3:
			if (flag(FLAG_BADGE01_GET) && flag(FLAG_BADGE02_GET) && flag(FLAG_BADGE03_GET) && flag(FLAG_BADGE04_GET)){
				setvar(VAR_PETALBURG_GYM_STATE, 6)
				warp(MAP_PETALBURG_CITY, 255, 15,9)
				waitstate
				release
				end
			}
			msgbox(PetalburgCity_Gym_Text_NormanGoToDewford, MSGBOX_DEFAULT)
			release
			end
		break
		case 4:
			if (flag(FLAG_BADGE01_GET) && flag(FLAG_BADGE02_GET) && flag(FLAG_BADGE03_GET) && flag(FLAG_BADGE04_GET)){
				setvar(VAR_PETALBURG_GYM_STATE, 6)
				warp(MAP_PETALBURG_CITY, 255, 15,9)
				waitstate
				release
				end
			}
			msgbox(PetalburgCity_Gym_Text_YouHaveGottenStronger, MSGBOX_DEFAULT)
			release
			end
		break
		case 5:
			if (flag(FLAG_BADGE01_GET) && flag(FLAG_BADGE02_GET) && flag(FLAG_BADGE03_GET) && flag(FLAG_BADGE04_GET)){
				setvar(VAR_PETALBURG_GYM_STATE, 6)
				warp(MAP_PETALBURG_CITY, 255, 15,9)
				waitstate
				release
				end
			}
			msgbox(PetalburgCity_Gym_Text_YouHaveGottenStronger, MSGBOX_DEFAULT)
			release
			end
		break
		case 6:
			if(flag(FLAG_SYS_RECEIVED_KEYSTONE)){
				goto(PetalburgCity_Gym_EventScript_NormanBattle)
			}
			else{
				msgbox(PetalburgCity_Gym_Text_NormanIntro, MSGBOX_DEFAULT)
				giveitem(ITEM_MEGA_BRACELET)
				setflag(FLAG_SYS_RECEIVED_KEYSTONE)
				msgbox(PetalburgCity_Gym_Text_NormanMegaBracelet, MSGBOX_DEFAULT)
				giveBattleItems
				playfanfare(MUS_OBTAIN_ITEM)
				message(format("{PLAYER}得到了一些{COLOR LIGHT_GREEN}进化石{COLOR DARK_GRAY}！$"))
				waitfanfare
				closemessage
				delay(30)
				msgbox(format("那么，{PLAYER}！\n我随时都可以开始！$"), MSGBOX_DEFAULT)
				closemessage
				end
			}
		break
		case 7:
		case 8:
		default:
			// dd changes caused VAR_PETALBURG_GYM_STATE to be incremented more than it should
			// even if the cause was fixed eventually.
			if (!flag(FLAG_BADGE06_GET)){
				setvar(VAR_PETALBURG_GYM_STATE, 6)
				goto(PetalburgCity_Gym_EventScript_Norman)
			}
			//Give Slakingite
			if(flag(FLAG_BADGE06_GET) && !flag(FLAG_OBTAINED_SLAKINGITE)){ // Checking if the player has already received the item
				msgbox(format("这件特别的物品，\n就当作我送你的礼物！$"))
				giveitem(ITEM_SLAKINGITE)
				playfanfare(MUS_OBTAIN_ITEM)
				waitfanfare
				setflag(FLAG_OBTAINED_SLAKINGITE)
				release
				end
			}
			elif(!flag(FLAG_RECEIVED_TM42)){
				goto(PetalburgCity_Gym_EventScript_Kangaskhan)
			}
			elif(flag(FLAG_SYS_GAME_CLEAR)){
				goto(PetalburgCity_Gym_EventScript_Norman_Rematch)
			}
			else{
				msgbox(PetalburgCity_Gym_Text_DadGoingToKeepTraining, MSGBOX_DEFAULT)
				release
				end
			}
		break
	}
}

script PetalburgCity_Gym_EventScript_Norman_WallyTutorial{
	msgbox(PetalburgCity_Gym_Text_DadYoureHereWithYourPokemon, MSGBOX_DEFAULT)
	closemessage
	switch(var(VAR_FACING)){
		case DIR_SOUTH:
			goto(PetalburgCity_Gym_EventScript_BeginWallyTutorialSouth)
		break
		case DIR_NORTH:
			goto(PetalburgCity_Gym_EventScript_BeginWallyTutorialNorth)
		break
		case DIR_WEST:
			goto(PetalburgCity_Gym_EventScript_BeginWallyTutorialWest)
		break
		case DIR_EAST:
			goto(PetalburgCity_Gym_EventScript_BeginWallyTutorialEast)
		break
	}
	end
}

script PetalburgCity_Gym_EventScript_Norman_Rematch{
	message(PetalburgCity_Gym_Text_NormanChooseFormat)
	waitmessage
	multichoice(17, 6, MULTI_REMATCH_BATTLE_MODE, 0)
	switch(var(VAR_RESULT)){
	case 0:
		goto(PetalburgCity_Gym_EventScript_SetSingles)
	break
	case 1:
		goto(PetalburgCity_Gym_EventScript_SetDoubles)
	case 2:
	case 127:
		goto(PetalburgCity_Gym_EventScript_Exit)
	break
	}
	releaseall
	end
}

script PetalburgCity_Gym_EventScript_Randall{
	lock
	faceplayer
	goto_if_set(FLAG_DEFEATED_PETALBURG_GYM, PetalburgCity_Gym_EventScript_RandallPostBadge)
	if (defeated(TRAINER_RANDALL)){
		msgbox(PetalburgCity_Gym_Text_RandallPostBattle, MSGBOX_AUTOCLOSE)
	} else {
		yesnobattle(format("喂，在跟你老爸打之前，\n先来跑一场怎么样？提醒你，\p{COLOR GREEN}我跑得越久就越快！{COLOR DARK_GRAY}。$"))
		if (var(VAR_RESULT)){
			trainerbattle_single(TRAINER_RANDALL, PetalburgCity_Gym_Text_RandallIntro , PetalburgCity_Gym_Text_RandallDefeat)
		}
	}
	release
	end
}

