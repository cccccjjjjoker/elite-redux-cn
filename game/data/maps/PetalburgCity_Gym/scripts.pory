script PetalburgCity_Gym_EventScript_CheckTrainers{
    if (defeated(TRAINER_NORMAN_1)) {
        msgbox(PetalburgCity_Gym_Text_YouHaveGottenStronger, MSGBOX_DEFAULT)
        release
        end
    }
    // set battle event flags
    if (!defeated(TRAINER_RANDALL)){
		registerbattleevent(BATTLE_EVENT_POSTURE_SPEED)
    }
	if (!defeated(TRAINER_MARY)){
		registerbattleevent(BATTLE_EVENT_STEADY_ACCURACY)
		registerbattleevent(BATTLE_EVENT_LAST_STAND, 5, 5)
    }
    if (!defeated(TRAINER_PARKER)){
		registerbattleevent(BATTLE_EVENT_SPIKES, 2)
    }
	if (!defeated(TRAINER_ALEXIA)){
		registerbattleevent(BATTLE_EVENT_POSTURE_DEFENSE)
    }
    if (!defeated(TRAINER_GEORGE)){
		registerbattleevent(BATTLE_EVENT_ONSTAY_LEECH_SEED, 3)
    }
	if (!defeated(TRAINER_JODY)){
		registerbattleevent(BATTLE_EVENT_POSTURE_OFFENSE)
    }
    if (!defeated(TRAINER_BERKE)){
		registerbattleevent(BATTLE_EVENT_SUBSTITUTE, 5)
    }
    
}

text PetalburgCity_Gym_Text_NormanBattleIntro0{
    format("所以你是想跟我真打一场，是吗，\n{PLAYER}？那好！\p让你老爸教你怎么打！$")
}
text PetalburgCity_Gym_Text_NormanBattleIntro1{
    format("你就这么急着走？\n那你最好有那个本事。来吧，\p{PLAYER}！$")
}
text PetalburgCity_Gym_Text_NormanBattleIntroAll{
    format("看来你已经学到了你老爸这道馆要教\n的东西。那么，{PLAYER}，\p能用出来吗？$")
}
text PetalburgCity_Gym_Text_NormanDefeat0{
	format("我……我不敢相信。\n在这么不利的情况下，\p我居然输给了{PLAYER}？\n这就是你想要的挑战吗？\p我真为你骄傲！$")
}
text PetalburgCity_Gym_Text_NormanDefeat1{
	format("嗯，看来你确实准备好了。\n干得漂亮，{PLAYER}！我很佩服。$")
}
text PetalburgCity_Gym_Text_NormanDefeatAll{
	format("我就猜会是这样……\n你成长了这么多，{PLAYER}。\p恭喜你获胜！$")
}
script PetalburgCity_Gym_EventScript_NormanBattle{
    call(PetalburgCity_Gym_EventScript_CheckTrainers)
    setvar(VAR_0x8004, 15)
    //msgbox(PetalburgCity_Gym_Text_NormanBattleIntro, MSGBOX_DEFAULT)
	registerbattleevent(BATTLE_EVENT_TENSE_BATTLE)
	adddefeatedcount(TRAINER_RANDALL, 1)
	adddefeatedcount(TRAINER_MARY)
	adddefeatedcount(TRAINER_PARKER)
	adddefeatedcount(TRAINER_ALEXIA)
	adddefeatedcount(TRAINER_GEORGE)
	adddefeatedcount(TRAINER_JODY)
	adddefeatedcount(TRAINER_BERKE)
    switch (var(VAR_RESULT)) {
        case 0:
            trainerbattle_single(TRAINER_NORMAN_1 PetalburgCity_Gym_Text_NormanBattleIntro0, PetalburgCity_Gym_Text_NormanDefeat0, PetalburgCity_Gym_EventScript_NormanAfterBattle, NO_MUSIC)
        break
        case 7:
            trainerbattle_single(TRAINER_NORMAN_1, PetalburgCity_Gym_Text_NormanBattleIntroAll, PetalburgCity_Gym_Text_NormanDefeatAll, PetalburgCity_Gym_EventScript_NormanAfterBattle, NO_MUSIC)
        break
        default:
            trainerbattle_single(TRAINER_NORMAN_1, PetalburgCity_Gym_Text_NormanBattleIntro1, PetalburgCity_Gym_Text_NormanDefeat1, PetalburgCity_Gym_EventScript_NormanAfterBattle, NO_MUSIC)
    }
    
}


script PetalburgCity_Gym_EventScript_AskResetTrainers{
	lock
	clydeaskresettrainers(PetalburgCity_Gym_EventScript_ResetAllTrainers, PetalburgCity_Gym_EventScript_SelectTrainers)
	release
	end
}
script PetalburgCity_Gym_EventScript_ResetAllTrainers{
	cleartrainerflag(TRAINER_RANDALL)
	cleartrainerflag(TRAINER_MARY)
	cleartrainerflag(TRAINER_PARKER)
	cleartrainerflag(TRAINER_ALEXIA)
	cleartrainerflag(TRAINER_GEORGE)
	cleartrainerflag(TRAINER_JODY)
	cleartrainerflag(TRAINER_BERKE)
	cleartrainerflag(TRAINER_NORMAN_1)
	return
}

movement PetalburgCity_Gym_Movement_Jody{
	walk_fastest_left * 1
	walk_fastest_up * 18
}

movement PetalburgCity_Gym_Movement_Mary{
	walk_fastest_right * 4
}

movement PetalburgCity_Gym_Movement_Parker{
	walk_fastest_up * 5
}

movement PetalburgCity_Gym_Movement_Alexia{
	walk_fastest_left * 2
}

movement PetalburgCity_Gym_Movement_Berke{
	walk_fastest_left * 2
}

movement PetalburgCity_Gym_Movement_Randall{
	walk_fastest_up * 5
}

movement PetalburgCity_Gym_Movement_George{
	walk_fastest_right * 4
}

movement PetalburgCity_Gym_Movement_Norman{
	walk_fastest_left * 2
	walk_fastest_up * 14
}

// don't forget to bring you back to the player
movement PetalburgCity_Gym_Movement_Clyde{
	walk_fastest_left * 1
	walk_fastest_down * 42
}

script PetalburgCity_Gym_EventScript_SelectTrainers{
	special(SpawnCameraObject)
	selecttrainercameraoffset()
	selecttrainer(PetalburgCity_Gym_Movement_Jody, "Jody", TRAINER_JODY)
	selecttrainer(PetalburgCity_Gym_Movement_Mary, "Mary", TRAINER_MARY)
	selecttrainer(PetalburgCity_Gym_Movement_Parker, "Parker", TRAINER_PARKER)
	selecttrainer(PetalburgCity_Gym_Movement_Alexia, "Alexia", TRAINER_ALEXIA)
	selecttrainer(PetalburgCity_Gym_Movement_Berke, "Berke", TRAINER_BERKE)
	selecttrainer(PetalburgCity_Gym_Movement_Randall, "Randall", TRAINER_RANDALL)
	selecttrainer(PetalburgCity_Gym_Movement_George, "George", TRAINER_GEORGE)
	selecttrainer(PetalburgCity_Gym_Movement_Norman, "Norman", TRAINER_NORMAN_1)
	applymovement(OBJ_EVENT_ID_CAMERA, PetalburgCity_Gym_Movement_Clyde)
	waitmovement(0)
	selecttrainercameraoffset(TRUE)
	special(RemoveCameraObject)
	return
}
