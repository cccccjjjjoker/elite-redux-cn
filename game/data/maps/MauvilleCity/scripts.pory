MauvilleCity_EventScript_Wattson:: @ 81DF73A
	lock
	faceplayer
	goto_if_set FLAG_GOT_TM24_FROM_WATTSON, MauvilleCity_EventScript_ReceivedThunderbolt
	compare VAR_NEW_MAUVILLE_STATE, 6
	goto_if_eq MauvilleCity_EventScript_CompletedNewMauville
	goto_if_set FLAG_GOT_BASEMENT_KEY_FROM_WATTSON, MauvilleCity_EventScript_BegunNewMauville
	msgbox MauvilleCity_Text_WattsonNeedFavorTakeKey, MSGBOX_DEFAULT
	giveitem ITEM_BASEMENT_KEY
	setflag FLAG_GOT_BASEMENT_KEY_FROM_WATTSON
	msgbox MauvilleCity_Text_WattsonWontBeChallenge, MSGBOX_DEFAULT
	release
	end

MauvilleCity_EventScript_BegunNewMauville:: @ 81DF77A
	msgbox MauvilleCity_Text_WattsonWontBeChallenge, MSGBOX_DEFAULT
	release
	end

MauvilleCity_EventScript_CompletedNewMauville:: @ 81DF784
	msgbox MauvilleCity_Text_WattsonThanksTakeTM, MSGBOX_DEFAULT
	givecustommon SPECIES_LANTURN, 55, ITEM_LANTURNITE, ITEM_POKE_BALL, NATURE_MODEST, 1, 252, 0, 0, 4, 252, 0, 0, 0, 0, 0, 0, 0, MOVE_VOLT_SWITCH, MOVE_SPARKLING_ARIA, MOVE_BLIZZARD, MOVE_DAZZLING_GLEAM, FALSE
	playfanfare MUS_OBTAIN_ITEM
	message MauvilleCity_Text_Got_Lanturn
	waitfanfare
	setflag FLAG_GOT_TM24_FROM_WATTSON
	msgbox MauvilleCity_Text_WattsonYoungTakeCharge, MSGBOX_DEFAULT
	release
	end

MauvilleCity_EventScript_ReceivedThunderbolt:: @ 81DF7B0
	msgbox MauvilleCity_Text_WattsonYoungTakeCharge, MSGBOX_DEFAULT
	release
	end

MauvilleCity_EventScript_RegisterWallyCall:: @ 81DF7BA
	lockall
	@ pokenavcall MauvilleCity_Text_WallyPokenavCall
	@ waitmessage
	@ delay 30
	@ playfanfare MUS_REGISTER_MATCH_CALL
	@ msgbox MauvilleCity_Text_RegisteredWally, MSGBOX_DEFAULT
	@ waitfanfare
	@ closemessage
	@ delay 30
	setflag FLAG_ENABLE_WALLY_MATCH_CALL
	clearflag FLAG_ENABLE_FIRST_WALLY_POKENAV_CALL
	releaseall
	end

MauvilleCity_Text_UncleHesTooPeppy: @ 81DF7DC
	.string "叔叔：我想这孩子有精神，\n"
	.string "都是因为宝可梦……\p"
	.string "但他现在有点太有精神了……$"

MauvilleCity_Text_WallyWantToChallengeGym: @ 81DF845
	.string "小胜：哎呀，叔叔，拜托嘛？\p"
	.string "我想挑战这个道馆，\n"
	.string "看看自己进步了多少。\p"
	.string "拜托？可以吗，拜托？$"

MauvilleCity_Text_UncleYourePushingIt: @ 81DF8B9
	.string "叔叔：等等，小胜。\p"
	.string "自从你和宝可梦一起生活，\n"
	.string "确实强了不少。\p"
	.string "可突然去挑战道馆，\n"
	.string "你不觉得太勉强了吗？$"

MauvilleCity_Text_WallyWeCanBeatAnyone: @ 81DF963
	.string "小胜：才不勉强。\p"
	.string "只要我和沙奈朵联手，\n"
	.string "谁都能打赢！$"

MauvilleCity_Text_WallyWillYouBattleMe: @ 81DF9B2
	.string "小胜：哦！嗨，{PLAYER}！\p"
	.string "自从我们见面之后，\n"
	.string "我变强了很多。\p"
	.string "{PLAYER}，我希望你\n"
	.string "和我叔叔都能明白这一点。\p"
	.string "{PLAYER}，拜托，\n"
	.string "能和我打一场吗？$"

MauvilleCity_Text_WallyMyUncleWontKnowImStrong: @ 81DFA4A
	.string "小胜：哦……{PLAYER}，\n"
	.string "你要是不跟我打，\p"
	.string "叔叔就不会知道我变强了。$"

MauvilleCity_Text_UncleCanYouBattleWally: @ 81DFAA5
	.string "叔叔：你是{PLAYER}{KUN}吧？\p"
	.string "我能替小胜求你\n"
	.string "就跟他打这一次吗？\p"
	.string "他现在这样，\n"
	.string "大概什么道理都听不进去。$"

MauvilleCity_Text_WallyPleaseBattleMe: @ 81DFB42
	.string "小胜：{PLAYER}，拜托！\p"
	.string "跟我打一场，拜托。$"

MauvilleCity_Text_WallyHereICome: @ 81DFB6D
	.string "小胜：{PLAYER}，谢谢你。\p"
	.string "好……我来了！$"

MauvilleCity_Text_WallyDefeat: @ 81DFB96
	.string "小胜：…… …… …… ……\p"
	.string "…… …… …… …… ……\p"
	.string "我输了……$"

MauvilleCity_Text_WallyIllGoBackToVerdanturf: @ 81DFBC3
	.string "小胜：叔叔……\p"
	.string "我回绿茵镇去……$"

MauvilleCity_Text_ThankYouNotEnoughToBattle: @ 81DFBED
	.string "{PLAYER}，谢谢你。\p"
	.string "当训练家真难啊。\p"
	.string "光有宝可梦、让它们对战\n"
	.string "是不够的。\p"
	.string "真正的训练家\n"
	.string "并不是那样的。$"

MauvilleCity_Text_UncleNoNeedToBeDown: @ 81DFC8A
	.string "叔叔：小胜，不用这么消沉。\p"
	.string "你看，有什么能拦住你\n"
	.string "变得越来越强呢？\p"
	.string "来吧，我们回家。\n"
	.string "大家都在等你。$"

MauvilleCity_Text_UncleVisitUsSometime: @ 81DFD34
	.string "叔叔：{PLAYER}{KUN}，我刚想起来，\n"
	.string "你一定是小胜抓宝可梦时\p"
	.string "在一旁照看他的那位训练家。\p"
	.string "有空来绿茵镇看看我们吧？\p"
	.string "小胜一定会很高兴。$"


MauvilleCity_Text_WallyPokenavCall: @ 81DFDFB
	.string "…… …… ……\n"
	.string "…… …… …… 嘀！\p"
	.string "小胜：哦，你好，{PLAYER}！\p"
	.string "我只是想告诉你，\n"
	.string "叔叔给我买了个宝可梦领航器！\p"
	.string "现在随时都能联系你了，\n"
	.string "{PLAYER}！\p"
	.string "…… …… ……\n"
	.string "…… …… …… 咔嗒！$"

MauvilleCity_Text_RegisteredWally: @ 81DFEB4
	.string "已将小胜\n"
	.string "登记到宝可梦领航器中。$"

MauvilleCity_Text_ScottYouDidntHoldBack: @ 81DFED5
	.string "斯科特：嘿嘿……\p"
	.string "我刚才在看那场比赛！\p"
	.string "你和那个叫小胜的孩子\n"
	.string "是朋友吧？\p"
	.string "可你一点都没留手，\n"
	.string "赢得漂亮。\p"
	.string "对！真正的宝可梦对战\n"
	.string "就该是这样！\p"
	.string "我最崇拜这样的训练家！\p"
	.string "…… …… ……\n"
	.string "我会为你加油的！$"

MauvilleCity_Text_WattsonNeedFavorTakeKey: @ 81DFFE4
	.string "铁旋：哦，{PLAYER}{KUN}！\n"
	.string "你看起来干劲十足！\p"
	.string "这是好事，哇哈哈哈！\p"
	.string "好！我决定了！\n"
	.string "{PLAYER}{KUN}，我要请你帮个忙！\p"
	.string "紫堇市有个地下区域，\n"
	.string "叫新紫堇。\p"
	.string "{PLAYER}{KUN}，我想请你\n"
	.string "去那儿关掉发电机。\p"
	.string "发电机最近有点失控，\n"
	.string "越来越不安全了。\p"
	.string "来，这是进入新紫堇的钥匙。$"

MauvilleCity_Text_WattsonWontBeChallenge: @ 81E0154
	.string "铁旋：别担心。\n"
	.string "这对你不算什么。\p"
	.string "新紫堇的入口\n"
	.string "从 110 号道路冲浪一小段就到。\p"
	.string "那就这样，我信得过你！\n"
	.string "哇哈哈哈！$"

MauvilleCity_Text_WattsonThanksTakeTM: @ 81E020E
	.string "铁旋：哇哈哈哈！\p"
	.string "我就知道，{PLAYER}{KUN}！\n"
	.string "我就知道找你没错！\p"
	.string "这是我的谢礼，收下吧。\p"
	.string "拿去吧，这是你应得的！$"

MauvilleCity_Text_WattsonYoungTakeCharge: @ 81E02AA
	.string "铁旋：哇哈哈哈！\p"
	.string "看到年轻人站出来担事，\n"
	.string "我高兴得不得了！$"

MauvilleCity_Text_NurseHurtMonBackToHealth: @ 81E0301
	.string "你知道吗，打宝可梦对战\n"
	.string "什么的确实很酷……\p"
	.string "可宝可梦受伤了，\n"
	.string "你得把它照顾到康复。$"

MauvilleCity_Text_AllSortsOfPeopleComeThrough: @ 81E037C
	.string "这个镇的道路南北东西\n"
	.string "四通八达。\p"
	.string "所以各种各样的人\n"
	.string "都会从这里经过。$"

MauvilleCity_Text_RydelVeryGenerous: @ 81E03FB
	.string "你去过利德尔自行车店了吗？\p"
	.string "老板利德尔是个\n"
	.string "非常大方的人。$"

MauvilleCity_Text_PokemonCanJumpYouOnBike: @ 81E044A
	.string "就算你骑着自行车，\n"
	.string "野生宝可梦也可能扑上来。$"

MauvilleCity_Text_CitySign: @ 81E0485
	.string "紫堇市\n"
	.string "“明亮闪耀的娱乐之城！”$"

MauvilleCity_Text_GymSign: @ 81E04B7
	.string "紫堇市宝可梦道馆\n"
	.string "馆主：铁旋\p"
	.string "“开朗的电气大叔！”$"

MauvilleCity_Text_BikeShopSign: @ 81E0504
	.string "“在砂石上飞驰，\n"
	.string "震撼你的灵魂！”\p"
	.string "利德尔自行车店$"

MauvilleCity_Text_GameCornerSign: @ 81E053C
	.string "“所有人的游乐场！”\n"
	.string "紫堇游戏城$"

MauvilleCity_Text_MoveTutorSign:
	.string "紫堇招式教学\n"
	.string "“给初始宝可梦的特别招式！”$"

MauvilleCity_Text_ExplainTV: @ 81E056A
	.string "嗨，你看电视吗？\p"
	.string "最近他们加了不少\n"
	.string "有趣的新节目。\p"
	.string "电视真酷。\n"
	.string "我还曾在电视上突然\p"
	.string "看到我的朋友。\p"
	.string "而且有时候，\n"
	.string "他们不打招呼就把你放上电视。\p"
	.string "我真希望哪天也能上电视。\p"
	.string "所以我觉得，\n"
	.string "你该抓住机会多看看电视。$"

MauvilleCity_Text_BeenCheckingOutTV: @ 81E0699
	.string "嗨，你最近看电视了吗？$"

MauvilleCity_Text_GiveTM74:
	.string "你知道吗？从这儿朝那个方向\n"
	.string "一直走，不用转弯\p"
	.string "就能走很远。\p"
	.string "说不定我还能滚过去。\p"
	.string "你觉得你的宝可梦\n"
	.string "也想滚一滚吗？\p"
	.string "来，愿意的话让它们\n"
	.string "试试这个招式学习器。$"

MauvilleCity_Text_HaveTM74:
	.string "我那些慢吞吞的宝可梦\n"
	.string "很喜欢陀螺球，\p"
	.string "自己比对手越慢，\n"
	.string "这招的伤害越高。$"
`
text MauvilleCity_Text_Got_Lanturn{
	format("{PLAYER}得到了铁旋的\n{COLOR BLUE}电灯怪{COLOR DARK_GRAY}\p作为礼物！$")
}