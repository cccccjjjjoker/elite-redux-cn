	walk_in_place_fastest_right
	step_end

RivalsHouse_2F_EventScript_Rival:: @ 81F94C1
	lockall
	goto_if_set FLAG_MET_RIVAL_LILYCOVE, RivalsHouse_2F_EventScript_RivalPostLilycove
	checkplayergender
	compare VAR_RESULT, MALE
	goto_if_eq RivalsHouse_2F_EventScript_May
	compare VAR_RESULT, FEMALE
	goto_if_eq RivalsHouse_2F_EventScript_Brendan
	end

RivalsHouse_2F_EventScript_May:: @ 81F94E3
	msgbox RivalsHouse_2F_Text_MayGettingReady, MSGBOX_DEFAULT
	releaseall
	end

RivalsHouse_2F_EventScript_Brendan:: @ 81F94ED
	msgbox RivalsHouse_2F_Text_BrendanGettingReady, MSGBOX_DEFAULT
	releaseall
	end

RivalsHouse_2F_EventScript_RivalPostLilycove:: @ 81F94F7
	applymovement VAR_LAST_TALKED, Common_Movement_FacePlayer
	waitmovement 0
	checkplayergender
	compare VAR_RESULT, MALE
	call_if_eq RivalsHouse_2F_EventScript_MayPostLilycove
	compare VAR_RESULT, FEMALE
	call_if_eq RivalsHouse_2F_EventScript_BrendanPostLilycove
	setflag FLAG_MET_RIVAL_IN_HOUSE_AFTER_LILYCOVE
	releaseall
	end

RivalsHouse_2F_EventScript_MayPostLilycove:: @ 81F951D
	goto_if_set FLAG_MET_RIVAL_IN_HOUSE_AFTER_LILYCOVE, RivalsHouse_2F_EventScript_MayWhereShouldIGoNext
	msgbox RivalsHouse_2F_Text_MayJustCheckingMyPokedex, MSGBOX_DEFAULT
	return

RivalsHouse_2F_EventScript_BrendanPostLilycove:: @ 81F952F
	goto_if_set FLAG_MET_RIVAL_IN_HOUSE_AFTER_LILYCOVE, RivalsHouse_2F_EventScript_BrendanWhereShouldIGoNext
	msgbox RivalsHouse_2F_Text_BrendanJustCheckingMyPokedex, MSGBOX_DEFAULT
	return

RivalsHouse_2F_EventScript_MayWhereShouldIGoNext:: @ 81F9541
	msgbox RivalsHouse_2F_Text_MayWhereShouldIGoNext, MSGBOX_DEFAULT
	return

RivalsHouse_2F_EventScript_BrendanWhereShouldIGoNext:: @ 81F954A
	msgbox RivalsHouse_2F_Text_BrendanWhereShouldIGoNext, MSGBOX_DEFAULT
	return

LittlerootTown_MaysHouse_2F_EventScript_PC:: @ 81F9553
	lockall
	checkplayergender
	compare VAR_RESULT, MALE
	goto_if_eq LittlerootTown_MaysHouse_2F_EventScript_CheckRivalsPC
	compare VAR_RESULT, FEMALE
	goto_if_eq LittlerootTown_MaysHouse_2F_EventScript_CheckPlayersPC
	end

LittlerootTown_MaysHouse_2F_EventScript_CheckRivalsPC:: @ 81F956C
	msgbox gText_PokemonTrainerSchoolEmail, MSGBOX_DEFAULT
	releaseall
	end

LittlerootTown_MaysHouse_2F_EventScript_CheckPlayersPC:: @ 81F9576
	goto EventScript_PC

LittlerootTown_MaysHouse_2F_EventScript_TurnOffPlayerPC:: @ 81F958F
	setvar VAR_0x8004, 2
	playse SE_PC_OFF
	special DoPCTurnOffEffect
	releaseall
	end

RivalsHouse_2F_Text_MayWhoAreYou: @ 81F959C
	.string "咦？\n"
	.string "你……你是谁？\p"
	.string "……………………\n"
	.string "……………………\p"
	.string "哦，你是{PLAYER}{KUN}。\n"
	.string "原来你今天搬来了。\p"
	.string "嗯……我是小遥。\n"
	.string "很高兴认识你！\p"
	.string "我……\n"
	.string "我有个梦想，就是想和\p"
	.string "全世界的宝可梦成为朋友。\n"
	.string "我……我听我爸爸小田卷博士\p"
	.string "提起过你，{PLAYER}{KUN}。\n"
	.string "我一直在想，希望你是位\p"
	.string "好相处的人，我们能做朋友。\n"
	.string "哦，这真傻，对吧？\p"
	.string "我……我才刚认识你，{PLAYER}{KUN}。\n"
	.string "呵呵……\p"
	.string "哦，糟了！我忘了！\n"
	.string "我本来要去帮爸爸\p"
	.string "抓野生宝可梦的！\n"
	.string "哦，对了，这倒提醒我了！\p"
	.string "你该去看看爸爸最新的宝可梦！\n"
	.string "他刚得到三只非常稀有的，\p"
	.string "从那个，嗯……$"

RivalsHouse_2F_Text_MayCatchYouLater:
	.string "咦？{STR_VAR_2}地区？\n"
	.string "哇，应该就是那个！\p"
	.string "{PLAYER}{KUN}，回头见！$"

RivalsHouse_2F_Text_MayGettingReady: @ 81F978A
	.string "宝可梦已完全恢复！\n"
	.string "道具也准备好了，还有……$"

RivalsHouse_2F_Text_BrendanWhoAreYou: @ 81F97B4
	.string "嘿！\n"
	.string "你……\p"
	.string "你是谁？\n"
	.string "哦，你是{PLAYER}吧？\p"
	.string "搬到隔壁来的，对吧？\n"
	.string "我不知道你是女孩子。\p"
	.string "我爸爸小田卷博士说，\n"
	.string "新搬来的邻居是道馆馆主的\p"
	.string "孩子，所以我还以为是男生。\n"
	.string "我叫祐树。\p"
	.string "那么，你好啊，邻居！\n"
	.string "咦？嘿，{PLAYER}，\p"
	.string "你没有宝可梦吗？\n"
	.string "要我去帮你抓一只吗？\p"
	.string "啊，糟了，我忘了……\n"
	.string "我本来要去帮爸爸\p"
	.string "抓野生宝可梦的。\n"
	.string "哦，你该去看看爸爸\p"
	.string "刚得到的三只新宝可梦。\n"
	.string "它们非常稀有，而且都是从\p"
	.string "那个，呃……$"

RivalsHouse_2F_Text_BrendanSomeOtherTime:
	.string "那个{STR_VAR_2}地区？\n"
	.string "唔，好像确实是那个。\p"
	.string "下次再说，好吗？$"

RivalsHouse_2F_Text_BrendanGettingReady: @ 81F9962
	.string "宝可梦已完全恢复……\n"
	.string "道具都装好了，还有……$"

RivalsHouse_2F_Text_ItsRivalsPokeBall: @ 81F9991
	.string "这是{RIVAL}的精灵球！\n"
	.string "还是别动它，就放在原处吧。$"

RivalsHouse_2F_Text_MayJustCheckingMyPokedex: @ 81F99C9
	.string "小遥：{PLAYER}{KUN}！\n"
	.string "我刚刚在查我的宝可梦图鉴。\p"
	.string "还有好多宝可梦是我见过\n"
	.string "却没抓到的。\p"
	.string "还有很多我觉得\n"
	.string "应该会进化的。\p"
	.string "接下来该去哪儿\n"
	.string "抓宝可梦呢？$"

RivalsHouse_2F_Text_MayWhereShouldIGoNext: @ 81F9A9E
	.string "小遥：接下来该去哪儿\n"
	.string "抓宝可梦呢？\p"
	.string "要是我们碰上了，\n"
	.string "是不是很好玩，{PLAYER}{KUN}？$"

RivalsHouse_2F_Text_BrendanJustCheckingMyPokedex: @ 81F9B0D
	.string "祐树：嘿，是{PLAYER}。\n"
	.string "我刚刚在看我的宝可梦图鉴。\p"
	.string "我知道还有很多宝可梦\n"
	.string "等着我去抓，不过目前\p"
	.string "看起来还不错。\n"
	.string "看着这本图鉴，就让我\p"
	.string "又想上路了。$"

RivalsHouse_2F_Text_BrendanWhereShouldIGoNext: @ 81F9BE7
	.string "祐树：我正拿不定主意\n"
	.string "接下来该去哪儿抓宝可梦。\p"
	.string "嘿，{PLAYER}，\n"
	.string "如果我出门抓宝可梦\p"
	.string "时碰到你，你愿意的话，\n"
	.string "我可以跟你打一场。$"

IntroSkip_EventScript_SetIntroFlagsFemale:: @ 823BF46
    lockall
	setrespawn HEAL_LOCATION_LITTLEROOT_TOWN_MAYS_HOUSE_2F
	setflag FLAG_HIDE_LITTLEROOT_TOWN_BRENDANS_HOUSE_MOM
	setflag FLAG_HIDE_LITTLEROOT_TOWN_BRENDANS_HOUSE_TRUCK
	setflag FLAG_HIDE_LITTLEROOT_TOWN_MAYS_HOUSE_TRUCK
	setflag FLAG_HIDE_LITTLEROOT_TOWN_MAYS_HOUSE_RIVAL_MOM
	setflag FLAG_HIDE_LITTLEROOT_TOWN_MAYS_HOUSE_RIVAL_SIBLING
	clearflag FLAG_HIDE_LITTLEROOT_TOWN_BRENDANS_HOUSE_2F_POKE_BALL
	setvar VAR_LITTLEROOT_HOUSES_STATE_MAY, 1
	setflag FLAG_HIDE_LITTLEROOT_TOWN_MOM_OUTSIDE
	setvar VAR_LITTLEROOT_INTRO_STATE, 5
	clearflag FLAG_HIDE_LITTLEROOT_TOWN_FAT_MAN
	clearflag FLAG_HIDE_MAP_NAME_POPUP
	releaseall
	return
`
movement IntroSkip_Movement_SetIntroFlagsFemaleFollowUpToClock0 {
	walk_left * 2
}
script IntroSkip_EventScript_SetIntroFlagsFemale0 {
	call(IntroSkip_EventScript_SetIntroFlagsFemale)
	lock
	applymovement(OBJ_EVENT_ID_PLAYER, IntroSkip_Movement_SetIntroFlagsFemaleFollowUpToClock0)
	waitmovement(OBJ_EVENT_ID_PLAYER)
	goto(IntroSkip_EventScript_SetIntroFlagsFemaleFollowUpToClock)
}
script IntroSkip_EventScript_SetIntroFlagsFemale1 {
	call(IntroSkip_EventScript_SetIntroFlagsFemale)
	lock
	goto(IntroSkip_EventScript_SetIntroFlagsFemaleFollowUpToClock)
}
movement IntroSkip_Movement_SetIntroFlagsFemaleFollowUpToClock {
	walk_left * 3
	walk_up * 2
}
script IntroSkip_EventScript_SetIntroFlagsFemaleFollowUpToClock{
	applymovement(OBJ_EVENT_ID_PLAYER, IntroSkip_Movement_SetIntroFlagsFemaleFollowUpToClock)
	waitmovement(OBJ_EVENT_ID_PLAYER)
	goto(IntroSkip_EventScript_FemaleForceClock)
	release
}

script IntroSkip_EventScript_FemaleForceClock{
	call(LittlerootTown_MaysHouse_2F_EventScript_WallClock)
	if (!flag(FLAG_SET_WALL_CLOCK)){
		goto(IntroSkip_EventScript_FemaleForceClock)
	}
}