script Route111_SunhollowRuins_Museum_EventScript_PyramidScript_MovePlayerToScriptStart {
    switch(var(VAR_TEMP_0)){
        case 2:
            applymovement(OBJECT_EVENT_NORMAN,  moves(walk_fastest_up step_end))
            applymovement(OBJECT_EVENT_BRANDON, moves(walk_fastest_up step_end))
            waitmovement(0)
        break
        case 3:
            applymovement(OBJECT_EVENT_NORMAN,  moves(walk_fastest_up * 2 step_end))
            applymovement(OBJECT_EVENT_BRANDON, moves(walk_fastest_up * 2 step_end))
            waitmovement(0)
        break
        case 4:
            applymovement(OBJECT_EVENT_NORMAN,  moves(walk_fastest_up * 3 step_end))
            applymovement(OBJECT_EVENT_BRANDON, moves(walk_fastest_up * 3 step_end))
            waitmovement(0)
        break
        case 5:
            applymovement(OBJECT_EVENT_NORMAN,  moves(walk_fastest_up * 4 step_end))
            applymovement(OBJECT_EVENT_BRANDON, moves(walk_fastest_up * 4 step_end))
            waitmovement(0)
        break
        case 6:
            applymovement(OBJECT_EVENT_NORMAN,  moves(walk_fastest_up * 5 step_end))
            applymovement(OBJECT_EVENT_BRANDON, moves(walk_fastest_up * 5 step_end))
            waitmovement(0)
        break
        case 7:
            applymovement(OBJECT_EVENT_NORMAN,  moves(walk_fastest_up * 6 step_end))
            applymovement(OBJECT_EVENT_BRANDON, moves(walk_fastest_up * 6 step_end))
            waitmovement(0)
        break
        case 8:
            applymovement(OBJECT_EVENT_NORMAN,  moves(walk_fastest_up * 7 step_end))
            applymovement(OBJECT_EVENT_BRANDON, moves(walk_fastest_up * 7 step_end))
            waitmovement(0)
        break
    }

    applymovement(OBJECT_EVENT_NORMAN, moves(
        walk_up * 6
        walk_right * 2
        step_end
    ))
    applymovement(OBJECT_EVENT_BRANDON, moves(
        walk_up * 7
        walk_right
        step_end
    ))
    waitmovement(0)

    msgbox(format("千里：退后，{PLAYER}，\n我们得商量一下对策。$"))
    closemessage

    applymovement(OBJECT_EVENT_BRANDON, moves(
        walk_left
        walk_down * 2
        step_end
    ))
    applymovement(OBJECT_EVENT_NORMAN, moves(
        walk_left * 2
        walk_down
        step_end
    ))
    applymovement(OBJ_EVENT_ID_PLAYER, moves(
        walk_left * 2
        walk_down
        step_end
    ))
    waitmovement(0)

    //Move player next to Norman
    switch(var(VAR_TEMP_0)){
        case 1:
            applymovement(OBJ_EVENT_ID_PLAYER, moves(
                walk_down * 6
                face_left
                step_end
            ))
            applymovement(OBJECT_EVENT_NORMAN, moves(
                walk_down * 6
                face_right
                step_end
            ))
            applymovement(OBJECT_EVENT_BRANDON, moves(
                walk_down * 6
                face_up
                step_end
            ))
        break
        case 2:
            applymovement(OBJ_EVENT_ID_PLAYER, moves(
                walk_down * 7
                face_left
                step_end
            ))
            applymovement(OBJECT_EVENT_NORMAN, moves(
                walk_down * 7
                face_right
                step_end
            ))
            applymovement(OBJECT_EVENT_BRANDON, moves(
                walk_down * 7
                face_up
                step_end
            ))
        break
        case 3:
            applymovement(OBJ_EVENT_ID_PLAYER, moves(
                walk_down * 8
                face_left
                step_end
            ))
            applymovement(OBJECT_EVENT_NORMAN, moves(
                walk_down * 8
                face_right
                step_end
            ))
            applymovement(OBJECT_EVENT_BRANDON, moves(
                walk_down * 8
                face_up
                step_end
            ))
        break
        case 4:
            applymovement(OBJ_EVENT_ID_PLAYER, moves(
                walk_down * 9
                face_left
                step_end
            ))
            applymovement(OBJECT_EVENT_NORMAN, moves(
                walk_down * 9
                face_right
                step_end
            ))
            applymovement(OBJECT_EVENT_BRANDON, moves(
                walk_down * 9
                face_up
                step_end
            ))
        break
        case 5:
            applymovement(OBJ_EVENT_ID_PLAYER, moves(
                walk_down * 10
                face_left
                step_end
            ))
            applymovement(OBJECT_EVENT_NORMAN, moves(
                walk_down * 10
                face_right
                step_end
            ))
            applymovement(OBJECT_EVENT_BRANDON, moves(
                walk_down * 10
                face_up
                step_end
            ))
        break
        case 6:
            applymovement(OBJ_EVENT_ID_PLAYER, moves(
                walk_down * 11
                face_left
                step_end
            ))
            applymovement(OBJECT_EVENT_NORMAN, moves(
                walk_down * 11
                face_right
                step_end
            ))
            applymovement(OBJECT_EVENT_BRANDON, moves(
                walk_down * 11
                face_up
                step_end
            ))
        break
        case 7:
            applymovement(OBJ_EVENT_ID_PLAYER, moves(
                walk_down * 12
                face_left
                step_end
            ))
            applymovement(OBJECT_EVENT_NORMAN, moves(
                walk_down * 12
                face_right
                step_end
            ))
            applymovement(OBJECT_EVENT_BRANDON, moves(
                walk_down * 12
                face_up
                step_end
            ))
        break
        case 8:
            applymovement(OBJ_EVENT_ID_PLAYER, moves(
                walk_down * 13
                face_left
                step_end
            ))
            applymovement(OBJECT_EVENT_NORMAN, moves(
                walk_down * 13
                face_up
                step_end
            ))
            applymovement(OBJECT_EVENT_BRANDON, moves(
                walk_down * 13
                face_up
                step_end
            ))
        break
    }
    waitmovement(0)
    setflag(FLAG_HIDE_SUNHOLLOW_MUSEUM_MAGMA_GRUNTS)

    hideobjectat(OBJECT_EVENT_MAGMA_MEMBER_1,  MAP_ROUTE111_SUNHOLLOW_RUINS_MUSEUM)
    removeobject(OBJECT_EVENT_MAGMA_MEMBER_1,  MAP_ROUTE111_SUNHOLLOW_RUINS_MUSEUM)
    setobjectxyperm(OBJECT_EVENT_MAGMA_MEMBER_1, 1, 1)

    return
}

script Route111_SunhollowRuins_Museum_EventScript_PyramidScript_Global {
    msgbox(format("千里：嘘！{PLAYER}！等等！$"))
    closemessage
    clearflag(FLAG_TEMP_2)

    addobject(OBJECT_EVENT_NORMAN)
    addobject(OBJECT_EVENT_BRANDON)

    setflag(FLAG_TEMP_4)

    hideobjectat(OBJECT_EVENT_MAGMA_MEMBER_2,  MAP_ROUTE111_SUNHOLLOW_RUINS_MUSEUM)
    removeobject(OBJECT_EVENT_MAGMA_MEMBER_2,  MAP_ROUTE111_SUNHOLLOW_RUINS_MUSEUM)
    setobjectxyperm(OBJECT_EVENT_MAGMA_MEMBER_2, 1, 1)

    playse(SE_PIN)
    applymovement(OBJ_EVENT_ID_PLAYER, moves(
        emote_exclamation_mark
        face_left
        step_end
    ))
    waitmovement(0)

    call(Route111_SunhollowRuins_Museum_EventScript_PyramidScript_MovePlayerToScriptStart)

    msgbox(format("千里：{PLAYER}，这位是神代。$"))
    closemessage

    applymovement(OBJECT_EVENT_NORMAN, moves(
        face_down
        step_end
    ))
    waitmovement(0)

    checkplayergender
    if(var(VAR_RESULT) == MALE) {
        msgbox(format("千里：神代，见见我儿子，\n{PLAYER}。$"))
    } else {
        msgbox(format("千里：神代，见见我女儿，\n{PLAYER}。$"))
    }
    closemessage

    applymovement(OBJECT_EVENT_BRANDON, moves(
        face_right
        step_end
    ))
    waitmovement(0)

    msgbox(format("神代：幸会，年轻的冒险者！$"))
    closemessage

    msgbox(format("千里：神代，你的队伍怎么样？$"))
    closemessage

    applymovement(OBJECT_EVENT_BRANDON, moves(
        face_up
        step_end
    ))
    waitmovement(0)

    msgbox(format("神代：累坏了。你呢？\p千里：也相当疲惫。$"))
    closemessage

    applymovement(OBJECT_EVENT_NORMAN, moves(
        face_right
        step_end
    ))
    waitmovement(0)

    msgbox(format("千里：{PLAYER}，你悄悄溜进来，\n体力还足吧？\p可火岩队的人太多了……\p我们怎么办？$"))
    closemessage

    playse(SE_BANG)
    delay(30)

    playse(SE_PIN)
    applymovement(OBJECT_EVENT_BRANDON, moves(
        emote_question_mark
        face_down
        step_end
    ))
    waitmovement(0)
    applymovement(OBJ_EVENT_ID_PLAYER, moves(
        face_down
        step_end
    ))
    waitmovement(0)
    applymovement(OBJECT_EVENT_NORMAN, moves(
        face_down
        step_end
    ))
    waitmovement(0)

    msgbox(format("神代：你们听见了吗？\p千里：听见什么？\p？？？：让开让开，借过！$"))
    closemessage

    applymovement(OBJ_EVENT_ID_PLAYER, moves(
        walk_up
        walk_left
        face_right
        step_end
    ))
    waitmovement(0)
    applymovement(OBJECT_EVENT_NORMAN, moves(
        face_right
        step_end
    ))
    applymovement(OBJECT_EVENT_BRANDON, moves(
        face_right
        step_end
    ))
    waitmovement(0)
    clearflag(FLAG_TEMP_1)
    addobject(OBJECT_EVENT_AQUA_MEMBER_1)
    addobject(OBJECT_EVENT_AQUA_MEMBER_2)
    addobject(OBJECT_EVENT_AQUA_MEMBER_3)
    addobject(OBJECT_EVENT_AQUA_MEMBER_4)
    addobject(OBJECT_EVENT_AQUA_MEMBER_5)
    addobject(OBJECT_EVENT_AQUA_MEMBER_5)
    addobject(OBJECT_EVENT_AQUA_MEMBER_5)
    addobject(OBJECT_EVENT_AQUA_MEMBER_5)

    applymovement(OBJECT_EVENT_AQUA_MEMBER_1, moves(
        walk_fast_up * 20
        step_end
    ))
    applymovement(OBJECT_EVENT_AQUA_MEMBER_2, moves(
        walk_fast_up * 20
        step_end
    ))
    applymovement(OBJECT_EVENT_AQUA_MEMBER_3, moves(
        walk_fast_up * 20
        step_end
    ))
    applymovement(OBJECT_EVENT_AQUA_MEMBER_4, moves(
        walk_fast_up * 20
        step_end
    ))
    applymovement(OBJECT_EVENT_AQUA_MEMBER_5, moves(
        walk_fast_up * 20
        step_end
    ))
    waitmovement(0)

    applymovement(OBJECT_EVENT_NORMAN, moves(
        face_up
        step_end
    ))
    applymovement(OBJECT_EVENT_BRANDON, moves(
        face_up
        step_end
    ))
    applymovement(OBJ_EVENT_ID_PLAYER, moves(
        face_up
        step_end
    ))
    waitmovement(0)

    msgbox(format("神代：……好吧。这就说得通了！\p千里：机会来了！\n我们去支援，你先走！$"))
    closemessage
    applymovement(OBJECT_EVENT_BRANDON, moves(
        walk_fast_right
        walk_fast_up * 1
        step_end
    ))
    waitmovement(0)
    applymovement(OBJECT_EVENT_BRANDON, moves(
        walk_fast_up * 15
        step_end
    ))
    applymovement(OBJECT_EVENT_NORMAN, moves(
        walk_fast_right
        walk_fast_up * 5
        face_down
        step_end
    ))
    waitmovement(0)
    msgbox(format("千里：小心点，{PLAYER}。$"))
    closemessage

    applymovement(OBJECT_EVENT_NORMAN, moves(
        walk_fast_up * 10
        step_end
    ))
    waitmovement(0)

    setflag(FLAG_TEMP_1)
    setflag(FLAG_TEMP_2)

    hideobjectat(OBJECT_EVENT_NORMAN, MAP_ROUTE111_SUNHOLLOW_RUINS_MUSEUM)
    removeobject(OBJECT_EVENT_NORMAN,  MAP_ROUTE111_SUNHOLLOW_RUINS_MUSEUM)
    setobjectxyperm(OBJECT_EVENT_NORMAN, 1, 1)

    hideobjectat(OBJECT_EVENT_BRANDON, MAP_ROUTE111_SUNHOLLOW_RUINS_MUSEUM)
    removeobject(OBJECT_EVENT_BRANDON,  MAP_ROUTE111_SUNHOLLOW_RUINS_MUSEUM)
    setobjectxyperm(OBJECT_EVENT_BRANDON, 1, 1)

    hideobjectat(OBJECT_EVENT_MAGMA_MEMBER_1, MAP_ROUTE111_SUNHOLLOW_RUINS_MUSEUM)
    removeobject(OBJECT_EVENT_MAGMA_MEMBER_1,  MAP_ROUTE111_SUNHOLLOW_RUINS_MUSEUM)
    setobjectxyperm(OBJECT_EVENT_MAGMA_MEMBER_1, 1, 1)

    call(Route111_SunhollowRuins_Museum_EventScript_PyramidScript_Enable_Fighting_Members)

    setvar(VAR_SUNHOLLOW_STATE, 2)
    release
    end
}

script Route111_SunhollowRuins_Museum_EventScript_PyramidScript_Enable_Fighting_Members {
    clearflag(FLAG_TEMP_3)
    addobject(OBJECT_EVENT_NORMAN_2)
    addobject(OBJECT_EVENT_BRANDON_2)

    addobject(OBJECT_EVENT_FIGHTING_MEMBER_MAGMA_1)
    addobject(OBJECT_EVENT_FIGHTING_MEMBER_MAGMA_2)
    addobject(OBJECT_EVENT_FIGHTING_MEMBER_MAGMA_3)
    addobject(OBJECT_EVENT_FIGHTING_MEMBER_MAGMA_4)
    addobject(OBJECT_EVENT_FIGHTING_MEMBER_MAGMA_5)
    addobject(OBJECT_EVENT_FIGHTING_MEMBER_MAGMA_6)
    addobject(OBJECT_EVENT_FIGHTING_MEMBER_MAGMA_7)
    addobject(OBJECT_EVENT_FIGHTING_MEMBER_MAGMA_8)

    addobject(OBJECT_EVENT_FIGHTING_MEMBER_AQUA_1)
    addobject(OBJECT_EVENT_FIGHTING_MEMBER_AQUA_2)
    addobject(OBJECT_EVENT_FIGHTING_MEMBER_AQUA_3)
    addobject(OBJECT_EVENT_FIGHTING_MEMBER_AQUA_4)
    addobject(OBJECT_EVENT_FIGHTING_MEMBER_AQUA_5)
    return
}

