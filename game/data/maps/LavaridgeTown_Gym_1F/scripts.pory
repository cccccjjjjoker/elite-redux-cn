raw `
.set LOCALID_COLE, 2
.set LOCALID_GERALD, 3
.set LOCALID_AXLE, 4
.set LOCALID_DANIELLE, 5

LavaridgeTown_Gym_1F_MapScripts:: @ 81FE6F4
	map_script MAP_SCRIPT_ON_TRANSITION, LavaridgeTown_Gym_1F_OnTransition
	.byte 0

LavaridgeTown_Gym_1F_OnTransition: @ 81FE6FA
	@ call LavaridgeTown_Gym_1F_EventScript_SetTrainerTempVars
	@ call LavaridgeTown_Gym_1F_EventScript_CheckBuryTrainers
	end

@ Unclear where/if these temp vars are getting checked
LavaridgeTown_Gym_1F_EventScript_SetTrainerTempVars:: @ 81FE705
	setvar VAR_TEMP_B, 0
	setvar VAR_TEMP_C, 0
	setvar VAR_TEMP_D, 0
	setvar VAR_TEMP_E, 0
	setvar VAR_TEMP_F, 0
	goto_if_defeated TRAINER_COLE LavaridgeTown_Gym_1F_EventScript_SetGeraldTempVar
	setvar VAR_TEMP_B, 1
LavaridgeTown_Gym_1F_EventScript_SetGeraldTempVar:: @ 81FE72C
	goto_if_defeated TRAINER_GERALD, LavaridgeTown_Gym_1F_EventScript_SetAxleTempVar
	setvar VAR_TEMP_C, 1
LavaridgeTown_Gym_1F_EventScript_SetAxleTempVar:: @ 81FE73A
	goto_if_defeated TRAINER_AXLE, LavaridgeTown_Gym_1F_EventScript_SetDanielleTempVar
	setvar VAR_TEMP_D, 1
LavaridgeTown_Gym_1F_EventScript_SetDanielleTempVar:: @ 81FE748
	goto_if_defeated TRAINER_DANIELLE, LavaridgeTown_Gym_1F_EventScript_EndSetTrainerTempVars
	setvar VAR_TEMP_E, 1
LavaridgeTown_Gym_1F_EventScript_EndSetTrainerTempVars:: @ 81FE756
	return

LavaridgeTown_Gym_1F_EventScript_CheckBuryTrainers:: @ 81FE757
	goto_if_defeated TRAINER_COLE, LavaridgeTown_Gym_1F_EventScript_CheckBuryGerald
	setobjectmovementtype LOCALID_COLE, MOVEMENT_TYPE_BURIED
LavaridgeTown_Gym_1F_EventScript_CheckBuryGerald:: @ 81FE764
	goto_if_defeated TRAINER_GERALD, LavaridgeTown_Gym_1F_EventScript_CheckBuryAxle
	setobjectmovementtype LOCALID_GERALD, MOVEMENT_TYPE_BURIED
LavaridgeTown_Gym_1F_EventScript_CheckBuryAxle:: @ 81FE771
	goto_if_defeated TRAINER_AXLE, LavaridgeTown_Gym_1F_EventScript_CheckBuryDanielle
	setobjectmovementtype LOCALID_AXLE, MOVEMENT_TYPE_BURIED
LavaridgeTown_Gym_1F_EventScript_CheckBuryDanielle:: @ 81FE77E
	goto_if_defeated TRAINER_DANIELLE, LavaridgeTown_Gym_1F_EventScript_EndCheckBuryTrainers
	setobjectmovementtype LOCALID_DANIELLE, MOVEMENT_TYPE_BURIED
LavaridgeTown_Gym_1F_EventScript_EndCheckBuryTrainers:: @ 81FE78B
	return


LavaridgeTown_Gym_1F_EventScript_FlanneryDefeated:: @ 81FE7C1
	goto_if_unset FLAG_DEFEATED_LAVARIDGE_GYM, LavaridgeTown_Gym_1F_EventScript_FlanneryDefeatedFirstTime
	release
	end

LavaridgeTown_Gym_1F_EventScript_FlanneryDefeatedFirstTime:
	message LavaridgeTown_Gym_1F_Text_ReceivedHeatBadge
	waitmessage
	call Common_EventScript_PlayGymBadgeFanfare
	msgbox LavaridgeTown_Gym_1F_Text_ExplainHeatBadgeTakeThis, MSGBOX_DEFAULT
	closemessage
	@ delay 30
	@ playfanfare MUS_REGISTER_MATCH_CALL
	@ msgbox LavaridgeTown_Gym_1F_Text_RegisteredArcanine, MSGBOX_DEFAULT
	@ waitfanfare
	@ closemessage
	@ delay 30
	msgbox LavaridgeTown_Gym_1F_Text_TakeThis, MSGBOX_DEFAULT
	setflag FLAG_WHITEOUT_TO_LAVARIDGE
	setflag FLAG_DEFEATED_LAVARIDGE_GYM
	setflag FLAG_BADGE04_GET
	call Common_EventScript_ReadyPetalburgGymForBattle
	setvar VAR_0x8008, 4
	call Common_EventScript_SetGymTrainers
	setflag FLAG_HIDE_VERDANTURF_TOWN_WANDAS_HOUSE_WALLY
	setvar VAR_LAVARIDGE_TOWN_STATE, 1
	call LavaridgeTown_Gym_1F_EventScript_GiveOverheat
	closemessage
	@ delay 30
	@ playfanfare MUS_REGISTER_MATCH_CALL
	@ msgbox LavaridgeTown_Gym_1F_Text_RegisteredFlannery, MSGBOX_DEFAULT
	@ waitfanfare
	@ closemessage
	@ delay 30
	setflag FLAG_ENABLE_FLANNERY_MATCH_CALL
	release
	end

LavaridgeTown_Gym_1F_EventScript_FlanneryRematch::
	message LavaridgeTown_Gym_1F_Text_FlanneryChooseFormat
	waitmessage
	multichoice 17, 6, MULTI_REMATCH_BATTLE_MODE, 0
	switch VAR_RESULT
	case 0, LavaridgeTown_Gym_1F_EventScript_SetSingles
	case 1, LavaridgeTown_Gym_1F_EventScript_SetDoubles
	case 2, LavaridgeTown_Gym_1F_EventScript_Exit
	case 127, LavaridgeTown_Gym_1F_EventScript_Exit
	releaseall
	end

@ 2: singles, legendaries
@ 3: singles, no legendaries
@ 4: doubles, legendaries
@ 5: doubles, no legendaries

LavaridgeTown_Gym_1F_EventScript_SetSingles::
	msgbox LavaridgeTown_Gym_1F_Text_FlanneryAllowLegends, MSGBOX_YESNO
	compare VAR_RESULT, NO
	goto_if_eq LavaridgeTown_Gym_1F_EventScript_FlannerySinglesRematch
	setvar VAR_0x8004, 10
	trainerbattle_no_intro TRAINER_FLANNERY_3, LavaridgeTown_Gym_1F_Text_FlanneryRematchDefeat
	//setflag FLAG_DAILY_REMATCH_FLANNERY
	releaseall
	end

LavaridgeTown_Gym_1F_EventScript_SetDoubles::
	msgbox LavaridgeTown_Gym_1F_Text_FlanneryAllowLegends, MSGBOX_YESNO
	compare VAR_RESULT, NO
	goto_if_eq LavaridgeTown_Gym_1F_EventScript_FlanneryDoublesRematch
	setvar VAR_0x8004, 10
	trainerbattle_no_intro TRAINER_FLANNERY_4, LavaridgeTown_Gym_1F_Text_FlanneryRematchDefeat
	//setflag FLAG_DAILY_REMATCH_FLANNERY
	releaseall
	end

LavaridgeTown_Gym_1F_EventScript_FlannerySinglesRematch::
	setvar VAR_0x8004, 10
	trainerbattle_no_intro TRAINER_FLANNERY_2, LavaridgeTown_Gym_1F_Text_FlanneryRematchDefeat
	//setflag FLAG_DAILY_REMATCH_FLANNERY
	releaseall
	end

LavaridgeTown_Gym_1F_EventScript_FlanneryDoublesRematch::
	setvar VAR_0x8004, 10
	trainerbattle_no_intro TRAINER_FLANNERY_5, LavaridgeTown_Gym_1F_Text_FlanneryRematchDefeat
	//setflag FLAG_DAILY_REMATCH_FLANNERY
	releaseall
	end

LavaridgeTown_Gym_1F_EventScript_AlreadyRematched::
	msgbox LavaridgeTown_Gym_1F_Text_FlanneryPostRematch, MSGBOX_AUTOCLOSE
	releaseall
	end

LavaridgeTown_Gym_1F_EventScript_Exit::
	releaseall
	end

LavaridgeTown_Gym_EventScript_CheckTrainerScript:: @ 81FE89A
	call LavaridgeTown_Gym_1F_EventScript_SetTrainerTempVars
	release
	special ShouldTryGetTrainerScript
	compare VAR_RESULT, 1
	goto_if_eq EventScript_GotoTrainerScript
	end

LavaridgeTown_Gym_1F_EventScript_GymGuide:: @ 81FE96C
	lock
	faceplayer
	goto_if_set FLAG_DEFEATED_LAVARIDGE_GYM, LavaridgeTown_Gym_1F_EventScript_AskResetTrainers
	msgbox LavaridgeTown_Gym_1F_Text_GymGuideAdvice1, MSGBOX_DEFAULT
	msgbox LavaridgeTown_Gym_1F_Text_GymGuideAdvice2, MSGBOX_DEFAULT
	release
	end

LavaridgeTown_Gym_1F_EventScript_GymGuide2::
	msgbox LavaridgeTown_Gym_1F_Text_GymGuideAdvice2, MSGBOX_DEFAULT
	release
	end

LavaridgeTown_Gym_1F_EventScript_GymGuidePostVictory:: @ 81FE981
	msgbox LavaridgeTown_Gym_1F_Text_GymGuidePostVictory, MSGBOX_DEFAULT
	release
	end

LavaridgeTown_Gym_1F_EventScript_LeftGymStatue:: @ 81FE98B
	lockall
	goto_if_set FLAG_BADGE04_GET, LavaridgeTown_Gym_1F_EventScript_GymStatueCertified
	goto LavaridgeTown_Gym_1F_EventScript_GymStatue
	end

LavaridgeTown_Gym_1F_EventScript_RightGymStatue:: @ 81FE99B
	lockall
	goto_if_set FLAG_BADGE04_GET, LavaridgeTown_Gym_1F_EventScript_GymStatueCertified
	goto LavaridgeTown_Gym_1F_EventScript_GymStatue
	end

LavaridgeTown_Gym_1F_EventScript_GymStatueCertified:: @ 81FE9AB
	msgbox LavaridgeTown_Gym_1F_Text_GymStatueCertified, MSGBOX_DEFAULT
	releaseall
	end

LavaridgeTown_Gym_1F_EventScript_GymStatue:: @ 81FE9B5
	msgbox LavaridgeTown_Gym_1F_Text_GymStatue, MSGBOX_DEFAULT
	releaseall
	end

LavaridgeTown_Gym_1F_Text_GymGuideAdvice1:
	.string "哟，向着冠军前进的{PLAYER}，\n"
	.string "过得怎么样？$"

LavaridgeTown_Gym_1F_Text_GymGuideAdvice2: @ 81FE9BF
	.string "釜炎镇的馆主亚莎使用火属性宝可梦\n"
	.string "。\p"
	.string "她对宝可梦的热情比火山还烫。\n"
	.string "她喜欢在阳光下对战，\p"
	.string "她的宝可梦都练成了一击就全力打出\n"
	.string "去。\p"
	.string "你或许需要额外的力量才跟得上！\n"
	.string "试试改变天气，\p"
	.string "把天气变成你的优势。$"

LavaridgeTown_Gym_1F_Text_GymGuidePostVictory: @ 81FEAB8
	.string "哟！那是一场滚烫的对战！$"

LavaridgeTown_Gym_1F_Text_ColeIntro: @ 81FEADE
	.string "哎哟哟哟！好烫！$"

LavaridgeTown_Gym_1F_Text_ColeDefeat:: @ 81FEAFB
	.string "汗水进眼睛了，看不清……$"

LavaridgeTown_Gym_1F_Text_ColePostBattle: @ 81FEB1C
	.string "埋在热沙里能促进血液循环。\n"
	.string "对缓解关节疼痛很有效。$"

LavaridgeTown_Gym_1F_Text_AxleIntro: @ 81FEB7B
	.string "我在试着缓解压力。\n"
	.string "别过来又给我添堵！$"

LavaridgeTown_Gym_1F_Text_AxleDefeat: @ 81FEBC0
	.string "希望亚莎把你烧个透！$"

LavaridgeTown_Gym_1F_Text_AxlePostBattle: @ 81FEBE1
	.string "哈啊……呼……\n"
	.string "在热沙里待太久会累坏的……$"

LavaridgeTown_Gym_B1F_Text_KeeganIntro: @ 81FEC31
	.string "你现在该累了吧。\n"
	.string "想在热沙里休息一下，是吧？\p"
	.string "但你得知道，保持意志力\n"
	.string "是所有训练家的重要能力。$"

LavaridgeTown_Gym_B1F_Text_KeeganDefeat:: @ 81FECE3
	.string "玩火，就会被烧伤……$"

LavaridgeTown_Gym_B1F_Text_KeeganPostBattle: @ 81FED02
	.string "你的技术是真的……\n"
	.string "但我们的馆主亚莎很强。\p"
	.string "不小心的话，你会被烧得很惨。$"

LavaridgeTown_Gym_1F_Text_GeraldIntro: @ 81FED72
	.string "你的宝可梦受得了392度的高温吗？$"

LavaridgeTown_Gym_1F_Text_GeraldDefeat: @ 81FED9E
	.string "烧得还不够热……$"

LavaridgeTown_Gym_1F_Text_GeraldPostBattle: @ 81FEDBB
	.string "岩浆的温度是392度。\n"
	.string "你的宝可梦打赢了我，\p"
	.string "那它们在岩浆里也该活得下来。$"

LavaridgeTown_Gym_1F_Text_DanielleIntro: @ 81FEE22
	.string "呃……\n"
	.string "好吧，我跟你打。$"

LavaridgeTown_Gym_1F_Text_DanielleDefeat: @ 81FEE42
	.string "哦，可你太强了。$"

LavaridgeTown_Gym_1F_Text_DaniellePostBattle: @ 81FEE5D
	.string "我要成为像亚莎那样\n"
	.string "又漂亮又强的训练家。$"

LavaridgeTown_Gym_B1F_Text_JaceIntro: @ 81FEE9D
	.string "来呀，快点！\n"
	.string "趁我的热情还没凉，开打！$"

LavaridgeTown_Gym_B1F_Text_JaceDefeat: @ 81FEED5
	.string "这么热的天，我的心却被冰攥住了…\n"
	.string "…$"

LavaridgeTown_Gym_B1F_Text_JacePostBattle: @ 81FEF07
	.string "你身上那股战意烧得那么旺，\n"
	.string "说不定能跟我们馆主一战。$"

LavaridgeTown_Gym_B1F_Text_JeffIntro: @ 81FEF60
	.string "看这火焰烧得多狂？\n"
	.string "它们在为我的胜利预热！$"

LavaridgeTown_Gym_B1F_Text_JeffDefeat: @ 81FEFA7
	.string "有点不对劲。$"

LavaridgeTown_Gym_B1F_Text_JeffPostBattle: @ 81FEFC2
	.string "那又怎样？我说那又怎样？\n"
	.string "我能赤脚走火炭！\p"
	.string "……你可别想着试！$"

LavaridgeTown_Gym_B1F_Text_EliIntro: @ 81FF025
	.string "我本来就爱山，\n"
	.string "尤其爱火山。$"

LavaridgeTown_Gym_B1F_Text_EliDefeat: @ 81FF05F
	.string "唉，看来我全程都没掌握住节奏就输\n"
	.string "了。$"

LavaridgeTown_Gym_B1F_Text_EliPostBattle: @ 81FF09A
	.string "我留在这里，是因为我成了\n"
	.string "亚莎力量的粉丝。\p"
	.string "呵呵呵呵。$"

LavaridgeTown_Gym_1F_Text_FlanneryIntro: @ 81FF0DC
	.string "欢迎……不对，等等。\n"
	.string "弱小的训练家，你能走到这里\p"
	.string "真是不错！\n"
	.string "我受委托掌管……不对，等等。\p"
	.string "我是亚莎，这里的道馆馆主！\n"
	.string "呃……\p"
	.string "别因为我当馆主不久就小看我！\n"
	.string "我要用从爷爷那里继承的本事，\p"
	.string "呃……展示我们在这片土地上\n"
	.string "磨炼出的火热招式！$"

LavaridgeTown_Gym_1F_Text_FlanneryDefeat: @ 81FF233
	.string "哦……\n"
	.string "我大概是太勉强自己了……\p"
	.string "我……我才刚当上道馆馆主不久。\n"
	.string "我太想成为不是自己的那个人。\p"
	.string "我得按自己的方式来。\n"
	.string "不然我的宝可梦会混乱的。\p"
	.string "谢谢你教会我这一点。\n"
	.string "为了这个，这个给你。$"

LavaridgeTown_Gym_1F_Text_ReceivedHeatBadge: @ 81FF32F
	.string "{PLAYER}从亚莎那里得到了烈焰徽\n"
	.string "章。$"

LavaridgeTown_Gym_1F_Text_ExplainHeatBadgeTakeThis: @ 81FF359
	.string "有了烈焰徽章，60级以下的宝可梦，\n"
	.string "连别人交换给你的，\p"
	.string "都会完全听你的话。\n"
	.string "而且，还能在战斗外使用秘传招式怪\p"
	.string "力。\n"
	.string "需要的话，我可以把我的风速狗\p"
	.string "借你使用怪力。$"

LavaridgeTown_Gym_1F_Text_TakeThis:
	.string "这是我的一点心意。\n"
	.string "别客气，收下吧！$"

LavaridgeTown_Gym_1F_Text_ExplainOverheat: @ 81FF45C
	.string "招式学习器50里装着过热。\n"
	.string "这招式会给对手造成严重伤害。\p"
	.string "但它也会大幅降低使用者的特攻。\n"
	.string "可能不适合长时间对战。$"

LavaridgeTown_Gym_1F_Text_RegisteredFlannery: @ 81FF517
	.string "在宝可梦导航器里登录了馆主亚莎。$"

LavaridgeTown_Gym_1F_Text_RegisteredArcanine: @ 81FF517
	.string "在宝可梦导航器里登录了亚莎的风速\n"
	.string "狗。$"

LavaridgeTown_Gym_1F_Text_FlanneryPostBattle: @ 81FF546
	.string "你的实力让我想起某个人……\n"
	.string "哦！我知道了！\p"
	.string "你打得像橙华市的道馆馆主千里。$"

LavaridgeTown_Gym_1F_Text_GymStatue: @ 81FF5A9
	.string "釜炎镇宝可梦道馆$"

LavaridgeTown_Gym_1F_Text_GymStatueCertified: @ 81FF5C4
	.string "釜炎镇宝可梦道馆\n"
	.string "亚莎的认定训练家：\p"
	.string "{PLAYER}$"

LavaridgeTown_Gym_1F_Text_FlanneryPreRematch: @ 81FF601
	.string "亚莎：下次再打一场火热的对战吧！$"

LavaridgeTown_Gym_1F_Text_FlanneryRematchDefeat: @ 81FF69F
	.string "呼！快到喷发的边缘了！$"

LavaridgeTown_Gym_1F_Text_FlanneryPostRematch: @ 81FF6BF
	.string "亚莎：这场我输了，\n"
	.string "但我完全满意。\p"
	.string "这么热的对战可不常有。\n"
	.string "以后再来一场这样的吧！$"

LavaridgeTown_Gym_1F_Text_FlanneryRematchNeedTwoMons: @ 81FF75E
	.string "哦，等等。你能对战的宝可梦\n"
	.string "只有一只吗？\p"
	.string "不好意思，你来见我的时候，\n"
	.string "至少带两只宝可梦。$"

LavaridgeTown_Gym_1F_Text_FlanneryChooseFormat:
	.string "亚莎：输一场不会让我泄气。\n"
	.string "我爱宝可梦。\p"
	.string "我爱对战。\n"
	.string "而且……我爱这个道馆！\p"
	.string "所以……给再战定个规则吧：\n"
	.string "单打还是双打？$"

LavaridgeTown_Gym_1F_Text_FlanneryAllowLegends:
	.string "亚莎：那要不要让我的传说宝可梦\n"
	.string "也来加把火？$"
`
script LavaridgeTown_Gym_1F_EventScript_GiveOverheat{
	msgbox(format("这只特别的宝可梦，\n就当作我送你的礼物！$"))
	givecustommon(SPECIES_VOLCARONA, 40, ITEM_CHARTI_BERRY, ITEM_CHERISH_BALL, NATURE_TIMID, 2, 248, 0, 0, 112, 40, 108, 0, 0, 0, 0, 0, 0, MOVE_FIERY_DANCE, MOVE_GIGA_DRAIN, MOVE_QUIVER_DANCE, MOVE_ROOST, TRUE)
	playfanfare(MUS_OBTAIN_ITEM)
	message(format("{PLAYER}得到了亚莎的{COLOR BLUE}火神蛾{COLOR DARK_GRAY}！$"))
	waitfanfare
	setflag(FLAG_RECEIVED_TM50)
	msgbox(LavaridgeTown_Gym_1F_Text_FlanneryPostBattle, MSGBOX_DEFAULT)
	release
	end
}

script LavaridgeTown_Gym_B1F_EventScript_Jeff{
	lock
	faceplayer
	if (defeated(TRAINER_JEFF)){
		msgbox(LavaridgeTown_Gym_B1F_Text_JeffPostBattle, MSGBOX_AUTOCLOSE)
	} else {
		yesnobattle(format("随着对战进行，\n我的火焰{COLOR GREEN}只会越来越旺！\p{COLOR DARK_GRAY}希望你做好了面对野火的准备。$"))
		if (var(VAR_RESULT)){
			trainerbattle_single(TRAINER_JEFF, LavaridgeTown_Gym_B1F_Text_JeffIntro , LavaridgeTown_Gym_B1F_Text_JeffDefeat)
		}
	}
	release
	end
}

script LavaridgeTown_Gym_B1F_EventScript_Jace{
	lock
	faceplayer
	if (defeated(TRAINER_JACE)){
		msgbox(LavaridgeTown_Gym_B1F_Text_JacePostBattle, MSGBOX_AUTOCLOSE)
	} else {
		yesnobattle(format("小心别吸进太多这种烟，\n它{COLOR GREEN}毒性{COLOR DARK_GRAY}极强。$"))
		if (var(VAR_RESULT)){
			trainerbattle_single(TRAINER_JACE, LavaridgeTown_Gym_B1F_Text_JaceIntro , LavaridgeTown_Gym_B1F_Text_JaceDefeat)
		}
	}
	release
	end
}

script LavaridgeTown_Gym_B1F_EventScript_Eli{
	lock
	faceplayer
	if (defeated(TRAINER_ELI)){
		msgbox(LavaridgeTown_Gym_B1F_Text_EliPostBattle, MSGBOX_AUTOCLOSE)
	} else {
		yesnobattle(format("我读到过，巨魔被火攻击时{COLOR GREEN}无法回复{COLOR DARK_GRAY}\n。你不觉得幻想很奇妙吗？$"))
		if (var(VAR_RESULT)){
			trainerbattle_single(TRAINER_ELI, LavaridgeTown_Gym_B1F_Text_EliIntro , LavaridgeTown_Gym_B1F_Text_EliDefeat)
		}
	}
	release
	end
}

script LavaridgeTown_Gym_B1F_EventScript_Keegan{
	lock
	faceplayer
	if (defeated(TRAINER_KEEGAN)){
		msgbox(LavaridgeTown_Gym_B1F_Text_KeeganPostBattle, MSGBOX_AUTOCLOSE)
	} else {
		goto(LavaridgeTown_Gym_1F_EventScript_ColeAndKeegan)
	}
	release
	end
}

script LavaridgeTown_Gym_1F_EventScript_Cole{
	lock
	faceplayer
	if (defeated(TRAINER_COLE)){
		msgbox(LavaridgeTown_Gym_1F_Text_ColePostBattle, MSGBOX_AUTOCLOSE)
	} else {
		goto(LavaridgeTown_Gym_1F_EventScript_ColeAndKeegan)
	}
	release
	end
}

script LavaridgeTown_Gym_1F_EventScript_ColeAndKeegan{
	yesnobattle(format("希望你准备好了。\n我的宝可梦会{COLOR GREEN}把你烧伤！\p{COLOR DARK_GRAY}这一带雾很浓，幸好我们都习惯了，\n能看得{COLOR GREEN}一清二楚{COLOR DARK_GRAY}。$"))
		if (var(VAR_RESULT)){
			starttagbattle(TRAINER_COLE, TRAINER_KEEGAN, TAG_TEAM_COLE_KEEGAN, 0)
		}
}

script LavaridgeTown_Gym_1F_EventScript_Gerald{
	lock
	faceplayer
	if (defeated(TRAINER_GERALD)){
		msgbox(LavaridgeTown_Gym_1F_Text_GeraldPostBattle, MSGBOX_AUTOCLOSE)
	} else {
		yesnobattle(format("都说火属性很脆，但只要肯下功夫，\n它们也能有{COLOR GREEN}坚实的防御{COLOR DARK_GRAY}。$"))
		if (var(VAR_RESULT)){
			trainerbattle_single(TRAINER_GERALD, LavaridgeTown_Gym_1F_Text_GeraldIntro , LavaridgeTown_Gym_1F_Text_GeraldDefeat)
		}
	}
	release
	end
}

script LavaridgeTown_Gym_1F_EventScript_Axle{
	lock
	faceplayer
	if (defeated(TRAINER_AXLE)){
		msgbox(LavaridgeTown_Gym_1F_Text_AxlePostBattle, MSGBOX_AUTOCLOSE)
	} else {
		yesnobattle(format("火焰真了不起！只要给一点燃料，\n它们就能烧很久，\p这不让你{COLOR GREEN}热血沸腾{COLOR DARK_GRAY}想打一场吗？$"))
		if (var(VAR_RESULT)){
			trainerbattle_single(TRAINER_AXLE, LavaridgeTown_Gym_1F_Text_AxleIntro , LavaridgeTown_Gym_1F_Text_AxleDefeat)
		}
	}
	release
	end
}

script LavaridgeTown_Gym_1F_EventScript_Danielle{
	lock
	faceplayer
	if (defeated(TRAINER_DANIELLE)){
		msgbox(LavaridgeTown_Gym_1F_Text_DaniellePostBattle, MSGBOX_AUTOCLOSE)
	} else {
		yesnobattle(format("我的热情烧得白热，\n{COLOR GREEN}我宝可梦的火焰也是{COLOR DARK_GRAY}！\p希望你准备好了！$"))
		if (var(VAR_RESULT)){
			trainerbattle_single(TRAINER_DANIELLE, LavaridgeTown_Gym_1F_Text_DanielleIntro , LavaridgeTown_Gym_1F_Text_DanielleDefeat)
		}
	}
	release
	end
}

script LavaridgeTown_Gym_EventScript_CheckTrainers{
    if (defeated(TRAINER_FLANNERY_1)) {
        msgbox(LavaridgeTown_Gym_1F_Text_FlanneryPostBattle, MSGBOX_DEFAULT)
        release
        end
    }
    // set battle event flags
	if (!defeated(TRAINER_JEFF)){
		registerbattleevent(BATTLE_EVENT_STEADY_SPECIAL)
    }
	if (!defeated(TRAINER_JACE)){
		registerbattleevent(BATTLE_EVENT_LAST_TOXIC, 2)
    }
    if (!defeated(TRAINER_ELI)){
		registerbattleevent(BATTLE_EVENT_PERMA_HEAL_BLOCK)
    }
	if (!defeated(TRAINER_KEEGAN)){
		registerbattleevent(BATTLE_EVENT_STEADY_ACCURACY)
    }
    if (!defeated(TRAINER_COLE)){
		registerbattleevent(BATTLE_EVENT_LAST_BURNED, 2)
    }
    if (!defeated(TRAINER_GERALD)){
		registerbattleevent(BATTLE_EVENT_POSTURE_DEFENSE)
    }
	if (!defeated(TRAINER_AXLE)){
		registerbattleevent(BATTLE_EVENT_ONDS_COPY_STATS)
    }
	if (!defeated(TRAINER_DANIELLE)){
		registerbattleevent(BATTLE_EVENT_POSTURE_SPECIAL)
    }

}

text LavaridgeTown_Gym_1F_Text_FlanneryIntro0{
    format("哦，看来你还没体验过我们的火热招\n式！那就准备好吧！$")
}

text LavaridgeTown_Gym_1F_Text_FlanneryIntro1{
    format("不错，你有点火气，\n但你还没准备好面对我地狱般的对战\p。$")
}

text LavaridgeTown_Gym_1F_Text_FlanneryIntroAll{
    format("看来是个冷静的人。$")
}

text LavaridgeTown_Gym_1F_Text_FlanneryDefeat0{
    format("没多少人能挡住我宝可梦全力的高温\n！希望你没被烧得太厉害！$")
}

text LavaridgeTown_Gym_1F_Text_FlanneryDefeat1{
    format("厉害！你把我整套战术都浇灭了！\n看来我要追上爷爷还得再练一阵子！$")
}

text LavaridgeTown_Gym_1F_Text_FlanneryDefeatAll{
    format("你的干劲和热情烧得比我还旺！\n希望你的火焰一直烧下去！$")
}

script LavaridgeTown_Gym_1F_EventScript_Flannery{
    goto_if_set(FLAG_SYS_GAME_CLEAR, LavaridgeTown_Gym_1F_EventScript_FlanneryRematch)
    call(LavaridgeTown_Gym_EventScript_CheckTrainers)
    setvar(VAR_0x8004, 15)
	registerbattleevent(BATTLE_EVENT_TENSE_BATTLE)
	adddefeatedcount(TRAINER_JEFF, 1)  
	adddefeatedcount(TRAINER_JACE) 
	adddefeatedcount(TRAINER_ELI) // TRAINER_KEEGAN 
	adddefeatedcount(TRAINER_COLE)  
	adddefeatedcount(TRAINER_GERALD)
	adddefeatedcount(TRAINER_AXLE) 
	adddefeatedcount(TRAINER_DANIELLE)
    switch (var(VAR_RESULT)) {
        case 0:
            trainerbattle_single(TRAINER_FLANNERY_1 LavaridgeTown_Gym_1F_Text_FlanneryIntro0, LavaridgeTown_Gym_1F_Text_FlanneryDefeat0, LavaridgeTown_Gym_1F_EventScript_FlanneryDefeated, NO_MUSIC)
        break
        case 7:
            trainerbattle_single(TRAINER_FLANNERY_1, LavaridgeTown_Gym_1F_Text_FlanneryIntroAll, LavaridgeTown_Gym_1F_Text_FlanneryDefeatAll, LavaridgeTown_Gym_1F_EventScript_FlanneryDefeated, NO_MUSIC)
        break
        default:
            trainerbattle_single(TRAINER_FLANNERY_1, LavaridgeTown_Gym_1F_Text_FlanneryIntro1, LavaridgeTown_Gym_1F_Text_FlanneryDefeat1, LavaridgeTown_Gym_1F_EventScript_FlanneryDefeated, NO_MUSIC)
    }
    goto_if_unset(FLAG_RECEIVED_TM50, LavaridgeTown_Gym_1F_EventScript_GiveOverheat)
}

script LavaridgeTown_Gym_1F_EventScript_Trolleychan{
    msgbox(format("你好呀，主人大人{COLOR BLUE}><{COLOR DARK_GRAY} 嘻嘻，\n我是小车车酱{COLOR GREEN}的说{COLOR DARK_GRAY}。\p请不要忘了人家哦{COLOR BLUE}><{COLOR DARK_GRAY}$"), MSGBOX_NPC)
}

script LavaridgeTown_Gym_1F_EventScript_AskResetTrainers{
	lock
	clydeaskresettrainers(LavaridgeTown_Gym_1F_EventScript_ResetAllTrainers, LavaridgeTown_Gym_1F_EventScript_SelectTrainers)
	release
	end
}

script LavaridgeTown_Gym_1F_EventScript_ResetAllTrainers{
	cleartrainerflag(TRAINER_JEFF)
	cleartrainerflag(TRAINER_COLE)
	cleartrainerflag(TRAINER_KEEGAN)
	cleartrainerflag(TRAINER_ELI)
	cleartrainerflag(TRAINER_GERALD)
	cleartrainerflag(TRAINER_AXLE)
	cleartrainerflag(TRAINER_JACE)
	cleartrainerflag(TRAINER_DANIELLE)
	cleartrainerflag(TRAINER_FLANNERY_1)
	return
}

movement LavaridgeTown_Gym_1F_Movement_ColeAndKeegan{
	walk_fastest_right * 2
	walk_fastest_up * 8
}

movement LavaridgeTown_Gym_1F_Movement_Axle{
	walk_fastest_up * 5
	walk_fastest_left * 2
}

movement LavaridgeTown_Gym_1F_Movement_Eli{
	walk_fastest_left * 6
}

movement LavaridgeTown_Gym_1F_Movement_Gerald{
	walk_fastest_left * 3
}

movement LavaridgeTown_Gym_1F_Movement_Jace{
	walk_fastest_down * 5
}

movement LavaridgeTown_Gym_1F_Movement_Danielle{
	walk_fastest_down * 5
}

movement LavaridgeTown_Gym_1F_Movement_Jeff{
	walk_fastest_up * 1
	walk_fastest_right * 5
}


movement LavaridgeTown_Gym_1F_Movement_Flannery{
	walk_fastest_right * 1
	walk_fastest_up * 7
}


// don't forget to bring you back to the player
movement LavaridgeTown_Gym_1F_Movement_Clyde{
	walk_fastest_right * 3
	walk_fastest_down * 11
}

script LavaridgeTown_Gym_1F_EventScript_SelectTrainers{
	special(SpawnCameraObject)
	selecttrainercameraoffset
	selecttrainer(LavaridgeTown_Gym_1F_Movement_ColeAndKeegan, "Cole & Keegan", TRAINER_COLE, TRAINER_KEEGAN)
	selecttrainer(LavaridgeTown_Gym_1F_Movement_Axle, "Axle", TRAINER_AXLE)
	selecttrainer(LavaridgeTown_Gym_1F_Movement_Eli, "Eli", TRAINER_ELI)
	selecttrainer(LavaridgeTown_Gym_1F_Movement_Gerald, "Gerald", TRAINER_GERALD)
	selecttrainer(LavaridgeTown_Gym_1F_Movement_Jace, "Jace", TRAINER_JACE)
	selecttrainer(LavaridgeTown_Gym_1F_Movement_Danielle, "Danielle", TRAINER_DANIELLE)
	selecttrainer(LavaridgeTown_Gym_1F_Movement_Jeff, "Jeff", TRAINER_JEFF)
	selecttrainer(LavaridgeTown_Gym_1F_Movement_Flannery, "Flannery", TRAINER_FLANNERY_1)
	applymovement(OBJ_EVENT_ID_CAMERA, LavaridgeTown_Gym_1F_Movement_Clyde)
	waitmovement(0)
	selecttrainercameraoffset(TRUE)
	special(RemoveCameraObject)
	return
}