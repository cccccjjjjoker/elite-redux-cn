script MossdeepCity_Gym_EventScript_CalcDefeatedCount{
	adddefeatedcount(TRAINER_SAMANTHA, 1) // TRAINER_BLAKE
	adddefeatedcount(TRAINER_MAURA) // TRAINER_PRESTON
	adddefeatedcount(TRAINER_SYLVIA) // TRAINER_HANNAH
	adddefeatedcount(TRAINER_KATHLEEN) // TRAINER_NICHOLAS
	adddefeatedcount(TRAINER_MACEY) // TRAINER_CLIFFORD
	adddefeatedcount(TRAINER_NATE) // TRAINER_VIRGIL
	return
}

script MossdeepCity_Gym_EventScript_CheckTrainers{
    if (defeated(TRAINER_TATE_AND_LIZA_1)) {
        msgbox(MossdeepCity_Gym_Text_TateAndLizaPostBattle, MSGBOX_DEFAULT)
        release
        end
    }
	// TRAINER_SAMANTHA => TRAINER_BLAKE
	// TRAINER_MAURA    => TRAINER_PRESTON	
	// TRAINER_SYLVIA   => TRAINER_HANNAH
	// TRAINER_KATHLEEN => TRAINER_NICHOLAS
	// TRAINER_MACEY    => TRAINER_CLIFFORD
	// TRAINER_NATE     => TRAINER_VIRGIL
    call (MossdeepCity_Gym_EventScript_CalcDefeatedCount)
	if (var(VAR_RESULT) < 1 ){
		registerbattleevent(BATTLE_EVENT_LIGHTSCREEN, 5)
	}
	if (var(VAR_RESULT) < 2){
		registerbattleevent(BATTLE_EVENT_REFLECT, 5)
	}
	if (var(VAR_RESULT) < 3){
		registerbattleevent(BATTLE_EVENT_LUCKY_CHANT, 5)
	}
	if (var(VAR_RESULT) < 4){
		registerbattleevent(BATTLE_EVENT_PERMA_WIDE_GUARD)
	}
	if (var(VAR_RESULT) < 5){
	    registerbattleevent(BATTLE_EVENT_LAST_SLEEP, 1)
	}
	if (var(VAR_RESULT) < 6){
		registerbattleevent(BATTLE_EVENT_NO_PROTECT)
	}
}
movement MossdeepCity_Gym_Text_LizaSansFromUndertale{
	walk_in_place_down * 3
}
text MossdeepCity_Gym_Text_TateAndLizaIntro0{
	format("小枫：不用超能力我们也知道……\n小南：……你接下来要吃苦头了。$")
}
text MossdeepCity_Gym_Text_TateAndLizaIntro1{
	format("小枫：你以为打几场对战……\n小南：……就能对付我们？\p小枫：好吧，但你最好确保……\n小南：……输了以后别抱怨太多！$")
}
text MossdeepCity_Gym_Text_TateAndLizaIntroAll{
	format("小枫：你的心已经强化到极致……\n小南：……\p但你要是以为我们没留最后一手，\n那就错了！！$")
}
text MossdeepCity_Gym_Text_TateAndLizaDefeat0{
	format("小枫：你逼我们拿出了特别的挑战，\n结果还是赢了。\p小南：看来该停手了。\n你得到想要的挑战了吗？$")
}
text MossdeepCity_Gym_Text_TateAndLizaDefeat1{
	format("小枫：虽然你一路上有点急……\n小南：……\p但最后还是站到了最高处！\n小枫：恭喜你获胜。\p小南：我们预见你未来会有精彩的对\n战。$")
}
text MossdeepCity_Gym_Text_TateAndLizaDefeatAll{
	format("小枫：你连我们都打败了……\n小南：……\p那下一个道馆对你来说一定没问题！$")
}
const LOCAL_ID_LIZA = 12
script MossdeepCity_Gym_EventScript_TateAndLiza{
    goto_if_set(FLAG_SYS_GAME_CLEAR, MossdeepCity_Gym_EventScript_TateAndLizaRematch)
    call(MossdeepCity_Gym_EventScript_CheckTrainers)
	setvar(VAR_0x8004, 15)
	setvar(VAR_BATTLE_FIELD_EFFECT_TYPE, BATTLE_FIELD_EFFECT_ROOM)
	setvar(VAR_BATTLE_FIELD_ID, STATUS_FIELD_TRICK_ROOM)
	setflag(FLAG_SYS_INVERSE_BATTLE)
	registerbattleevent(BATTLE_EVENT_TENSE_BATTLE)
	call (MossdeepCity_Gym_EventScript_CalcDefeatedCount)
    switch (var(VAR_RESULT)) {
		case 0:
			msgbox(MossdeepCity_Gym_Text_TateAndLizaIntro0)
			applymovement(LOCAL_ID_LIZA, MossdeepCity_Gym_Text_LizaSansFromUndertale)
			playse(SE_M_METRONOME)
			delay(8)
			playse(SE_M_METRONOME)
			delay(8)
			playse(SE_M_SKETCH)
			delay(6)
			playse(SE_M_METRONOME)
			trainerbattle_double_no_intro(TRAINER_TATE_AND_LIZA_1, MossdeepCity_Gym_Text_TateAndLizaDefeat0, MossdeepCity_Gym_Text_TateAndLizaNeedTwoMons, MossdeepCity_Gym_EventScript_TateAndLizaDefeated)
		break
		case 6:
			trainerbattle_double(TRAINER_TATE_AND_LIZA_1, MossdeepCity_Gym_Text_TateAndLizaIntroAll, MossdeepCity_Gym_Text_TateAndLizaDefeatAll, MossdeepCity_Gym_Text_TateAndLizaNeedTwoMons, MossdeepCity_Gym_EventScript_TateAndLizaDefeated, NO_MUSIC)
		break
		default:
			trainerbattle_double(TRAINER_TATE_AND_LIZA_1, MossdeepCity_Gym_Text_TateAndLizaIntro1, MossdeepCity_Gym_Text_TateAndLizaDefeat1, MossdeepCity_Gym_Text_TateAndLizaNeedTwoMons, MossdeepCity_Gym_EventScript_TateAndLizaDefeated, NO_MUSIC)
		break
	}
	
	clearflag(FLAG_SYS_INVERSE_BATTLE)
	setvar(VAR_BATTLE_FIELD_EFFECT_TYPE, 0)
	setvar(VAR_BATTLE_FIELD_ID, 0)
	goto_if_eq(MossdeepCity_Gym_EventScript_TateAndLizaRematch)
	goto_if_unset(FLAG_RECEIVED_TM04, MossdeepCity_Gym_EventScript_GiveCalmMind)
	msgbox(MossdeepCity_Gym_Text_TateAndLizaPostBattle, MSGBOX_DEFAULT)
	release
	end

}

script MossdeepCity_Gym_EventScript_AskResetTrainers{
	lock
	clydeaskresettrainers(MossdeepCity_Gym_EventScript_ResetAllTrainers, MossdeepCity_Gym_EventScript_SelectTrainers)
	release
	end
}

script MossdeepCity_Gym_EventScript_ResetAllTrainers{
	cleartrainerflag(TRAINER_SAMANTHA)
	cleartrainerflag(TRAINER_BLAKE)
	cleartrainerflag(TRAINER_MAURA)
	cleartrainerflag(TRAINER_PRESTON)
	cleartrainerflag(TRAINER_SYLVIA)
	cleartrainerflag(TRAINER_HANNAH)
	cleartrainerflag(TRAINER_KATHLEEN)
	cleartrainerflag(TRAINER_NICHOLAS)
	cleartrainerflag(TRAINER_MACEY)
	cleartrainerflag(TRAINER_CLIFFORD)
	cleartrainerflag(TRAINER_NATE)
	cleartrainerflag(TRAINER_VIRGIL)
	cleartrainerflag(TRAINER_TATE_AND_LIZA_1)
	return
}

