Route115_Text_NeverKnowWhenCavePokemonWillAppear: @ 81F2B55
	.string "探索洞窟和走在路上不一样。\p"
	.string "你永远不知道野生宝可梦\n"
	.string "什么时候会冒出来。充满悬念。$"

Route115_Text_RouteSignRustboro: @ 81F2BC9
	.string "115 号道路\n"
	.string "{DOWN_ARROW} 卡那兹市$"

Route115_Text_MeteorFallsSign: @ 81F2BE3
	.string "流星瀑布\n"
	.string "由此前往秋叶镇$"

`
script Route115_EventScript_LegendaryNPC{
    lock
    faceplayer
	msgbox(format("贤者：理解、情感、意志。\n我为愿意倾听的人吟唱\p湖之守护者赐予我们的祝福。$"), MSGBOX_YESNO)
	if(var(VAR_RESULT) == 1){
		if (!flag(FLAG_SYS_GAME_CLEAR)){
			msgbox(format("知识、情感、意志。\n沉睡的湖之守护者\p等待着能洞察其深意的人。\p只有理解它们的旨意，\n你才能成为它们力量的通道。\p接受它们的召唤吧，\n年轻的训练家，然后再来找我。$"))
	}
	else{
		if(defeated(TRAINER_TIMOTHY_1) &&
		   defeated(TRAINER_KOICHI) &&
		   defeated(TRAINER_NOB_1)  &&
		   defeated(TRAINER_CYNDY_1)  &&
		   defeated(TRAINER_HECTOR)  &&
		   defeated(TRAINER_KYRA)  &&
		   defeated(TRAINER_JAIDEN)  &&
		   defeated(TRAINER_ALIX)  &&
		   defeated(TRAINER_HELENE)  &&
		   defeated(TRAINER_MARLENE)){
				msgbox(format("洞察、热忱、坚毅。\n这些美德在你心中燃烧。\p守护者已准备好与你相见：\n用图鉴导航器找出它们的位置。$"))
			}
		else{
			msgbox(format("智慧、热情、决心。\n你对心灵裂隙的掌控非同寻常，\p但还不够全面。\p清除这条道路上所有的阻碍，\n守护三神就会再度苏醒。$"))
		}
	}
	}
	else{
		msgbox(format("恶意、荒芜、背叛。\n你竟然拒绝守护者的馈赠，\p真可耻！$"), MSGBOX_NPC)
	}
    release
    end
}

script Route115_EventScript_Gen8_NPC{
    lock
    faceplayer
		if(defeated(TRAINER_TIMOTHY_1) &&
		   defeated(TRAINER_KOICHI) &&
		   defeated(TRAINER_NOB_1)  &&
		   defeated(TRAINER_CYNDY_1)  &&
		   defeated(TRAINER_HECTOR)  &&
		   defeated(TRAINER_KYRA)  &&
		   defeated(TRAINER_JAIDEN)  &&
		   defeated(TRAINER_ALIX)  &&
		   defeated(TRAINER_HELENE)  &&
		   defeated(TRAINER_MARLENE)){
		// when you defeat every trainer
		msgbox(format("终于完成了。谢谢你，朋友！$"))
		givemon(SPECIES_DRACOVISH, 50, ITEM_NONE)
		playfanfare(MUS_OBTAIN_ITEM)
		message(format("{PLAYER}获得了{COLOR BLUE}鳃鱼龙{COLOR DARK_GRAY}，\n这是打败这里所有训练家的礼物！$"))
		waitfanfare
	}
	else{
		// before defeating every trainer here
		msgbox(format("我有嘴，就必须咬。\n与我一同踏上这片土地的\p食肉之旅吧。$"))
	}
    release
    end
}