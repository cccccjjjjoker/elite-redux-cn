`
script Route134_EventScript_LegendaryNPC{
    lock
    faceplayer
	msgbox(format("修行者：最后一批究极异兽就住在这\n里。你知道规矩：想知道更多吗？$"), MSGBOX_YESNO)
	if(var(VAR_RESULT) == 1){
	if (!flag(FLAG_SYS_GAME_CLEAR)){
		msgbox(format("和其他地方一样，\n这条路上也住着一些来自外太空的究\p极异兽。我会告诉你它们的位置，\n但要等你成为冠军之后！$"))
	}
	else{
		if(defeated(TRAINER_KELVIN)  &&
		   defeated(TRAINER_MARLEY)  &&
		   defeated(TRAINER_REYNA)   &&
		   defeated(TRAINER_HUDSON)  &&
		   defeated(TRAINER_HITOSHI) &&
		   defeated(TRAINER_AARON)   &&
		   defeated(TRAINER_ALEX)    &&
		   defeated(TRAINER_LAUREL)  &&
		   defeated(TRAINER_JACK)){
			msgbox(format("你在旅途中展现出了强大的实力与坚\n定，我想你已经准备好与究极异兽见\p面了。电束木、\n垒磊石和砰头小丑就藏在这里：\p用图鉴导航看它们的位置。$"))
		}
		else{
			msgbox(format("你是来找究极异兽的吗？我就知道。\n我会告诉你它们藏在哪儿，\p但先打败这条路上所有的训练家！$"))
		}
	}
	}
	else{
		msgbox(format("我可以忘记所有我想成为的东西，\n却忘不了我不想成为的东西：你！$"))
	}
    release
    end
}