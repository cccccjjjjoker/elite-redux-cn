PetalburgCity_EventScript_GymBoy:: @ 81DC82E
	msgbox PetalburgCity_Text_AreYouRookieTrainer, MSGBOX_NPC
	end

PetalburgCity_Text_WhereIsWally: @ 81DC837
	.string "我们的小胜去哪儿了？\p"
	.string "我们马上就要去\n"
	.string "绿茵镇了……$"

PetalburgCity_Text_AreYouRookieTrainer: @ 81DC881
	.string "嘿！你是不是……\n"
	.string "新手训练家？\p"
	.string "你知道训练家\n"
	.string "到一个新城镇会先做什么吗？\p"
	.string "他们会先看看这里\n"
	.string "有什么样的道馆。$"

PetalburgCity_Text_ThisIsPetalburgGym: @ 81DC91B
	.string "看，这就是橙华市的道馆。$"

PetalburgCity_Text_ThisIsGymSign: @ 81DC93E
	.string "这是道馆的招牌。找道馆时\n"
	.string "就找这个标志。$"

PetalburgCity_Text_WaterReflection: @ 81DC985
	.string "水面上映着我的脸。\p"
	.string "那是充满希望的灿烂笑容……\p"
	.string "也可能是与恐惧搏斗的\n"
	.string "沉静神情……\p"
	.string "你的脸上映出了什么？$"

PetalburgCity_Text_FullPartyExplanation: @ 81DCA30
	.string "假设你有六只宝可梦。\n"
	.string "如果又抓到一只……\p"
	.string "它会通过电脑连接\n"
	.string "自动送到寄存盒里。$"

PetalburgCity_Text_GymSign: @ 81DCAAA
	.string "橙华市宝可梦道馆\n"
	.string "馆主：千里\l"
	.string "“追求力量的男人！”$"

PetalburgCity_Text_CitySign: @ 81DCAF1
	.string "橙华市\n"
	.string "“人与自然共生之地。”$"

PetalburgCity_Text_WallyHouseSign: @ 81DCB23
	.string "小胜的家$"

PetalburgCity_Text_AreYouATrainer: @ 81DCB31
	.string "打扰了！\p"
	.string "让我猜猜，看你这一身打扮，\n"
	.string "你是训练家吧？$"

PetalburgCity_Text_WellMaybeNot: @ 81DCB82
	.string "… … … … … …\p"
	.string "嗯，也许不是。\n"
	.string "你的衣服还不算太脏。\p"
	.string "你要么是个新手训练家，\n"
	.string "要么就是个普通小孩。$"

PetalburgCity_Text_ImLookingForTalentedTrainers: @ 81DCC09
	.string "我在各地旅行，寻找\n"
	.string "有才华的训练家。\p"
	.string "抱歉占用你的时间。$"
`
script PetalburgCity_OnLoad{
	if(flag(FLAG_BADGE04_GET) && !flag(FLAG_FINISHED_SUNHOLLOW_STORY)){
		setmetatile(15, 8, METATILE_Petalburg_ClosedGymDoor, 1)
	}
	end
}

script PetalburgCity_EventScript_GymSign_Closed{
	if(flag(FLAG_BADGE04_GET) && !flag(FLAG_FINISHED_SUNHOLLOW_STORY)){
		msgbox(format("（门上贴着一张便条。）\p"
					"你好！很抱歉，\n"
					"我们暂时停业。\p"
					"馆主千里外出办事了。\n"
					"应该很快就会恢复营业！"), MSGBOX_SIGN)
	}
	end
}

script PetalburgCity_EventScript_Gentleman{
	if(flag(FLAG_BADGE04_GET) && !flag(FLAG_FINISHED_SUNHOLLOW_STORY)){
		msgbox(format("不久前我看见千里先生\n"
		              "带着一套防尘护目镜离开了。\p"
		              "他到底去沙漠里\n"
					  "做什么呢？"), MSGBOX_NPC)
	}
	else{
		msgbox(PetalburgCity_Text_FullPartyExplanation, MSGBOX_NPC)
	}
	end
}
