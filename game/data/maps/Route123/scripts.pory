Route123_Text_LoveGrassMonsHaveAny: @ 81F641E
	.string "我最喜欢草属性宝可梦了！\n"
	.string "你有草属性宝可梦吗？$"

Route123_Text_YouLikeGrassMonsTooHaveThis: @ 81F645D
	.string "哦？\n"
	.string "你也喜欢草属性宝可梦，对吧？\p"
	.string "我好开心，这个给你！\n"
	.string "这是我们友情的证明。$"

Route123_Text_CheckTreesWithMyGrassMon: @ 81F64CF
	.string "我用草属性宝可梦检查树木。\n"
	.string "我就像个树医。$"

Route123_Text_RouteSign: @ 81F6511
	.string "{RIGHT_ARROW} 123号道路\n"
	.string "{LEFT_ARROW} 118号道路$"

Route123_Text_RouteSignMtPyre: @ 81F6529
	.string "{UP_ARROW} 送神火山\n"
	.string "“胆小者禁止入内。”$"

Route123_Text_BerryMastersHouse: @ 81F6557
	.string "树果大师的家$"

`
script Route123_EventScript_LegendaryNPC{
    lock
    faceplayer
	msgbox(format("修行者：传说中的三头龙正小心地在\n我们身边踱步。想知道它们是谁吗？$"), MSGBOX_YESNO)
	if(var(VAR_RESULT) == 1){
		if (!flag(FLAG_SYS_GAME_CLEAR)){
		msgbox(format("从这里就能感受到道之三龙那种和谐\n的失衡。它们体现着这个世界的矛盾\p本质：莱希拉姆炽烈的热情，\n能与捷克罗姆井然有序的节奏共存。\p它们永远对立地共舞，\n却又设法找到了平衡点。\p酋雷姆是秩序的化身，\n它证明了最混乱的生物也能在自身中\p找到和谐。继续修炼你的气度，\n成为冠军后再回来吧。$"))
	}
	else{
		if(defeated(TRAINER_WENDY)  &&
		   defeated(TRAINER_BRAXTON)  &&
		   defeated(TRAINER_VIOLET)  &&
		   defeated(TRAINER_CAMERON_1)  &&
		   defeated(TRAINER_JACKI_1)  &&
		   defeated(TRAINER_MIU_AND_YUKI)  &&
		   defeated(TRAINER_KINDRA)  &&
		   defeated(TRAINER_FREDRICK)  &&
		   defeated(TRAINER_ALBERTO)  &&
		   defeated(TRAINER_ED)  &&
		   defeated(TRAINER_KAYLEY)  &&
		   defeated(TRAINER_JONAS)  &&
		   defeated(TRAINER_JAZMYN)  &&
		   defeated(TRAINER_DAVIS)  &&
		   defeated(TRAINER_FERNANDO_1)){
			msgbox(format("你的气已和谐，\n你的灵魂也与自身相合。\p我赐予你会见道之三龙的资格。\n用图鉴导航，它们现在就会出现。$"))
		}
		else{
			msgbox(format("寻求平衡的人，你的努力已被看见。\n道之三龙注意到了你的行动，\p但还想做最后一次确认。\n打败这条路上所有的训练家，\p就能见到它们！$"))
		}
	}
	}
	else{
		msgbox(format("那么，我想我们合不来。$"))
	}
    release
    end
}

script Route123_EventScript_Granbullite_Battle {
	lock
	faceplayer
	if (flag(FLAG_BADGE07_GET)) { // Checking if the player has the badge
		//cleartrainerflag(TRAINER_GRANBULLITE_ROUTE123) // Only For testing
		if (!defeated(TRAINER_GRANBULLITE_ROUTE123)) { // asking for battle
			msgbox(format("你好呀。要摸摸我的狗吗？\n它们不咬人！$"), MSGBOX_YESNO)
			if (var(VAR_RESULT) == 1) {
				msgbox(format("啊！布鲁皇，不要！$"), MSGBOX_NPC) // When the player accepts the battle
				// trainerbattle_double TRAINER_TATE_AND_LIZA_1, MossdeepCity_Gym_Text_TateAndLizaIntro, MossdeepCity_Gym_Text_TateAndLizaDefeat, MossdeepCity_Gym_Text_TateAndLizaNeedTwoMons, MossdeepCity_Gym_EventScript_TateAndLizaDefeated, NO_MUSIC
				trainerbattle_no_intro(TRAINER_GRANBULLITE_ROUTE123, format("真、真是太对不起了！$")) // in-battle, player wins
				msgbox(format("太抱歉了！\n我没想到它们六个会一起从精灵球里\p跳出来！它们平时不咬人的。\n请收下这个作为补偿。$"), MSGBOX_NPC) // after player won
				playfanfare(MUS_OBTAIN_ITEM)
				giveitem(ITEM_ARCANITE_H, 1) // Item given to the player
				waitmessage
			}
			else { // when refusing the battle
				msgbox(format("唉，好吧。我发誓，\n它们真的不咬人。$"), MSGBOX_NPC)
			}
		}
		else { // When the trainer is already defeated
			msgbox(format("再说一次，真的很抱歉。\n我的狗平时都很温顺，\p连只苍蝇都不会伤害！$"), MSGBOX_NPC)
		}
	}
	else { // When the player doesn't have the badge yet
		msgbox(format("嗯？哦。你看起来挺有意思。嘿，\n如果你在绿岭市打败那对双胞胎之后\p再来，我就送你点东西！$"), MSGBOX_NPC)
	}
	release
	end	
}