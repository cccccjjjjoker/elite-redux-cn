mapscripts Route111_Desert_MapScripts {
}

script Route111_Desert_EventScript_Lett{
	trainerbattle_single(TRAINER_LETT, format("别在意，我只是个占位符。$"), format("I guess even placeholders can be defeated"))
	msgbox(format("这是段占位文本，对吧？$"), MSGBOX_AUTOCLOSE)
	end
}

