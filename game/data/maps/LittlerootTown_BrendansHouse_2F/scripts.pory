`
text LittlerootTown_BrendansHouse_2F_Text_Which_Region{
	"Hmm. Which region or type was it again?"
}

script LittlerootTown_BrendansHouse_2F_EventScript_ChooseStarterSet{
	msgbox (LittlerootTown_BrendansHouse_2F_Text_Which_Region, MSGBOX_DEFAULT)
	setvar (VAR_0x8004, SCROLL_MULTI_REGION_NAMES)
	special(ShowScrollableMultichoice)
	waitstate
	if (var(VAR_RESULT) == MULTI_B_PRESSED){
		goto(LittlerootTown_BrendansHouse_2F_EventScript_ChooseStarterSet)
	}
	//understandably safe
	copyvar(VAR_STARTER_GEN, VAR_RESULT)
	addvar(VAR_STARTER_GEN, 1)
	switch(var(VAR_STARTER_GEN)){
		case 1:   bufferstring(1, StarterRegionStringKanto)
	break
	    case 2:   bufferstring(1, StarterRegionStringJohto)
	break
	    case 3:   bufferstring(1, StarterRegionStringHoenn)
	break
	    case 4:   bufferstring(1, StarterRegionStringSinnoh)
	break
	    case 5:   bufferstring(1, StarterRegionStringUnova)
	break
	    case 6:   bufferstring(1, StarterRegionStringKalos)
	break
	    case 7:   bufferstring(1, StarterRegionStringAlola)
	break
	    case 8:   bufferstring(1, StarterRegionStringGalar)
	break
	    case 9:   bufferstring(1, StarterRegionStringPaldea)
	break
	    case 10:  bufferstring(1, StarterRegionStringBug)
	break
	    case 11:  bufferstring(1, StarterRegionStringDark)
	break
	    case 12:  bufferstring(1, StarterRegionStringDragon)
	break
	    case 13:  bufferstring(1, StarterRegionStringElectric)
	break
	    case 14:  bufferstring(1, StarterRegionStringFairy)
	break
	    case 15:  bufferstring(1, StarterRegionStringFighting)
	break
	    case 16:  bufferstring(1, StarterRegionStringFlying)
	break
	    case 17:  bufferstring(1, StarterRegionStringGhost)
	break
	    case 18:  bufferstring(1, StarterRegionStringGround)
	break
	    case 19:  bufferstring(1, StarterRegionStringIce)
	break
	    case 20:  bufferstring(1, StarterRegionStringNormal)
	break
	    case 21:  bufferstring(1, StarterRegionStringPoison)
	break
	    case 22:  bufferstring(1, StarterRegionStringPsychic)
	break
	    case 23:  bufferstring(1, StarterRegionStringRock)
	break
	    case 24:  bufferstring(1, StarterRegionStringSteel)
	}
	if (var(VAR_STARTER_GEN) < 10){
		msgbox(format("所以是{STR_VAR_2}地区。\n对吧？$"), MSGBOX_YESNO)
		if (!var(VAR_RESULT)){
			goto(LittlerootTown_BrendansHouse_2F_EventScript_ChooseStarterSet)
		}
		msgbox(RivalsHouse_1F_Text_BrendanSomeOtherTime, MSGBOX_DEFAULT)
		closemessage
	} else {
		msgbox(format("所以是{STR_VAR_2}属性。\n对吧？$"), MSGBOX_YESNO)
		if (!var(VAR_RESULT)){
			goto(LittlerootTown_BrendansHouse_2F_EventScript_ChooseStarterSet)
		}
		msgbox(RivalsHouse_1F_Text_BrendanSomeOtherTimeType, MSGBOX_DEFAULT)
		closemessage
	}
	
}
movement IntroSkip_Movement_SetIntroFlagsMaleFollowUpToClock0 {
	walk_right * 2
}
script IntroSkip_EventScript_SetIntroFlagsMale0 {
	call(IntroSkip_EventScript_SetIntroFlagsMale)
	lock
	applymovement(OBJ_EVENT_ID_PLAYER, IntroSkip_Movement_SetIntroFlagsMaleFollowUpToClock0)
	waitmovement(OBJ_EVENT_ID_PLAYER)
	goto(IntroSkip_EventScript_SetIntroFlagsMaleFollowUpToClock)
}
script IntroSkip_EventScript_SetIntroFlagsMale1 {
	call(IntroSkip_EventScript_SetIntroFlagsMale)
	lock
	goto(IntroSkip_EventScript_SetIntroFlagsMaleFollowUpToClock)
}
movement IntroSkip_Movement_SetIntroFlagsMaleFollowUpToClock {
	walk_right * 3
	walk_up * 2
}
script IntroSkip_EventScript_SetIntroFlagsMaleFollowUpToClock{
	applymovement(OBJ_EVENT_ID_PLAYER, IntroSkip_Movement_SetIntroFlagsMaleFollowUpToClock)
	waitmovement(OBJ_EVENT_ID_PLAYER)
	goto(IntroSkip_EventScript_MaleForceClock)
	release
}

script IntroSkip_EventScript_MaleForceClock{
	call(LittlerootTown_BrendansHouse_2F_EventScript_WallClock)
	if (!flag(FLAG_SET_WALL_CLOCK)){
		goto(IntroSkip_EventScript_MaleForceClock)
	}
}