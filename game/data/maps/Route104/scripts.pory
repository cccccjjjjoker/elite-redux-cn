Route104_Text_BrineyLivesInSeasideCottage: @ 81ED5EC
	.string "海边那栋小屋就是布林先生的家。\p"
	.string "他曾经是个了不起的水手，\n"
	.string "不管风浪多大都不怕海。$"

Route104_Text_WhatsItLikeAtBottomOfSea: @ 81ED662
	.string "海啊……\p"
	.string "海底到底是什么样子呢？$"

Route104_Text_ThrowBallAtWeakenedPokemon: @ 81ED6A2
	.string "要扔精灵球，\n"
	.string "先把野生宝可梦削弱。\p"
	.string "让它中毒、灼伤或睡着，\n"
	.string "会更容易抓到。$"

Route104_Text_OnlyThrowBallAtWildPokemon: @ 81ED735
	.string "想抢别人的宝可梦，\n"
	.string "那就是小偷。\p"
	.string "精灵球只该扔向\n"
	.string "野生宝可梦。$"

Route104_Text_ImNotATrainer: @ 81ED7A2
	.string "哦，不，我不是训练家。\p"
	.string "不过没错，训练家一对上眼，\n"
	.string "就是一场对战的挑战。\p"
	.string "不想打的话，\n"
	.string "就别让他们看见你。$"

Route104_Text_LikeFillingMouthWithSeedsTakeThis: @ 81ED838
	.string "我喜欢把种子塞满嘴，\n"
	.string "再飞快地吐出来！\p"
	.string "你已经有所有招式学习器了，\n"
	.string "不过我可以给你个有用的建议。\p"
	.string "拥有连续攻击特性的宝可梦，\n"
	.string "连击招式一定会打五次。$"

Route104_Text_TMsAreOneTimeUse:
	.string "给你个忠告！\p"
	.string "招式学习器可以反复使用，\n"
	.string "用完不会消失。$"

Route104_Text_DontNeedThisTakeIt: @ 81ED96A
	.string "这家花店最近开始卖树苗了。\p"
	.string "我高兴得买过头了。\p"
	.string "这株白色香草我已经不需要了。\n"
	.string "你愿意收下吗？$"

Route104_Text_FlowerShopSellingSaplings: @ 81EDA0F
	.string "这家花店最近开始卖树苗了。\p"
	.string "我高兴得买过头了。\n"
	.string "该把它们放哪儿呢？$"

Route104_Text_MrBrineysCottage: @ 81EDA8C
	.string "布林先生的小屋$"

Route104_Text_RouteSignPetalburg: @ 81EDAA1
	.string "104 号道路\n"
	.string "{RIGHT_ARROW} 橙华市$"

Route104_Text_RouteSignRustboro: @ 81EDABC
	.string "104 号道路\n"
	.string "{UP_ARROW} 卡那兹市$"

Route104_Text_PrettyPetalFlowShop: @ 81EDAD6
	.string "美丽花店$"

Route104_Text_TrainerTipsDoubleBattles: @ 81EDAEF
	.string "训练家小贴士\p"
	.string "在丰缘地区，有些训练家\n"
	.string "会两人一组向别人挑战\p"
	.string "二对二的“双打对战”。\p"
	.string "双打对战时，训练家要派两只\n"
	.string "宝可梦：队伍列表最左边的一只\p"
	.string "和最上面的一只。\p"
	.string "注意宝可梦的排列顺序。$"

Route104_Text_MayWeShouldRegister: @ 81EDBFF
	.string "小遥：哦，嗨，{PLAYER}{KUN}！\p"
	.string "得文给你的宝可梦领航器\n"
	.string "升级了通讯呼叫系统吧？\p"
	.string "我们互相登记一下吧，\n"
	.string "这样随时都能联系。$"

Route104_Text_RegisteredMay: @ 81EDC8F
	.string "{PLAYER}把小遥\n"
	.string "登记到宝可梦领航器中。$"

Route104_Text_MayHowsYourPokedex: @ 81EDCB1
	.string "小遥：对了，{PLAYER}{KUN}，\n"
	.string "你的图鉴进展如何？$"

Route104_Text_MayMinesDecentLetsBattle: @ 81EDCED
	.string "我的图鉴看起来还不错。\p"
	.string "那么……\p"
	.string "来场小对战怎么样？$"

Route104_Text_MayHaventRaisedPokemon: @ 81EDD2A
	.string "小遥：哦，怎么了？\p"
	.string "你的宝可梦还没怎么\n"
	.string "捕捉和培养吗？\p"
	.string "这样可不算个合格的训练家！$"

Route104_Text_MayLetsBattle: @ 81EDD9F
	.string "小遥：那么，你觉得呢？\p"
	.string "就在这儿来场小对战？$"

Route104_Text_MayIntro: @ 81EDDDB
	.string "小遥：{PLAYER}{KUN}，\n"
	.string "你才刚当上训练家。\p"
	.string "我可不会输！$"

Route104_Text_MayDefeat: @ 81EDE18
	.string "哇！\p"
	.string "你比我想的厉害！$"

Route104_Text_MayPostBattle: @ 81EDE3E
	.string "小遥：看得出你对待宝可梦\n"
	.string "已经很有心得了。\p"
	.string "不过别只让它们对战，\n"
	.string "你该学学布林先生。\p"
	.string "和宝可梦成为朋友\n"
	.string "也很重要。$"

Route104_Text_BrendanWeShouldRegister: @ 81EDF04
	.string "祐树：哦，嘿，{PLAYER}！\p"
	.string "不错嘛，你让得文给领航器\n"
	.string "装了通讯呼叫系统！\p"
	.string "我们在领航器里互相登记吧，\n"
	.string "这样就能保持联系。$"

Route104_Text_RegisteredBrendan: @ 81EDFA0
	.string "{PLAYER}把祐树\n"
	.string "登记到宝可梦领航器中。$"

Route104_Text_BrendanHowsYourPokedex: @ 81EDFC6
	.string "祐树：{PLAYER}，图鉴进展如何？\n"
	.string "已经填上几页了吗？$"

Route104_Text_BrendanDoingGreatLetsBattle: @ 81EE009
	.string "我这边进展很好！\p"
	.string "想不想用一场对战\n"
	.string "检验一下我的实力？$"

Route104_Text_BrendanNoConfidence: @ 81EE04D
	.string "祐树：怎么了？\n"
	.string "对自己的宝可梦没信心？$"

Route104_Text_BrendanLetsBattle: @ 81EE094
	.string "祐树：怎么了？\p"
	.string "想跟我打一场吗？$"

Route104_Text_BrendanIntro: @ 81EE0C7
	.string "祐树：我知道你才刚当上训练家，\n"
	.string "但我不会手下留情！$"

Route104_Text_BrendanDefeat: @ 81EE107
	.string "嗯……\p"
	.string "你还挺不错。$"

Route104_Text_BrendanPostBattle: @ 81EE120
	.string "祐树：你对待宝可梦\n"
	.string "已经相当上手了。\p"
	.string "不过，你不该只让它们对战。\p"
	.string "要像布林先生那样，\n"
	.string "和宝可梦成为朋友，这很重要。$"
`
script Route104South_EventScript_Gen8_NPC{
    lock
    faceplayer
	if(defeated(TRAINER_DARIAN) &&
	   defeated(TRAINER_BILLY) &&
	   defeated(TRAINER_CINDY_1)){
		// when you defeat every trainer
		msgbox(format("嘿嘿嘿，你打赢那些对战时\n笑得很开心吧！\p拿着这个，这是你应得的。$"))
		givemon(SPECIES_ZIGZAGOON_GALARIAN, 10, ITEM_NONE)
		playfanfare(MUS_OBTAIN_ITEM)
		message(format("{PLAYER}得到了\n{COLOR BLUE}伽勒尔蛇纹熊{COLOR DARK_GRAY}，\p这是击败这里所有训练家的礼物！$"))
		waitfanfare
	}
	else{
		// before defeating every trainer here
		msgbox(format("嘿，未来的冠军！\p击败这条路上所有训练家，\n我就送你一份来自伽勒尔的\p偷偷摸摸的惊喜。\n准备好捣点乱了吗？$"))
	}
    release
    end
}

script Route104North_EventScript_Gen8_NPC{
    lock
    faceplayer
	if(defeated(TRAINER_WINSTON_1) &&
	   defeated(TRAINER_HALEY_1) &&
	   defeated(TRAINER_GINA_AND_MIA_1) &&
	   defeated(TRAINER_IVAN)){
		// when you defeat every trainer
		msgbox(format("干得好，小子！\n这只猫正需要一个\p像你这样真正的丰缘老家伙作伴！$"))
		givemon(SPECIES_MEOWTH_GALARIAN, 10, ITEM_NONE)
		playfanfare(MUS_OBTAIN_ITEM)
		message(format("{PLAYER}得到了\n{COLOR BLUE}伽勒尔喵喵{COLOR DARK_GRAY}，\p这是击败这里所有训练家的礼物！$"))
		waitfanfare
	}
	else{
		// before defeating every trainer here
		msgbox(format("只要你击败这里\n所有其他训练家，\p我就奖励你一只\n忠诚的猫科宝可梦！$"))
	}
    release
    end
}

script Route104_EventScript_TrainerTemplate{
    lock
    faceplayer
	if(!defeated(TRAINER_IVAN)){//TRAINER_IVAN will be changed for the new trainer
		trainerbattle_single(TRAINER_IVAN, format("（开场白占位）$"), format("Put the Defeat message here."))
		msgbox(format("（战后台词占位）$"), MSGBOX_AUTOCLOSE)
	}
	else{
		// before defeating every trainer here
		msgbox(format("（战后台词占位）$"))
	}
    release
    end
}

movement Route104_Movement_StealBrineyBoatStepOut {
	walk_down * 3
}

script Route104_EventScript_StealBrineyBoat {
	lock
	if (flag(FLAG_HIDE_ROUTE_104_MR_BRINEY_BOAT)){
		release
		end
	}
	if (var(VAR_BRINEY_HOUSE_STATE) == 0){
		msgbox("这艘船上缺了钥匙。$", MSGBOX_SIGN)
		release
		end
	}
	msgbox("钥匙插着，要偷这艘船吗？$", MSGBOX_YESNO)
	if (!var(VAR_RESULT)){
		msgbox("我为什么要偷？$", MSGBOX_AUTOCLOSE)
		release
		end
	}
	msgbox("这才叫水舰队的风格！$", MSGBOX_AUTOCLOSE)
	setvar(VAR_RUSTBORO_CITY_STATE, 10)
	setvar(VAR_ROUTE104_STATE, 2)
	setflag(FLAG_HIDE_RUSTBORO_CITY_RIVAL)
	setflag(FLAG_HIDE_ROUTE_104_RIVAL)
	hideobjectat(OBJ_EVENT_ID_PLAYER, MAP_ROUTE104)
	call(Common_EventScript_PlayBrineysBoatMusic)
	if (!flag(FLAG_ENABLE_NORMAN_MATCH_CALL)){
		setflag(FLAG_ENABLE_NORMAN_MATCH_CALL)
	}
	hideobjectat(LOCALID_BRINEY_R104, MAP_ROUTE104)
	applymovement(LOCALID_BOAT_R104, Route104_Movement_SailToDewford)
	applymovement(OBJ_EVENT_ID_PLAYER, Route104_Movement_SailToDewford)
	waitmovement(0)
	applymovement(OBJ_EVENT_ID_PLAYER, Route104_Movement_StealBrineyBoatStepOut)
	waitmovement(0)
	showobjectat(OBJ_EVENT_ID_PLAYER, MAP_DEWFORD_TOWN)
	call(Common_EventScript_StopBrineysBoatMusic)
	clearflag(FLAG_HIDE_MR_BRINEY_BOAT_DEWFORD_TOWN)
	addobject(LOCALID_BOAT_DEWFORD)
	setflag(FLAG_HIDE_ROUTE_104_MR_BRINEY_BOAT)
	//setvar(VAR_BRINEY_LOCATION, 4) // this may cause massives issues mreow :3
	hideobjectat(LOCALID_BOAT_R104, MAP_ROUTE104)
	release
}
