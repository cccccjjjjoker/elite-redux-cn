RusturfTunnel_EventScript_Mike:: @ 822D1B1
	trainerbattle_single TRAINER_MIKE_2, RusturfTunnel_Text_MikeIntro, RusturfTunnel_Text_MikeDefeat
	msgbox RusturfTunnel_Text_MikePostBattle, MSGBOX_AUTOCLOSE
	end

RusturfTunnel_Text_ComeAndGetSome: @ 822D1C8
	.string "怎么，你过来了？那就来拿吧！$"

RusturfTunnel_Text_Peeko: @ 822D1F7
	.string "皮可：皮……皮啾！$"

RusturfTunnel_Text_GruntIntro: @ 822D20A
	.string "可恶，全完了！\n"
	.string "那个当人质的宝可梦根本没用！\p"
	.string "没想到我逃跑……\n"
	.string "竟跑进这条死路隧道！\p"
	.string "喂！你！\n"
	.string "你想跟我打？$"

RusturfTunnel_Text_GruntDefeat: @ 822D2B0
	.string "呃啊啊！我的犯罪生涯到此为止了！$"

RusturfTunnel_Text_GruntTakePackage: @ 822D2E1
	.string "这根本不对……\n"
	.string "老大跟我说这是个轻松活儿。\p"
	.string "我只要从得文那儿偷个包裹就行。\n"
	.string "啧！\p"
	.string "你这么想要，就拿去！$"

RusturfTunnel_Text_PeekoGladToSeeYouSafe: @ 822D395
	.string "皮可！\n"
	.string "看到你平安我真高兴！$"

RusturfTunnel_Text_ThankYouLetsGoHomePeeko: @ 822D3BA
	.string "皮可的命是你救的！\n"
	.string "别人叫我布里尼先生。你是？\p"
	.string "…… …… …… ……\n"
	.string "…… …… …… ……\p"
	.string "啊，原来你是{PLAYER}{KUN}！\n"
	.string "我真心感谢你！\p"
	.string "以后有什么难处，别客气，\n"
	.string "尽管告诉我！\p"
	.string "通常你可以在橙华森林附近\n"
	.string "我海边的小屋找到我。\p"
	.string "来，皮可，我们该回家了。\n"
	.string "{PLAYER}{KUN}，我送你回城里。\p"
	.string "皮可：皮啾！$"

RusturfTunnel_Text_WhyCantTheyKeepDigging: @ 822D510
	.string "……\n"
	.string "他们为什么不能继续挖？\p"
	.string "是基岩太硬吗？\n"
	.string "我心爱的人就在这前面的绿茵镇等我\p"
	.string "……\n"
	.string "要是卡那兹和绿茵镇被这条隧道连起\p"
	.string "来，\n"
	.string "我就能每天都去看她……\p"
	.string "可是这样……我该怎么办？$"

RusturfTunnel_Text_ToGetToVerdanturf: @ 822D5F3
	.string "要从卡那兹去绿茵镇，\n"
	.string "得先去武斗镇，\p"
	.string "再经过凯那市和紫堇市……$"

RusturfTunnel_Text_YouShatteredBoulderTakeHM: @ 822D65C
	.string "哇！你把挡路的岩石打碎了。\n"
	.string "为了表示我的感谢，\p"
	.string "这个秘传学习器给你。$"

RusturfTunnel_Text_ExplainStrength: @ 822D6D2
	.string "那个秘传学习器里装着怪力。\n"
	.string "要是力气大的宝可梦学会它，\p"
	.string "连巨大的岩石都能推动。$"

RusturfTunnel_Text_WandaReunion: @ 822D745
	.string "旺达！现在我可以随时见到你了！\n"
	.string "旺达：那……太好了。\p"
	.string "请到我家里休息一下吧。$"

RusturfTunnel_Text_BoyfriendOnOtherSideOfRock: @ 822D7A3
	.string "在这块岩石的另一边……\n"
	.string "我的男朋友就在那里。\p"
	.string "他……他不只是为了见我才挖隧道。\n"
	.string "他为了大家的利益，\p"
	.string "把手都磨得又粗又破。$"

RusturfTunnel_Text_MikeIntro: @ 822D84D
	.string "山上野着的人叫什么？山人，对吧？\n"
	.string "那为什么山里的宝可梦\p"
	.string "不叫山宝可梦？$"

RusturfTunnel_Text_MikeDefeat: @ 822D8DB
	.string "我的宝可梦……力量用完了……$"

RusturfTunnel_Text_MikePostBattle: @ 822D8F9
	.string "他们为了保护宝可梦才停止开发的，\n"
	.string "对吧？\p"
	.string "真是个好故事！$"

`

script RusturfTunnel_EventScript_Gen8_NPC{
    lock
    faceplayer
	if(defeated(TRAINER_MIKE_2)){
		// when you defeat every trainer
		msgbox(format("这只伽勒尔的宝可梦给你。\n你想要多少都行！真的，\p能拿多少拿多少！（拜托了……）$"))
		givemon(SPECIES_IMPIDIMP, 10, ITEM_NONE)
		playfanfare(MUS_OBTAIN_ITEM)
		message(format("{PLAYER}获得了{COLOR BLUE}诈唬魔{COLOR DARK_GRAY}，\n这是打败那位登山男的礼物！$"))
		waitfanfare
	}
	else{
		// before defeating every trainer here
		msgbox(format("你要是能打赢那边那个登山男，\n我就给你一只伽勒尔的特别宝可梦。\p它们其实有点烦人……\n（不该说这个的！）\p不过我觉得你会……喜欢它们。\n大概吧。$"))
	}
    release
    end
}
