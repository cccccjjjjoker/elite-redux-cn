raw `
RustboroCity_Gym_MapScripts:: @ 8212F30
	.byte 0

RustboroCity_Gym_EventScript_RoxanneDefeated:: @ 8212F66
	goto_if_unset FLAG_DEFEATED_RUSTBORO_GYM, RustboroCity_Gym_EventScript_RoxanneDefeatedFirstTime
	release
	end
RustboroCity_Gym_EventScript_RoxanneDefeatedFirstTime:: 
	message RustboroCity_Gym_Text_ReceivedStoneBadge
	waitmessage
	call Common_EventScript_PlayGymBadgeFanfare
	msgbox RustboroCity_Gym_Text_StoneBadgeInfoTakeThis, MSGBOX_DEFAULT
	setflag FLAG_DEFEATED_RUSTBORO_GYM
	setflag FLAG_BADGE01_GET
	setvar VAR_RUSTBORO_CITY_STATE, 2
	setvar VAR_0x8008, 1
	call Common_EventScript_SetGymTrainers
	call Common_EventScript_ReadyPetalburgGymForBattle
	goto RustboroCity_Gym_EventScript_GiveRockTomb
	end

RustboroCity_Gym_EventScript_RoxanneRematch::
	message RustboroCity_Gym_Text_RoxanneChooseFormat
	waitmessage
	multichoice 17, 6, MULTI_REMATCH_BATTLE_MODE, 0
	switch VAR_RESULT
	case 0, RustboroCity_Gym_EventScript_SetSingles
	case 1, RustboroCity_Gym_EventScript_SetDoubles
	case 2, RustboroCity_Gym_EventScript_Exit
	case 127, RustboroCity_Gym_EventScript_Exit
	releaseall
	end

RustboroCity_Gym_EventScript_SetSingles::
	msgbox RustboroCity_Gym_Text_RoxanneAllowLegends, MSGBOX_YESNO
	compare VAR_RESULT, NO
	goto_if_eq RustboroCity_Gym_EventScript_RoxanneSinglesRematch
	setvar VAR_0x8004, 10
	trainerbattle_no_intro TRAINER_ROXANNE_3, RustboroCity_Gym_Text_RoxanneRematchDefeat
	//setflag FLAG_DAILY_REMATCH_ROXANNE
	releaseall
	end

RustboroCity_Gym_EventScript_SetDoubles::
	msgbox RustboroCity_Gym_Text_RoxanneAllowLegends, MSGBOX_YESNO
	compare VAR_RESULT, NO
	goto_if_eq RustboroCity_Gym_EventScript_RoxanneDoublesRematch
	setvar VAR_0x8004, 10
	trainerbattle_no_intro TRAINER_ROXANNE_5, RustboroCity_Gym_Text_RoxanneRematchDefeat
	//setflag FLAG_DAILY_REMATCH_ROXANNE
	releaseall
	end

RustboroCity_Gym_EventScript_RoxanneSinglesRematch::
	setvar VAR_0x8004, 10
	trainerbattle_no_intro TRAINER_ROXANNE_2, RustboroCity_Gym_Text_RoxanneRematchDefeat
	//setflag FLAG_DAILY_REMATCH_ROXANNE
	releaseall
	end

RustboroCity_Gym_EventScript_RoxanneDoublesRematch::
	setvar VAR_0x8004, 10
	trainerbattle_no_intro TRAINER_ROXANNE_4, RustboroCity_Gym_Text_RoxanneRematchDefeat
	//setflag FLAG_DAILY_REMATCH_ROXANNE
	releaseall
	end

RustboroCity_Gym_EventScript_AlreadyRematched::
	msgbox RustboroCity_Gym_Text_RoxannePostRematch, MSGBOX_AUTOCLOSE
	releaseall
	end

RustboroCity_Gym_EventScript_Exit::
	releaseall
	end

RustboroCity_Gym_EventScript_GymGuide:: @ 8213028
	lock
	faceplayer
	goto_if_set FLAG_BADGE01_GET, RustboroCity_Gym_EventScript_AskResetTrainers
	msgbox RustboroCity_Gym_Text_GymGuideAdvice, MSGBOX_DEFAULT
	release
	end

RustboroCity_Gym_EventScript_GymGuidePostVictory:: @ 821303D
	release
	end

RustboroCity_Gym_EventScript_LeftGymStatue:: @ 8213047
	lockall
	goto_if_set FLAG_BADGE01_GET, RustboroCity_Gym_EventScript_GymStatueCertified
	goto RustboroCity_Gym_EventScript_GymStatue
	end

RustboroCity_Gym_EventScript_RightGymStatue:: @ 8213057
	lockall
	goto_if_set FLAG_BADGE01_GET, RustboroCity_Gym_EventScript_GymStatueCertified
	goto RustboroCity_Gym_EventScript_GymStatue
	end

RustboroCity_Gym_EventScript_GymStatueCertified:: @ 8213067
	msgbox RustboroCity_Gym_Text_GymStatueCertified, MSGBOX_DEFAULT
	releaseall
	end

RustboroCity_Gym_EventScript_GymStatue:: @ 8213071
	msgbox RustboroCity_Gym_Text_GymStatue, MSGBOX_DEFAULT
	releaseall
	end

RustboroCity_Gym_EventScript_RegisterRoxanne:: @ 821307B
	lockall
	@ pokenavcall RustboroCity_Gym_Text_RoxanneRegisterCall
	@ waitmessage
	@ delay 30
	@ playfanfare MUS_REGISTER_MATCH_CALL
	@ msgbox RustboroCity_Gym_Text_RegisteredRoxanne, MSGBOX_DEFAULT
	@ waitfanfare
	@ closemessage
	@ delay 30
	setflag FLAG_ENABLE_ROXANNE_MATCH_CALL
	clearflag FLAG_ENABLE_ROXANNE_FIRST_CALL
	releaseall
	end

Rustboro_Gym_Guide_Trigger1::
	lockall
	setvar VAR_TEMP_1, 1
	playse SE_PIN
	applymovement 4, Common_Movement_ExclamationMark
	waitmovement 0
	applymovement 4, Common_Movement_Delay48
	waitmovement 0
	applymovement 4, Rustboro_Gym_Guide_Move1
	waitmovement 0
	goto Rustboro_Gym_Guide_Speech

Rustboro_Gym_Guide_Trigger2::
	lockall
	setvar VAR_TEMP_1, 2
	playse SE_PIN
	applymovement 4, Common_Movement_ExclamationMark
	waitmovement 0
	applymovement 4, Common_Movement_Delay48
	waitmovement 0
	applymovement 4, Rustboro_Gym_Guide_Move2
	waitmovement 0
	applymovement OBJ_EVENT_ID_PLAYER, Rustboro_Gym_Player_Move2
	waitmovement 0
	goto Rustboro_Gym_Guide_Speech

Rustboro_Gym_Guide_Trigger3::
	lockall
	setvar VAR_TEMP_1, 3
	playse SE_PIN
	applymovement 4, Common_Movement_ExclamationMark
	waitmovement 0
	applymovement 4, Common_Movement_Delay48
	waitmovement 0
	applymovement 4, Rustboro_Gym_Guide_Move3
	waitmovement 0
	goto Rustboro_Gym_Guide_Speech

Rustboro_Gym_Guide_Trigger4::
	lockall
	setvar VAR_TEMP_1, 4
	playse SE_PIN
	applymovement 4, Common_Movement_ExclamationMark
	waitmovement 0
	applymovement 4, Common_Movement_Delay48
	waitmovement 0
	applymovement OBJ_EVENT_ID_PLAYER, Rustboro_Gym_Player_Move_Face
	applymovement 4, Rustboro_Gym_Guide_Move4
	waitmovement 0
	applymovement OBJ_EVENT_ID_PLAYER, Rustboro_Gym_Player_Move4
	waitmovement 0
	goto Rustboro_Gym_Guide_Speech

Rustboro_Gym_Guide_Speech::
	msgbox RustboroCity_Gym_Text_Tips, MSGBOX_DEFAULT
	setvar VAR_RUSTBORO_CITY_STATE, 1
	compare VAR_TEMP_1, 1
	goto_if_eq Rustboro_Gym_Guide_Walk_Away1
	compare VAR_TEMP_1, 2
	goto_if_eq Rustboro_Gym_Guide_Walk_Away2
	compare VAR_TEMP_1, 3
	goto_if_eq Rustboro_Gym_Guide_Walk_Away3
	compare VAR_TEMP_1, 4
	goto_if_eq Rustboro_Gym_Guide_Walk_Away4
	releaseall
	end

Rustboro_Gym_Guide_Walk_Away1::
	applymovement 4, Rustboro_Gym_Guide_Move5
	waitmovement 0
	releaseall
	end

Rustboro_Gym_Guide_Walk_Away2::
	applymovement 4, Rustboro_Gym_Guide_Move6
	waitmovement 0
	releaseall
	end

Rustboro_Gym_Guide_Walk_Away3::
	applymovement 4, Rustboro_Gym_Guide_Move7
	waitmovement 0
	releaseall
	end

Rustboro_Gym_Guide_Walk_Away4::
	applymovement 4, Rustboro_Gym_Guide_Move8
	waitmovement 0
	releaseall
	end

Rustboro_Gym_Guide_Move1::
	walk_down
	face_right
	step_end

Rustboro_Gym_Guide_Move2::
	walk_right
	step_end

Rustboro_Gym_Guide_Move3::
	walk_right
	walk_right
	step_end

Rustboro_Gym_Guide_Move4::
	walk_right
	walk_right
	walk_right
	walk_right
	face_down
	step_end

Rustboro_Gym_Player_Move2::
	face_left
	step_end

Rustboro_Gym_Player_Move4::
	face_up
	step_end

Rustboro_Gym_Player_Move_Face::
	face_left
	step_end

Rustboro_Gym_Guide_Move5::
	walk_up
	face_down
	step_end

Rustboro_Gym_Guide_Move6::
	walk_left
	face_down
	step_end

Rustboro_Gym_Guide_Move7::
	walk_left
	walk_left
	face_down
	step_end

Rustboro_Gym_Guide_Move8::
	walk_left
	walk_left
	walk_left
	walk_left
	face_down
	step_end

RustboroCity_Gym_Text_GymGuideAdvice::
	.string "我现在能说的就这些，\n"
	.string "未来的冠军！\p"
	.string "想要更多建议，\n"
	.string "我建议你尽量多带几只宝可梦！\p"
	.string "也可以去城里四处问问。\n"
	.string "说不定有人能帮上你，\p"
	.string "比如愿意跟你交换钢属性宝可梦的人\n"
	.string "！$"

RustboroCity_Gym_Text_JoshIntro: @ 82133E9
	.string "别小看我们道馆训练家！\n"
	.string "我让你看看我们强在哪儿！$"

RustboroCity_Gym_Text_JoshDefeat: @ 821342D
	.string "你比我强太多了……$"

RustboroCity_Gym_Text_JoshPostBattle: @ 8213447
	.string "你还没见识过岩石属性的可怕力量！$"

RustboroCity_Gym_Text_TommyIntro: @ 8213486
	.string "连我都打不过，\n"
	.string "你根本不可能赢杜娟！$"

RustboroCity_Gym_Text_TommyDefeat: @ 82134C6
	.string "哇！你有点潜力！$"

RustboroCity_Gym_Text_TommyPostBattle: @ 82134E6
	.string "杜娟比我强好几倍。\n"
	.string "你最好打起十二分精神！$"

RustboroCity_Gym_Text_MarcIntro: @ 8213533
	.string "我们虽然在城镇中心，但那又怎样？\n"
	.string "我的岩石宝可梦需要地方撒野！$"

RustboroCity_Gym_Text_MarcDefeat: @ 8213589
	.string "哎呀呀！\n"
	.string "我们的挑战者真是个好斗的家伙！$"

RustboroCity_Gym_Text_MarcPostBattle: @ 82135C0
	.string "得服我们馆主。\n"
	.string "她那么小的年纪就选中岩石属性，\p"
	.string "这份聪明和眼光真了不起。$"

RustboroCity_Gym_Text_RoxanneIntro: @ 821362A
	.string "能请你展示一下你是怎么对战的、\n"
	.string "用哪些宝可梦吗？$"

RustboroCity_Gym_Text_RoxanneDefeat: @ 821370B
	.string "这样啊……\n"
	.string "我输了……\p"
	.string "看来我要学的还有很多……\n"
	.string "我明白了。\p"
	.string "宝可梦联盟的规则规定，\n"
	.string "打败道馆馆主的训练家可以得到这个\p"
	.string "。\n"
	.string "请收下宝可梦联盟正式的石头徽章。$"

RustboroCity_Gym_Text_ReceivedStoneBadge: @ 82137EC
	.string "{PLAYER}从杜娟那里得到了石头徽\n"
	.string "章。$"

RustboroCity_Gym_Text_StoneBadgeInfoTakeThis: @ 8213816
	.string "有了石头徽章，你的宝可梦\n"
	.string "就能在战斗外使用秘传招式居合斩。$"

RustboroCity_Gym_Text_ExplainRockTomb: @ 82138B1
	.string "那个招式学习器39里装着岩石封锁。\n"
	.string "它不仅能落下岩石造成伤害，\p"
	.string "还能降低速度。\n"
	.string "使用招式学习器能立刻让宝可梦学会\p"
	.string "招式。\n"
	.string "招式学习器可以反复使用，\p"
	.string "请试试看！$"

RustboroCity_Gym_Text_RoxannePostBattle: @ 82139A7
	.string "你这么强，\n"
	.string "应该去挑战其他道馆馆主。\p"
	.string "和许多训练家对战，\n"
	.string "你会学到很多东西。$"

RustboroCity_Gym_Text_GymStatue: @ 8213A21
	.string "卡那兹市宝可梦道馆$"

RustboroCity_Gym_Text_GymStatueCertified: @ 8213A3B
	.string "卡那兹市宝可梦道馆\n"
	.string "杜娟的认定训练家：\p"
	.string "{PLAYER}$"

RustboroCity_Gym_Text_RoxanneRegisterCall: @ 8213A76
	.string "…… …… …… ……\n"
	.string "…… …… …… 嘀！\p"
	.string "杜娟：哦，你好，{PLAYER}？\n"
	.string "我是卡那兹市的杜娟。\p"
	.string "藤树告诉我，你正以惊人的速度\n"
	.string "在训练家的路上往上爬。\p"
	.string "不过，我可不想认为自己打不过你。\n"
	.string "我保证，我会把道馆整顿好，\p"
	.string "让你再来挑战我们。\n"
	.string "希望你也和我一样期待那一天！\p"
	.string "…… …… …… ……\n"
	.string "…… …… …… 咔嗒！$"

RustboroCity_Gym_Text_RegisteredRoxanne: @ 8213C01
	.string "在宝可梦导航器里登录了馆主杜娟。$"

RustboroCity_Gym_Text_RoxannePreRematch: @ 8213C2F
	.string "杜娟：我们来对战吧！$"

RustboroCity_Gym_Text_RoxanneRematchDefeat: @ 8213CF9
	.string "唔……\n"
	.string "我又输了……$"

RustboroCity_Gym_Text_RoxannePostRematch: @ 8213D12
	.string "杜娟：在宝可梦对战这方面，\n"
	.string "我要学的还有很多。\p"
	.string "正因为这样，我才更爱对战！$"

RustboroCity_Gym_Text_RoxanneRematchNeedTwoMons: @ 8213D93
	.string "杜娟：哦，不……\n"
	.string "你只带了一只宝可梦？\p"
	.string "请至少再多带一只再来。$"

RustboroCity_Gym_Text_RoxanneChooseFormat:
	.string "杜娟：真高兴又见到你。\n"
	.string "我是这里的道馆馆主杜娟。\p"
	.string "上次见面之后，\n"
	.string "我们一定都经历了许多对战。\p"
	.string "我想看看我们各自进步了多少。\n"
	.string "你想单打还是双打？$"

RustboroCity_Gym_Text_RoxanneAllowLegends:
	.string "还有，要不要我和传说宝可梦一起打\n"
	.string "？$"
`
text RustboroCity_Gym_Text_Tips {
	format("哟，我猜你是新来的训练家？\n我叫克莱德，\p我的工作就是确保你知道自己要面对\n什么。就算你觉得自己有点宝可梦经\p验，也最好别掉以轻心！\n{COLOR BLUE}这里的道馆跟你想象的不太一样。\p{COLOR DARK_GRAY}{COLOR RED}这里所有训练家都是可以跳过的！\n{COLOR DARK_GRAY}所以你要是赶时间，\p可以直接上去挑战馆主。\n不过我不建议这么做。\p各位馆主都有自己的理由，\n{COLOR RED}他们可能不喜欢你一路硬闯过去。\p{COLOR DARK_GRAY}所以慢慢来，\n就算你决定不跟他们对战，\p也一定要和这里的每个人说话。\n{COLOR GREEN}他们可能会给你重要的提示。\p{COLOR DARK_GRAY}祝你的宝可梦之旅顺利，训练家！\n你肯定用得上这句话。$")
}

script RustboroCity_Gym_EventScript_GiveRockTomb{
	msgbox(format("这只特别的宝可梦，\n就当作我送你的礼物！$"))
	//random(3)
	givecustommon(SPECIES_AMAURA, 14, ITEM_CHOPLE_BERRY, ITEM_CHERISH_BALL, NATURE_BOLD, 0, 252, 0, 4, 0, 252, 0, 0, 0, 0, 0, 0, 0, MOVE_FREEZE_DRY, MOVE_THUNDER_WAVE, MOVE_ANCIENT_POWER, MOVE_HYPER_VOICE, TRUE)
	// switch (var(VAR_RESULT)){
	// 	case 0: givecustommon(SPECIES_CORM, 14, ITEM_CHOPLE_BERRY, ITEM_CHERISH_BALL, NATURE_BOLD, 0, 252, 0, 4, 0, 252, 0, 0, 0, 0, 0, 0, 0, MOVE_FREEZE_DRY, MOVE_THUNDER_WAVE, MOVE_ANCIENT_POWER, MOVE_HYPER_VOICE, TRUE)
	// break	
	// 	case 1: givecustommon(SPECIES_BLASTOISE, 14, ITEM_CHOPLE_BERRY, ITEM_CHERISH_BALL, NATURE_BOLD, 0, 252, 0, 4, 0, 252, 0, 0, 0, 0, 0, 0, 0, MOVE_FREEZE_DRY, MOVE_THUNDER_WAVE, MOVE_ANCIENT_POWER, MOVE_HYPER_VOICE, TRUE)
	// break
	// 	case 2: givecustommon(SPECIES_CHARCADET, 14, ITEM_CHOPLE_BERRY, ITEM_CHERISH_BALL, NATURE_BOLD, 0, 252, 0, 4, 0, 252, 0, 0, 0, 0, 0, 0, 0, MOVE_FREEZE_DRY, MOVE_THUNDER_WAVE, MOVE_ANCIENT_POWER, MOVE_HYPER_VOICE, TRUE)
	// }
	playfanfare(MUS_OBTAIN_ITEM)
	msgbox(format("{PLAYER}得到了杜娟的{COLOR BLUE}冰雪龙{COLOR DARK_GRAY}！$"))
	waitfanfare
	setflag(FLAG_RECEIVED_TM39)
	msgbox(RustboroCity_Gym_Text_RoxannePostBattle, MSGBOX_DEFAULT)
	release
	end
}

script RustboroCity_Gym_EventScript_Josh{
	lock
	faceplayer
	if (defeated(TRAINER_JOSH)){
		msgbox(RustboroCity_Gym_Text_JoshPostBattle, MSGBOX_AUTOCLOSE)
	} else {
		yesnobattle(format("杜娟总跟我说，\n最好的防守是{COLOR GREEN}先打牢基础{COLOR DARK_GRAY}，\p然后再{COLOR GREEN}慢慢变硬{COLOR DARK_GRAY}。$"))
		if (var(VAR_RESULT)){
			trainerbattle_single(TRAINER_JOSH, RustboroCity_Gym_Text_JoshIntro , RustboroCity_Gym_Text_JoshDefeat)
		}
	}
	release
	end
}

script RustboroCity_Gym_EventScript_Tommy{
	lock
	faceplayer
	if (defeated(TRAINER_TOMMY)){
		msgbox(RustboroCity_Gym_Text_TommyPostBattle, MSGBOX_AUTOCLOSE)
	} else {
		yesnobattle(format("远足的时候要小心{COLOR GREEN}崎岖不平的岩石地\n面{COLOR DARK_GRAY}。别受伤，更别{COLOR GREEN}被尖石划伤{COLOR DARK_GRAY}！$"))
		if (var(VAR_RESULT)){
			trainerbattle_single(TRAINER_TOMMY, RustboroCity_Gym_Text_TommyIntro , RustboroCity_Gym_Text_TommyDefeat)
		}
	}
	release
	end
}

script RustboroCity_Gym_EventScript_Marc{
	lock
	faceplayer
	if (defeated(TRAINER_MARC)){
		msgbox(RustboroCity_Gym_Text_MarcPostBattle, MSGBOX_AUTOCLOSE)
	} else {
		yesnobattle(format("都说在巨大压力下，\n连煤都会变成钻石。\p等我{COLOR GREEN}被逼到角落{COLOR DARK_GRAY}，\n那才是我真正的力量发光的时候！$"))
		if (var(VAR_RESULT)){
			trainerbattle_single(TRAINER_MARC, RustboroCity_Gym_Text_MarcIntro , RustboroCity_Gym_Text_MarcDefeat)
		}
	}
	release
	end
}


script RustboroCity_Gym_EventScript_CheckTrainers{
	if (defeated(TRAINER_ROXANNE_1)) {
		msgbox(RustboroCity_Gym_Text_RoxannePostBattle, MSGBOX_DEFAULT)
		release
		end
	}
	// register all battle events for all trainer not fought
	if (!defeated(TRAINER_MARC)){
		registerbattleevent(BATTLE_EVENT_LAST_STAND, 5, 5)
	}
	if (!defeated(TRAINER_TOMMY)){
		registerbattleevent(BATTLE_EVENT_LAST_BLEED, 2)
		registerbattleevent(BATTLE_EVENT_STEALTH_ROCK)
	}
	if (!defeated(TRAINER_JOSH)){
		registerbattleevent(BATTLE_EVENT_POSTURE_DEFENSE)
		registerbattleevent(BATTLE_EVENT_STEADY_DEFENSE)
	}
	return
}

text RustboroCity_Gym_Text_RoxanneIntro0{
	format("跳过课程还想考高分？\n你最好知道自己在干什么！$")
}
text RustboroCity_Gym_Text_RoxanneIntro1{
	format("功课做得还不错，应该准备好了……\n看看你学得怎么样。$")
}
text RustboroCity_Gym_Text_RoxanneIntroAll{
	format("啊，你很用功！那就该收尾了。\n准备好了吗？$")
}
text RustboroCity_Gym_Text_RoxanneDefeat0{
	format("看来你是在争取加分，\n而且成绩优异！轻松的A+。$")
}
text RustboroCity_Gym_Text_RoxanneDefeat1{
	format("你的作业虽然赶，\n但我看得出你还是下了功夫！满分，\p给你一个A！$")
}
text RustboroCity_Gym_Text_RoxanneDefeatAll{
	format("你认真学，考了全班第一，\n这个A你值得！$")
}
script RustboroCity_Gym_EventScript_Roxanne{
    goto_if_set(FLAG_SYS_GAME_CLEAR, RustboroCity_Gym_EventScript_RoxanneRematch)
	call(RustboroCity_Gym_EventScript_CheckTrainers)
	registerbattleevent(BATTLE_EVENT_TENSE_BATTLE)
	setvar(VAR_0x8004, 15)
	// count the number of trainer defeated, and tell a different line
	adddefeatedcount(TRAINER_JOSH, 1)
	adddefeatedcount(TRAINER_TOMMY)
	adddefeatedcount(TRAINER_MARC)
	switch (var(VAR_RESULT)) {
		case 0:
			trainerbattle_single(TRAINER_ROXANNE_1, RustboroCity_Gym_Text_RoxanneIntro0, RustboroCity_Gym_Text_RoxanneDefeat0, RustboroCity_Gym_EventScript_RoxanneDefeated, NO_MUSIC)
		break
		case 3:
			trainerbattle_single(TRAINER_ROXANNE_1, RustboroCity_Gym_Text_RoxanneIntroAll, RustboroCity_Gym_Text_RoxanneDefeat1, RustboroCity_Gym_EventScript_RoxanneDefeated, NO_MUSIC)
		break
		default:
			trainerbattle_single(TRAINER_ROXANNE_1, RustboroCity_Gym_Text_RoxanneIntro1, RustboroCity_Gym_Text_RoxanneDefeatAll, RustboroCity_Gym_EventScript_RoxanneDefeated, NO_MUSIC)
    	}
	
	goto_if_eq(RustboroCity_Gym_EventScript_RoxanneRematch)
	goto_if_unset(FLAG_RECEIVED_TM39, RustboroCity_Gym_EventScript_GiveRockTomb)
	release
	end
}

script RustboroCity_Gym_EventScript_AskResetTrainers{
	lock
	clydeaskresettrainers(RustboroCity_Gym_EventScript_ResetAllTrainers, RustboroCity_Gym_EventScript_SelectTrainers)
	release
	end
}

script RustboroCity_Gym_EventScript_ResetAllTrainers{
	cleartrainerflag(TRAINER_JOSH)
	cleartrainerflag(TRAINER_TOMMY)
	cleartrainerflag(TRAINER_MARC)
	cleartrainerflag(TRAINER_ROXANNE_1)
	return
}

movement RustboroCity_Gym_Movement_Tommy{
	walk_fastest_right * 3
	walk_fastest_up * 6
}

movement RustboroCity_Gym_Movement_Marc{
	walk_fastest_left * 4
	walk_fastest_up * 4
}

movement RustboroCity_Gym_Movement_Josh{
	walk_fastest_right * 5
	walk_fastest_up * 3
}

movement RustboroCity_Gym_Movement_Roxanne{
	walk_fastest_left * 1
	walk_fastest_up * 3
}

// don't forget to bring you back to the player
movement RustboroCity_Gym_Movement_Clyde{
	walk_fastest_left * 1
	walk_fastest_down * 16
}


script RustboroCity_Gym_EventScript_SelectTrainers{
	special(SpawnCameraObject)
	selecttrainercameraoffset()
	selecttrainer(RustboroCity_Gym_Movement_Tommy, "Tommy", TRAINER_TOMMY)
	selecttrainer(RustboroCity_Gym_Movement_Marc, "Marc", TRAINER_MARC)
	selecttrainer(RustboroCity_Gym_Movement_Josh, "Josh", TRAINER_JOSH)
	selecttrainer(RustboroCity_Gym_Movement_Roxanne, "Roxanne", TRAINER_ROXANNE_1)
	applymovement(OBJ_EVENT_ID_CAMERA, RustboroCity_Gym_Movement_Clyde)
	waitmovement(0)
	selecttrainercameraoffset(TRUE)
	special(RemoveCameraObject)
	return
}
