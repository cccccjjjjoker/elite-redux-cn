script SootopolisCity_Gym_EventScript_TriggerTopBattle{
	if (defeated(TRAINER_OLIVIA) && defeated(TRAINER_ANNIKA) && defeated(TRAINER_BRIANNA)){
		setvar(VAR_TEMP_2, 1)
        end
    }
    lock
    msgbox(format("准备好和我们三人对战了吗？$"), MSGBOX_YESNO)
    if (!var(VAR_RESULT)){
        goto(SootopolisCity_Gym_EventScript_PlayerWalksAway)
    }
	msgbox(format("和这竞技场里其他同伴一样，\n我们给你一些选择。$"), MSGBOX_DEFAULT)
    multichoice2(0, 0, MultiChoice_TopBattle)
	switch(var(VAR_RESULT)){
        case 0:
            goto(SootopolisCity_Gym_EventScript_PlayerWalksAway)
        break
        case 1:
			trainerbattle_no_intro(TRAINER_OLIVIA, SootopolisCity_Gym_B1F_Text_OliviaDefeat)
			setflag(FLAG_SYS_DISABLE_AUTOHEAL)
            trainerbattle_no_intro(TRAINER_BRIANNA, SootopolisCity_Gym_B1F_Text_BriannaDefeat)
            trainerbattle_no_intro(TRAINER_ANNIKA, SootopolisCity_Gym_B1F_Text_AnnikaDefeat)
			clearflag(FLAG_SYS_DISABLE_AUTOHEAL)
        break
        case 2:
			trainerbattle_no_intro(TRAINER_OLIVIA, SootopolisCity_Gym_B1F_Text_OliviaDefeat)
            starttagbattle(TRAINER_ANNIKA, TRAINER_BRIANNA, TAG_TEAM_ANNIKA_BRIANNA, 0)
        break
        case 3:
			trainerbattle_no_intro(TRAINER_BRIANNA, SootopolisCity_Gym_B1F_Text_BriannaDefeat)
			starttagbattle(TRAINER_OLIVIA, TRAINER_ANNIKA, TAG_TEAM_OLIVIA_ANNIKA, 0)
        break
        case 4:
			trainerbattle_no_intro(TRAINER_ANNIKA, SootopolisCity_Gym_B1F_Text_AnnikaDefeat)
			starttagbattle(TRAINER_BRIANNA, TRAINER_OLIVIA, TAG_TEAM_BRIANNA_OLIVIA, 0)
        break
    }
	setvar(VAR_TEMP_2, 1)
	release
	end
}


