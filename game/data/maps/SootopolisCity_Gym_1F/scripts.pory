script SootopolisCity_Gym_EventScript_TriggerMiddleBattle{
    lock
	if (defeated(TRAINER_DAPHNE) && defeated(TRAINER_CONNIE) && defeated(TRAINER_ANDREA)){
		setvar(VAR_TEMP_1, 1)
        end
    }
	msgbox(format("准备好和我们三人对战了吗？$"), MSGBOX_YESNO)
    if (!var(VAR_RESULT)){
        goto(SootopolisCity_Gym_EventScript_PlayerWalksAway)
    }
	msgbox(format("出于对我们价值观的尊重，\n我们给你几个决定对战顺序的选项。$"), MSGBOX_DEFAULT)
    multichoice2(0, 0, MultiChoice_MiddleBattle)
	switch(var(VAR_RESULT)){
        case 0:
            goto(SootopolisCity_Gym_EventScript_PlayerWalksAway)
        break
        case 1:
			trainerbattle_no_intro(TRAINER_DAPHNE, SootopolisCity_Gym_B1F_Text_DaphneDefeat)
			setflag(FLAG_SYS_DISABLE_AUTOHEAL)
			trainerbattle_no_intro(TRAINER_CONNIE, SootopolisCity_Gym_B1F_Text_ConnieDefeat)
			trainerbattle_no_intro(TRAINER_ANDREA, SootopolisCity_Gym_B1F_Text_AndreaDefeat)
			clearflag(FLAG_SYS_DISABLE_AUTOHEAL)
        break
        case 2:
            trainerbattle_no_intro(TRAINER_DAPHNE, SootopolisCity_Gym_B1F_Text_DaphneDefeat)
			starttagbattle(TRAINER_CONNIE, TRAINER_ANDREA, TAG_TEAM_CONNIE_ANDREA, 0)
        break
        case 3:
			trainerbattle_no_intro(TRAINER_CONNIE, SootopolisCity_Gym_B1F_Text_ConnieDefeat)
			starttagbattle(TRAINER_ANDREA, TRAINER_DAPHNE, TAG_TEAM_ANDREA_DAPHNE, 0)
        break
        case 4:
			trainerbattle_no_intro(TRAINER_ANDREA, SootopolisCity_Gym_B1F_Text_AndreaDefeat)
			starttagbattle(TRAINER_DAPHNE, TRAINER_CONNIE, TAG_TEAM_DAPHNE_CONNIE, 0)
        break
    }
    setvar(VAR_TEMP_1, 1)
    release
    end
}

