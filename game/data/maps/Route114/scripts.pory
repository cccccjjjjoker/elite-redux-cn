script Route114_EventScript_LegendaryNPC{
    lock
    faceplayer
	msgbox(format("修行者：你是那种\n想当冠军的训练家吗？$"), MSGBOX_YESNO)
	if(var(VAR_RESULT) == 1){
		if (!flag(FLAG_SYS_GAME_CLEAR)){
		msgbox(format("我猜你是想确认传说宝可梦是否在这\n一带出没。放心，确实如此。雷公、\p水君、炎帝这三位传说中的猛兽，\n把这片风啸之地当作了巢穴。\p若你继续展现出这般天赋，\n捕捉这些威严生物的特权，\p或许就会落到你头上。\n拥抱你日渐强大的力量吧，\p它或许会带你走向非凡的命运。$"))
	}
	else{
		if(defeated(TRAINER_LENNY) &&
		   defeated(TRAINER_LUCAS_1) &&
		   defeated(TRAINER_SHANE)  &&
		   defeated(TRAINER_NANCY)  &&
		   defeated(TRAINER_STEVE_1)  &&
		   defeated(TRAINER_BERNIE_1)  &&
		   defeated(TRAINER_CLAUDE)  &&
		   defeated(TRAINER_NOLAN)  &&
		   defeated(TRAINER_TYRA_AND_IVY)  &&
		   defeated(TRAINER_ANGELINA)  &&
		   defeated(TRAINER_CHARLOTTE)  &&
		   defeated(TRAINER_KAI)){
				msgbox(format("我们终于又见面了。\n你的战斗实力已被许多人认可，\p包括那三头猛兽。\n带着图鉴导航走这条路，\p它们的伟大就会向你显现。$"))
			}
		else{
			msgbox(format("啊，真是有趣的进展。\n你的实力已超出我最初的预期。\p虽然你的旅程还没到高潮，\n但你已展现出惊人的潜力。\p命运在召唤你：\n打完最后这几场战斗，\p去迎接那三头猛兽吧。$"))
			}
		}
	}
	else{
		msgbox(format("那我们还有什么好说的？$"), MSGBOX_NPC)
	}
    release
    end
}

script Route114_EventScript_Feraligatr{
	lock
	faceplayer
    goto_if_set(FLAG_DEFEATED_ROUTE114_FERALIGATR, Route114_EventScript_Feraligatr_Join)
    goto_if_unset(FLAG_BADGE05_GET, Route114_EventScript_Feraligatr_PreNorman)
	playmoncry(SPECIES_FERALIGATR, 2)
    msgbox(format("伴随着一声雷鸣般的咆哮，\n大力鳄朝你猛扑过来，\p发起了凶猛的攻击！$"), MSGBOX_YESNO)
	if(var(VAR_RESULT) == 1){
        playmoncry(SPECIES_FERALIGATR, 2)
        msgbox(format("大力鳄：鳄！$"), MSGBOX_DEFAULT)
	delay(40)
	waitmoncry
	setflag(FLAG_TOTEM_BATTLE)
	setvar(VAR_TOTEM_POKEMON_ATK_BOOST,      2)
	setvar(VAR_TOTEM_POKEMON_DEF_BOOST,      2)
	setvar(VAR_TOTEM_POKEMON_SP_ATK_BOOST,   2)
	setvar(VAR_TOTEM_POKEMON_SP_DEF_BOOST,   2)
	setvar(VAR_TOTEM_POKEMON_SPEED_BOOST,    1)
	setvar(VAR_TOTEM_POKEMON_ACCURACY_BOOST, 2)
	setvar(VAR_TOTEM_POKEMON_EVASION_BOOST,  0)
	setvar(VAR_TOTEM_MESSAGE, TOTEM_FIGHT_FERALIGATR)
	//setflag(FLAG_SHINY_CREATION)
	setflag(FLAG_ALPHA_CREATION)
	setwildbattlewithcustommoves(SPECIES_FERALIGATR, 0, ITEM_FERALIGITE_Y, MOVE_HYDRO_CANNON, MOVE_HYPER_BEAM, MOVE_BLIZZARD, MOVE_HYPER_VOICE, 0, NATURE_MODEST, 252, 252, 252, 252, 252, 252)
	setflag(FLAG_SYS_CTRL_OBJ_DELETE)
	dowildbattle
	clearflag(FLAG_SYS_CTRL_OBJ_DELETE)
	specialvar(VAR_RESULT, GetBattleOutcome)
    switch(var(VAR_RESULT)){
        case B_OUTCOME_CAUGHT:
        case B_OUTCOME_WON:
			goto(Route114_EventScript_Feraligatr_Join)
        break
        case B_OUTCOME_RAN:
        case B_OUTCOME_PLAYER_TELEPORTED:
            setvar(VAR_0x8004, SPECIES_FERALIGATR)
            fadescreenswapbuffers(FADE_TO_BLACK)
            removeobject(VAR_LAST_TALKED)
            fadescreenswapbuffers(FADE_FROM_BLACK)
            bufferspeciesname(0, VAR_0x8004)
            msgbox(format("{STR_VAR_1}逃走了！$"), MSGBOX_DEFAULT)
        break
    }
}
    else{
        playmoncry(SPECIES_FERALIGATR, 2)
        msgbox(format("大力鳄：鳄……$"), MSGBOX_DEFAULT)
    }
	release
	end
}

script Route114_EventScript_Feraligatr_PreNorman{
    message(format("大力鳄轻蔑地看着你。\n等你更强了再来吧？{PAUSE_UNTIL_PRESS}$"))
	waitmessage
    release
    end	
}

script Route114_EventScript_Feraligatr_Join{
    msgbox(format("大力鳄似乎想加入你的队伍，\n要让这只大力鳄加入吗？$"), MSGBOX_YESNO)
	if(var(VAR_RESULT) == 1){
		setflag(FLAG_OBTAINED_ROUTE114_FERALIGATR)
		setflag(FLAG_ALPHA_CREATION)
		givecustommon(SPECIES_FERALIGATR, 50, ITEM_NONE, ITEM_CHERISH_BALL, NATURE_MODEST, 0, 252, 0, 0, 0, 252, 4, 0, 0, 0, 0, 0, 0, MOVE_HYDRO_CANNON, MOVE_HYPER_BEAM, MOVE_BLIZZARD, MOVE_HYPER_VOICE, FALSE)
		clearflag(FLAG_ALPHA_CREATION)
		playfanfare(MUS_OBTAIN_ITEM)
		message(format("{PLAYER}得到了大力鳄！$"))
		waitfanfare
		fadescreenswapbuffers(FADE_TO_BLACK)
		removeobject(VAR_LAST_TALKED)
		fadescreenswapbuffers(FADE_FROM_BLACK)
	}
	if(!flag(FLAG_DEFEATED_ROUTE114_FERALIGATR)){
    	setflag(FLAG_DEFEATED_ROUTE114_FERALIGATR)
		playfanfare(MUS_OBTAIN_ITEM)
		giveitem(ITEM_FERALIGITE_Y, 1)
		message(format("{PLAYER}得到了大力鳄进化石Y！$"))
		waitfanfare
	}
	release
	end
}
const LOCALID_ROCK_0 = 9
const LOCALID_ROCK_1 = 16
const LOCALID_ROCK_2 = 17
const LOCALID_ROCK_3 = 18
const LOCALID_ROCK_4 = 19
const LOCALID_ROCK_5 = 29

script Route114_EventScript_RockSmashSign{
    lock
    msgbox(format("是个按钮，要按下去吗？$"), MSGBOX_YESNO)
    closemessage
    if (var(VAR_RESULT) != 1){
        release
        end
    }
    playse(SE_M_ROCK_THROW)
    applymovement(LOCALID_ROCK_0, Movement_SmashRock)
	applymovement(LOCALID_ROCK_1, Movement_SmashRock)
	applymovement(LOCALID_ROCK_2, Movement_SmashRock)
	applymovement(LOCALID_ROCK_3, Movement_SmashRock)
	applymovement(LOCALID_ROCK_4, Movement_SmashRock)
	applymovement(LOCALID_ROCK_5, Movement_SmashRock)
	waitmovement(0)
	removeobject(LOCALID_ROCK_0)
	removeobject(LOCALID_ROCK_1)
	removeobject(LOCALID_ROCK_2)
	removeobject(LOCALID_ROCK_3)
	removeobject(LOCALID_ROCK_4)
	removeobject(LOCALID_ROCK_5)
	waitse
}
