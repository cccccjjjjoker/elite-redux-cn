script LittlerootTown_EventScript_LegendaryNPC {
    lock
    faceplayer
	if (!flag(FLAG_GOT_LEGENDARY_NPC_ITEMS)){
		checkSaveblockValue(SAVEBLOCK_ENABLE_LEGENDARY)
		if(var(VAR_RESULT) == TRUE && !flag(FLAG_SYS_GAME_CLEAR)){
			msgbox(format("既然你在玩随机模式，这些传说宝可梦道具就都给你吧！"))
		}
		else{
			msgbox(format("恭喜你成为冠军！你的努力没有白费。我等这一天已经很久了，终于可以把这些道具交给值得信赖的人。"))
		}
		additem(ITEM_GRACIDEA)
		additem(ITEM_REVEAL_GLASS)
		additem(ITEM_DNA_SPLICERS)
		additem(ITEM_PRISON_BOTTLE)
		additem(ITEM_N_LUNARIZER)
		additem(ITEM_N_SOLARIZER)
		additem(ITEM_FLAME_PLATE)
		additem(ITEM_SPLASH_PLATE)
		additem(ITEM_ZAP_PLATE)
		additem(ITEM_MEADOW_PLATE)
		additem(ITEM_ICICLE_PLATE)
		additem(ITEM_FIST_PLATE)
		additem(ITEM_TOXIC_PLATE)
		additem(ITEM_EARTH_PLATE)
		additem(ITEM_SKY_PLATE)
		additem(ITEM_MIND_PLATE)
		additem(ITEM_INSECT_PLATE)
		additem(ITEM_STONE_PLATE)
		additem(ITEM_SPOOKY_PLATE)
		additem(ITEM_DRACO_PLATE)
		additem(ITEM_DREAD_PLATE)
		additem(ITEM_IRON_PLATE)
		additem(ITEM_PIXIE_PLATE)
		additem(ITEM_FIRE_MEMORY)
		additem(ITEM_WATER_MEMORY)
		additem(ITEM_ELECTRIC_MEMORY)
		additem(ITEM_GRASS_MEMORY)
		additem(ITEM_ICE_MEMORY)
		additem(ITEM_FIGHTING_MEMORY)
		additem(ITEM_POISON_MEMORY)
		additem(ITEM_GROUND_MEMORY)
		additem(ITEM_FLYING_MEMORY)
		additem(ITEM_PSYCHIC_MEMORY)
		additem(ITEM_BUG_MEMORY)
		additem(ITEM_ROCK_MEMORY)
		additem(ITEM_GHOST_MEMORY)
		additem(ITEM_DRAGON_MEMORY)
		additem(ITEM_DARK_MEMORY)
		additem(ITEM_STEEL_MEMORY)
		additem(ITEM_FAIRY_MEMORY)
		additem(ITEM_SHOCK_DRIVE)
		additem(ITEM_BURN_DRIVE)
		additem(ITEM_CHILL_DRIVE)
		additem(ITEM_DOUSE_DRIVE)
		additem(ALL_LEGENDARY_SAGE_ITEMS)
		playfanfare(MUS_OBTAIN_ITEM)
		msgbox(format("{PLAYER}从贤者那里得到了传说神器！"))
		waitmessage
		waitfanfare
		setflag(FLAG_GOT_LEGENDARY_NPC_ITEMS)
		msgbox(format("曾经游荡在这片土地上的传说宝可梦，因你而回归了。\p"
			"清光一条道路上的所有对手，\n这些传说宝可梦才会出现。\p"
			"有不明白的，就问野外的同伴，\n他们会告诉你该知道的一切。\p"
			"祝你好运，冠军，我们期待你的成功！"))
	}
	else{
		msgbox(format("你需要什么吗？"), MSGBOX_DEFAULT)
		multichoice2(1, 1, LittlerootTown_EventScript_LegendaryNPC_Options)
		switch (var(VAR_RESULT)) {
			case 0:
				msgbox(format("曾经游荡在这片土地上的传说宝可梦\n，因你而回归了。\p"
			"清光一条道路上的所有对手，\n这些传说宝可梦才会出现。\p"
			"有不明白的，就问野外的同伴，\n他们会告诉你该知道的一切。\p"
			"祝你好运，冠军，我们期待你的成功！"))
			case MULTI_B_PRESSED:
			default:
				msgbox("回头见。")
		}
    }
    release
    end
}

text LittlerootTown_EventScript_LegendaryNPC_Options{
    "请再给我讲一遍$"
    "算了$"
    "$"
}

script LittlerootTown_EventScript_TutorialNPC{
    lock
    faceplayer
	msgbox(format("你好{PLAYER}，我可以告诉你Elite Redux有哪些改动。"))
	goto(LittlerootTown_EventScript_TutorialNPC2)
    release
    end
}

script LittlerootTown_EventScript_TutorialNPC2{
	messageinstant(format("你想了解什么？"))
	scrollingmultichoice2(0, 0, 0, 6, TRUE)
	switch (var(VAR_RESULT)) {
		case 0:// Nurse Joy
			msgbox(format("在任何宝可梦中心找护士乔伊，她会给你以下东西：\p"
                          "糖果盒、宝可梦搜寻器、招式机盒、\n全部招式机与秘传机、对战道具、\p各种精灵球、各种树果、\n各种属性宝石等。\p"
                          "每次和她说话，所有道具都会补满。"))
			goto(LittlerootTown_EventScript_TutorialNPC2)
			case 1:// Read the Wiki
				msgbox(format("需要帮助？Wiki里有答案！\p"
                          "从开始菜单进入，选择“百科”。\p"
                          "里面有特性、招式、\n道具和玩法提示！"))
				goto(LittlerootTown_EventScript_TutorialNPC2)
		case 2:// Pokémon changes
			msgbox(format("几乎所有宝可梦都被强化得更有趣、更好用了。\p"
                          "一些宝可梦被重做了：\n比如阿柏怪改成了毒/恶，\p暴鲤龙是水/龙且拥有飘浮。\p" 
						  "白海狮的种族值提升不少，\n攻守都好用了。\p"
                          "想看更多详情，请查阅在线图鉴。"))
			goto(LittlerootTown_EventScript_TutorialNPC2)
		case 3:// Ability changes
			msgbox(format("现在每只宝可梦最多同时拥有四个特性。\p"
						  "最多有三个固定特性，\n称为“先天特性”。\p"
						  "新增了 110 多种特性，\n许多旧特性也有了新效果。\p比如冰冻之躯现在每回合回复 1/8 H\nP，健壮胸肌则相当于硬爪。\p"
                          "想看更多详情，请查阅在线图鉴。"))
			goto(LittlerootTown_EventScript_TutorialNPC2)
		case 4:// Move changes
			msgbox(format("许多招式被强化了（主要是命中率，有些改动更大）。\p"
                          "地裂这类一击必杀招式不再必杀，\n改为 80% 命中、约 120 点伤害。\p"
                          "更多招式会受到特定特性的影响（比\n如超级发射器）。\p"
                          "想看更多详情，请查阅在线图鉴。"))
			goto(LittlerootTown_EventScript_TutorialNPC2)
		case 5:// Quality of Life
			msgbox(format("你现在有了便携电脑（开始菜单）。四天王战中禁用。\p"
                          "自动奔跑、常驻驱虫喷雾等都能在设\n置里开关。\p"
						  "不用再教秘传机，任何宝可梦都能飞\n往去过的地方。\p"
						  "道具可以登记到新的列表菜单（按 L\n 打开列表）。"))
			goto(LittlerootTown_EventScript_TutorialNPC2)
		case 6:// Battle changes
			msgbox(format("招式与特性引发的天气现在持续8回合（带天气岩石为12回合）。\p"
                          "冰属性在冰雹中防御提升 50%。\n沙暴仍是特防提升 50%。\p"
                          "所有宝可梦默认个体值全 31，\n用铁丸可以把速度设为 0。\p"
						  "进阶和精英模式下有睡眠条款：\n不能同时让两只敌方宝可梦睡眠。\p"
						  "所有招式的 PP 都已最大化。\n对战后携带的道具会保留。"))
			goto(LittlerootTown_EventScript_TutorialNPC2)
		case 7:// Battle UI changes
			msgbox(format("战斗中按L可查看招式威力、命中率与是否接触。\p"
                          "攻击前就能看到招式的效果，\n连飘浮、食草这类特性也会计入！\p"
                          "本系加成（50% 同属性加成）\n会用加号标出。\p"
						  "现在可以放弃训练家对战，\n会被送回最近去过的宝可梦中心。"))
			goto(LittlerootTown_EventScript_TutorialNPC2)
		case 8:// Catching Pokémon
			msgbox(format("护士乔伊会给你每种精灵球各一个。所有球捕捉率都是100%。\p"
                          "护士乔伊会给你升级版搜寻器：\n可以直接搜索想要的宝可梦，\p靠近时也不用慢慢走。\p"
						  "闪光率可以大幅提升，最高到 1/5。\p"
						  "从第一世代到第九世代，\n几乎所有宝可梦都能捕获。"))
			goto(LittlerootTown_EventScript_TutorialNPC2)
		case 9:// Switch abilities 
			msgbox(format("可以在宝可梦摘要页直接切换特性。\p"
                          "有的宝可梦只有一个特性，\n有的最多三个。\p"
                          "每只宝可梦最多有三个固定先天特性\n，先天特性无法更改。"))
			goto(LittlerootTown_EventScript_TutorialNPC2)
		case 10:// Switch nature
			msgbox(format("可以在宝可梦摘要页直接切换性格。\p"
                          "性格会让一项种族值提升 10%，\n另一项降低 10%。"))
			goto(LittlerootTown_EventScript_TutorialNPC2)
		case 11:// Switch Hidden Power
			msgbox(format("把护士乔伊给你的属性宝石用在任意宝可梦身上就行。"))
			goto(LittlerootTown_EventScript_TutorialNPC2)
		case 12:// Set EVs
			msgbox(format("可以在摘要页直接设定努力值。再也不用刷了！\p"
                          "单项努力值最多 252，总和最多 510。\p"
                          "多数情况下，把 252 点投给最强的\n两项就好。"))
			goto(LittlerootTown_EventScript_TutorialNPC2)
		case 13:// Learn moves
			msgbox(format("可以在队伍菜单里直接学会新招式，但某些招式仍需升级才能学。"))
			goto(LittlerootTown_EventScript_TutorialNPC2)
		case 14:// Auto-Healing
			msgbox(format("每场战斗前全队都会回复。\p"
                          "这也是为了防止提前烧伤或中毒 ;-)"))
			goto(LittlerootTown_EventScript_TutorialNPC2)
		case 15:// Leveling
			msgbox(format("新增了重要道具：糖果盒。可以轻松升级。\p"
                          "因为有等级上限和自动等级缩放，\n不用担心练过头。"))
			goto(LittlerootTown_EventScript_TutorialNPC2)
		case 16:// Evolutions
			msgbox(format("所有进化道具都能在友好商店买到。\p"
                          "想看某只宝可梦怎么进化，\n可以查游戏内或在线图鉴。"))
			goto(LittlerootTown_EventScript_TutorialNPC2)
		case 17:// Exit
		case MULTI_B_PRESSED:
		default:
			msgbox("回头见。")
	}
    release
    end
}

script PKMN_Center_Move_Tutor{
	lockall
	messageinstant("How can I help you today?")
	multichoice2(0, 0, MultiChoice_Move_Tutor_NPC)
	switch(var(VAR_RESULT)){
		case 0:
			closemessage
			goto(PKMN_Center_EventScript_DayNightToggle)
		break
		case 1:
			closemessage
			goto(PKMN_Center_EventScript_RandomizerToggle)
		break
		case 2:
			closemessage
			goto(PKMN_Center_NameRater_EventScript)
		break
		case 3:
			closemessage
			goto(PKMN_Center_EventScript_Mystery_Gift)
		break
		case 4:
			closemessage
			goto(PKMN_Center_Change_Difficulty)
		break
		case 5:
			closemessage
			goto(PKMN_Center_Change_Season)
		break
		case MULTI_B_PRESSED:
		default:
		case 6:
			closemessage
			goto(PKMN_Center_Move_Tutor_General_Exit)
		break
	}
}

script PKMN_Center_Change_Difficulty{
	lockall
	messageinstant("What do you want to do with it?")
	multichoice2(0, 0, MultiChoice_Difficulty_Change)
	switch(var(VAR_RESULT)){
		case 0:
			closemessage
			goto(PKMN_Center_EventScript_Up_Difficulty)
		break
		case 1:
			closemessage
			goto(PKMN_Center_EventScript_Lower_Difficulty)
		break
		case MULTI_B_PRESSED:
		default:
		case 6:
			closemessage
			goto(PKMN_Center_Move_Tutor)
		break
	}
}

script PKMN_Center_Change_Season{
	lockall
	messageinstant("Please chose the season you like\nthe best.")
	multichoice2(0, 0, MultiChoice_Season_Change)
	switch(var(VAR_RESULT)){
		case 0:
			//Spring
			clearflag(FLAG_AUTOMATIC_SEASON)
			toggleSaveblock(SAVEBLOCK_SEASON, SEASON_SPRING)
			playfanfare(MUS_OBTAIN_ITEM)
			message(format("季节变成了春天！"))
			waitmessage
			waitfanfare
		break
		case 1:
			//Spring
			clearflag(FLAG_AUTOMATIC_SEASON)
			toggleSaveblock(SAVEBLOCK_SEASON, SEASON_SUMMER)
			playfanfare(MUS_OBTAIN_ITEM)
			message(format("季节变成了夏天！"))
			waitmessage
			waitfanfare
		break
		case 2:
			//Spring
			clearflag(FLAG_AUTOMATIC_SEASON)
			toggleSaveblock(SAVEBLOCK_SEASON, SEASON_AUTUMN)
			playfanfare(MUS_OBTAIN_ITEM)
			message(format("季节变成了秋天！"))
			waitmessage
			waitfanfare
		break
		case 3:
			//Spring
			clearflag(FLAG_AUTOMATIC_SEASON)
			toggleSaveblock(SAVEBLOCK_SEASON, SEASON_WINTER)
			playfanfare(MUS_OBTAIN_ITEM)
			message(format("季节变成了冬天！"))
			waitmessage
			waitfanfare
		break
		case 4:
			//Spring
			setflag(FLAG_AUTOMATIC_SEASON)
			playfanfare(MUS_OBTAIN_ITEM)
			message(format("季节将自动设置！"))
			waitmessage
			waitfanfare
		break
		case MULTI_B_PRESSED:
		default:
		case 6:
			closemessage
			goto(PKMN_Center_Move_Tutor)
		break
	}
}

script PKMN_Center_EventScript_DayNightToggle{
	msgbox("要反转昼夜吗？\n"
           "仅用于浅滩洞穴。$", MSGBOX_YESNO)
	switch(var(VAR_RESULT)){
		case YES:
			if(flag(FLAG_IS_DAYNIGHT_INVERTED)){
				clearflag(FLAG_IS_DAYNIGHT_INVERTED)
			}
			else{
				setflag(FLAG_IS_DAYNIGHT_INVERTED)
			}
			playfanfare(MUS_OBTAIN_ITEM)
			message(format("昼夜已经反转。"))
			waitmessage
			waitfanfare
		break
		case NO:
		case MULTI_B_PRESSED:
		default:
			goto(PKMN_Center_Move_Tutor)
		break
	}
    release
    end
}

script PKMN_Center_EventScript_RandomizerToggle{
	checkSaveblockValue(SAVEBLOCK_RANDOMIZER)
	if(var(VAR_RESULT) == TRUE){
		msgbox(format("要关闭野外遭遇的随机化吗？"), MSGBOX_YESNO)
		switch(var(VAR_RESULT)){
			case YES:
				checkSaveblockValue(SAVEBLOCK_RANDOMIZER)
				if(var(VAR_RESULT) == TRUE){
					toggleSaveblock(SAVEBLOCK_RANDOMIZER, FALSE)
					playfanfare(MUS_OBTAIN_ITEM)
					message(format("随机化已关闭。"))
				}
				waitmessage
				waitfanfare
			break
			case NO:
			case MULTI_B_PRESSED:
			default:
				goto(PKMN_Center_Move_Tutor)
			break
		}
	}
	else{
		msgbox(format("随机化已经关闭了。$"), MSGBOX_NPC)
		waitmessage
		goto(PKMN_Center_Move_Tutor)
	}
    release
    end
}

script PKMN_Center_EventScript_Lower_Difficulty{
	checkSaveblockValue(SAVEBLOCK_DIFFICULTY)
	if(var(VAR_RESULT) != DIFFICULTY_EASY){
		msgbox(format("要降低难度吗？"), MSGBOX_YESNO)
		switch(var(VAR_RESULT)){
			case YES:
				checkSaveblockValue(SAVEBLOCK_DIFFICULTY)
				if(var(VAR_RESULT) == DIFFICULTY_HELL){
					//Hell Mode -> Elite Mode
					//toggleSaveblock(SAVEBLOCK_DIFFICULTY, DIFFICULTY_ELITE)
					//playfanfare(MUS_OBTAIN_ITEM)
					//message(format("难度变为精英。"))
					msgbox(format("无法关闭地狱模式难度！\n如果觉得太难，\l请重新开始存档。"), MSGBOX_NPC)
				}
				elif(var(VAR_RESULT) == DIFFICULTY_ELITE){
					//Elite Mode -> Ace Mode
					toggleSaveblock(SAVEBLOCK_DIFFICULTY, DIFFICULTY_ACE)
					playfanfare(MUS_OBTAIN_ITEM)
					message(format("难度变为进阶。"))
					waitmessage
					waitfanfare
				}
				else{
					//Ace Mode -> Easy Mode
					toggleSaveblock(SAVEBLOCK_DIFFICULTY, DIFFICULTY_EASY)
					playfanfare(MUS_OBTAIN_ITEM)
					message(format("难度变为简单。"))
					waitmessage
					waitfanfare
				}
			break
			case NO:
			case MULTI_B_PRESSED:
			default:
				goto(PKMN_Center_Change_Difficulty)
			break
		}
	}
	else{
		msgbox(format("已经是最低难度了，练练吧！"))
		goto(PKMN_Center_Move_Tutor)
	}
    release
    end
}

script PKMN_Center_EventScript_Up_Difficulty{
	checkSaveblockValue(SAVEBLOCK_DIFFICULTY)
	if(var(VAR_RESULT) != DIFFICULTY_HELL){
		msgbox(format("要提升难度吗？"), MSGBOX_YESNO)
		switch(var(VAR_RESULT)){
			case YES:
				checkSaveblockValue(SAVEBLOCK_DIFFICULTY)
				if(var(VAR_RESULT) == DIFFICULTY_EASY){
					//Easy Mode -> Ace Mode
					toggleSaveblock(SAVEBLOCK_DIFFICULTY, DIFFICULTY_ACE)
					playfanfare(MUS_OBTAIN_ITEM)
					message(format("难度变为进阶。"))
					setflag(FLAG_SYS_UPPED_DIFFICULTY)
					waitmessage
					waitfanfare
				}
				elif(var(VAR_RESULT) == DIFFICULTY_ACE){
					//Ace Mode -> Elite Mode
					toggleSaveblock(SAVEBLOCK_DIFFICULTY, DIFFICULTY_ELITE)
					playfanfare(MUS_OBTAIN_ITEM)
					message(format("难度变为精英。"))
					setflag(FLAG_SYS_UPPED_DIFFICULTY)
					waitmessage
					waitfanfare
				}
				else{
					//Elite Mode -> Hell Mode
					//toggleSaveblock(SAVEBLOCK_DIFFICULTY, DIFFICULTY_HELL)
					//playfanfare(MUS_OBTAIN_ITEM)
					//message(format("难度变为地狱。"))
					msgbox(format("不重新开始存档\n就无法进入地狱难度！"), MSGBOX_NPC)
				}
			break
			case NO:
			case MULTI_B_PRESSED:
			default:
				goto(PKMN_Center_Change_Difficulty)
			break
		}
	}
	else{
		msgbox(format("已经是最高难度了，出去走走吧！"))
		goto(PKMN_Center_Move_Tutor)
	}
    release
    end
}
