    "反转昼夜$"
    "关闭随机化$"
    "评价昵称$"
    "神秘礼物$"
    "更改难度$"
    "更改季节$"
    "$"
}

text MultiChoice_Difficulty_Change{
    "提升难度$"
    "降低难度$"
    "退出$"
    "$"
}

text MultiChoice_Season_Change{
    "春天$"
    "夏天$"
    "秋天$"
    "冬天$"
    "自动$"
    "退出$"
    "$"
}

text Text_Pokemart_Script_No_Badges{
    format("抱歉，你还没有徽章，我不能卖东西给你。")
}

script LittlerootTown_EventScript_EnableLegendaryNPC{
	setflag(FLAG_REMOVE_LEGENDARY_NPC)
	checkSaveblockValue(SAVEBLOCK_ENABLE_LEGENDARY)
	if(var(VAR_RESULT) == TRUE || flag(FLAG_SYS_GAME_CLEAR)){
		clearflag(FLAG_REMOVE_LEGENDARY_NPC) //Adds the NPC
	}
	return
}
