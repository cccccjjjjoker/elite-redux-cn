    "Yes$"
    "10$"
    "11$"
    "19$"
    "20$"
    "21$"
    "22$"
    "23$"
    "24$"
    "25$"
    "27$"
    "29$"
    "38$"
    "40$"
    "41$"
    "42$"
    "$"
}
text MultiChoice_MawootadFinlandQuestion{
    "Yes$"
    "A Scorbuny$"
    "50BP$"
    "An OP Pokémon$"
    "$"
}
text MultiChoice_MawootadXDQuestion{
    "Yes$"
    "Roxanne$"
    "Flannery$"
    "Winona$"
    "Liza$"
    "Wattson$"
    "$"
}
movement Route120_EventScript_MawootadNPCWalkAway{
    walk_right * 5
    walk_up * 2
    walk_right * 5
}
movement Route120_EventScript_MawootadNPCTrainerFollowUp{
    walk_right * 6
    walk_up * 2
    walk_right * 4
}
movement Route120_EventScript_MawootadNPCTrainerCatchUp{
    walk_down
    walk_right
}
